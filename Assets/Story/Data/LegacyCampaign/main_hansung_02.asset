  eventId: main_hansung_02
  category: 1
  linearDialogue: 0
  tutorialOnly: 0
  title: "\uB124 \uD68C\uC0AC\uC758 \uC7A5\uBD80\uAC00 \uB9CC\uB098\uB294 \uACF3"
  image: {fileID: 21300000, guid: e4f06f328acf53c4385995fb1f2c1e65, type: 3}
  cardImage: {fileID: 21300000, guid: d04aa39026668454991718ef00702904, type: 3}
  npcArts: []
  highlightImage: {fileID: 0}
  negotiationBackground: {fileID: 0}
  description: "\uBCF4\uACE0\uC11C\uC5D0 \uC801\uD78C \uD68C\uC0AC\uB294 \uB137\uC774\uB2E4.
    \uC790\uAE08\uACFC \uAC70\uB798 \uCC3D\uAD6C\uB97C \uB530\uB77C\uAC00\uB2C8 \uBA87
    \uC904\uC774 \uAC19\uC740 \uACF3\uC5D0\uC11C \uB9CC\uB0AC\uB2E4. \uB2E4\uC74C\uC5D0\uB294
    \uB204\uAD6C\uC5D0\uAC8C \uC5B4\uB5A4 \uAE30\uB85D\uC744 \uBB3C\uC744\uC9C0 \uC815\uD574\uC57C
    \uD55C\uB2E4."
  apCost: 0
  startButtonText: "\uB9CC\uB098\uAE30"
  companyIds:
  - hansung-industry
  speakerNpcId: npc-investigative-reporter-jung-sua
  speakerName: "\uC815\uC218\uC544"
  speakerRole:
  dialogue: "\uACF5\uAC1C \uAC70\uB798 \uAD00\uACC4\uC640 \uC0AC\uC5C5 \uCC38\uC5EC
    \uC790\uB8CC\uB97C \uB9DE\uCDB0\uBD24\uC5B4\uC694. APEX\uAC00 \uC774 \uC0AC\uC5C5\uB4E4\uC5D0
    \uAD00\uC5EC\uD588\uB358 \uAC74 \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
    \uB2E4\uB9CC \uB204\uAC00 \uC2E4\uC81C\uB85C \uC870\uAC74\uC744 \uBC14\uAFE8\uACE0
    \uBB34\uC5C7\uC774 \uACC4\uC57D\uC744 \uC5B4\uAE34 \uC77C\uC778\uC9C0\uB294 \uC544\uC9C1
    \uB354 \uBD10\uC57C \uD574\uC694."
  companyQuestion:
  companyPlayerLine:
  choices:
  - choiceText: "\uBBF8\uB798\uAC74\uC124 \uAC70\uB798\uBD80\uD130 \uC0B4\uD540\uB2E4"
    choiceDescription:
    playerLine: "\uBBF8\uB798\uAC74\uC124\uC758 \uD604\uC7A5 \uC778\uACC4\uC640 \uC815\uC0B0\uBD80\uD130
      \uB530\uB77C\uAC00\uACA0\uC2B5\uB2C8\uB2E4. \uADF8 \uB2E4\uC74C\uC5D0 \uC5F0\uACB0\uB41C
      \uAC70\uB798\uCC98\uC758 \uC124\uBA85\uC744 \uB4E3\uC8E0."
    resultDialogue: "\uACF5\uC0AC\uAC00 \uB05D\uB09C \uB4A4 \uB204\uAC00 \uC77C\uC744
      \uC774\uC5B4\uBC1B\uC558\uB294\uC9C0\uBD80\uD130\uC694. \uC55E\uC5D0\uC11C
      \uBC1B\uC740 \uB0A0\uC9DC\uB4E4\uC744 \uCC59\uACA8\uB450\uC138\uC694. \uB2E4\uC74C
      \uC124\uBA85\uACFC \uB9DE\uCDB0\uBCFC \uC218 \uC788\uC744 \uAC70\uC608\uC694."
    resultValue: answer_0
