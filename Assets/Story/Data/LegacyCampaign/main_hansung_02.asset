  title: "29\uC77C\uCC28 \u2014 \uB124 \uD68C\uC0AC\uC758 \uB2E4\uB978 \uC774\uB984,
    \uC774\uC5B4\uC9C0\uB294 \uC0AC\uC5C5\uB9DD"
  image: {fileID: 21300000, guid: d8d3f113a14a1de47b97d1e11657d5d6, type: 3}
  cardImage: {fileID: 21300000, guid: d8d3f113a14a1de47b97d1e11657d5d6, type: 3}
  npcArts: []
  highlightImage: {fileID: 0}
  negotiationBackground: {fileID: 0}
  description: "29\uC77C\uCC28 \u2014 \uB124 \uD68C\uC0AC\uC758 \uB2E4\uB978 \uC774\uB984,
    \uC774\uC5B4\uC9C0\uB294 \uC0AC\uC5C5\uB9DD\uC5D0 \uAD00\uD55C \uBA74\uB2F4 \uC694\uCCAD\uC785\uB2C8\uB2E4.
    \uB0B4\uC6A9\uACFC \uBE44\uC6A9\uC744 \uD655\uC778\uD55C \uB4A4 \uB9CC\uB098\uC2ED\uC2DC\uC624."
  apCost: 0
  startButtonText: "\uB9CC\uB098\uAE30"
  companyIds:
  - hansung-industry
  speakerNpcId: npc-investigative-reporter-jung-sua
  speakerName: "\uC815\uC218\uC544"
  speakerRole:
  dialogue: "\uACF5\uAC1C \uAC70\uB798 \uAD00\uACC4\uC640 \uC0AC\uC5C5 \uCC38\uC5EC
    \uC790\uB8CC\uB97C \uB9DE\uCDB0\uBD24\uC5B4\uC694. APEX\uAC00 \uC774 \uC0AC\uC5C5\uB4E4\uC5D0
    \uAD00\uC5EC\uD588\uB358 \uAC74 \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
    \uB2E4\uB9CC \uB204\uAC00 \uC2E4\uC81C\uB85C \uC870\uAC74\uC744 \uBC14\uAFE8\uACE0
    \uBB34\uC5C7\uC774 \uACC4\uC57D\uC744 \uC5B4\uAE34 \uC77C\uC778\uC9C0\uB294 \uC544\uC9C1
    \uB354 \uBD10\uC57C \uD574\uC694."
  companyQuestion:
  companyPlayerLine:
  choices:
  - choiceText: "\uBBF8\uB798\uAC74\uC124\uC744 \uC6B0\uC120\uD55C\uB2E4"
    choiceDescription: "\uC774\uBC88 \uB300\uD654\uC758 \uC120\uD0DD\uACFC \uAD00\uCC30
      \uC0AC\uC2E4\uC744 \uAE30\uB85D\uD569\uB2C8\uB2E4. \uD604\uAE08\xB7\uC9C0\uBD84
      \uBCC0\uD654 \uC5C6\uC74C."
    playerLine: "\uBBF8\uB798\uAC74\uC124\uC744 \uC6B0\uC120\uD55C\uB2E4"
    resultDialogue: "\uD604\uC7A5\uACFC \uACC4\uC57D\uC744 \uC774\uC5B4\uAC08 \uC870\uAC74\uBD80\uD130
      \uBCF4\uC2DC\uC8E0. \uC9C0\uAE08\uAE4C\uC9C0 \uB4E4\uC740 \uB0B4\uC6A9\uC744
      \uBC14\uD0D5\uC73C\uB85C \uB2E4\uC74C \uACC4\uD68D\uC744 \uC815\uD558\uBA74
      \uB418\uACA0\uB124\uC694."
