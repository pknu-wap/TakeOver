  openingLines:
  - npcId:
    text: "\uC8FC\uC8FC \uBA74\uB2F4\uC2E4\uC758 \uD14C\uC774\uBE14\uC5D0\uB294 \uAC19\uC740
      \uC81C\uD488\uC774 \uB450 \uC811\uC2DC\uC5D0 \uB098\uB258\uC5B4 \uC788\uC5C8\uB2E4.
      \uAE40\uD558\uB9B0\uC740 \uC790\uB8CC\uBD80\uD130 \uD3BC\uCE58\uC9C0 \uC54A\uACE0
      \uBB3C\uCEF5\uC744 \uB0B4 \uCABD\uC73C\uB85C \uBC00\uC5B4\uC8FC\uC5C8\uB2E4."
    player: 0
    narration: 1
  - npcId: npc-haneul-food-ceo-kim-harin
    text: "\uBA3C\uC800 \uB4DC\uC154\uBCF4\uC138\uC694. \uC124\uBA85 \uB4E3\uACE0
      \uBA39\uC73C\uBA74 \uB2E4\uB4E4 \uC124\uBA85\uC5D0 \uB9DE\uCDB0\uC11C \uB2F5\uD558\uC2DC\uB354\uB77C\uACE0\uC694."
    player: 0
    narration: 0
  - npcId:
    text: "\uC5B4\uB290 \uCABD\uC774 \uB354 \uC88B\uC740\uC9C0 \uB9DE\uD788\uB294
      \uAC81\uB2C8\uAE4C?"
    player: 1
    narration: 0
  - npcId: npc-haneul-food-ceo-kim-harin
    text: "\uADF8\uB7F0 \uC2DC\uD5D8\uC740 \uC544\uB2C8\uC5D0\uC694. \uC81C\uAC00
      \uC800\uD76C \uC81C\uD488 \uB9DB\uC744 \uB9DE\uD788\uB77C\uACE0 \uC190\uB2D8\uC744
      \uBD88\uB800\uC73C\uBA74 \uB2E4\uC74C\uC5D0\uB294 \uC548 \uC624\uC2DC\uC8E0."
    player: 0
    narration: 0
  - npcId:
    text: "\uD55C\uCABD\uC740 \uC870\uAE08 \uB354 \uC9C4\uD588\uACE0 \uB2E4\uB978
      \uCABD\uC740 \uB05D\uB9DB\uC774 \uAC00\uBCBC\uC6E0\uB2E4. \uD070 \uCC28\uC774\uB97C
      \uB9D0\uD558\uAE30 \uC804\uC5D0 \uB2E4\uC2DC \uD55C \uBC88 \uBA39\uC5B4\uBCF4\uAC8C
      \uB410\uB2E4."
    player: 0
    narration: 1
  - npcId:
    text: "\uC624\uB978\uCABD\uC774 \uB354 \uAC00\uBCCD\uC2B5\uB2C8\uB2E4. \uB9E4\uC77C
      \uBA39\uB294\uB2E4\uBA74 \uADF8\uCABD\uC744 \uACE0\uB97C \uC218\uB3C4 \uC788\uACA0\uB124\uC694."
    player: 1
    narration: 0
  - npcId: npc-haneul-food-ceo-kim-harin
    text: "\uB124. \uD55C \uC785 \uB9DB\uC788\uB2E4\uACE0 \uACC4\uC18D \uACE0\uB974\uB294
      \uAC74 \uC544\uB2C8\uAC70\uB4E0\uC694. \uC190\uB2D8\uC774 \uB2E4\uC2DC \uC9D1\uC5B4\uB4DC\uB294
      \uC774\uC720\uB97C \uC54C\uC544\uC57C \uD574\uC694."
    player: 0
    narration: 0
  - npcId: npc-haneul-food-cfo-oh-jaeseong
    text: "\uB450 \uC81C\uD488\uC740 \uBCF4\uAD00 \uC870\uAC74\uACFC \uC0DD\uC0B0
      \uBE44\uC6A9\uB3C4 \uB2E4\uB985\uB2C8\uB2E4. \uC120\uD638\uB3C4\uB9CC \uBCF4\uBA74
      \uC624\uB978\uCABD\uC778\uB370 \uD3D0\uAE30\uC728\uAE4C\uC9C0 \uBCF4\uBA74
      \uB2E4\uB978 \uB2F5\uC774 \uB098\uC62C \uC218 \uC788\uACE0\uC694."
    player: 0
    narration: 0
  - npcId: npc-haneul-food-ceo-kim-harin
    text: "\uC774\uCABD\uC740 \uC624\uC7AC\uC131 \uC774\uC0AC\uC608\uC694. \uC81C\uAC00
      \uB9DB \uC598\uAE30\uB97C \uAE38\uAC8C \uD558\uBA74 \uC606\uC5D0\uC11C \uC720\uD1B5\uAE30\uD55C\uC744
      \uAEBC\uB0B4\uB294 \uBD84\uC774\uC8E0."
    player: 0
    narration: 0
  - npcId: npc-haneul-food-cfo-oh-jaeseong
    text: "\uD310\uB9E4\uAC00 \uB05D\uB0A0 \uB54C\uAE4C\uC9C0\uB294 \uADF8 \uBB38\uC81C\uAC00
      \uB0A8\uC73C\uB2C8\uAE4C\uC694. \uC6D0\uAC00\uD45C\uB294 \uC870\uAE08 \uB4A4\uC5D0
      \uBCF4\uC5EC\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4."
    player: 0
    narration: 0
  - npcId:
    text: "\uB300\uD45C\uB2D8\uC740 \uC18C\uBE44\uC790 \uBC18\uC751\uC744 \uC9C1\uC811
      \uB9CE\uC774 \uBCF4\uC2ED\uB2C8\uAE4C?"
    player: 1
    narration: 0
  - npcId: npc-haneul-food-ceo-kim-harin
    text: "\uAC00\uB2A5\uD55C \uD55C \uBD10\uC694. \uC5B4\uB5A4 \uBD84\uC740 \uB9DB\uC774
      \uBC14\uB00C\uC5C8\uB2E4\uACE0 \uC804\uD654\uD558\uC2DC\uACE0 \uC5B4\uB5A4
      \uBD84\uC740 \uD3EC\uC7A5\uC774 \uC548 \uC5F4\uB9B0\uB2E4\uACE0 \uD558\uC138\uC694.
      \uCC98\uC74C\uC5D4 \uC0AC\uC18C\uD574 \uBCF4\uC5EC\uB3C4 \uB9E4\uC77C \uC4F0\uB294
      \uBD84\uB4E4\uD55C\uD14C\uB294 \uADF8\uAC8C \uC81C\uD488\uC774\uC5D0\uC694."
    player: 0
    narration: 0
  - npcId: npc-haneul-food-cfo-oh-jaeseong
    text: "\uBC18\uB300\uB85C \uC758\uACAC\uC744 \uB2E4 \uBC18\uC601\uD558\uBA74
      \uD488\uBAA9\uB9CC \uB298\uACE0 \uC0DD\uC0B0 \uC2DC\uAC04\uC774 \uBD80\uC871\uD574\uC9D1\uB2C8\uB2E4.
      \uBCC0\uACBD\uD560 \uB54C \uBB34\uC5C7\uC744 \uC904\uC77C\uC9C0\uB3C4 \uC815\uD574\uC57C
      \uD569\uB2C8\uB2E4."
    player: 0
    narration: 0
  - npcId:
    text: "\uD488\uC9C8\uC744 \uC9C0\uD0A4\uC790\uB294 \uB370\uB3C4 \uC11C\uB85C
      \uB2E4\uB978 \uACC4\uC0B0\uC774 \uC788\uAD70\uC694."
    player: 1
    narration: 0
  - npcId: npc-haneul-food-ceo-kim-harin
    text: "\uB9DE\uC544\uC694. \uC800\uB294 \uC775\uC219\uD55C \uC190\uB2D8\uC774
      \uB2E4\uC2DC \uC0B4 \uC774\uC720\uB97C \uC9C0\uD0A4\uACE0 \uC2F6\uC5B4\uC694.
      \uC774\uC0AC\uB2D8\uC740 \uADF8\uAC78 \uACC4\uC18D \uB9CC\uB4E4 \uB3C8\uC774
      \uC788\uB294\uC9C0 \uBCF4\uC2DC\uACE0\uC694."
    player: 0
    narration: 0
  - npcId: npc-haneul-food-cfo-oh-jaeseong
    text: "\uC18C\uBE44\uC790\uC5D0\uAC8C \uBE44\uC6A9\uC744 \uC228\uAE30\uB294 \uC120\uD0DD\uC740
      \uC624\uB798 \uBABB \uAC11\uB2C8\uB2E4. \uB2E4\uB9CC \uC81C\uD488\uC5D0 \uD544\uC694\uD55C
      \uD488\uC9C8\uACFC \uC9C0\uAE08 \uC720\uC9C0\uD558\uB294 \uBAA8\uB4E0 \uC808\uCC28\uAC00
      \uD56D\uC0C1 \uAC19\uC740 \uAC74 \uC544\uB2D9\uB2C8\uB2E4."
    player: 0
    narration: 0
  - npcId:
    text: "\uD488\uC9C8\uC744 \uAC74\uB4DC\uB9AC\uC9C0 \uC54A\uACE0 \uC904\uC77C
      \uBE44\uC6A9\uC774 \uC788\uB2E4\uB294 \uAC81\uB2C8\uAE4C?"
    player: 1
    narration: 0
  - npcId: npc-haneul-food-cfo-oh-jaeseong
    text: "\uADF8\uAC78 \uD655\uC778\uD558\uB294 \uC911\uC785\uB2C8\uB2E4. \uD589\uC0AC
      \uBB3C\uB7C9, \uC0DD\uC0B0 \uC21C\uC11C, \uD3EC\uC7A5 \uC885\uB958\uCC98\uB7FC\uC694.
      \uC6D0\uB8CC\uBD80\uD130 \uBC14\uAFB8\uBA74 \uC26C\uC6CC \uBCF4\uC774\uC9C0\uB9CC
      \uB098\uC911\uC5D0 \uC124\uBA85\uD560 \uBE44\uC6A9\uC774 \uD07D\uB2C8\uB2E4."
    player: 0
    narration: 0
  - npcId: npc-haneul-food-ceo-kim-harin
    text: "\uC124\uBA85\uC73C\uB85C \uB05D\uB098\uC9C0\uB3C4 \uC54A\uC8E0. \uD55C
      \uBC88 \uBABB \uBBFF\uACA0\uB2E4\uACE0 \uB0B4\uB824\uB193\uC740 \uBB3C\uAC74\uC740
      \uB2E4\uC2DC \uC9D1\uC5B4\uB4E4\uAC8C \uD558\uAE30 \uC5B4\uB824\uC6CC\uC694."
    player: 0
    narration: 0
  - npcId: npc-haneul-food-ceo-kim-harin
    text: "\uC640\uC8FC\uC168\uB124\uC694. \uC8FC\uC2DD\uC744 \uB298\uB9AC\uC168\uB2E4\uACE0
      \uB4E4\uC5C8\uC5B4\uC694. \uC5B4\uB5A4 \uC124\uBA85\uC744 \uB4E3\uACE0 \uC2F6\uC73C\uC2E0\uC9C0\uB3C4
      \uBBF8\uB9AC \uC801\uC5B4\uC8FC\uC168\uACE0\uC694. \uC81C\uD488 \uC774\uC57C\uAE30\uBD80\uD130
      \uC7A0\uAE50 \uD558\uACE0, \uADF8 \uAC70\uB798\uB3C4 \uB9D0\uC500\uB4DC\uB9B4\uAC8C\uC694."
    player: 0
    narration: 0
  - npcId: npc-haneul-food-cfo-oh-jaeseong
    text: "\uC608\uC804 \uAC70\uB798\uB294 \uBB3C\uB7C9\uB9CC \uBCF4\uBA74 \uC131\uACF5\uC801\uC774\uC5C8\uC2B5\uB2C8\uB2E4.
      \uC800\uB3C4 \uCD08\uAE30\uC5D0 \uADF8\uB807\uAC8C \uC124\uBA85\uD588\uC2B5\uB2C8\uB2E4.
      \uC815\uC0B0 \uC2DC\uC810\uACFC \uC6B0\uB9AC\uAC00 \uBD80\uB2F4\uD560 \uC870\uAC74\uC744
      \uCDA9\uBD84\uD788 \uBC18\uC601\uD558\uC9C0 \uBABB\uD588\uACE0\uC694."
    player: 0
    narration: 0
  - npcId: npc-haneul-food-ceo-kim-harin
    text: "\uB354 \uB9CE\uC740 \uBD84\uAED8 \uC81C\uD488\uC744 \uBCF4\uC5EC\uC904
      \uC218 \uC788\uB2E4\uACE0 \uC0DD\uAC01\uD588\uC5B4\uC694. \uD3EC\uC7A5\uB3C4
      \uB9DE\uCD94\uACE0, \uC0DD\uC0B0 \uACC4\uD68D\uB3C4 \uBC14\uAFE8\uC8E0. \uC190\uB2D8\uC774
      \uB4E4\uC5B4\uC62C \uC790\uB9AC\uAC00 \uB298\uC5B4\uB098\uB294 \uC77C\uC774\uB77C\uACE0
      \uBD24\uC73C\uB2C8\uAE4C\uC694."
    player: 0
    narration: 0
  - npcId:
    text: "\uADF8\uB7F0\uB370 \uC57D\uC18D\uD55C \uAC70\uB798\uAC00 \uC904\uC5C8\uC2B5\uB2C8\uAE4C?"
    player: 1
    narration: 0
  - npcId: npc-haneul-food-cfo-oh-jaeseong
    text: "\uAC70\uB798\uB7C9\uBFD0 \uC544\uB2C8\uB77C \uBE44\uC6A9 \uBD80\uB2F4\uB3C4
      \uB2EC\uB77C\uC84C\uC2B5\uB2C8\uB2E4. \uC0C1\uB300\uB294 \uADF8 \uC870\uC815\uC774
      \uAE30\uC874 \uACC4\uC57D\uC5D0 \uD3EC\uD568\uB41C\uB2E4\uACE0 \uD588\uC2B5\uB2C8\uB2E4.
      \uC6B0\uB9AC\uB294 \uB2E4\uB978 \uD574\uC11D\uC774\uC5C8\uACE0\uC694. \uC815\uC0B0
      \uC911\uC7AC\uB97C \uB9E1\uC740 \uD68C\uC0AC\uB3C4 \uB530\uB85C \uC788\uC5C8\uC2B5\uB2C8\uB2E4."
    player: 0
    narration: 0
  - npcId:
    text: "\uBBF8\uB798\uAC74\uC124\uC5D0\uC11C\uB3C4 \uACC4\uC57D \uD68C\uC0AC\uC640
      \uC815\uC0B0 \uCC3D\uAD6C\uAC00 \uB2EC\uB790\uC2B5\uB2C8\uB2E4. \uC774\uB984\uACFC
      \uC2DC\uAE30\uB97C \uBE44\uAD50\uD574\uB3C4 \uB418\uACA0\uC2B5\uB2C8\uAE4C?
      \uACF5\uAC1C\uD560 \uC218 \uC788\uB294 \uBC94\uC704\uC5D0\uC11C\uC694."
    player: 1
    narration: 0
  - npcId: npc-haneul-food-cfo-oh-jaeseong
    text: "\uC0C1\uB300 \uD68C\uC0AC\uC758 \uBE44\uACF5\uAC1C \uACC4\uC57D \uC804\uCCB4\uB97C
      \uB118\uAE38 \uC218\uB294 \uC5C6\uC2B5\uB2C8\uB2E4. \uACF5\uAC1C \uC124\uBA85\uC5D0
      \uC4F4 \uAC70\uB798 \uC8FC\uCCB4\uC640 \uC815\uC0B0 \uACBD\uACFC\uB294 \uD655\uC778\uD574\uB4DC\uB9B4
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    player: 0
    narration: 0
  - npcId: npc-haneul-food-ceo-kim-harin
    text: "\uADF8 \uC774\uB984\uC744 \uCC3E\uB294 \uAC8C \uC800\uD76C\uD55C\uD14C\uB3C4
      \uB3C4\uC6C0\uC774 \uB429\uB2C8\uAE4C?"
    player: 0
    narration: 0
  - npcId:
    text: "\uC544\uC9C1\uC740 \uBAA8\uB974\uACA0\uC2B5\uB2C8\uB2E4. \uB2E4\uB9CC
      \uAC19\uC740 \uBC29\uC2DD\uC73C\uB85C \uBD80\uB2F4\uC774 \uB0A8\uC558\uB2E4\uBA74
      \uC9C0\uAE08\uC758 \uC870\uAC74\uC744 \uBCFC \uB54C\uB3C4 \uD655\uC778\uD560
      \uAC8C \uC788\uC744 \uAC81\uB2C8\uB2E4. \uADF8\uB9AC\uACE0 \uC800\uB3C4 \uC774\uB7F0
      \uAC70\uB798\uAC00 \uC5B4\uB514\uC11C \uACB0\uC815\uB418\uB294\uC9C0 \uC54C\uACE0
      \uC2F6\uC2B5\uB2C8\uB2E4."
    player: 1
    narration: 0
  - npcId: npc-haneul-food-ceo-kim-harin
    text: "\uC800\uD76C\uAC00 \uACAA\uC740 \uC77C\uC744 \uB204\uAD70\uAC00\uB97C
      \uACF5\uACA9\uD558\uB294 \uC7AC\uB8CC\uB85C\uB9CC \uC4F0\uC9C0\uB294 \uC54A\uC73C\uC168\uC73C\uBA74
      \uD574\uC694. \uC9C0\uAE08\uB3C4 \uC81C\uD488\uC744 \uB9CC\uB4DC\uB294 \uC0AC\uB78C\uD558\uACE0
      \uC0AC\uB294 \uC0AC\uB78C\uC774 \uC788\uC73C\uB2C8\uAE4C\uC694."
    player: 0
    narration: 0
  - npcId: npc-haneul-food-cfo-oh-jaeseong
    text: "\uB2F9\uC2DC \uC81C \uD310\uB2E8\uB3C4 \uC790\uB8CC\uC5D0\uC11C \uBE60\uC9C0\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4. \uC0C1\uB300\uAC00 \uC870\uAC74\uC744 \uBC14\uAFE8\uB2E4\uACE0
      \uD574\uC11C \uC6B0\uB9AC\uAC00 \uACC4\uC0B0\uC744 \uC798\uBABB\uD55C \uBD80\uBD84\uAE4C\uC9C0
      \uC5C6\uC5B4\uC9C0\uB294 \uAC74 \uC544\uB2C8\uACE0\uC694."
    player: 0
    narration: 0
  - npcId:
    text: "\uADF8 \uBD80\uBD84\uB3C4 \uAC19\uC774 \uBCF4\uACA0\uC2B5\uB2C8\uB2E4.
      \uD68C\uC0AC\uAC00 \uC9C0\uAE08 \uBC14\uAFC0 \uC218 \uC788\uB294 \uAC83\uACFC
      \uACFC\uAC70 \uAC70\uB798\uC5D0\uC11C \uC0DD\uAE34 \uC190\uC2E4\uC744 \uB098\uB220\uC11C\uC694."
    player: 1
    narration: 0
  - npcId: npc-haneul-food-ceo-kim-harin
    text: "\uC624\uB298 \uD655\uC778\uD55C \uB0B4\uC6A9\uC740 \uC5B4\uB5BB\uAC8C
      \uBCF4\uACE0 \uACC4\uC2ED\uB2C8\uAE4C?"
    player: 0
    narration: 0
  companyVariants: []
