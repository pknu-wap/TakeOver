  companyQuestion:
  companyPlayerLine:
  choices:
  - choiceText: "\uBE0C\uB79C\uB4DC\uC640 \uAC70\uB798 \uC870\uAC74\uC744 \uD568\uAED8
      \uBCF8\uB2E4"
    choiceDescription: "\uC774\uBC88 \uB300\uD654\uC758 \uC120\uD0DD\uACFC \uAD00\uCC30
      \uC0AC\uC2E4\uC744 \uAE30\uB85D\uD569\uB2C8\uB2E4. \uD604\uAE08\xB7\uC9C0\uBD84
      \uBCC0\uD654 \uC5C6\uC74C."
    playerLine: "\uBE0C\uB79C\uB4DC\uC640 \uAC70\uB798 \uC870\uAC74\uC744 \uD568\uAED8
      \uBCF8\uB2E4"
    resultDialogue: "\uADF8\uB807\uAC8C \uBD10\uC8FC\uC2DC\uBA74 \uC88B\uACA0\uC5B4\uC694.
      \uC190\uB2D8\uC774 \uB2E4\uC2DC \uC0AC\uB294 \uC774\uC720\uC640 \uC800\uD76C\uAC00
      \uACC4\uC18D \uB9CC\uB4E4 \uC870\uAC74\uC744 \uAC19\uC774 \uC815\uB9AC\uD574\uB4DC\uB9B4\uAC8C\uC694.
      \uC624\uB298\uC740 \uD611\uB825\uC744 \uAC80\uD1A0\uD558\uB294 \uB2E8\uACC4\uB85C
      \uC774\uD574\uD558\uACA0\uC2B5\uB2C8\uB2E4."
