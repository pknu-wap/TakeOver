  - choiceText: "\uC790\uB8CC\uB97C \uBCF8 \uB4A4 \uD310\uB2E8\uD55C\uB2E4"
    choiceDescription:
    playerLine: "\uC624\uB298 \uB9D0\uC500\uC740 \uC790\uB8CC\uC640 \uD568\uAED8
      \uB2E4\uC2DC \uC77D\uC5B4\uBCF4\uACA0\uC2B5\uB2C8\uB2E4. \uC9C0\uAE08 \uBC14\uB85C
