  eventId: main_hansung_01
  category: 1
  linearDialogue: 0
  tutorialOnly: 0
  title: "\uD55C\uC131\uACF5\uC5C5 \u2014 \uAC80\uC218\uC5D0\uC11C \uBA48\uCD98 \uC124\uBE44"
  image: {fileID: 21300000, guid: e4f06f328acf53c4385995fb1f2c1e65, type: 3}
  cardImage: {fileID: 21300000, guid: d04aa39026668454991718ef00702904, type: 3}
  npcArts: []
  highlightImage: {fileID: 0}
  negotiationBackground: {fileID: 0}
  description: "\uC870\uBBFC\uC11D\uACFC \uCD5C\uBBF8\uC815\uC774 \uC0DD\uC0B0 \uC804\uD658\uC5D0
    \uD544\uC694\uD55C \uC791\uC5C5\uC744 \uBCF4\uC5EC\uC900\uB2E4. \uC608\uC804\uC5D0\uB3C4
    \uBE44\uC2B7\uD55C \uC7A5\uBE44\uB97C \uC644\uC131\uD588\uB2E4\uB294\uB370, \uAC80\uC218\uB294
    \uC774\uB8E8\uC5B4\uC9C0\uC9C0 \uC54A\uC558\uB2E4\uACE0 \uD55C\uB2E4. \uADF8\uB54C
    \uB0A8\uC740 \uBE44\uC6A9\uC774 \uC9C0\uAE08 \uACAC\uC801\uC5D0 \uC5BC\uB9C8\uB098
    \uACB9\uCE58\uB294\uC9C0 \uAD81\uAE08\uD558\uB2E4."
  apCost: 0
  startButtonText: "\uB9CC\uB098\uAE30"
  companyIds:
  - hansung-industry
  speakerNpcId: npc-hansung-industry-ceo-jo-minseok
  speakerName: "\uC870\uBBFC\uC11D"
  speakerRole:
  dialogue: "\uB208\uC73C\uB85C \uBCF4\uC2DC\uC8E0. \uB458 \uC911 \uC5B4\uB290 \uAC8C
    \uC81C\uB300\uB85C \uB098\uC628 \uAC81\uB2C8\uAE4C?"
  companyQuestion:
  companyPlayerLine:
  choices:
  - choiceText: "\uB2F9\uC2DC \uACB0\uC815 \uBC94\uC704\uB97C \uBB3B\uB294\uB2E4"
    choiceDescription:
    playerLine: "\uC124\uBE44\uB97C \uB9DE\uCD94\uB358 \uB54C\uC5D0 \uC5B4\uB290
      \uBD80\uBD84\uAE4C\uC9C0 \uC9C1\uC811 \uC815\uD558\uC168\uC2B5\uB2C8\uAE4C?
      \uBC16\uC5D0\uC11C \uC694\uAD6C\uD55C \uC870\uAC74\uB3C4 \uD568\uAED8 \uB4E3\uACE0
      \uC2F6\uC2B5\uB2C8\uB2E4."
    resultDialogue: "\uB9CC\uB4DC\uB294 \uBC29\uBC95\uC740 \uC6B0\uB9AC\uAC00 \uC815\uD588\uC18C.
      \uBB3C\uB7C9\uC774 \uC774\uC5B4\uC9C8 \uAC70\uB77C\uB294 \uC124\uBA85\uC740
      \uB530\uB85C \uBC1B\uC558\uACE0. \uB0B4\uAC00 \uACB0\uC815\uD55C \uBD80\uBD84\uBD80\uD130
      \uC228\uAE40\uC5C6\uC774 \uB9D0\uD558\uB9AC\uB2E4."
    resultValue: answer_0
    npcResult:
