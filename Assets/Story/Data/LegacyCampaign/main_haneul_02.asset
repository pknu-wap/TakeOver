  startButtonText: "\uB9CC\uB098\uAE30"
  companyIds:
  - haneul-food
  speakerNpcId: npc-investigative-reporter-jung-sua
  speakerName: "\uC815\uC218\uC544"
  speakerRole:
  dialogue: "\uBCF4\uB0B4\uC8FC\uC2E0 \uAC74 \uACF5\uAC1C \uC124\uBA85\uC5D0 \uB098\uC628
    \uC774\uB984\uB4E4\uC774\uC8E0? \uADF8 \uBC94\uC704\uC5D0\uC11C \uAE30\uC5C5
    \uAD00\uACC4\uB294 \uD655\uC778\uD560 \uC218 \uC788\uACA0\uC5B4\uC694. \uB2E4\uB9CC
    \uAC19\uC740 \uC815\uC0B0 \uC77C\uC744 \uB9E1\uC558\uB2E4\uB294 \uAC83\uACFC
    \uCCA0\uC218\uB97C \uACB0\uC815\uD588\uB2E4\uB294 \uAC74 \uB2E4\uB985\uB2C8\uB2E4."
  companyQuestion:
  companyPlayerLine:
  choices:
  - choiceText:
    choiceDescription:
    playerLine: "\uB0A9\uD488\uD55C \uB4A4\uC5D0 \uB3C8\uC744 \uBC1B\uB294 \uC870\uAC74\uC774
      \uD68C\uC0AC\uB97C \uC5BC\uB9C8\uB098 \uBC14\uAFE8\uB294\uC9C0 \uB354 \uBCF4\uACE0
