    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uC800\uB3C4 \uB450 \uD68C\uC0AC\uC758 \uD53C\uD574\uB97C \uD55C \uC0AC\uAC74\uC73C\uB85C
      \uB2E8\uC815\uD558\uB824\uB294 \uAC74 \uC544\uB2D9\uB2C8\uB2E4. \uB204\uAC00
      \uC870\uAC74\uC744 \uBC14\uAFE8\uB294\uC9C0\uBD80\uD130 \uC54C\uACE0 \uC2F6\uC2B5\uB2C8\uB2E4."
    player: 1
    narration: 0
    scene: 0
  - npcId: npc-investigative-reporter-jung-sua
    text: "\uD558\uB298\uC2DD\uD488\uC740 \uBC18\uD488\uC744 \uB118\uAE34 \uB0A0\uBD80\uD130
      \uB3C8\uC744 \uAE30\uB2E4\uB838\uC8E0. \uBBF8\uB798\uAC74\uC124\uC740 \uD604\uC7A5\uC744
      \uB118\uAE30\uB294 \uB0A0\uC9DC\uBD80\uD130 \uBC14\uB00C\uC5C8\uACE0\uC694.
      \uB450 \uD68C\uC0AC\uC5D0 \uCC98\uC74C \uC5F0\uB77D\uC774 \uAC04 \uB0A0\uC744
      \uB530\uB85C \uAE30\uB85D\uD574\uBCF4\uC138\uC694."
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uD68C\uC0AC\uBCC4\uB85C \uD1B5\uBCF4\uD55C \uACF3\uACFC \uC2E4\uC81C\uB85C
      \uBE44\uC6A9\uC744 \uB0B8 \uACF3\uC744 \uC368\uBCF4\uACA0\uC2B5\uB2C8\uB2E4.
      \uC815\uC0B0\uC744 \uB9E1\uC740 \uC774\uB984\uC740 \uADF8 \uB2E4\uC74C\uC5D0
      \uBD99\uC774\uC8E0."
    player: 1
    narration: 0
    scene: 0
  - npcId: npc-investigative-reporter-jung-sua
    text: "\uADF8\uB7FC \uB3C8\uC744 \uC815\uB9AC\uD55C \uD68C\uC0AC\uB9CC \uBCF4\uC9C0
      \uB9D0\uACE0, \uADF8 \uAC70\uB798\uAC00 \uC2E4\uC81C\uB85C \uB3CC\uC544\uAC04
      \uC790\uB9AC\uB97C \uBCF4\uC138\uC694. \uC77C\uC774 \uC911\uB2E8\uB410\uC744
      \uB54C \uB204\uAC00 \uBB34\uC5C7\uC744 \uD1B5\uBCF4\uBC1B\uC558\uB294\uC9C0\uC694."
    player: 0
    narration: 0
    scene: 0
