    narration: 0
  - npcId: npc-mirae-construction-ceo-kang-junhyeok
    text: "\uC788\uC5C8\uC18C. \uC6B0\uB9AC \uADDC\uBAA8\uB85C\uB294 \uC27D\uAC8C
      \uBABB \uB9E1\uB294 \uC77C\uC774\uC5C8\uACE0, \uB2E4\uC74C \uACF5\uC0AC\uAE4C\uC9C0
      \uC774\uC5B4\uC9C8 \uAC70\uB77C\uACE0 \uBD24\uC2B5\uB2C8\uB2E4. \uB0B4\uAC00
      \uC870\uAC74\uC744 \uB108\uBB34 \uC88B\uAC8C \uC77D\uC740 \uAC83\uB3C4 \uC788\uC2B5\uB2C8\uB2E4."
    player: 0
    narration: 0
  - npcId: npc-mirae-construction-cfo-seo-jia
    text: "\uADF8 \uC0AC\uC5C5 \uD558\uB098 \uB54C\uBB38\uC5D0 \uC9C0\uAE08\uC758
      \uBAA8\uB4E0 \uBB38\uC81C\uAC00 \uC0DD\uACBC\uB2E4\uB294 \uB9D0\uC500\uC740
      \uC544\uB2C8\uC5D0\uC694. \uC774\uD6C4\uC5D0 \uBC1B\uC740 \uACF5\uC0AC\uC640
      \uC9C0\uAE09 \uACC4\uD68D\uB3C4 \uC800\uD76C \uACB0\uC815\uC774\uC5C8\uC73C\uB2C8\uAE4C\uC694."
    player: 0
    narration: 0
  - npcId:
    text: "\uC0C1\uB300 \uD68C\uC0AC\uB294 \uC9C0\uAE08\uB3C4 \uC788\uC2B5\uB2C8\uAE4C?"
    player: 1
    narration: 0
  - npcId: npc-mirae-construction-cfo-seo-jia
    text: "\uB2F9\uC2DC \uACC4\uC57D \uC8FC\uCCB4\uC640 \uB098\uC911 \uC815\uC0B0
      \uCC3D\uAD6C\uAC00 \uB2EC\uB77C\uC694. \uACF5\uAC1C \uAE30\uB85D\uC73C\uB85C
      \uD655\uC778\uD560 \uC218 \uC788\uB294 \uC774\uB984\uC740 \uC815\uB9AC\uD574\uB4DC\uB9B4\uAC8C\uC694.
      \uD558\uC9C0\uB9CC \uADF8 \uC774\uB984\uB9CC \uBCF4\uACE0 \uB204\uAC00 \uC804\uCCB4\uB97C
      \uACB0\uC815\uD588\uB294\uC9C0\uAE4C\uC9C0\uB294 \uB9D0\uD558\uAE30 \uC5B4\uB824\uC6CC\uC694."
    player: 0
    narration: 0
  - npcId: npc-mirae-construction-ceo-kang-junhyeok
    text: "\uB0B4\uAC00 \uB3C4\uC7A5 \uCC0D\uC740 \uACC4\uC57D\uC740 \uAE30\uC5B5\uD569\uB2C8\uB2E4.
      \uADF8 \uB4A4\uC5D0\uC11C \uB204\uAC00 \uC5B4\uB5A4 \uACC4\uC0B0\uC744 \uD588\uB294\uC9C0\uB294
      \uB2E4 \uBAA8\uB985\uB2C8\uB2E4."
    player: 0
    narration: 0
  - npcId:
    text: "\uC124\uBA85\uC744 \uB4E3\uB294 \uB3D9\uC548 \uC775\uC219\uD55C \uC7A5\uBA74\uC774
      \uB5A0\uC62C\uB790\uB2E4. \uB2E4\uC74C \uAC70\uB798\uB97C \uBBFF\uACE0 \uBA3C\uC800
      \uC368\uBC84\uB9B0 \uB3C8. \uAC00\uC871 \uD68C\uC0AC\uB3C4 \uADF8\uB7F0 \uB9D0\uC744
      \uC790\uC8FC \uD588\uB2E4. \uB2EE\uC558\uB2E4\uB294 \uC774\uC720\uB9CC\uC73C\uB85C
      \uAC19\uC740 \uC0C1\uB300\uB97C \uB5A0\uC62C\uB9AC\uAE30\uC5D0\uB294 \uC544\uC9C1
      \uC544\uB294 \uAC8C \uC5C6\uC5C8\uB2E4."
    player: 0
    narration: 1
  - npcId:
    text: "\uD604\uC7AC \uBB38\uC81C\uB294 \uD604\uC7AC \uBB38\uC81C\uB300\uB85C
      \uBCF4\uACA0\uC2B5\uB2C8\uB2E4. \uACFC\uAC70 \uAC70\uB798 \uCABD\uB3C4 \uC81C\uAC00
      \uD655\uC778\uD560 \uC218 \uC788\uB294 \uB370\uAE4C\uC9C0\uB294 \uC54C\uC544\uBCF4\uC8E0.
      \uC624\uB298 \uC9C0\uC6D0\uC744 \uC57D\uC18D\uD558\uB294 \uAC74 \uC544\uB2D9\uB2C8\uB2E4."
    player: 1
    narration: 0
  - npcId: npc-mirae-construction-cfo-seo-jia
    text: "\uB124. \uD655\uC778\uD55C \uC0AC\uC2E4\uC774 \uC788\uC73C\uBA74 \uACF5\uAC1C\uD560
      \uC218 \uC788\uB294 \uBC94\uC704\uC5D0\uC11C\uB9CC \uC54C\uB824\uC8FC\uC138\uC694.
      \uC800\uD76C\uB3C4 \uC798\uBABB \uAE30\uC5B5\uD55C \uBD80\uBD84\uC774 \uC788\uC744
      \uC218 \uC788\uC73C\uB2C8\uAE4C\uC694."
    player: 0
    narration: 0
  companyVariants: []
