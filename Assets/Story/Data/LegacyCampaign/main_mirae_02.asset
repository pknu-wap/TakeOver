  - npcId: npc-mirae-construction-cfo-seo-jia
    text: "\uC624\uB298\uC740 \uC8FC\uC8FC\uC5D0\uAC8C \uACF5\uC720\uD560 \uC218
      \uC788\uB294 \uC694\uC57D\uC744 \uBCFC\uAC8C\uC694. \uD611\uB825 \uC5EC\uBD80\uC640
      \uBCC4\uAC1C\uB85C \uD604\uC7AC \uACC4\uD68D\uC744 \uC124\uBA85\uB4DC\uB9AC\uB294
      \uC790\uB9AC\uC608\uC694."
    player: 0
    narration: 0
  - npcId:
    text: "\uD68C\uC758\uC2E4 \uD0C1\uC790\uC5D0\uB294 \uC11C\uB85C \uB2E4\uB978
      \uD45C \uC138 \uC7A5\uC774 \uB193\uC5EC \uC788\uC5C8\uB2E4. \uB0A0\uC9DC\uBCC4
      \uC790\uAE08\uD45C, \uD604\uC7A5\uBCC4 \uC77C\uC815\uD45C, \uC0C8 \uACF5\uC0AC\uC758
      \uAC80\uD1A0\uD45C\uC600\uB2E4. \uC5B4\uB290 \uD45C\uB3C4 \uB0A8\uC740 \uB450
      \uC7A5\uC758 \uB2F5\uC744 \uAC16\uACE0 \uC788\uC9C0 \uC54A\uC558\uB2E4."
    player: 0
    narration: 1
  - npcId: npc-mirae-construction-ceo-kang-junhyeok
    text: "\uC2DC\uAC04 \uB0B4\uC8FC\uC154\uC11C \uAC10\uC0AC\uD569\uB2C8\uB2E4.
      \uBA3C\uC800 \uB9D0\uC500\uB4DC\uB9AC\uC8E0. \uC9C0\uAE08 \uACF5\uC0AC\uB97C
      \uBC84\uB9AC\uACE0 \uC0C8 \uD68C\uC0AC\uCC98\uB7FC \uC2DC\uC791\uD560 \uC0DD\uAC01\uC740
      \uC5C6\uC2B5\uB2C8\uB2E4. \uB05D\uB0B4\uC57C \uD560 \uD604\uC7A5\uC774 \uC788\uC2B5\uB2C8\uB2E4."
    player: 0
    narration: 0
  - npcId: npc-mirae-construction-cfo-seo-jia
    text: "\uADF8 \uD604\uC7A5\uC744 \uB05D\uB0BC \uB3C8\uC744 \uB9DE\uCD94\uB294
      \uC911\uC774\uC5D0\uC694. \uBB38\uC81C\uB294 \uC0C8 \uACF5\uC0AC\uAE4C\uC9C0
      \uAC19\uC774 \uC2DC\uC791\uD558\uBA74 \uB4E4\uC5B4\uC624\uB294 \uB3C8\uBCF4\uB2E4
      \uBA3C\uC800 \uB098\uAC00\uB294 \uB3C8\uC774 \uB2E4\uC2DC \uB298\uC5B4\uB09C\uB2E4\uB294
      \uAC70\uACE0\uC694."
    player: 0
    narration: 0
  - npcId: npc-mirae-construction-field-director-park-dosik
    text: "\uD604\uC7A5\uB3C4 \uC0AC\uB78C\uC744 \uB098\uB220 \uC368\uC57C \uD569\uB2C8\uB2E4.
      \uD45C\uC5D0 \uC774\uB984 \uB450 \uBC88 \uC801\uB294\uB2E4\uACE0 \uB450 \uC0AC\uB78C\uC774
      \uB418\uC9C0\uB294 \uC54A\uC544\uC694."
    player: 0
    narration: 0
  - npcId: npc-mirae-construction-ceo-kang-junhyeok
    text: "\uC0C8 \uACF5\uC0AC\uB97C \uB193\uCE58\uBA74 \uB2E4\uC74C \uC77C\uAC10\uC740
      \uB204\uAC00 \uB9CC\uB4ED\uB2C8\uAE4C. \uC9C0\uAE08 \uD604\uC7A5 \uB05D\uB09C
      \uB2E4\uC74C\uC5D0 \uC0AC\uB78C\uB4E4\uC744 \uC26C\uAC8C \uD560 \uC218\uB3C4
      \uC5C6\uC796\uC18C."
    player: 0
    narration: 0
  - npcId: npc-mirae-construction-cfo-seo-jia
    text: "\uADF8\uB798\uC11C \uADF8\uB2E4\uC74C \uACF5\uC0AC\uAC00 \uD544\uC694\uD55C
      \uAC74 \uC54C\uC544\uC694. \uB2E4\uB9CC \uACC4\uC57D\uC744 \uAC00\uC838\uC624\uBA74
