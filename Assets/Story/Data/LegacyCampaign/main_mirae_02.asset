  - choiceText: "\uC8FC\uC8FC \uC124\uBA85\uC758 \uBC94\uC704\uB97C \uBD84\uBA85\uD788
      \uD558\uACE0 \uD68C\uC0AC \uD310\uB2E8\uC744 \uC9C0\uCF1C\uBCF8\uB2E4"
    choiceDescription: "\uC774\uBC88 \uB2F5\uBCC0\uC744 \uAD00\uACC4\uC640 \uAE30\uC5B5\uC5D0
      \uBC18\uC601\uD569\uB2C8\uB2E4. \uD604\uAE08\xB7\uC9C0\uBD84 \uBCC0\uD654 \uC5C6\uC74C."
    playerLine: "\uC624\uB298 \uC81C\uAC00 \uC6B4\uC601 \uC21C\uC11C\uB97C \uC815\uD560
      \uC218\uB294 \uC5C6\uC2B5\uB2C8\uB2E4. \uD68C\uC0AC\uAC00 \uC120\uD0DD\uD55C
      \uC6B0\uC120\uC21C\uC704\uC640 \uD68C\uC218 \uC77C\uC815\uC774 \uB2EC\uB77C\uC9C8
      \uB54C \uC5B4\uB5A4 \uAE30\uC900\uC73C\uB85C \uB2E4\uC2DC \uC124\uBA85\uD560\uC9C0
      \uC54C\uB824\uC8FC\uC2ED\uC2DC\uC624."
    resultDialogue: "\uADF8\uAC74 \uD68C\uC0AC\uAC00 \uB2F5\uD574\uC57C \uD560 \uC77C\uC774\uC624.
      \uC88B\uC2B5\uB2C8\uB2E4. \uACB0\uC815\uD55C \uB0B4\uC6A9\uD558\uACE0 \uC544\uC9C1
      \uACB0\uC815\uD558\uC9C0 \uBABB\uD55C \uB0B4\uC6A9\uC744 \uB098\uB220\uC11C
      \uC124\uBA85\uD558\uC8E0.\n\n\uACF5\uAC1C\uD560 \uC218 \uC788\uB294 \uBC94\uC704\uC5D0\uC11C\uC694.
      \uD604\uC7A5\uBCC4 \uAC70\uB798\uCC98 \uC870\uAC74\uAE4C\uC9C0 \uBAA8\uB450
