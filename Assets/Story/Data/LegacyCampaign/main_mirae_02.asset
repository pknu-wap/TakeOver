  - choiceText: "\uC0C8 \uC218\uC8FC\uC758 \uB300\uAE08\xB7\uCC29\uC218 \uC870\uAC74\uC744
      \uB2E4\uC2DC \uBB3B\uB294\uB2E4"
    choiceDescription: "\uC774\uBC88 \uB2F5\uBCC0\uC744 \uAD00\uACC4\uC640 \uAE30\uC5B5\uC5D0
      \uBC18\uC601\uD569\uB2C8\uB2E4. \uD604\uAE08\xB7\uC9C0\uBD84 \uBCC0\uD654 \uC5C6\uC74C."
    playerLine: "\uC0C8 \uACF5\uC0AC\uB97C \uBC1B\uB418 \uC9C0\uAE09 \uC870\uAC74\uC744
      \uBC14\uAFC0 \uC218 \uC788\uB294\uC9C0\uBD80\uD130 \uD655\uC778\uD558\uBA74
      \uC5B4\uB5BB\uC2B5\uB2C8\uAE4C? \uCC29\uC218 \uC804\uC5D0 \uD68C\uC0AC\uAC00
      \uAC10\uB2F9\uD574\uC57C \uD558\uB294 \uAE30\uAC04\uC744 \uC904\uC77C \uC218
      \uC788\uB294\uC9C0\uC694."
    resultDialogue: "\uBC1C\uC8FC\uCC98\uAC00 \uBC1B\uC544\uC8FC\uBA74 \uAC00\uC7A5
      \uC88B\uC8E0. \uD558\uC9C0\uB9CC \uC6B0\uB9AC\uBCF4\uB2E4 \uAE09\uD55C \uCABD\uC740
      \uB300\uAC1C \uC6B0\uB9AC\uC785\uB2C8\uB2E4. \uC870\uAC74\uC744 \uB354 \uC694\uAD6C\uD558\uBA74
      \uB2E4\uB978 \uC5C5\uCCB4\uB85C \uAC08 \uC218\uB3C4 \uC788\uC18C.\n\n\uB193\uCE60
      \uC218 \uC788\uB2E4\uB294 \uC804\uC81C\uAE4C\uC9C0 \uC801\uC5B4\uC57C\uACA0\uB124\uC694.
      \uADF8\uB798\uB3C4 \uC870\uAC74\uC774 \uACE0\uC815\uC774\uB77C\uACE0 \uBCF4\uACE0
      \uBC84\uD2F0\uB294 \uBC29\uBC95\uB9CC \uCC3E\uB294 \uAC83\uBCF4\uB2E4\uB294
      \uD655\uC778\uD560 \uAC00\uCE58\uAC00 \uC788\uC5B4\uC694.\n\n\uACC4\uC57D \uC870\uAC74\uC774
      \uB2EC\uB77C\uC838\uB3C4 \uC2E4\uC81C \uD22C\uC785\uC77C\uC740 \uB530\uB85C
      \uD655\uC778\uD574\uC8FC\uC2ED\uC2DC\uC624. \uB3C8 \uBA3C\uC800 \uBC1B\uC558\uB2E4\uACE0
      \uC0AC\uB78C\uAE4C\uC9C0 \uBA3C\uC800 \uC0DD\uAE30\uC9C4 \uC54A\uC2B5\uB2C8\uB2E4."
