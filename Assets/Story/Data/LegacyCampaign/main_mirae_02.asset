  eventId: main_mirae_02
  category: 1
  tutorialOnly: 0
  title: "6\uC77C\uCC28 \u2014 \uB0A8\uACA8\uC9C4 \uC9C0\uAE09 \uC77C\uC815 (\uBBF8\uB798\uAC74\uC124\uC5D0\uC11C
    \uCCAB \uC2E4\uB9C8\uB9AC)"
  image: {fileID: 21300000, guid: e4f06f328acf53c4385995fb1f2c1e65, type: 3}
  cardImage: {fileID: 21300000, guid: d04aa39026668454991718ef00702904, type: 3}
  npcArts: []
  highlightImage: {fileID: 0}
  negotiationBackground: {fileID: 0}
  description: "6\uC77C\uCC28 \u2014 \uB0A8\uACA8\uC9C4 \uC9C0\uAE09 \uC77C\uC815
    (\uBBF8\uB798\uAC74\uC124\uC5D0\uC11C \uCCAB \uC2E4\uB9C8\uB9AC)\uC5D0 \uAD00\uD55C
    \uBA74\uB2F4 \uC694\uCCAD\uC785\uB2C8\uB2E4. \uB0B4\uC6A9\uACFC \uBE44\uC6A9\uC744
    \uD655\uC778\uD55C \uB4A4 \uB9CC\uB098\uC2ED\uC2DC\uC624."
  apCost: 0
  startButtonText: "\uB9CC\uB098\uAE30"
  companyIds:
  - mirae-construction
  speakerNpcId: npc-mirae-construction-cfo-seo-jia
  speakerName: "\uC11C\uC9C0\uC544"
  speakerRole:
  dialogue: "\uC624\uB298\uC740 \uC8FC\uC8FC\uC5D0\uAC8C \uACF5\uC720\uD560 \uC218
    \uC788\uB294 \uC694\uC57D\uC744 \uBCFC\uAC8C\uC694. \uD611\uB825 \uC5EC\uBD80\uC640
    \uBCC4\uAC1C\uB85C \uD604\uC7AC \uACC4\uD68D\uC744 \uC124\uBA85\uB4DC\uB9AC\uB294
    \uC790\uB9AC\uC608\uC694."
  companyQuestion:
  companyPlayerLine:
  choices:
  - choiceText: "\uAE30\uC874 \uD604\uC7A5\uC744 \uB05D\uB0B4\uB294 \uB370 \uD544\uC694\uD55C
      \uCD5C\uC18C \uC870\uAC74\uC744 \uBA3C\uC800 \uBB3B\uB294\uB2E4"
    choiceDescription: "\uC774\uBC88 \uB2F5\uBCC0\uC744 \uAD00\uACC4\uC640 \uAE30\uC5B5\uC5D0
      \uBC18\uC601\uD569\uB2C8\uB2E4. \uD604\uAE08\xB7\uC9C0\uBD84 \uBCC0\uD654 \uC5C6\uC74C."
    playerLine: "\uC9C0\uAE08 \uB05D\uB0BC \uD604\uC7A5\uBD80\uD130 \uBCF4\uACA0\uC2B5\uB2C8\uB2E4.
      \uC77C\uC815\uC774 \uD55C \uBC88 \uB2A6\uC5B4\uC838\uB3C4 \uC548\uC804\uACFC
      \uC9C0\uAE09\uC744 \uC720\uC9C0\uD558\uB824\uBA74 \uBB34\uC5C7\uC774 \uD544\uC694\uD55C\uC9C0\uC694.
      \uC0C8 \uACF5\uC0AC\uB294 \uADF8 \uC870\uAC74\uC744 \uBE7C\uC557\uC9C0 \uC54A\uB294
      \uC120\uC5D0\uC11C \uAC80\uD1A0\uD558\uBA74 \uC5B4\uB5BB\uC2B5\uB2C8\uAE4C?"
    resultDialogue: "\uD604\uC7A5\uBCC4\uB85C \uB0A8\uC740 \uC791\uC5C5\uC740 \uC815\uB9AC\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uAF2D \uAC19\uC740 \uC0AC\uB78C\uC774 \uC774\uC5B4\uC11C
      \uD574\uC57C \uD558\uB294 \uACF5\uC815\uB3C4 \uD45C\uC2DC\uD558\uC8E0.\n\n\uADF8\uB7EC\uBA74
      \uC9C0\uAE09 \uC77C\uC815\uACFC \uAC19\uC774 \uBCFC \uC218 \uC788\uC5B4\uC694.
      \uB300\uC2E0 \uC0C8 \uC218\uC8FC\uB97C \uC904\uC774\uBA74 \uB098\uC911 \uD604\uAE08\uC774
      \uBE44\uB294 \uC2DC\uC810\uB3C4 \uB098\uC62C \uAC70\uC608\uC694. \uADF8 \uBD80\uBD84\uAE4C\uC9C0
      \uAC19\uC774 \uBCF4\uC154\uC57C \uD574\uC694.\n\n\uAE30\uC874 \uD604\uC7A5\uB9CC
      \uB05D\uB0B4\uACE0 \uADF8\uB2E4\uC74C\uC774 \uC5C6\uB294 \uACC4\uD68D\uC740
      \uC548 \uB429\uB2C8\uB2E4. \uADF8\uB798\uB3C4 \uC9C0\uAE08 \uBC84\uD2F8 \uC120\uC744
      \uBA3C\uC800 \uAE0B\uC790\uB294 \uAC74 \uC774\uD574\uD588\uC18C. \uC5B4\uB290
      \uACF5\uC0AC\uB97C \uBBF8\uB8F0\uC9C0\uAE4C\uC9C0 \uC81C\uAC00 \uBCF4\uACA0\uC2B5\uB2C8\uB2E4."
    resultValue: answer_0
    npcResult:
      eventId:
      companyId:
      actorId:
      actionId:
      targetNpcIds:
      - npc-mirae-construction-cfo-seo-jia
      targetReactions: []
      memoryType: 8
      strength: 1
