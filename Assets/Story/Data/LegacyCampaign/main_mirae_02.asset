      permanent: 0
      durationTurns: 3
      reliability: 1
      interpretation: "\uAE30\uC874 \uD604\uC7A5 \uC644\uACF5 \uC870\uAC74\uC744
        \uC6B0\uC120 \uAC80\uD1A0\uD558\uC790\uACE0 \uC81C\uC548\uD588\uB2E4. \uC2E0\uADDC
