  - choiceText: "\uD611\uB825\uC740 \uBCF4\uB958\uD55C\uB2E4"
    choiceDescription:
    playerLine: "\uC6B4\uC601 \uC124\uBA85\uC740 \uB4E3\uACE0 \uC2F6\uC2B5\uB2C8\uB2E4.
      \uB2E4\uB9CC \uD611\uB825 \uC5EC\uBD80\uB294 \uC790\uB8CC\uB97C \uBCF4\uACE0
      \uB098\uC11C \uB9D0\uC500\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4."
    resultDialogue: "\uC131\uAE09\uD558\uAC8C \uC57D\uC18D\uD558\uB294 \uAC83\uBCF4\uB2E4\uB294
      \uB0AB\uACA0\uC9C0. \uC6B0\uB9AC\uB3C4 \uC2E4\uC81C\uB85C \uC6C0\uC9C1\uC77C
      \uC218 \uC788\uB294 \uC0C1\uB300\uC778\uC9C0 \uBCF4\uACE0 \uC2F6\uC73C\uB2C8\uAE4C."
