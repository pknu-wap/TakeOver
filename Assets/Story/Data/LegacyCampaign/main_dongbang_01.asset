  - choiceText: "\uB2F9\uC2DC \uACB0\uC815\uD55C \uC0AC\uB78C\uC744 \uD655\uC778\uD55C\uB2E4"
    choiceDescription:
    playerLine: "\uCC98\uC74C \uADF8 \uBB3C\uB7C9\uC744 \uC7A1\uC558\uC744 \uB54C
      \uB204\uAC00 \uBB34\uC5C7\uC744 \uC57D\uC18D\uD588\uACE0, \uD68C\uC0AC\uC5D0\uC11C\uB294
