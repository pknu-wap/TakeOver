  eventId: main_dongbang_01
  category: 1
  linearDialogue: 0
  tutorialOnly: 0
  title: "\uB3D9\uBC29\uBB3C\uC0B0 \u2014 \uBE44\uC5B4 \uC788\uB294 \uCC3D\uACE0\uC758
    \uAC00\uB3D9\uBE44"
  image: {fileID: 21300000, guid: e4f06f328acf53c4385995fb1f2c1e65, type: 3}
  cardImage: {fileID: 21300000, guid: d04aa39026668454991718ef00702904, type: 3}
  npcArts: []
  highlightImage: {fileID: 0}
  negotiationBackground: {fileID: 0}
  description: "\uAC15\uC7AC\uD604\uACFC \uBC15\uBBFC\uC6B0\uAC00 \uC2DC\uC5F0\uC744
    \uB9C8\uCE58\uACE0 \uCC3D\uACE0 \uC6B4\uC601\uC548\uC744 \uC124\uBA85\uD55C\uB2E4.
    \uBB3C\uB7C9\uC774 \uC624\uAE30 \uC804\uC5D0 \uB4E4\uC5EC\uB193\uC740 \uC124\uBE44\uC640
    \uC62E\uACA8 \uB193\uC740 \uC778\uB825\uC5D0 \uC9C0\uAE08\uB3C4 \uC5BC\uB9C8\uB098
    \uB3C8\uC774 \uB4DC\uB294\uC9C0 \uBD10\uC57C \uD55C\uB2E4."
  apCost: 0
  startButtonText: "\uB9CC\uB098\uAE30"
  companyIds:
  - dongbang-trading
  speakerNpcId: npc-dongbang-trading-ceo-kang-jaehyeon
  speakerName: "\uAC15\uC7AC\uD604"
  speakerRole:
  dialogue: "\uC624\uC168\uC2B5\uB2C8\uAE4C. \uC124\uBA85\uC740 \uBCF4\uBA74\uC11C
    \uD558\uC8E0. \uC5EC\uAE30 \uC549\uC544\uC11C \uC5F4 \uC7A5 \uC77D\uB294 \uAC83\uBCF4\uB2E4
    \uD55C \uBC88 \uBCF4\uB294 \uAC8C \uBE60\uB985\uB2C8\uB2E4."
  companyQuestion:
  companyPlayerLine:
  choices:
  - choiceText: "\uD604\uC7AC \uC0AC\uC5C5\uACFC \uACFC\uAC70 \uC190\uC2E4\uC744
      \uD568\uAED8 \uBCF8\uB2E4"
    choiceDescription:
    playerLine: "\uC9C0\uAE08 \uB3CC\uC544\uAC00\uB294 \uC0AC\uC5C5\uBD80\uD130 \uBCF4\uACA0\uC2B5\uB2C8\uB2E4.
      \uC608\uC804\uC5D0 \uC783\uC740 \uBB3C\uB7C9\uC774 \uC624\uB298\uC758 \uCC3D\uACE0
      \uC6B4\uC601\uC5D0 \uC5BC\uB9C8\uB098 \uB0A8\uC544 \uC788\uB294\uC9C0\uB3C4\uC694."
    resultDialogue: "\uACFC\uAC70 \uC190\uC2E4\uC744 \uB5BC\uC5B4\uB193\uACE0 \uC0C8
      \uC0AC\uC5C5\uB9CC \uBCF4\uC790\uB294 \uB9D0\uC500\uC740 \uC544\uB2C8\uAD70.
      \uC88B\uC18C. \uC9C0\uAE08 \uB4E4\uC5B4\uC624\uB294 \uBB3C\uB7C9\uACFC \uAE30\uB300\uB9CC
      \uD558\uB294 \uBB3C\uB7C9\uC744 \uB098\uB220 \uBCF4\uC5EC\uB4DC\uB9AC\uACA0\uC18C."
    resultValue: answer_0
