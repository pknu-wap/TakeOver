  m_Name: main_hansung_contact
  m_EditorClassIdentifier: Assembly-CSharp::TakeOver.Events.EventDefinition
  eventId: main_hansung_contact
  category: 1
  linearDialogue: 1
  tutorialOnly: 0
  title: "\uD55C\uC131\uACF5\uC5C5 \u2014 \uD3EC\uC7A5 \uC804\uD658\uC5D0 \uD544\uC694\uD55C
    \uC124\uBE44"
  image: {fileID: 21300000, guid: e4f06f328acf53c4385995fb1f2c1e65, type: 3}
  cardImage: {fileID: 21300000, guid: d04aa39026668454991718ef00702904, type: 3}
  npcArts: []
  highlightImage: {fileID: 0}
  negotiationBackground: {fileID: 0}
  description: "\uD558\uB298\uC2DD\uD488\uC774 \uC81C\uD488\uC744 \uBC14\uAFD4 \uB9CC\uB4E4\uB824\uBA74
    \uD3EC\uC7A5 \uACF5\uC815\uBD80\uD130 \uC190\uBD10\uC57C \uD55C\uB2E4. \uD55C\uC131\uACF5\uC5C5\uC5D0
    \uACAC\uC801\uC744 \uBB3B\uAE30 \uC804\uC5D0, \uAE30\uC874 \uC124\uBE44\uB85C
    \uC5BC\uB9C8\uB098 \uC790\uC8FC \uC0DD\uC0B0\uC744 \uBC14\uAFC0 \uC218 \uC788\uB294\uC9C0
    \uC54C\uC544\uBCF4\uC790."
  apCost: 0
  startButtonText: "\uB9CC\uB098\uAE30"
  companyIds:
  - hansung-industry
  speakerNpcId: npc-hansung-industry-labor-director-choi-mijeong
  speakerName: "\uCD5C\uBBF8\uC815"
  speakerRole:
  dialogue: "\uAC00\uB2A5\uC131\uC740 \uC788\uC8E0. \uB2E4\uB9CC \uC774\uB984\uC774
    \uC5F0\uACB0\uB410\uB2E4\uB294 \uC774\uC720\uB9CC\uC73C\uB85C \uD22C\uC790\uD560
    \uC218\uB294 \uC5C6\uC2B5\uB2C8\uB2E4. \uC9C0\uAE08\uB3C4 \uB9CC\uB4E4 \uC218
    \uC788\uB294 \uAC83, \uADF8\uAC78 \uB2E4\uC74C \uC0AC\uB78C\uB3C4 \uB9CC\uB4E4
    \uC218 \uC788\uB294\uC9C0 \uBCF4\uC138\uC694."
  companyQuestion:
  companyPlayerLine:
  choices:
  - choiceText:
    choiceDescription: "23\uC77C\uCC28 \uD22C\uC790 \uAC80\uD1A0 \uC5F0\uB77D\uC785\uB2C8\uB2E4.
      \uD55C\uC131\uACF5\uC5C5 \uC9C0\uBD84 10%\uB97C 28\uC77C\uCC28 \uC2DC\uC791
      \uC804\uAE4C\uC9C0 \uD655\uBCF4\uD558\uC2ED\uC2DC\uC624."
    playerLine: "\uB9CC\uB4E4 \uC218 \uC788\uB2E4\uB294 \uB9D0\uACFC \uACC4\uC18D
      \uB9CC\uB4E4 \uC218 \uC788\uB2E4\uB294 \uB9D0\uC740 \uB2E4\uB974\uACA0\uAD70\uC694.
      \uD604\uC7A5\uC5D0\uC11C\uB294 \uBB34\uC5C7\uC774 \uD544\uC694\uD55C\uC9C0
      \uC9C1\uC811 \uB4E3\uACA0\uC2B5\uB2C8\uB2E4."
    resultDialogue: "\uC624\uC2DC\uBA74 \uB3C4\uBA74\uB9CC \uBCF4\uC5EC\uB4DC\uB9AC\uC9C0\uB294
      \uC54A\uC744\uAC8C\uC694. \uB204\uAC00 \uADF8 \uC77C\uC744 \uC54C\uACE0 \uC788\uACE0,
      \uB204\uAC00 \uB2E4\uC74C\uC5D0 \uB9E1\uC744\uC9C0\uB3C4 \uAC19\uC774 \uBD10\uC8FC\uC138\uC694."
    resultValue: answer_0
