  description: "15\uC77C\uCC28 \uD22C\uC790 \uAC80\uD1A0 \uC5F0\uB77D\uC785\uB2C8\uB2E4.
    \uB3D9\uBC29\uBB3C\uC0B0 \uC9C0\uBD84 10%\uB97C 20\uC77C\uCC28 \uC2DC\uC791 \uC804\uAE4C\uC9C0
    \uD655\uBCF4\uD558\uC2ED\uC2DC\uC624."
  apCost: 0
  startButtonText: "\uB9CC\uB098\uAE30"
  companyIds:
  - dongbang-trading
  speakerNpcId: npc-dongbang-trading-hr-director-park-minu
  speakerName: "\uBC15\uBBFC\uC6B0"
  speakerRole:
  dialogue: "\uADF8 \uB4A4\uC5D0\uB3C4 \uC6B4\uC601\uC744 \uC774\uC5B4\uC654\uB124\uC694.
    \uD604\uC7AC\uB294 \uACE0\uAC1D\uB3C4 \uB098\uB220 \uBC1B\uB294 \uCABD\uC774\uACE0\uC694.
    \uACFC\uAC70 \uAC70\uB798 \uD558\uB098\uB9CC \uBCF4\uC9C0 \uB9D0\uACE0 \uC9C0\uAE08
    \uB3C8 \uBC84\uB294 \uBC29\uC2DD\uB3C4 \uBCF4\uC138\uC694."
  companyQuestion:
  companyPlayerLine:
  choices:
  - choiceText: "\uD655\uC778"
    choiceDescription: "15\uC77C\uCC28 \uD22C\uC790 \uAC80\uD1A0 \uC5F0\uB77D\uC785\uB2C8\uB2E4.
      \uB3D9\uBC29\uBB3C\uC0B0 \uC9C0\uBD84 10%\uB97C 20\uC77C\uCC28 \uC2DC\uC791
      \uC804\uAE4C\uC9C0 \uD655\uBCF4\uD558\uC2ED\uC2DC\uC624."
    playerLine: "\uD655\uC778\uD588\uC2B5\uB2C8\uB2E4. \uACC4\uC18D \uC0B4\uD3B4\uBCF4\uACA0\uC2B5\uB2C8\uB2E4."
    resultDialogue: "\uB124. \uC624\uB298 \uD655\uC778\uD55C \uBC94\uC704\uC5D0\uC11C
      \uAE30\uB85D\uD558\uACA0\uC2B5\uB2C8\uB2E4."
