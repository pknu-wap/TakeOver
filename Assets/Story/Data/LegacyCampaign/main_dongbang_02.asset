    narration: 0
    scene: 0
  - npcId: npc-economic-reporter-lee-mingyu
    text: "\uB124. \uC774\uBC88\uC5D0\uB294 \uC81C\uBAA9\uC744 \uBA3C\uC800 \uC368\uB458
      \uC218 \uC5C6\uACA0\uB124\uC694. \uBD80\uD488 \uB9CC\uB4E0 \uD68C\uC0AC\uB3C4
