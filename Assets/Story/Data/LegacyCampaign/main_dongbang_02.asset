  startButtonText: "\uB9CC\uB098\uAE30"
  companyIds:
  - dongbang-trading
  speakerNpcId: npc-economic-reporter-lee-mingyu
  speakerName: "\uC774\uBBFC\uADDC"
  speakerRole:
  dialogue: "\uC124\uBE44 \uB4E4\uC5B4\uC628 \uB4A4 \uBB38\uC81C\uAC00 \uC0DD\uACBC\uB2E4\uB294
    \uC124\uBA85\uD558\uACE0, \uC124\uBE44 \uAC80\uC218\uBD80\uD130 \uC911\uB2E8\uB410\uB2E4\uB294
    \uC124\uBA85\uC740 \uC21C\uC11C\uAC00 \uB2E4\uB974\uB124\uC694. \uB2F9\uC2DC
    \uACF5\uAC1C\uB41C \uC0AC\uC5C5 \uBCC0\uACBD \uC2DC\uC810\uBD80\uD130 \uB9DE\uCDB0\uBCF4\uACA0\uC2B5\uB2C8\uB2E4."
