  highlightImage: {fileID: 0}
  negotiationBackground: {fileID: 0}
  description: "\uBB3C\uB7C9\uC774 \uC904\uC5B4\uC11C \uAC80\uC218\uB97C \uBBF8\uB8EC
    \uAC74\uC9C0, \uAC80\uC218\uB97C \uBBF8\uB904 \uBB3C\uB7C9\uC744 \uBABB \uBC1B\uC740
    \uAC74\uC9C0\uC5D0 \uB530\uB77C \uC774\uC57C\uAE30\uAC00 \uB2EC\uB77C\uC9C4\uB2E4.
    \uC815\uC218\uC544\uC640 \uB3D9\uBC29\uC774 \uBC1B\uC740 \uD1B5\uBCF4\uBD80\uD130
    \uB2E4\uC2DC \uC77D\uC5B4\uBCF4\uC790."
