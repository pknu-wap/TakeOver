    player: 0
    narration: 0
  - npcId:
    text: "\uC608\uC804\uCC98\uB7FC \uC0C1\uB300\uAC00 \uC57D\uC18D\uC744 \uBC14\uAFB8\uBA74\uC694?"
    player: 1
    narration: 0
  - npcId: npc-dongbang-trading-ceo-kang-jaehyeon
    text: "\uC5B4\uB290 \uBB3C\uB7C9\uC774 \uBE60\uC9C0\uBA74 \uC5B4\uB290 \uACB0\uC815\uC744
