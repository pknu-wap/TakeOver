  - npcId: npc-dongbang-trading-hr-director-park-minu
    text: "\uC774\uBC88 \uBE48\uCE78\uC740 \uAD6C\uBA4D\uC774 \uC544\uB2C8\uB77C
      \uC790\uB9AC\uC608\uC694. \uC77C \uB4E4\uC5B4\uC624\uBA74 \uCC44\uC6B8 \uC790\uB9AC.
      \uC544\uC9C1 \uC548 \uB4E4\uC5B4\uC628 \uC77C\uB85C \uC0AC\uB78C\uBD80\uD130
      \uC62E\uAE30\uC9C4 \uC54A\uACE0\uC694."
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uC608\uC804\uCC98\uB7FC \uC0C1\uB300\uAC00 \uC57D\uC18D\uC744 \uBC14\uAFB8\uBA74\uC694?"
    player: 1
    narration: 0
    scene: 0
  - npcId: npc-dongbang-trading-hr-director-park-minu
    text: "\uD55C \uACE0\uAC1D \uBB3C\uB7C9\uC774 \uB2A6\uC73C\uBA74 \uC57C\uAC04\uC870\uBD80\uD130
      \uB298\uB9AC\uC9C0 \uC54A\uC73C\uB824\uACE0\uC694. \uC9C0\uB09C\uBC88\uC5D4
      \uAC70\uC810 \uAC1C\uC2DC\uB97C \uC55E\uB2F9\uAE34\uB2E4\uB294 \uC5F0\uB77D
      \uD55C \uD1B5\uC5D0 \uCD9C\uADFC\uC9C0\uBD80\uD130 \uBC14\uAFE8\uC796\uC544\uC694."
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uCCAB \uCC28\uAC00 \uB4E4\uC5B4\uC624\uB294 \uB0A0\uC744 \uB204\uAC00
      \uD655\uC778\uD569\uB2C8\uAE4C? \uADF8 \uC804\uC5D0 \uC784\uCC28 \uAD6C\uC5ED\uC744
      \uB354 \uB298\uB9AC\uB294 \uACB0\uC7AC\uAC00 \uC62C\uB77C\uC624\uBA74 \uBA48\uCD9C
      \uC218 \uC788\uC2B5\uB2C8\uAE4C?"
    player: 1
    narration: 0
    scene: 0
  - npcId: npc-dongbang-trading-ceo-kang-jaehyeon
    text: "\uC785\uACE0 \uAE30\uB85D\uC774 \uC5C6\uC73C\uBA74 \uB0B4\uAC00 \uACB0\uC7AC\uB97C
      \uC548 \uD558\uACA0\uC18C. \uAE30\uC874 \uACE0\uAC1D \uCC28\uB97C \uBA3C\uC800
      \uBC1B\uB294 \uB3D9\uC548, \uC0C8 \uAD6C\uC5ED \uC784\uCC28\uB294 \uC11C\uB958\uB97C
      \uC950\uACE0 \uC788\uC5B4\uB3C4 \uC5F4\uC9C0 \uC54A\uACA0\uC2B5\uB2C8\uB2E4."
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uBCBD\uC5D0 \uBD99\uC740 \uADFC\uBB34\uD45C\uC5D0 \uC8FC\uC18C\uAC00
      \uB450 \uAC1C\uC600\uB2E4. \uBC15\uBBFC\uC6B0\uB294 \uB450 \uBC88\uC9F8 \uC8FC\uC18C\uC758
      \uC2DC\uC791\uC77C\uC744 \uBE44\uC6CC\uB480\uB2E4. \uC9C0\uB09C\uBC88\uC5D0\uB294
      \uBB3C\uB7C9\uC774 \uC624\uAE30\uB3C4 \uC804\uC5D0 \uAC70\uAE30\uBD80\uD130
      \uC801\uD600 \uC788\uC5C8\uB2E4."
    player: 0
    narration: 1
    scene: 0
  - npcId: npc-dongbang-trading-ceo-kang-jaehyeon
    text: "\uC5B4\uB290 \uBB3C\uB7C9\uC774 \uBE60\uC9C0\uBA74 \uC5B4\uB290 \uACB0\uC815\uC744
      \uBA48\uCD9C\uC9C0 \uC774\uBC88\uC5D0\uB294 \uC801\uC5B4\uB1A8\uC2B5\uB2C8\uB2E4.
      \uB0B4\uAC00 \uC2EB\uC5B4\uD55C\uB2E4\uACE0 \uC5C6\uC5B4\uC9C0\uB294 \uC704\uD5D8\uC740
      \uC544\uB2C8\uB2C8\uAE4C."
