  - choiceText: "\uACE0\uAC1D \uB2E4\uBCC0\uD654\uB97C \uC911\uAC04 \uC810\uAC80\uD55C\uB2E4"
    choiceDescription:
    playerLine: "\uAC70\uB798\uCC98\uB97C \uB298\uB9AC\uB294 \uB3D9\uC548 \uC911\uAC04
      \uC810\uAC80\uC744 \uB123\uC8E0. \uC5B4\uB290 \uACE0\uAC1D\uC758 \uBB3C\uB7C9\uC774
      \uBE60\uC9C0\uBA74 \uBB34\uC5C7\uC744 \uBA48\uCD9C\uC9C0\uB3C4 \uC815\uD574\uC8FC\uC2ED\uC2DC\uC624."
    resultDialogue: "\uBA48\uCD9C \uAE30\uC900\uAE4C\uC9C0 \uC801\uC73C\uB77C\uB294
