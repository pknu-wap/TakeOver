  title: "\uB3D9\uBC29\uBB3C\uC0B0 \u2014 \uD655\uC815 \uBB3C\uB7C9\uACFC \uADFC\uBB34\uD45C"
  image: {fileID: 21300000, guid: e4f06f328acf53c4385995fb1f2c1e65, type: 3}
  cardImage: {fileID: 21300000, guid: d04aa39026668454991718ef00702904, type: 3}
  npcArts: []
  highlightImage: {fileID: 0}
  negotiationBackground: {fileID: 0}
  description: "\uBC15\uBBFC\uC6B0\uAC00 \uACC4\uC57D\uC774 \uC7A1\uD78C \uBB3C\uB7C9\uB9CC\uC73C\uB85C
    \uC0C8 \uADFC\uBB34\uD45C\uB97C \uC9F0\uB2E4. \uAC15\uC7AC\uD604\uC774 \uCC3D\uACE0
    \uD655\uC7A5 \uACC4\uD68D\uC744 \uC5B4\uB514\uAE4C\uC9C0 \uB2A6\uCD9C \uC218
    \uC788\uB294\uC9C0 \uC9C1\uC811 \uB4E3\uACE0 \uC2F6\uB2E4."
  apCost: 0
  startButtonText: "\uB9CC\uB098\uAE30"
  companyIds:
  - dongbang-trading
  speakerNpcId: npc-dongbang-trading-ceo-kang-jaehyeon
  speakerName: "\uAC15\uC7AC\uD604"
  speakerRole:
  dialogue: "\uACC4\uD68D\uC5D0 \uBE48\uCE78\uC744 \uB0A8\uACBC\uC18C. \uC804\uC5D0\uB294
    \uBE48\uCE78\uC774 \uC788\uC73C\uBA74 \uB0B4\uAC00 \uC77C\uC744 \uC548 \uD55C
    \uAC83 \uAC19\uC558\uB294\uB370."
  companyQuestion:
  companyPlayerLine:
  choices:
  - choiceText: "\uB2E8\uACC4\uC801\uC73C\uB85C \uC6B4\uC601\uD55C\uB2E4"
    choiceDescription:
    playerLine: "\uC7A1\uD78C \uBB3C\uB7C9\uBD80\uD130 \uC6B4\uC601\uD558\uACE0,
      \uB2E4\uC74C \uB2E8\uACC4\uB294 \uC2E4\uC81C \uBC18\uC785\uC744 \uBCF4\uACE0
      \uC5EC\uB294 \uCABD\uC744 \uC9C0\uC9C0\uD558\uACA0\uC2B5\uB2C8\uB2E4. \uBE48
      \uCC3D\uACE0\uB97C \uC608\uC0C1 \uBB3C\uB7C9\uC73C\uB85C \uCC44\uC6B0\uC9C0\uB294
      \uB9D0\uC8E0."
    resultDialogue: "\uAE30\uB2E4\uB9AC\uB294 \uC0AC\uC774 \uB2E4\uB978 \uAE30\uD68C\uB97C
      \uB193\uCE60 \uC218\uB294 \uC788\uACA0\uC9C0. \uADF8\uB798\uB3C4 \uC5C6\uB294
      \uBB3C\uB7C9\uC73C\uB85C \uC0AC\uB78C\uBD80\uD130 \uC62E\uAE30\uB294 \uC77C\uC740
      \uBC18\uBCF5\uD558\uC9C0 \uC54A\uACA0\uC18C."
    resultValue: answer_0
    npcResult:
      eventId:
