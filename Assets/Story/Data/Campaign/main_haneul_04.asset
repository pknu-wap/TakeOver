  title: "\uD558\uB298\uC2DD\uD488 \u2014 \uC7AC\uC8FC\uBB38\uACFC \uB2E4\uC74C \uC0DD\uC0B0\uBE44"
  image: {fileID: 21300000, guid: e4f06f328acf53c4385995fb1f2c1e65, type: 3}
  cardImage: {fileID: 21300000, guid: d04aa39026668454991718ef00702904, type: 3}
  npcArts: []
  highlightImage: {fileID: 0}
  negotiationBackground: {fileID: 0}
  description: "\uAE40\uD558\uB9B0\uC774 \uB2E8\uACE8 \uC8FC\uBB38\uC744 \uBC14\uD0D5\uC73C\uB85C
    \uB0A8\uAE38 \uD488\uBAA9\uC744 \uACE8\uB790\uB2E4. \uADF8 \uC81C\uD488\uC744
    \uACC4\uC18D \uB9CC\uB4E4 \uC218 \uC788\uB3C4\uB85D \uB0A9\uD488 \uB300\uAE08\uACFC
    \uB2E4\uC74C \uC6D0\uB8CC\uBE44\uC758 \uC77C\uC815\uC744 \uB9DE\uCDB0\uBCF8\uB2E4."
  apCost: 0
  startButtonText: "\uB9CC\uB098\uAE30"
  companyIds:
  - haneul-food
  speakerNpcId: npc-haneul-food-ceo-kim-harin
  speakerName: "\uAE40\uD558\uB9B0"
  speakerRole:
  dialogue: "\uB2E4 \uB0A8\uAE30\uACA0\uB2E4\uACE0 \uB9D0\uD558\uB294 \uAC8C \uC190\uB2D8
    \uD3B8\uC774\uB77C\uACE0 \uC0DD\uAC01\uD588\uC5B4\uC694. \uADF8\uB7F0\uB370 \uADF8
    \uB9D0\uC744 \uC9C0\uD0A4\uB824\uACE0 \uB2E4\uB978 \uB370\uC11C \uD488\uC9C8\uC744
    \uC904\uC774\uBA74 \uB354 \uB098\uC058\uACA0\uC8E0."
  companyQuestion:
  companyPlayerLine:
  choices:
  - choiceText: "\uB2E4\uC2DC \uCC3E\uC744 \uC81C\uD488\uC744 \uAE30\uC900\uC73C\uB85C
      \uBCF8\uB2E4"
    choiceDescription:
    playerLine: "\uC190\uB2D8\uC774 \uB2E4\uC2DC \uACE0\uB97C \uC81C\uD488\uC740
      \uBB34\uC5C7\uC785\uB2C8\uAE4C? \uADF8 \uC81C\uD488\uC744 \uAC19\uC740 \uD488\uC9C8\uB85C
      \uB0A8\uAE38 \uC218 \uC788\uB294\uC9C0\uBD80\uD130 \uBCF4\uACA0\uC2B5\uB2C8\uB2E4."
    resultDialogue: "\uC81C\uAC00 \uAC00\uC7A5 \uC9C0\uD0A4\uACE0 \uC2F6\uC740 \uC9C8\uBB38\uC774\uC5D0\uC694.
      \uB0A8\uAE38 \uC81C\uD488\uC758 \uC774\uC720\uC640 \uADF8\uB9CC\uD07C \uD3EC\uAE30\uD574\uC57C
      \uD558\uB294 \uAC83\uB3C4 \uAC19\uC774 \uB9D0\uC500\uB4DC\uB9B4\uAC8C\uC694."
    resultValue: answer_0
