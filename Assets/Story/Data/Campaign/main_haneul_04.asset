    scene: 0
  - npcId: npc-haneul-food-cfo-oh-jaeseong
    text: "\uC5C6\uC560\uB294 \uC218\uB9CC \uC815\uD558\uBA74 \uBE60\uB974\uAE34
      \uD569\uB2C8\uB2E4. \uC624\uB298\uC740 \uB0A8\uAE30\uB294 \uC774\uC720\uC640
      \uADF8 \uBE44\uC6A9\uAE4C\uC9C0 \uC801\uC5C8\uC2B5\uB2C8\uB2E4."
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uD68C\uC218 \uC870\uAC74\uC774 \uB2E4\uC2DC \uBC14\uB00C\uBA74 \uBB34\uC5C7\uBD80\uD130
      \uBA48\uCDA5\uB2C8\uAE4C?"
    player: 1
    narration: 0
    scene: 0
  - npcId: npc-haneul-food-ceo-kim-harin
    text: "\uAC70\uB798\uCC98\uC5D0\uC11C \uBB36\uC74C \uD3EC\uC7A5\uC744 \uB2E4\uC2DC
      \uB123\uC790\uB294 \uC5F0\uB77D\uC774 \uC654\uC5B4\uC694. \uC804\uC5D0 \uBC1B\uC544\uC900
      \uB4A4\uB85C \uB2E8\uACE8\uB4E4\uC774 \uCC3E\uB294 \uC791\uC740 \uD3EC\uC7A5
      \uC81C\uD488\uC774 \uBA87 \uC8FC\uC529 \uBE60\uC84C\uC8E0. \uC774\uBC88\uC5D0\uB294
      \uADF8 \uC790\uB9AC\uB97C \uBA3C\uC800 \uBE90\uC5B4\uC694."
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uCD94\uAC00 \uBB3C\uB7C9\uC744 \uBC1B\uB354\uB77C\uB3C4 \uBC18\uD488
      \uC2B9\uC778\uACFC \uD589\uC0AC\uBE44 \uC815\uC0B0\uC740 \uB204\uAC00 \uB9E1\uB294\uC9C0
      \uC368\uB450\uC168\uC2B5\uB2C8\uAE4C? \uC9C0\uB09C\uBC88\uC5D0\uB294 \uB2F4\uB2F9\uC774
      \uBC14\uB00C\uACE0 \uB098\uC11C \uADF8\uAC8C \uBC00\uB838\uB2E4\uACE0 \uB4E4\uC5C8\uC2B5\uB2C8\uB2E4."
    player: 1
    narration: 0
    scene: 0
  - npcId: npc-haneul-food-cfo-oh-jaeseong
    text: "\uD55C \uB2F4\uB2F9 \uCC3D\uAD6C\uC5D0\uC11C \uB2F5\uC744 \uBC1B\uACE0,
      \uBC18\uD488 \uAE30\uD55C\uC774 \uC9C0\uB098\uBA74 \uC774\uBC88 \uBC1C\uC8FC
      \uAC74 \uC548\uC5D0\uC11C \uC815\uB9AC\uD558\uC790\uB294 \uC870\uAC74\uC785\uB2C8\uB2E4.
      \uC0C1\uB300\uAC00 \uADF8\uAC78 \uBABB \uC815\uD558\uBA74 \uC0DD\uC0B0 \uC77C\uC815\uC5D0\uB3C4
      \uC62C\uB9AC\uC9C0 \uC54A\uC744 \uAC81\uB2C8\uB2E4."
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uC774\uC804 \uD310\uB9E4\uD45C\uC5D0\uB294 \uD589\uC0AC \uC218\uB7C9
      \uC606\uC758 \uCE78\uC774 \uC804\uBD80 \uD30C\uB7AC\uB2E4. \uC774\uBC88\uC5D0\uB294
      \uB0A9\uD488\uC77C \uB4A4\uB85C \uBC18\uD488 \uAE30\uD55C\uACFC \uC785\uAE08
      \uC608\uC815\uC77C\uC774 \uB530\uB85C \uC774\uC5B4\uC838 \uC788\uC5C8\uB2E4."
    player: 0
    narration: 1
    scene: 0
  - npcId: npc-haneul-food-cfo-oh-jaeseong
    text: "\uB0A9\uD488\uC744 \uC774\uBBF8 \uB05D\uB0B8 \uB3C8\uACFC \uB2E4\uC74C
      \uC0DD\uC0B0\uC5D0 \uC4F8 \uB3C8\uBD80\uD130 \uC11E\uC9C0 \uC54A\uACA0\uC2B5\uB2C8\uB2E4.
      \uCD94\uAC00 \uD589\uC0AC \uBB3C\uB7C9\uC740 \uBCC4\uB3C4 \uD310\uB2E8\uD558\uACE0\uC694."
    player: 0
    narration: 0
    scene: 0
  companyVariants: []
