  - npcId: npc-mirae-construction-cfo-seo-jia
    text: "\uC800\uD76C \uD45C\uC5D0\uB294 \u2018\uC778\uACC4 \uC608\uC815\u2019\uC774\uC5C8\uC5B4\uC694.
      \uC0C1\uB300 \uD45C\uC5D0\uB294 \u2018\uAC1C\uC2DC \uB300\uAE30\u2019\uC600\uB2E4\uB294
      \uAC70\uAD70\uC694."
    player: 0
    narration: 0
    scene: 0
  - npcId: npc-dongbang-trading-hr-director-park-minu
    text: "\uD604\uC7A5 \uB458\uC774 \uC2F8\uC6CC\uC11C \uBA48\uCDC4\uB2E4\uB294
      \uC124\uBA85\uC73C\uB85C\uB294 \uC880 \uACE4\uB780\uD574\uC84C\uB124\uC694.
      \uB458 \uB2E4 \uC11C\uB85C \uAE30\uB2E4\uB9AC\uB77C\uB294 \uB9D0\uC744 \uB4E3\uACE0
      \uC788\uC5C8\uC73C\uB2C8\uAE4C."
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uB204\uAC00 \uAC70\uC9D3\uB9D0\uD588\uB294\uC9C0\uBD80\uD130 \uC815\uD558\uC9C0
      \uC54A\uACA0\uC2B5\uB2C8\uB2E4. \uB2E4\uB9CC \uD604\uC7A5 \uAC04 \uC778\uACC4
      \uBB38\uC81C\uB9CC\uC73C\uB85C \uC124\uBA85\uD560 \uC218 \uC5C6\uB2E4\uB294
      \uAC74 \uB0A8\uACA8\uB450\uC8E0."
    player: 1
    narration: 0
    scene: 0
  - npcId: npc-dongbang-trading-hr-director-park-minu
    text: "\uC6B0\uB9AC \uCABD\uC740 \uAC1C\uC2DC\uC77C\uC744 \uB2E4\uC2DC \uC7A1\uC544\uC900\uB2E4\uACE0
      \uD588\uC5B4\uC694. \uB0A0\uC9DC\uB3C4, \uB204\uAC00 \uC5F0\uB77D\uD560\uC9C0\uB3C4
      \uC5C6\uC5C8\uC2B5\uB2C8\uB2E4. \uB4E3\uACE0 \uBCF4\uB2C8 \uAC70\uAE30 \uBC1B\uC73C\uC2E0
      \uBB38\uAD6C\uD558\uACE0 \uAC70\uC758 \uAC19\uB124\uC694."
    player: 0
    narration: 0
    scene: 0
  - npcId: npc-mirae-construction-cfo-seo-jia
    text: "\uC800\uD76C\uB294 \uAE30\uB2E4\uB9AC\uB294 \uB3D9\uC548 \uC7A5\uBE44\uB8CC\uB97C,
      \uB3D9\uBC29\uC740 \uC774\uBBF8 \uC62E\uAE34 \uC778\uAC74\uBE44\uB97C \uC37C\uAD70\uC694.
      \uD55C \uC7A5\uC5D0 \uAC19\uC774 \uC801\uACA0\uC2B5\uB2C8\uB2E4. \uADF8\uB0A0
      \uB3C8\uC744 \uB0B8 \uAC74 \uC591\uCABD \uB2E4\uC600\uC73C\uB2C8\uAE4C\uC694."
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uBBF8\uB798\uAC74\uC124\uC5D0\uC120 \uB0A8\uC740 \uC7A5\uBE44\uC640 \uC0C8
      \uACF5\uC0AC\uB97C, \uB3D9\uBC29\uBB3C\uC0B0\uC5D0\uC120 \uD655\uC815 \uBB3C\uB7C9\uACFC
      \uADFC\uBB34\uD45C\uB97C \uB530\uB85C \uAC00\uC838\uC624\uAE30\uB85C \uD588\uB2E4.
      \uB2E4\uC74C \uD68C\uC758\uC5D0\uC11C \uB450 \uD68C\uC0AC\uAC00 \uC9C0\uAE08
      \uB2F9\uC7A5 \uBA48\uCD9C \uC218 \uC788\uB294 \uC9C0\uCD9C\uBD80\uD130 \uBCFC
      \uC0DD\uAC01\uC774\uB2E4."
    player: 0
    narration: 1
    scene: 0
  companyVariants: []
