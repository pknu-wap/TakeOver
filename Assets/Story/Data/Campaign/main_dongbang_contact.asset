  negotiationBackground: {fileID: 0}
  description: "\uBBF8\uB798\uAC74\uC124\uC758 \uC900\uACF5 \uC77C\uC815\uC5D0 \uC774\uB984\uC744
    \uC62C\uB9B0 \uC6B4\uC601\uC0AC\uB294 \uB3D9\uBC29\uBB3C\uC0B0\uC774\uC5C8\uB2E4.
    \uADF8\uB4E4\uC774 \uCC3D\uACE0\uB97C \uC5F4\uAE30\uB85C \uD55C \uB0A0 \uBB34\uC5C7\uC774
    \uB4E4\uC5B4\uC62C \uC608\uC815\uC774\uC5C8\uB294\uC9C0 \uBB3B\uACE0 \uC2F6\uB2E4."
  apCost: 0
