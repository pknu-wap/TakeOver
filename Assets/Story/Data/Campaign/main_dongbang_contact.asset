  description: "\uC6B4\uC601 \uAC70\uC810\uC758 \uB2E4\uC74C \uC77C\uC815\uC5D0 \uAD00\uD55C
    \uBA74\uB2F4 \uC694\uCCAD\uC785\uB2C8\uB2E4. \uB0B4\uC6A9\uACFC \uBE44\uC6A9\uC744
    \uD655\uC778\uD55C \uB4A4 \uB9CC\uB098\uC2ED\uC2DC\uC624."
  apCost: 0
  startButtonText: "\uB9CC\uB098\uAE30"
