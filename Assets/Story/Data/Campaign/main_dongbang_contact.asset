  speakerNpcId: npc-broker-yoon-hajin
  speakerName: "\uC724\uD558\uC9C4"
  speakerRole:
  dialogue: "\uC800\uD76C \uC794\uC5EC \uC815\uB9AC\uC548\uB3C4 20\uC77C\uCC28\uC5D0
    \uAC80\uD1A0\uD569\uB2C8\uB2E4. \uB3D9\uBC29 \uCABD \uACF5\uAC1C \uC6B4\uC601
    \uC124\uBA85\uD558\uACE0 \uAC19\uC740 \uC2DC\uAE30\uB85C \uBCF4\uC2DC\uBA74 \uC9C8\uBB38\uC744
    \uC815\uB9AC\uD558\uAE30 \uC88B\uC744 \uAC70\uC608\uC694."
