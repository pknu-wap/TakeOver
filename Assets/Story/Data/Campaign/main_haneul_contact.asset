  m_Name: main_haneul_contact
  m_EditorClassIdentifier: Assembly-CSharp::TakeOver.Events.EventDefinition
  eventId: main_haneul_contact
  category: 1
  linearDialogue: 1
  tutorialOnly: 0
  title: "\uD558\uB298\uC2DD\uD488 \u2014 \uB9E4\uCD9C \uAE30\uC0AC\uC5D0 \uBE60\uC9C4
    \uC815\uC0B0"
  image: {fileID: 21300000, guid: 5e4f9d2677ff7d14485fc7b35103459b, type: 3}
  cardImage: {fileID: 21300000, guid: 50c03d92d4dbc3141a37c95c1ddcd7c6, type: 3}
  npcArts: []
  highlightImage: {fileID: 0}
  negotiationBackground: {fileID: 0}
  description: "\uC774\uBBFC\uADDC\uAC00 \uD558\uB298\uC2DD\uD488\uC758 \uD310\uB9E4
    \uD638\uC870 \uAE30\uC0AC\uC640 \uB4A4\uB2A6\uC740 \uC815\uC0B0 \uC790\uB8CC\uB97C
    \uD568\uAED8 \uBCF4\uB0C8\uB2E4. \uADF8\uB807\uAC8C \uB9CE\uC774 \uD314\uACE0\uB3C4
    \uB2E4\uC74C \uC0DD\uC0B0\uBE44\uAC00 \uBE60\uB4EF\uD588\uB2E4\uBA74, \uC5B4\uB514\uC5D0
    \uB3C8\uC774 \uBB36\uC600\uC744\uAE4C."
  apCost: 0
  startButtonText: "\uB9CC\uB098\uAE30"
  companyIds:
  - haneul-food
  speakerNpcId: npc-economic-reporter-lee-mingyu
  speakerName: "\uC774\uBBFC\uADDC"
  speakerRole:
  dialogue: "\uC9C0\uB09C\uBC88\uC5D0 \uD68C\uC0AC \uC790\uB8CC \uD655\uC778 \uC911\uC774\uB77C\uACE0
    \uD558\uC168\uC8E0. \uC774\uBC88\uC5D0\uB294 \uC22B\uC790\uAC00 \uC870\uAE08
    \uC7AC\uBBF8\uC788\uC2B5\uB2C8\uB2E4. \uC7AC\uBBF8\uC788\uB2E4\uB294 \uB9D0\uC744
    \uC81C\uAC00 \uC4F0\uBA74 \uBCF4\uD1B5 \uB2F9\uC0AC\uC790\uB294 \uC548 \uC88B\uC544\uD558\uC2DC\uC9C0\uB9CC\uC694."
  companyQuestion:
  companyPlayerLine:
  choices:
  - choiceText:
    choiceDescription: "7\uC77C\uCC28 \uD22C\uC790 \uAC80\uD1A0 \uC5F0\uB77D\uC785\uB2C8\uB2E4.
      \uD558\uB298\uC2DD\uD488 \uC9C0\uBD84 10%\uB97C 12\uC77C\uCC28 \uC2DC\uC791
      \uC804\uAE4C\uC9C0 \uD655\uBCF4\uD558\uC2ED\uC2DC\uC624."
    playerLine: "\uB2E4\uB978 \uC5C5\uC885\uC5D0\uC11C\uB3C4 \uBE44\uC2B7\uD55C \uC77C\uC774
      \uC788\uC5C8\uAD70\uC694. \uC9C1\uC811 \uB9CC\uB098\uC11C \uC81C\uD488\uACFC
      \uAC70\uB798 \uC870\uAC74\uC744 \uD568\uAED8 \uB4E4\uC5B4\uBCF4\uACA0\uC2B5\uB2C8\uB2E4."
    resultDialogue: "\uD558\uB298\uC2DD\uD488 \uCABD\uC5D0 \uC5F0\uB77D\uD574\uB458\uAC8C\uC694.
      \uC22B\uC790\uB9CC \uBCF4\uC9C0 \uB9D0\uACE0, \uADF8 \uC81C\uD488\uC744 \uC65C
      \uB0A8\uAE30\uB824\uB294\uC9C0\uB3C4 \uBB3C\uC5B4\uBCF4\uC138\uC694."
