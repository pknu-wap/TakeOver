  description: "\uC798 \uD314\uB9B4 \uC81C\uD488\uACFC \uB0A8\uACA8\uC9C8 \uC81C\uD488\uC5D0
    \uAD00\uD55C \uBA74\uB2F4 \uC694\uCCAD\uC785\uB2C8\uB2E4. \uB0B4\uC6A9\uACFC
    \uBE44\uC6A9\uC744 \uD655\uC778\uD55C \uB4A4 \uB9CC\uB098\uC2ED\uC2DC\uC624."
  apCost: 0
  startButtonText: "\uB9CC\uB098\uAE30"
  companyIds:
  - haneul-food
  speakerNpcId: npc-haneul-food-ceo-kim-harin
  speakerName: "\uAE40\uD558\uB9B0"
  speakerRole:
  dialogue: "\uD070 \uAC70\uB798\uCC98\uAC00 \uC88B\uC544\uD560 \uAD6C\uC131\uC73C\uB85C
    \uBC14\uAFB8\uBA74 \uC22B\uC790\uB294 \uB098\uC544 \uBCF4\uC774\uACA0\uC8E0.
    \uADF8\uB7F0\uB370 \uB298 \uC0AC\uB358 \uC190\uB2D8\uC774 \uCC3E\uB294 \uAC74
    \uADF8 \uC0C1\uC790\uAC00 \uC544\uB2D0 \uC218 \uC788\uC5B4\uC694."
  companyQuestion:
  companyPlayerLine:
  choices:
  - choiceText: "\uD575\uC2EC \uC81C\uD488\uC744 \uC815\uD558\uACE0 \uC804\uD658
      \uBE44\uC6A9\uC744 \uACC4\uC0B0\uD55C\uB2E4"
    choiceDescription: "\uC774\uBC88 \uB300\uD654\uC758 \uC120\uD0DD\uACFC \uAD00\uCC30
      \uC0AC\uC2E4\uC744 \uAE30\uB85D\uD569\uB2C8\uB2E4. \uD604\uAE08\xB7\uC9C0\uBD84
      \uBCC0\uD654 \uC5C6\uC74C."
    playerLine: "\uD575\uC2EC \uC81C\uD488\uC744 \uC815\uD558\uACE0 \uC804\uD658
      \uBE44\uC6A9\uC744 \uACC4\uC0B0\uD55C\uB2E4"
    resultDialogue: "\uB0A8\uAE38 \uC774\uC720\uBD80\uD130 \uC815\uB9AC\uD560\uAC8C\uC694.
      \uBB34\uC5C7\uC744 \uB35C \uB9CC\uB4E4\uC9C0 \uC124\uBA85\uD558\uB294 \uCC45\uC784\uB3C4
      \uC800\uD76C\uC5D0\uAC8C \uC788\uACE0\uC694."
    resultValue: answer_0
    npcResult:
      eventId:
