    scene: 0
  - npcId: npc-haneul-food-cfo-oh-jaeseong
    text: "\uADF8\uB300\uB85C \uC804\uBD80 \uB0A8\uAE30\uBA74 \uC0DD\uC0B0 \uC804\uD658
      \uD69F\uC218\uBD80\uD130 \uB298\uC5B4\uC694. \uC608\uC804\uC5D0\uB294 \uB9CE\uC774
      \uD314\uBA74 \uADF8 \uBE44\uC6A9\uC740 \uB530\uB77C\uC62C \uAC70\uB77C\uACE0
      \uBD24\uC2B5\uB2C8\uB2E4. \uC774\uBC88\uC5D0\uB294 \uD68C\uC218 \uB0A0\uC9DC\uAE4C\uC9C0
      \uB193\uACE0 \uBCF4\uB824\uACE0\uC694."
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uC81C\uD488\uC744 \uC904\uC774\uB294 \uBB38\uC81C\uC640, \uB9CC\uB4DC\uB294
      \uBC29\uC2DD\uC744 \uBC14\uAFB8\uB294 \uBB38\uC81C\uB97C \uB098\uB220\uBCFC
      \uC218 \uC788\uC2B5\uB2C8\uAE4C?"
    player: 1
    narration: 0
    scene: 0
  - npcId: npc-haneul-food-ceo-kim-harin
    text: "\uADF8\uAC78 \uB4E3\uACE0 \uC2F6\uC5C8\uC5B4\uC694. \uB0A8\uAE38 \uC81C\uD488\uC774
      \uBB54\uC9C0 \uC815\uD558\uAE30\uB3C4 \uC804\uC5D0 \uC5C6\uC560\uB294 \uBC29\uBC95\uBD80\uD130
      \uB098\uC624\uB294 \uAC74 \uC2EB\uC5B4\uC11C\uC694."
    player: 0
    narration: 0
    scene: 0
  - npcId: npc-haneul-food-cfo-oh-jaeseong
    text: "\uC124\uBE44 \uACAC\uC801\uC744 \uBC1B\uC544\uB3C4 \uB418\uB294 \uB2E8\uACC4\uC640
      \uC8FC\uBB38\uD574\uB3C4 \uB418\uB294 \uB2E8\uACC4\uB3C4 \uB098\uB215\uC2DC\uB2E4.
      \uC8FC\uC8FC\uBD84\uC774 \uAD00\uC2EC\uC744 \uBCF4\uC600\uB2E4\uACE0 \uBC1C\uC8FC\uAC00
      \uB09C \uAC74 \uC544\uB2C8\uB2C8\uAE4C\uC694."
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uD55C\uC131 \uCABD\uC5D0\uB294 \uAC00\uB2A5\uD55C \uC804\uD658 \uBC94\uC704\uBD80\uD130
      \uBB3B\uACA0\uC2B5\uB2C8\uB2E4. \uC2F8\uAC8C \uB9CC\uB4E4 \uC218 \uC788\uB2E4\uB294
      \uB2F5\uBCF4\uB2E4, \uBC18\uBCF5\uD574\uC11C \uAC19\uC740 \uD488\uC9C8\uC744
      \uB0BC \uC218 \uC788\uB294\uC9C0 \uBCF4\uACE0 \uC2F6\uC2B5\uB2C8\uB2E4."
    player: 1
    narration: 0
    scene: 0
  - npcId: npc-haneul-food-ceo-kim-harin
    text: "\uC804\uC5D0 \uD589\uC0AC\uC6A9 \uBB36\uC74C\uC744 \uB9DE\uCD94\uB290\uB77C
      \uB0B1\uAC1C \uD3EC\uC7A5\uC744 \uBBF8\uB918\uC5B4\uC694. \uD589\uC0AC\uB294
      \uC811\uD614\uB294\uB370, \uD3C9\uC18C \uD55C \uBD09\uC9C0\uC529 \uC0AC\uB358
      \uBD84\uB4E4\uC774 \uB2E4\uC2DC \uCC3E\uC558\uC744 \uB550 \uBCF4\uB0B4\uB4DC\uB9B4
      \uAC8C \uC5C6\uC5C8\uC8E0."
    player: 0
    narration: 0
    scene: 0
  - npcId: npc-haneul-food-cfo-oh-jaeseong
    text: "\uADF8\uB54C \uBC14\uAFD4 \uCC0D\uC740 \uD3EC\uC7A5\uC9C0\uB294 \uBC18\uD488\uC73C\uB85C
      \uB3CC\uC544\uC628 \uC81C\uD488\uC5D0 \uB2E4\uC2DC \uC4F8 \uC218 \uC5C6\uC5C8\uC2B5\uB2C8\uB2E4.
      \uC774\uBC88\uC5D0\uB294 \uAC70\uB798\uCC98 \uC804\uC6A9\uC73C\uB85C \uB9CC\uB4E4
      \uBE44\uC6A9\uC744 \uBCC4\uB3C4\uB85C \uBE7C\uB1A8\uC5B4\uC694."
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uB450 \uBC88\uC9F8 \uC8FC\uBB38\uC774 \uB4E4\uC5B4\uC624\uC9C0 \uC54A\uC544\uB3C4
      \uBC84\uD2F8 \uC218 \uC788\uB294 \uC591\uC744 \uBA3C\uC800 \uC801\uC5B4\uC8FC\uC2ED\uC2DC\uC624.
      \uADF8 \uAE30\uC900\uC744 \uD55C\uC131\uC5D0 \uAC00\uC838\uAC00\uBA74 \uC5BC\uB9C8\uB9CC\uD07C\uC758
      \uC804\uD658\uC774 \uD544\uC694\uD55C\uC9C0\uB3C4 \uBCF4\uC774\uACA0\uAD70\uC694."
