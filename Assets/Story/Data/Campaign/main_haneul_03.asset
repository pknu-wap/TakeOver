  - choiceText: "\uD68C\uC218 \uC870\uAC74\uACFC \uC81C\uD488\uC744 \uD568\uAED8
      \uBCF8\uB2E4"
    choiceDescription:
    playerLine: "\uC798 \uD314\uB9AC\uB294 \uC81C\uD488\uACFC \uB3C8\uC774 \uC81C\uB54C
      \uB4E4\uC5B4\uC624\uB294 \uC81C\uD488\uC774 \uAC19\uC740\uC9C0 \uBCF4\uACE0
