  title: "\uD558\uB298\uC2DD\uD488 \u2014 \uC81C\uD488\uBCC4 \uC0DD\uC0B0\xB7\uD68C\uC218
    \uACC4\uD68D"
  image: {fileID: 21300000, guid: e4f06f328acf53c4385995fb1f2c1e65, type: 3}
  cardImage: {fileID: 21300000, guid: d04aa39026668454991718ef00702904, type: 3}
  npcArts: []
  highlightImage: {fileID: 0}
  negotiationBackground: {fileID: 0}
  description: "\uAE40\uD558\uB9B0\uC740 \uB2E8\uACE8\uC774 \uCC3E\uB294 \uC81C\uD488\uC744
    \uB0A8\uAE30\uACE0 \uC2F6\uC5B4 \uD55C\uB2E4. \uC624\uC7AC\uC131\uC740 \uC0DD\uC0B0
    \uC804\uD658\uBE44\uC640 \uC785\uAE08\uC77C\uC744 \uB2E4\uC2DC \uACC4\uC0B0\uD588\uB2E4.
    \uC5B4\uB5A4 \uD488\uBAA9\uC744 \uB0A8\uAE38 \uC5EC\uB825\uC774 \uC788\uB294\uC9C0
    \uB450 \uD45C\uB97C \uD568\uAED8 \uBCF4\uC790."
  apCost: 0
  startButtonText: "\uB9CC\uB098\uAE30"
  companyIds:
  - haneul-food
  speakerNpcId: npc-haneul-food-ceo-kim-harin
  speakerName: "\uAE40\uD558\uB9B0"
  speakerRole:
  dialogue: "\uD070 \uAC70\uB798\uCC98\uAC00 \uC88B\uC544\uD560 \uAD6C\uC131\uC73C\uB85C
    \uBC14\uAFB8\uBA74 \uC22B\uC790\uB294 \uB098\uC544 \uBCF4\uC774\uACA0\uC8E0.
    \uADF8\uB7F0\uB370 \uB298 \uC0AC\uB358 \uC190\uB2D8\uC774 \uCC3E\uB294 \uAC74
    \uADF8 \uC0C1\uC790\uAC00 \uC544\uB2D0 \uC218 \uC788\uC5B4\uC694."
  companyQuestion:
  companyPlayerLine:
  choices:
  - choiceText: "\uB0A8\uAE38 \uC81C\uD488\uBD80\uD130 \uC815\uD55C\uB2E4"
    choiceDescription:
    playerLine: "\uACC4\uC18D \uB9CC\uB4E4 \uC81C\uD488\uBD80\uD130 \uC881\uD600\uBCF4\uC8E0.
      \uADF8\uAC78 \uB0A8\uAE30\uB824\uBA74 \uD3EC\uC7A5\uACFC \uC0DD\uC0B0\uC744
      \uBC14\uAFB8\uB294 \uB370 \uC5BC\uB9C8\uAC00 \uB4DC\uB294\uC9C0\uB3C4 \uC54C\uACE0
      \uC2F6\uC2B5\uB2C8\uB2E4."
    resultDialogue: "\uB0A8\uAE38 \uC774\uC720\uB97C \uC81C\uAC00 \uBA3C\uC800 \uC124\uBA85\uD560\uAC8C\uC694.
      \uC775\uC219\uD558\uB2E4\uB294 \uC774\uC720\uB9CC\uC73C\uB85C \uC804\uBD80
      \uC9C0\uD0A4\uACA0\uB2E4\uACE0 \uD558\uC9C0\uB294 \uC54A\uC744\uAC8C\uC694."
    resultValue: answer_0
    npcResult:
