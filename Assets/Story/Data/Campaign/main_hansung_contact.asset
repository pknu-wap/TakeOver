  title: "\uD55C\uC131\uACF5\uC5C5 \u2014 \uD3EC\uC7A5 \uC804\uD658\uC5D0 \uD544\uC694\uD55C
    \uC124\uBE44"
  image: {fileID: 21300000, guid: e4f06f328acf53c4385995fb1f2c1e65, type: 3}
  cardImage: {fileID: 21300000, guid: d04aa39026668454991718ef00702904, type: 3}
  npcArts: []
  highlightImage: {fileID: 0}
  negotiationBackground: {fileID: 0}
  description: "\uD558\uB298\uC2DD\uD488\uC774 \uC81C\uD488\uC744 \uBC14\uAFD4 \uB9CC\uB4E4\uB824\uBA74
    \uD3EC\uC7A5 \uACF5\uC815\uBD80\uD130 \uC190\uBD10\uC57C \uD55C\uB2E4. \uD55C\uC131\uACF5\uC5C5\uC5D0
    \uACAC\uC801\uC744 \uBB3B\uAE30 \uC804\uC5D0, \uAE30\uC874 \uC124\uBE44\uB85C
    \uC5BC\uB9C8\uB098 \uC790\uC8FC \uC0DD\uC0B0\uC744 \uBC14\uAFC0 \uC218 \uC788\uB294\uC9C0
    \uC54C\uC544\uBCF4\uC790."
  apCost: 0
  startButtonText: "\uB9CC\uB098\uAE30"
  companyIds:
  - hansung-industry
  speakerNpcId: npc-hansung-industry-labor-director-choi-mijeong
  speakerName: "\uCD5C\uBBF8\uC815"
