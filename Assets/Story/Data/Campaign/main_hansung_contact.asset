  openingLines:
  - npcId:
    text: "\uD558\uB298\uC2DD\uD488\uC758 \uD3EC\uC7A5\xB7\uD488\uBAA9 \uC804\uD658
      \uC9C8\uBB38\uC744 \uD604\uC7AC \uD22C\uC790 \uAC80\uD1A0 \uD56D\uBAA9\uC73C\uB85C
      \uC815\uB9AC\uD588\uB2E4. \uACF5\uAC1C\uB41C \uBC94\uC6A9 \uC124\uBE44\xB7\uBD80\uD488
      \uB300\uC751 \uC774\uB825\uC5D0\uC11C \uD55C\uC131\uACF5\uC5C5\uC744 \uCC3E\uC558\uB2E4."
    player: 0
    narration: 1
    scene: 0
  - npcId: npc-haneul-food-cfo-oh-jaeseong
    text: "\uC124\uBE44 \uACAC\uC801\uC774 \uC2F8\uB2E4\uB294 \uB2F5\uBCF4\uB2E4
      \uC2E4\uC81C\uB85C \uD488\uC9C8\uC744 \uBC18\uBCF5\uD560 \uC218 \uC788\uB294\uC9C0
      \uBCF4\uACE0 \uC2F6\uC2B5\uB2C8\uB2E4. \uC8FC\uBB38\uC774\uB098 \uBC1C\uC8FC\uB97C
      \uD655\uC815\uD55C \uAC74 \uC544\uB2D9\uB2C8\uB2E4."
    player: 0
    narration: 0
    scene: 0
  - npcId: npc-hansung-industry-labor-director-choi-mijeong
    text: "\uD55C\uC131\uACF5\uC5C5 \uCD5C\uBBF8\uC815\uC785\uB2C8\uB2E4. \uD604\uC7AC
      \uC0DD\uC0B0\uACFC \uC804\uC218 \uACC4\uD68D\uC744 \uD568\uAED8 \uBB38\uC758\uD558\uC168\uC8E0.
      28\uC77C\uCC28 \uC124\uBA85 \uBA74\uB2F4\uC5D0\uC11C \uACF5\uC720\uD560 \uC218
      \uC788\uB294 \uBC94\uC704\uB97C \uC900\uBE44\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    player: 0
    narration: 0
    scene: 0
  - npcId: npc-institutional-investor-kim-taeseong
    text: "\uC81C\uD488 \uC218\uC694\uC640 \uC0DD\uC0B0 \uC870\uAC74\uC744 \uD568\uAED8
      \uBCF4\uB824\uB294 \uACC4\uD68D\uC774\uAD70\uC694. \uCD9C\uC790\uC790\uC5D0\uAC8C\uB3C4
      \uC5B4\uB290 \uD55C\uCABD\uC774 \uBE60\uC9C4 \uD22C\uC790\uC548\uC744 \uB0B4\uC9C0
      \uC54A\uB3C4\uB85D \uD558\uC138\uC694."
    player: 0
    narration: 0
    scene: 0
  - npcId: npc-broker-yoon-hajin
    text: "\uC774\uBC88\uC5D0\uB294 \uB450 \uD68C\uC0AC\uC758 \uAC80\uD1A0\uB97C
      \uD568\uAED8 \uC900\uBE44\uD574\uC57C \uD574\uC694. \uD55C\uCABD \uC774\uC57C\uAE30\uB9CC
      \uB4E4\uC73C\uBA74 \uC11C\uB85C \uC5B4\uB514\uC11C \uC5B4\uAE0B\uB0AC\uB294\uC9C0
      \uB193\uCE60 \uC218 \uC788\uC73C\uB2C8\uAE4C\uC694."
    player: 0
    narration: 0
    scene: 0
  - npcId: npc-hansung-industry-labor-director-choi-mijeong
    text: "\uC608\uC804\uC5D0 \uC804\uD658 \uC7A5\uCE58\uB97C \uB9DE\uCD94\uACE0
      \uAC80\uC218 \uC790\uB9AC\uAC00 \uCDE8\uC18C\uB41C \uC801\uC774 \uC788\uC5B4\uC694.
      \uAC19\uC740 \uBC29\uC2DD\uC73C\uB85C \uACAC\uC801\uC744 \uB0BC \uC21C \uC5C6\uC2B5\uB2C8\uB2E4.
      \uC791\uC5C5\uC790\uAC00 \uC7A5\uBE44\uB97C \uBD99\uB4E4\uACE0 \uC788\uC5B4\uC57C
      \uD558\uB294 \uC2DC\uAC04\uAE4C\uC9C0 \uBCF4\uC5EC\uB4DC\uB9B4\uAC8C\uC694."
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uD558\uB298 \uCABD\uC5D0\uB3C4 \uADF8 \uC2DC\uAC04\uC744 \uC54C\uB824\uB450\uACA0\uC2B5\uB2C8\uB2E4.
      \uC7A5\uBE44\uAC00 \uC624\uB294 \uB0A0\uACFC \uACF5\uC7A5\uC774 \uB2E4\uC2DC
      \uB3C4\uB294 \uB0A0\uBD80\uD130 \uB530\uB85C \uC7A1\uC8E0."
    player: 1
    narration: 0
    scene: 0
  - npcId:
    text: "\uD558\uB298\uC2DD\uD488\uC758 \uD488\uBAA9\uD45C\uB97C \uD55C\uC131\uACF5\uC5C5
      \uACAC\uC801 \uC694\uCCAD\uC11C \uC606\uC5D0 \uB193\uC558\uB2E4. \uC591\uCABD\uC758
      \uB300\uB2F5\uC744 \uB4E4\uC73C\uBA74 \uC6B0\uB9AC \uD68C\uC0AC\uB3C4 \uACC4\uC18D
      \uD22C\uC790\uD560 \uB9CC\uD55C \uC0DD\uC0B0 \uACC4\uD68D\uC778\uC9C0 \uC124\uBA85\uD560
      \uC218 \uC788\uC744 \uAC83\uC774\uB2E4."
    player: 0
    narration: 1
    scene: 0
  companyVariants: []
