  openingLines:
  - npcId: npc-mirae-construction-cfo-seo-jia
    text: "\uC774\uBC88\uC5D0\uB294 \uB4E4\uC5B4\uC62C \uB3C8\uD558\uACE0, \uB4E4\uC5B4\uC62C
      \uAC70\uB77C\uACE0 \uAE30\uB300\uD55C \uB3C8\uC744 \uAC19\uC740 \uC904\uC5D0
      \uB193\uC9C0 \uC54A\uC558\uC5B4\uC694."
    player: 0
    narration: 0
  - npcId: npc-dongbang-trading-hr-director-park-minu
    text: "\uC800\uD76C\uB3C4\uC694. \uD655\uC815\uB41C \uC77C\uD558\uACE0 \uC798\uB418\uBA74
      \uD560 \uC77C\uC744 \uBD84\uB9AC\uD588\uB354\uB2C8 \uC0AC\uB78C \uD45C\uC815\uC774
      \uC870\uAE08 \uD3B4\uC84C\uC2B5\uB2C8\uB2E4. \uB300\uD45C\uB2D8\uC740 \uD45C\uAC00
      \uAE38\uC5B4\uC84C\uB2E4\uACE0 \uD558\uC168\uC9C0\uB9CC\uC694."
    player: 0
    narration: 0
  - npcId: npc-dongbang-trading-ceo-kang-jaehyeon
    text: "\uC77D\uC744 \uC218\uB294 \uC788\uB354\uAD70. \uC804 \uD45C\uBCF4\uB2E4."
    player: 0
    narration: 0
  - npcId:
    text: "\uB450 \uD68C\uC0AC\uAC00 \uAC01\uC790\uC758 \uD604\uC7AC \uACC4\uD68D\uACFC
      \uC124\uBA85 \uCC45\uC784\uC744 \uC815\uB9AC\uD588\uB2E4. \uACF5\uB3D9 \uACC4\uC57D\uC774\uB098
      \uACFC\uAC70 \uBC30\uC0C1, \uD22C\uC790 \uC218\uC775\uC774 \uD655\uC815\uB41C
      \uAC83\uC740 \uC544\uB2C8\uB2E4. \uC8FC\uC778\uACF5 \uD68C\uC0AC\uB3C4 \uC774
      \uAC80\uD1A0 \uACB0\uACFC\uB97C \uB2E4\uC74C \uC0AC\uC5C5 \uC2EC\uC0AC\uC5D0
      \uC81C\uCD9C\uD55C\uB2E4. \uBBF8\uB798\uAC74\uC124\uACFC \uB3D9\uBC29\uBB3C\uC0B0\uC758
      \uCD08\uBC18 \uBA54\uC778\uC774 \uB05D\uB0AC\uB2E4."
    player: 0
    narration: 1
  - npcId: npc-mirae-construction-cfo-seo-jia
    text: "\uD655\uC778\uD558\uC168\uC73C\uBA74 \uB9D0\uC500\uD574\uC8FC\uC138\uC694."
    player: 0
    narration: 0
