    scene: 0
  - npcId: npc-dongbang-trading-hr-director-park-minu
    text: "\uC800\uD76C\uB3C4\uC694. \uD655\uC815\uB41C \uC77C\uD558\uACE0 \uC798\uB418\uBA74
      \uD560 \uC77C\uC744 \uBD84\uB9AC\uD588\uB354\uB2C8 \uC0AC\uB78C \uD45C\uC815\uC774
      \uC870\uAE08 \uD3B4\uC84C\uC2B5\uB2C8\uB2E4. \uB300\uD45C\uB2D8\uC740 \uD45C\uAC00
      \uAE38\uC5B4\uC84C\uB2E4\uACE0 \uD558\uC168\uC9C0\uB9CC\uC694."
    player: 0
    narration: 0
    scene: 0
  - npcId: npc-dongbang-trading-ceo-kang-jaehyeon
    text: "\uC77D\uC744 \uC218\uB294 \uC788\uB354\uAD70. \uC804 \uD45C\uBCF4\uB2E4."
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uC608\uC804\uC5D0 \uBC1B\uC740 \uD1B5\uBCF4\uB294 \uB450 \uD68C\uC0AC
      \uC790\uB8CC\uC5D0 \uAC19\uC774 \uB0A8\uAE30\uACA0\uC2B5\uB2C8\uB2E4. \uC774\uBC88
      \uBCF4\uACE0\uC5D0\uC120 \uADF8 \uB2F5\uC744 \uAE30\uB2E4\uB9AC\uB294 \uB3D9\uC548\uC5D0\uB3C4
      \uC5B4\uB290 \uBE44\uC6A9\uC744 \uBA3C\uC800 \uCC98\uB9AC\uD560\uC9C0 \uB530\uB85C
      \uC4F0\uC8E0."
    player: 1
    narration: 0
    scene: 0
  - npcId: npc-mirae-construction-cfo-seo-jia
    text: "\uC88B\uC544\uC694. \uD604\uC7A5 \uC815\uB9AC\uBE44\uB294 \uC800\uD76C
      \uD45C\uC5D0, \uB3D9\uBC29\uC774 \uC7A1\uC544\uB193\uC740 \uAD50\uB300 \uC778\uC6D0\uC740
      \uB3D9\uBC29 \uD45C\uC5D0 \uB450\uC8E0. \uB0B4\uC77C \uAC19\uC740 \uB0A0\uC9DC\uB97C
      \uBCF4\uACE0\uB3C4 \uC11C\uB85C \uB2E4\uB978 \uC77C\uC744 \uD558\uB294 \uAC8C
      \uC790\uC5F0\uC2A4\uB7EC\uC6B4 \uAC70\uB2C8\uAE4C\uC694."
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uC11C\uB85C \uCC45\uC784\uC9C8 \uC77C\uC774 \uC870\uAE08 \uC120\uBA85\uD574\uC84C\uB2E4.
      \uD655\uC778\uD55C \uB0B4\uC6A9\uACFC \uC544\uC9C1 \uAE30\uB2E4\uB824\uC57C
      \uD560 \uB2F5\uC744 \uB098\uB204\uC5B4 \uD68C\uC0AC \uBCF4\uACE0\uC11C\uC5D0
      \uB2F4\uC558\uB2E4."
    player: 0
    narration: 1
    scene: 0
  companyVariants: []
