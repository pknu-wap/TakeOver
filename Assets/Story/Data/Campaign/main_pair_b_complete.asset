      \uC218 \uC788\uB294\uC9C0\uAE4C\uC9C0 \uB9D0\uC500\uB4DC\uB824\uC57C\uC8E0."
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uB2E4\uC74C \uBC1C\uC8FC\uC5D0\uB3C4 \uCCAB \uC0DD\uC0B0\uBD84\uC744
      \uB2E4\uC2DC \uBCFC \uB0A0\uC744 \uAC19\uC774 \uC7A1\uC544\uB450\uC8E0. \uB2F5\uC774
      \uB2A6\uC5B4\uC9C0\uBA74 \uC5B4\uB290 \uB0A0\uC5D0 \uC0DD\uC0B0\uC744 \uBA48\uCD94\uACE0
      \uD1B5\uD654\uD560\uC9C0\uB3C4\uC694."
    player: 1
    narration: 0
    scene: 0
  - npcId: npc-haneul-food-ceo-kim-harin
    text: "\uB124. \uBC18\uD488 \uC598\uAE30\uB97C \uB2E4\uC74C \uB2EC\uB85C \uB118\uACA8\uB193\uACE0
      \uC77C\uB2E8 \uB354 \uB9CC\uB4E4\uC790\uB294 \uC804\uD654\uB294 \uC81C\uAC00
      \uB9C9\uC744\uAC8C\uC694. \uADF8\uAC8C \uACF5\uC7A5 \uD0D3\uC73C\uB85C \uB3CC\uC544\uAC00\uBA74
      \uC0AC\uB78C\uC774 \uBA3C\uC800 \uC9C0\uCE58\uB354\uB77C\uACE0\uC694."
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uC81C\uD488\uC744 \uB0A8\uAE38 \uC774\uC720\uC640 \uADF8 \uC77C\uC744
      \uC774\uC5B4\uAC08 \uC0AC\uB78C\uC774 \uAC19\uC740 \uACC4\uD68D \uC548\uC5D0
      \uB4E4\uC5B4\uC654\uB2E4. \uB450 \uD68C\uC0AC\uB294 \uAC01\uC790\uC758 \uC790\uB9AC\uB85C
      \uB3CC\uC544\uAC00 \uC900\uBE44\uD55C \uC77C\uC744 \uC2DC\uC791\uD588\uB2E4."
