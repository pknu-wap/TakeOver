    narration: 0
  - npcId:
    text: "\uC81C\uD488\xB7\uD68C\uC218\xB7\uC804\uC218\xB7\uB0A9\uAE30\uC758 \uD604\uC7AC
      \uACC4\uD68D\uC744 \uAC01 \uD68C\uC0AC\uAC00 \uCC45\uC784\uC9C0\uAE30\uB85C
      \uD588\uB2E4. \uC2E4\uC81C \uACF5\uAE09 \uACC4\uC57D\uC740 \uBCC4\uB3C4 \uC808\uCC28\uB2E4.
      \uC8FC\uC778\uACF5 \uD68C\uC0AC\uB294 \uC774 \uAC80\uD1A0\uB97C \uBC14\uD0D5\uC73C\uB85C
      \uB2E4\uC74C \uC0AC\uC5C5\uC744 \uC900\uBE44\uD55C\uB2E4. \uD558\uB298\uC2DD\uD488\uACFC
      \uD55C\uC131\uACF5\uC5C5\uC758 \uCD08\uBC18 \uBA54\uC778\uC774 \uB05D\uB0AC\uB2E4."
    player: 0
    narration: 1
