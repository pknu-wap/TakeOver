    choiceDescription:
    playerLine: "\uC774\uBC88\uC5D0\uB294 \uD55C \uBC88 \uD574\uB0B4\uB294 \uAC83\uBCF4\uB2E4
      \uB2E4\uC74C\uC5D0\uB3C4 \uC774\uC5B4\uAC08 \uC218 \uC788\uB294\uC9C0\uB97C
