  openingLines:
  - npcId:
    text: "\uB2E4\uC74C \uD68C\uC0AC \uBCF4\uACE0\uB97C \uC900\uBE44\uD588\uB2E4.
      \uC81C\uD488\xB7\uD68C\uC218\xB7\uC804\uC218\xB7\uB0A9\uAE30\uB97C \uD568\uAED8
      \uB193\uC740 \uC9C0\uC18D \uC0AC\uC5C5 \uAC80\uD1A0\uB2E4. \uACF5\uB3D9\uCD9C\uC790\uC790\uB4E4\uC740
      \uC774 \uACB0\uACFC\uB97C \uBCF4\uACE0 \uD68C\uC0AC\uC758 \uB2E4\uC74C \uC6B4\uC6A9
      \uBC29\uD5A5\uC744 \uC2EC\uC0AC\uD558\uAE30\uB85C \uD588\uB2E4."
    player: 0
    narration: 1
    scene: 0
  - npcId: npc-broker-yoon-hajin
    text: "\uC55E\uC5D0\uC11C \uBCF4\uC2E0 \uAC74 \uB9CC\uB4E4 \uC218 \uC788\uB294\uC9C0\uC640
      \uB0A8\uAE38 \uC81C\uD488\uC774\uC5C8\uC8E0. \uC774\uBC88\uC5D0\uB294 \uB2E4\uC74C\uC5D0\uB3C4
      \uAC19\uC740 \uBC29\uC2DD\uC73C\uB85C \uC774\uC5B4\uAC08 \uC218 \uC788\uB294\uC9C0
      \uC815\uB9AC\uD560 \uCC28\uB840\uC608\uC694."
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uD558\uB298\uC2DD\uD488\uACFC \uD55C\uC131\uACF5\uC5C5\uC5D0\uC11C \uAC01\uAC01
      \uC790\uAE30 \uACC4\uD68D\uC744 \uACB0\uC815\uD558\uB294 \uC790\uB9AC\uAC00
      \uB418\uACA0\uAD70\uC694."
    player: 1
    narration: 0
    scene: 0
  - npcId:
    text: "\uD558\uB298\uC5D0\uC11C \uB0B4\uBCF4\uB0B8 \uCCAB \uBB3C\uB7C9\uC774
      \uAC70\uB798\uCC98\uC5D0\uC11C \uB3CC\uC544\uC624\uBA74, \uD55C\uC131\uC740
      \uADF8\uC0AC\uC774 \uB2E4\uC74C \uC7A5\uBE44\uC5D0 \uC0AC\uB78C\uC744 \uBD99\uC77C
      \uC218 \uC788\uC744\uAE4C\uC694? \uBCF4\uC644 \uC694\uCCAD\uC774 \uC5B8\uC81C
      \uB4E4\uC5B4\uC624\uB294\uC9C0\uB3C4 \uC54C\uC544\uC57C\uACA0\uAD70\uC694."
    player: 1
    narration: 0
    scene: 0
  - npcId: npc-broker-yoon-hajin
    text: "\uADF8 \uC9C8\uBB38\uC744 \uAC01\uC790\uD55C\uD14C \uD574\uBCF4\uC138\uC694.
      \uC11C\uB85C \uB300\uC2E0 \uB2F5\uD558\uAE30 \uC2DC\uC791\uD558\uBA74 \uD68C\uC758\uB294
      \uBE68\uB9AC \uB05D\uB098\uB3C4, \uBC1C\uC8FC\uD558\uACE0 \uB098\uC120 \uAF2D
      \uB2E4\uC2DC \uC804\uD654\uD558\uAC8C \uB418\uB354\uB77C\uACE0\uC694."
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uB450 \uD68C\uC0AC\uC758 \uC774\uB984\uC744 \uBCF4\uACE0\uC11C \uB9C8\uC9C0\uB9C9
      \uC7A5\uC5D0 \uB098\uB780\uD788 \uC801\uC5C8\uB2E4. \uC774\uBC88\uC5D0 \uC138\uC6B4
      \uACC4\uD68D\uC744 \uB2E4\uC74C\uC5D0\uB3C4 \uC774\uC5B4\uAC08 \uC218 \uC788\uC744\uC9C0,
      \uC9C1\uC811 \uBCF4\uACE0 \uB2F5\uD574\uC57C \uD588\uB2E4."
    player: 0
    narration: 1
    scene: 0
  companyVariants: []
