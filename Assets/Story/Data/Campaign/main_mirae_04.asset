    player: 0
    narration: 0
  - npcId: npc-mirae-construction-cfo-seo-jia
    text: "\uADF8 \uC9C8\uBB38\uC740 \uBC1B\uC544\uC57C \uD574\uC694. \uB2E4\uC74C
      \uACF5\uC0AC\uAC00 \uD574\uACB0\uD574\uC904 \uAC83\uCC98\uB7FC \uC124\uBA85\uD558\uB294
      \uCABD\uC774 \uB354 \uC624\uB798 \uAC11\uB2C8\uB2E4."
    player: 0
    narration: 0
  - npcId: npc-mirae-construction-field-director-park-dosik
    text: "\uD604\uC7A5 \uBCF4\uACE0\uC11C\uC5D0\uB294 \uACC4\uC18D \uC788\uC5C8\uC2B5\uB2C8\uB2E4.
      \uD68C\uC0AC\uAC00 \uC124\uBA85\uD558\uB294 \uD45C\uC5D0\uB3C4 \uC788\uC73C\uBA74
      \uB429\uB2C8\uB2E4."
    player: 0
    narration: 0
  - npcId:
    text: "\uACFC\uAC70 \uC0C1\uB300\uC758 \uCC45\uC784\uC740 \uACC4\uC18D \uD655\uC778\uD558\uACA0\uC2B5\uB2C8\uB2E4.
      \uADF8 \uB2F5\uC774 \uB098\uC624\uAE30 \uC804\uC5D0\uB3C4 \uC9C0\uAE08 \uBE44\uC6A9\uC744
      \uC5B4\uB5BB\uAC8C \uC124\uBA85\uD560\uC9C0\uB294 \uC815\uD560 \uC218 \uC788\uC8E0."
    player: 1
    narration: 0
  - npcId: npc-mirae-construction-cfo-seo-jia
    text: "\uC5B4\uB5A4 \uBC29\uD5A5\uC73C\uB85C \uAC80\uD1A0\uD558\uC2E4\uC9C0 \uB9D0\uC500\uD574\uC8FC\uC2DC\uACA0\uC5B4\uC694?"
