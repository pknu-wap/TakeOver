  title: "\uBBF8\uB798\uAC74\uC124 \u2014 \uC774\uC804 \uD604\uC7A5\uC758 \uC815\uB9AC\uBE44"
  image: {fileID: 21300000, guid: e4f06f328acf53c4385995fb1f2c1e65, type: 3}
  cardImage: {fileID: 21300000, guid: d04aa39026668454991718ef00702904, type: 3}
  npcArts: []
  highlightImage: {fileID: 0}
  negotiationBackground: {fileID: 0}
  description: "\uC11C\uC9C0\uC544\uAC00 \uC774\uC804 \uD604\uC7A5\uC758 \uBBF8\uC9C0\uAE09
    \uBE44\uC6A9\uC744 \uC0C8 \uACF5\uC0AC \uC608\uC0B0\uC5D0\uC11C \uB5BC\uC5B4\uB0C8\uB2E4.
    \uB0A8\uC740 \uCCAD\uAD6C\uC11C\uB97C \uC5B8\uC81C \uCC98\uB9AC\uD560 \uC218
    \uC788\uB294\uC9C0, \uC774\uBC88 \uC218\uC8FC\uC758 \uC870\uAC74\uC740 \uCDA9\uBD84\uD55C\uC9C0
    \uB4E3\uAE30\uB85C \uD588\uB2E4."
  apCost: 0
  startButtonText: "\uB9CC\uB098\uAE30"
  companyIds:
  - mirae-construction
  speakerNpcId: npc-mirae-construction-cfo-seo-jia
  speakerName: "\uC11C\uC9C0\uC544"
  speakerRole:
  dialogue: "\uC774\uB807\uAC8C \uBCF4\uC5EC\uC8FC\uBA74 \uC65C \uC774\uC81C\uC57C
    \uB530\uB85C \uC801\uC5C8\uB0D0\uACE0 \uD558\uACA0\uC9C0\uC694."
  companyQuestion:
  companyPlayerLine:
  choices:
  - choiceText: "\uB0A8\uC740 \uBE44\uC6A9\uC758 \uC124\uBA85 \uBC94\uC704\uB97C
      \uC815\uD55C\uB2E4"
    choiceDescription:
    playerLine: "\uC544\uC9C1 \uB0A8\uC740 \uBE44\uC6A9\uACFC \uACF5\uAC1C\uD560
      \uC218 \uC788\uB294 \uB0B4\uC6A9\uC744 \uAD6C\uBD84\uD574\uC11C \uBD05\uC2DC\uB2E4.
      \uC124\uBA85\uD560 \uC218 \uC5C6\uB294 \uBD80\uBD84\uAE4C\uC9C0 \uD574\uACB0\uB410\uB2E4\uACE0
      \uC801\uC9C0\uB294 \uC54A\uACA0\uC2B5\uB2C8\uB2E4."
    resultDialogue: "\uB0A8\uC740 \uC9C0\uAE09\uACFC \uD655\uC778\uD560 \uC790\uB8CC\uB97C
      \uB530\uB85C \uBB36\uC744\uAC8C\uC694. \uBE48\uCE78\uC740 \uBE48\uCE78\uC73C\uB85C
      \uB450\uACE0, \uB204\uAC00 \uC5B8\uC81C \uB2F5\uD560 \uC218 \uC788\uB294\uC9C0\uB3C4
      \uC801\uACA0\uC2B5\uB2C8\uB2E4."
    resultValue: answer_0
    npcResult:
