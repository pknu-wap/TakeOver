  - choiceText: "\uD68C\uC0AC\uC758 \uC218\uC815\uC548\uC744 \uBA3C\uC800 \uB4E3\uB294\uB2E4"
    choiceDescription:
    playerLine: "\uC8FC\uC8FC \uCABD \uC694\uAD6C\uBD80\uD130 \uB298\uB9AC\uAE30\uBCF4\uB2E4
      \uACBD\uC601\uC9C4\uC774 \uBC14\uAFB8\uB824\uB294 \uC548\uC744 \uBA3C\uC800
      \uB4E3\uACA0\uC2B5\uB2C8\uB2E4. \uC5B4\uB290 \uBD80\uBD84\uC744 \uCC45\uC784\uC9C0\uACE0
