  - choiceText: "\uC0C8 \uC218\uC8FC \uC2EC\uC0AC\uB97C \uBCF4\uAC15\uD55C\uB2E4"
    choiceDescription:
    playerLine: "\uB2E4\uC74C \uD604\uC7A5\uC5D0\uC11C\uB3C4 \uAC19\uC740 \uBD80\uB2F4\uC774
      \uB0A8\uC9C0 \uC54A\uC73C\uB824\uBA74 \uC218\uC8FC\uB97C \uBC1B\uC744 \uB54C
