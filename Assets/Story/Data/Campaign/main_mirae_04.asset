    scene: 0
  - npcId: npc-mirae-construction-cfo-seo-jia
    text: "\uADF8 \uC9C8\uBB38\uC740 \uBC1B\uC544\uC57C \uD574\uC694. \uB2E4\uC74C
      \uACF5\uC0AC\uAC00 \uD574\uACB0\uD574\uC904 \uAC83\uCC98\uB7FC \uC124\uBA85\uD558\uB294
      \uCABD\uC774 \uB354 \uC624\uB798 \uAC11\uB2C8\uB2E4."
    player: 0
    narration: 0
    scene: 0
  - npcId: npc-mirae-construction-field-director-park-dosik
    text: "\uD604\uC7A5 \uBCF4\uACE0\uC11C\uC5D0\uB294 \uACC4\uC18D \uC788\uC5C8\uC2B5\uB2C8\uB2E4.
      \uD68C\uC0AC\uAC00 \uC124\uBA85\uD558\uB294 \uD45C\uC5D0\uB3C4 \uC788\uC73C\uBA74
      \uB429\uB2C8\uB2E4."
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uACFC\uAC70 \uC0C1\uB300\uC758 \uCC45\uC784\uC740 \uACC4\uC18D \uD655\uC778\uD558\uACA0\uC2B5\uB2C8\uB2E4.
      \uADF8 \uB2F5\uC774 \uB098\uC624\uAE30 \uC804\uC5D0\uB3C4 \uC9C0\uAE08 \uBE44\uC6A9\uC744
      \uC5B4\uB5BB\uAC8C \uC124\uBA85\uD560\uC9C0\uB294 \uC815\uD560 \uC218 \uC788\uC8E0."
    player: 1
    narration: 0
    scene: 0
  - npcId: npc-mirae-construction-cfo-seo-jia
    text: "\uC804\uC5D0\uB294 \uC0C8 \uACC4\uC57D\uC758 \uACC4\uC57D\uAE08\uC774
      \uB4E4\uC5B4\uC624\uB294 \uC8FC\uC5D0 \uC608\uC804 \uC7A5\uBE44\uAC12\uBD80\uD130
      \uB0B4\uB294 \uAC78\uB85C \uC7A1\uC558\uC5B4\uC694. \uADF8\uB7EC\uBA74 \uC0C8
      \uD604\uC7A5\uC5D0 \uBCF4\uB0BC \uB3C8\uC774 \uCCAB \uC8FC\uBD80\uD130 \uBAA8\uC790\uB790\uC8E0."
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uC774\uBC88 \uCCAD\uAD6C\uC11C\uC5D0\uB3C4 \uC778\uACC4 \uD655\uC778\uC744
      \uAE30\uB2E4\uB9AC\uB77C\uB294 \uD68C\uC2E0\uC774 \uBD99\uC5B4 \uC788\uB124\uC694.
      \uC0C1\uB300\uAC00 \uBE44\uC6A9\uC744 \uBD80\uB2F4\uD560 \uAC70\uB77C\uB294
      \uAC00\uC815\uB3C4 \uC7A5\uBD80\uC5D0\uC11C \uBE7C\uC168\uC2B5\uB2C8\uAE4C?"
    player: 1
    narration: 0
    scene: 0
  - npcId: npc-mirae-construction-field-director-park-dosik
    text: "\uC608. \uB2F5\uC774 \uC548 \uC640\uB3C4 \uB2E4\uC74C \uB2EC\uAE4C\uC9C0
      \uBE4C\uB9B0 \uC7A5\uBE44\uB294 \uB3CC\uB824\uC90D\uB2C8\uB2E4. \uB0A8\uC740
      \uC815\uB9AC \uC791\uC5C5\uC5D0 \uC0AC\uB78C\uC774 \uBA70\uCE60 \uBD99\uB294\uC9C0\uB3C4
      \uB530\uB85C \uC801\uC5C8\uACE0\uC694."
    player: 0
    narration: 0
    scene: 0
  - npcId: npc-mirae-construction-ceo-kang-junhyeok
    text: "\uB2E4\uC74C \uACF5\uC0AC\uB294 \uADF8 \uC0AC\uB78C\uC744 \uBE7C\uB3C4
      \uC77C\uC815\uC774 \uB9DE\uC744 \uB54C \uACC4\uC57D\uD558\uACA0\uC2B5\uB2C8\uB2E4.
      \uC774\uBC88\uC5D4 \uB0B4\uAC00 \uC218\uC8FC \uC598\uAE30\uB97C \uBA3C\uC800
      \uAEBC\uB0B4\uB3C4 \uC774 \uD45C\uBD80\uD130 \uAC19\uC774 \uD3B4\uC9C0\uC694."
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uBCF4\uACE0\uC11C\uC5D0\uC11C \u2018\uD68C\uC218 \uC608\uC815\u2019\uC5D0
      \uADF8\uC5B4\uB450\uC5C8\uB358 \uB3D9\uADF8\uB77C\uBBF8\uB97C \uC9C0\uC6E0\uB2E4.
      \uC11C\uC9C0\uC544\uAC00 \uB0A8\uAE34 \uC790\uAE08\uD45C\uC5D0\uC120 \uAE30\uB2E4\uB9B4
      \uC218 \uC788\uB294 \uD56D\uBAA9\uACFC \uB2F9\uC7A5 \uC9C0\uAE09\uD560 \uD56D\uBAA9\uC774
      \uCC98\uC74C\uC73C\uB85C \uAC08\uB838\uB2E4."
    player: 0
    narration: 1
    scene: 0
  - npcId: npc-mirae-construction-cfo-seo-jia
    text: "\uC774 \uD45C\uB300\uB85C\uB77C\uBA74 \uC774\uBC88 \uC8FC\uC5D0 \uACB0\uC815\uD560
