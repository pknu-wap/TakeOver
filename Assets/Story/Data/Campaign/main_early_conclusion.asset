  title: "\uB124 \uD68C\uC0AC\uC758 \uB2E4\uB978 \uC774\uB984, \uC774\uC5B4\uC9C0\uB294
    \uC0AC\uC5C5\uB9DD"
  image: {fileID: 21300000, guid: e4ad3f1b63392de47bb9cbfeb6be2bd0, type: 3}
  cardImage: {fileID: 21300000, guid: e317d1d530e3577478c641da73f9c3d8, type: 3}
  npcArts: []
  highlightImage: {fileID: 0}
  negotiationBackground: {fileID: 0}
  description: "\uB124 \uD68C\uC0AC\uC758 \uB2E4\uB978 \uC774\uB984, \uC774\uC5B4\uC9C0\uB294
    \uC0AC\uC5C5\uB9DD\uC5D0 \uAD00\uD55C \uBA74\uB2F4 \uC694\uCCAD\uC785\uB2C8\uB2E4.
    \uB0B4\uC6A9\uACFC \uBE44\uC6A9\uC744 \uD655\uC778\uD55C \uB4A4 \uB9CC\uB098\uC2ED\uC2DC\uC624."
  apCost: 0
  startButtonText: "\uB9CC\uB098\uAE30"
  companyIds:
  - hansung-industry
  speakerNpcId: npc-broker-yoon-hajin
  speakerName: "\uC724\uD558\uC9C4"
  speakerRole:
  dialogue: "\uC9C0\uAE08 \uD655\uC778\uB41C \uCC38\uC5EC \uAD00\uACC4\uC640, \uC544\uC9C1
    \uC0C1\uB300 \uAE30\uB85D\uC774 \uD544\uC694\uD55C \uC8FC\uC7A5\uC744 \uB098\uB220\uB1A8\uC5B4\uC694.
    \uD53C\uD574\uAC00 \uC788\uC5C8\uB2E4\uB294 \uB9D0\uACFC \uB204\uAC00 \uBB34\uC5C7\uC744
    \uC704\uBC18\uD588\uB294\uC9C0 \uBC1D\uD788\uB294 \uAC74 \uB05D\uAE4C\uC9C0 \uAD6C\uBD84\uD574\uC57C
    \uD569\uB2C8\uB2E4."
  companyQuestion:
  companyPlayerLine:
  choices:
  - choiceText: "\uBBF8\uB798\uAC74\uC124 \uAD00\uB828 \uAC70\uB798\uB97C \uC6B0\uC120
      \uAC80\uD1A0\uD55C\uB2E4"
    choiceDescription: "\uC774\uBC88 \uB300\uD654\uC758 \uC120\uD0DD\uACFC \uAD00\uCC30
      \uC0AC\uC2E4\uC744 \uAE30\uB85D\uD569\uB2C8\uB2E4. \uD604\uAE08\xB7\uC9C0\uBD84
      \uBCC0\uD654 \uC5C6\uC74C."
    playerLine: "\uBBF8\uB798\uAC74\uC124 \uAD00\uB828 \uAC70\uB798\uB97C \uC6B0\uC120
      \uAC80\uD1A0\uD55C\uB2E4"
    resultDialogue: "\uD604\uC7A5\xB7\uAC1C\uBC1C\xB7\uC815\uC0B0 \uAD00\uACC4\uBD80\uD130
      \uB2E4\uC74C \uC9C8\uBB38\uC744 \uC900\uBE44\uD558\uC8E0."
    resultValue: answer_0
