    player: 0
    narration: 0
  - npcId: npc-economic-reporter-lee-mingyu
    text: "\uB124 \uD68C\uC0AC\uB97C \uD55C \uBB38\uC7A5\uC73C\uB85C \uC4F0\uBA74
      \uC81C\uBAA9\uC740 \uC9E7\uC544\uC9D1\uB2C8\uB2E4. \uAE30\uC0AC\uB3C4 \uD2C0\uB9AC\uAE30
      \uC26C\uC6CC\uC9C0\uACE0\uC694. \uC774\uBC88\uC5D0\uB294 \uC880 \uAE38\uAC8C
      \uAC00\uC8E0."
    player: 0
    narration: 0
  - npcId:
    text: "APEX\uAC00 \uAD00\uC5EC\uD588\uB2E4\uB294 \uAC74 \uD655\uC778\uD588\uC2B5\uB2C8\uB2E4.
      \uC774\uC81C \uC2E4\uC81C\uB85C \uAC70\uB798\uB97C \uC9D1\uD589\uD55C \uD68C\uC0AC\uC5D0
      \uBB3C\uC744 \uCC28\uB840\uAD70\uC694."
    player: 1
    narration: 0
  - npcId: npc-broker-yoon-hajin
    text: "\uC9C0\uAE08\uAE4C\uC9C0 \uB9CC\uB09C \uD68C\uC0AC\uB4E4\uC758 \uD604\uC7AC\uB3C4
      \uB0A8\uACA8\uB450\uACE0 \uAC00\uC138\uC694. \uB2E4\uC74C \uC0C1\uB300\uB97C
      \uCC3E\uC558\uB2E4\uACE0 \uB05D\uB09C \uD22C\uC790\uB294 \uC544\uB2C8\uB2C8\uAE4C\uC694."
    player: 0
    narration: 0
  - npcId:
    text: "\uD68C\uC0AC \uBCF4\uACE0\uC11C\uC5D0\uB294 \uD655\uC778\uD55C \uC0AC\uC5C5
      \uAD00\uACC4\uC640 \uB0A8\uC740 \uAC80\uC99D \uC9C8\uBB38\uC744 \uB098\uB220
      \uC801\uC5C8\uB2E4. \uACF5\uB3D9\uCD9C\uC790 \uAC80\uD1A0\uB294 \uB2E4\uC74C
      \uB2E8\uACC4\uB85C \uC774\uC5B4\uC9C4\uB2E4. \uC790\uAE08\uC774 \uC790\uB3D9
      \uC9C0\uAE09\uB418\uAC70\uB098 \uC218\uC775\uC774 \uBCF4\uC7A5\uB41C \uAC83\uC740
      \uC544\uB2C8\uB2E4. \uB2E4\uC74C\uC5D0\uB294 \uC2E4\uC81C \uAC70\uB798\uB97C
      \uC9D1\uD589\uD55C \uAE30\uC5C5\uB4E4\uC758 \uD604\uC7AC \uC0AC\uC5C5\uACFC
      \uAE30\uB85D\uC744 \uC0B4\uD3B4\uBCF8\uB2E4."
    player: 0
    narration: 1
  - npcId: npc-broker-yoon-hajin
    text: "\uC5B4\uB5A4 \uBC29\uD5A5\uC73C\uB85C \uAC80\uD1A0\uD558\uC2E4\uC9C0 \uB9D0\uC500\uD574\uC8FC\uC2DC\uACA0\uC5B4\uC694?"
    player: 0
    narration: 0
  companyVariants: []
