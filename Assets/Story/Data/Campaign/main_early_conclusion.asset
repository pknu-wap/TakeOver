  - npcId:
    text: "APEX\uAC00 \uAD00\uC5EC\uD588\uB2E4\uB294 \uAC74 \uD655\uC778\uD588\uC2B5\uB2C8\uB2E4.
      \uC774\uC81C \uC2E4\uC81C\uB85C \uAC70\uB798\uB97C \uC9D1\uD589\uD55C \uD68C\uC0AC\uC5D0
      \uBB3C\uC744 \uCC28\uB840\uAD70\uC694."
    player: 1
    narration: 0
    scene: 0
  - npcId: npc-broker-yoon-hajin
    text: "\uC9C0\uAE08\uAE4C\uC9C0 \uB9CC\uB09C \uD68C\uC0AC\uB4E4\uC758 \uD604\uC7AC\uB3C4
      \uB0A8\uACA8\uB450\uACE0 \uAC00\uC138\uC694. \uB2E4\uC74C \uC0C1\uB300\uB97C
      \uCC3E\uC558\uB2E4\uACE0 \uB05D\uB09C \uD22C\uC790\uB294 \uC544\uB2C8\uB2C8\uAE4C\uC694."
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uCD9C\uC790\uC790\uB4E4\uC5D0\uAC8C \uBCF4\uB0BC \uBCF4\uACE0\uC11C\uC5D0\uB294
      \uD655\uC778\uD55C \uC5F0\uACB0\uACFC \uC544\uC9C1 \uB2F5\uC744 \uBABB \uBC1B\uC740
      \uC9C8\uBB38\uC744 \uB098\uB220 \uC801\uC5C8\uB2E4. \uC774\uC81C \uC9C1\uC811
      \uCC3E\uC544\uAC00 \uBB3C\uC744 \uC218 \uC788\uB294 \uAC70\uB798\uCC98\uAC00
      \uC0DD\uACBC\uB2E4."
    player: 0
    narration: 1
    scene: 0
  - npcId:
    text: "\uBBF8\uB798\uAC74\uC124\uC740 \uC7A5\uBE44\uB97C \uBABB \uBE90\uACE0,
      \uB3D9\uBC29\uC740 \uC62C \uBB3C\uB7C9\uC774 \uC5C6\uC5C8\uC2B5\uB2C8\uB2E4.
      \uD558\uB298\uC758 \uC815\uC0B0\uC774 \uBC00\uB9B0 \uAE30\uB85D\uD558\uACE0
      \uD55C\uC131\uC758 \uAC80\uC218\uAC00 \uBA48\uCD98 \uAE30\uB85D\uC5D0\uB3C4
      \uB2F5\uC744 \uAE30\uB2E4\uB9AC\uB77C\uB294 \uB9D0\uC774 \uB0A8\uC544 \uC788\uC5C8\uC5B4\uC694."
    player: 1
    narration: 0
    scene: 0
  - npcId: npc-investigative-reporter-jung-sua
    text: "\uADF8 \uAE30\uB2E4\uB9BC\uC744 \uBE44\uC6A9\uC73C\uB85C \uC801\uC740
      \uD68C\uC0AC\uB294 \uB137\uC774\uB124\uC694. \uC774\uC81C \uADF8\uC911 \uC5B4\uB290
      \uD1B5\uBCF4\uAC00 \uC5B4\uB514\uC11C \uB098\uC654\uB294\uC9C0 \uD558\uB098\uC529
      \uBB3C\uC744 \uC218 \uC788\uACA0\uC5B4\uC694. \uB2F5\uD55C \uC0AC\uB78C\uC774
      \uC11C\uBA85\uD55C \uBB38\uC11C\uAE4C\uC9C0 \uC774\uC5B4\uC9C0\uBA74 \uB354
      \uC88B\uACE0\uC694."
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uBCF4\uACE0\uC11C \uB9C8\uC9C0\uB9C9\uC5D0 \uAC00\uC871 \uD68C\uC0AC\uC758
      \uC774\uB984\uC744 \uC4F0\uB824\uB2E4\uAC00 \uD39C\uC744 \uB193\uC558\uB2E4.
      \uC624\uB298 \uB4E4\uC740 \uB124 \uD68C\uC0AC \uC774\uC57C\uAE30\uB97C \uAC01\uC790\uC758
      \uC774\uB984\uC73C\uB85C \uB0A8\uACA8\uB450\uACE0, \uB4A4\uC5D0 \uBD99\uC740
      \uAC70\uB798\uCC98\uBD80\uD130 \uB2E4\uC2DC \uB9CC\uB098\uAE30\uB85C \uD588\uB2E4."
    player: 0
    narration: 1
    scene: 0
  - npcId: npc-broker-yoon-hajin
    text: "\uC5F0\uB77D\uCC98\uB97C \uC54C\uC544\uBCFC \uC218\uB294 \uC788\uC5B4\uC694.
      \uC5B4\uB514\uBD80\uD130 \uCC3E\uC544\uBCFC\uAE4C\uC694?"
