  openingLines:
  - npcId: npc-haneul-food-cfo-oh-jaeseong
    text: "\uC0DD\uC0B0 \uC911\uB2E8 \uC2DC\uAC04\uC774 \uC774\uB9CC\uD07C \uB4E4\uC5B4\uAC00\uBA74
      \uCCAB \uACAC\uC801\uBCF4\uB2E4 \uBE44\uC2F8\uC9C0\uB124\uC694."
    player: 0
    narration: 0
    scene: 0
  - npcId: npc-hansung-industry-labor-director-choi-mijeong
    text: "\uC5C6\uB358 \uC2DC\uAC04\uC774 \uC0DD\uAE34 \uAC74 \uC544\uB2C8\uC5D0\uC694.
      \uB204\uAC00 \uB300\uC2E0 \uBC84\uD2F0\uB294\uC9C0 \uAC00\uACA9\uC5D0\uC11C
      \uBE60\uC838 \uC788\uC5C8\uB358 \uAC70\uC8E0."
    player: 0
    narration: 0
    scene: 0
  - npcId: npc-haneul-food-ceo-kim-harin
    text: "\uADF8 \uC2DC\uAC04\uC744 \uBE7C\uC11C \uC2FC \uAC70\uB77C\uBA74, \uC6B0\uB9AC\uB3C4
      \uB098\uC911\uC5D0 \uB2E4\uB978 \uD488\uC9C8\uB85C \uBC1B\uB294 \uAC70\uB124\uC694."
    player: 0
    narration: 0
    scene: 0
  - npcId: npc-investigative-reporter-jung-sua
    text: "APEX\uAC00 \uC0AC\uC5C5\uC5D0 \uAD00\uC5EC\uD588\uB2E4\uB294 \uC0AC\uC2E4\uACFC
      \uC2E4\uC81C \uB204\uAC00 \uACC4\uC57D\uC744 \uC704\uBC18\uD588\uB294\uC9C0\uB294
      \uAD6C\uBD84\uD574\uC57C \uD569\uB2C8\uB2E4. \uADF8\uCABD \uC2E4\uD589 \uAE30\uB85D\uC774
      \uB354 \uD544\uC694\uD574\uC694."
    player: 0
    narration: 0
    scene: 0
  - npcId: npc-institutional-investor-kim-taeseong
    text: "\uB9E4\uB9E4 \uC218\uC775\uACFC \uB300\uD45C\uC5D0\uAC8C \uB2E4\uC74C
      \uC6B4\uC6A9\uC744 \uB9E1\uAE38\uC9C0\uB294 \uB2E4\uB978 \uBB38\uC81C\uC785\uB2C8\uB2E4.
      \uC900\uBE44\uD55C \uAC80\uD1A0\uB97C \uB05D\uAE4C\uC9C0 \uC815\uB9AC\uD55C
      \uD22C\uC790 \uD310\uB2E8\uC73C\uB85C \uBCF4\uC5EC\uC8FC\uC138\uC694."
    player: 0
    narration: 0
    scene: 0
  - npcId: npc-hansung-industry-labor-director-choi-mijeong
    text: "\uAC80\uC218\uAC00 \uBC00\uB9B4 \uB54C \uB300\uAE30\uD560 \uC0AC\uB78C
      \uC774\uB984\uB3C4 \uBBF8\uB9AC \uC801\uC5C8\uC5B4\uC694. \uC608\uC804\uC5D4
      \uBAA8\uB450 \uADF8\uB0A0 \uB05D\uB09C\uB2E4\uACE0 \uC0DD\uAC01\uD574\uC11C
      \uAC19\uC740 \uC870\uC5D0 \uB2E4\uB978 \uB0A9\uD488\uAE4C\uC9C0 \uC7A1\uC558\uAC70\uB4E0\uC694."
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uC815\uC0B0 \uC790\uB8CC\uC5D0\uB3C4 \uBE44\uC2B7\uD558\uAC8C \uBE48
      \uB0A0\uC774 \uC788\uC5C8\uC2B5\uB2C8\uB2E4. \uC774\uBC88\uC5D0\uB294 \uC0C1\uB300
      \uB2F5\uC744 \uAE30\uB2E4\uB9AC\uB294 \uB3D9\uC548 \uB450 \uD68C\uC0AC\uAC00
      \uAC01\uAC01 \uC5B4\uB5A4 \uC77C\uC744 \uBBF8\uB904\uC57C \uD558\uB294\uC9C0
      \uC368\uB450\uC8E0."
    player: 1
    narration: 0
    scene: 0
  - npcId:
    text: "\uB2E4\uC2DC \uBBF8\uB798\uAC74\uC124\uACFC \uB3D9\uBC29\uBB3C\uC0B0\uC758
      \uC790\uB8CC\uB97C \uD3BC\uCCE4\uB2E4. \uC774\uBC88\uC5D0\uB294 \uB0A8\uC740
      \uBE44\uC6A9\uACFC \uC2E4\uC81C \uB4E4\uC5B4\uC62C \uBB3C\uB7C9\uC744 \uAC01
      \uD68C\uC0AC\uAC00 \uC5B4\uB5BB\uAC8C \uC815\uB9AC\uD588\uB294\uC9C0 \uBCFC
      \uCC28\uB840\uC600\uB2E4."
    player: 0
    narration: 1
    scene: 0
  companyVariants: []
