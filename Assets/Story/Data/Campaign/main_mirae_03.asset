  title: "\uBBF8\uB798\uAC74\uC124 \u2014 \uC900\uACF5 \uB4A4\uC758 \uC7A5\uBE44
    \uC784\uCC28\uB8CC"
  image: {fileID: 21300000, guid: e4f06f328acf53c4385995fb1f2c1e65, type: 3}
  cardImage: {fileID: 21300000, guid: d04aa39026668454991718ef00702904, type: 3}
  npcArts: []
  highlightImage: {fileID: 0}
  negotiationBackground: {fileID: 0}
  description: "\uAC15\uC900\uD601\uC740 \uC900\uACF5\uC73C\uB85C \uD604\uC7A5 \uC77C\uC774
    \uB05D\uB0AC\uB2E4\uACE0 \uC0DD\uAC01\uD588\uB2E4. \uBC15\uB3C4\uC2DD\uC740 \uADF8
    \uB4A4\uB85C\uB3C4 \uC7A5\uBE44\uB97C \uBE7C\uC9C0 \uBABB\uD588\uB2E4\uACE0 \uD55C\uB2E4.
    \uC778\uC218\uC778\uACC4\uAC00 \uBA48\uCD98 \uB0A0\uBD80\uD130 \uCCAD\uAD6C\uC11C\uB97C
    \uB2E4\uC2DC \uB9DE\uCDB0\uBCF4\uC790."
  apCost: 0
  startButtonText: "\uB9CC\uB098\uAE30"
  companyIds:
  - mirae-construction
  speakerNpcId: npc-mirae-construction-cfo-seo-jia
  speakerName: "\uC11C\uC9C0\uC544"
  speakerRole:
  dialogue: "\uB3D9\uBC29 \uCABD\uB3C4 \uBCF4\uC2E0\uB2E4\uC9C0\uC694. \uC6B0\uB9AC
    \uACF5\uC0AC\uAC00 \uB05D\uB098\uBA74 \uADF8\uCABD \uC6B4\uC601\uC774 \uC2DC\uC791\uB420
    \uAC70\uB77C\uB358 \uB54C\uAC00 \uC788\uC5C8\uC2B5\uB2C8\uB2E4. \uB09C \uACF5\uC0AC\uB9CC
    \uB05D\uB0B4\uBA74 \uC6B0\uB9AC \uC77C\uC740 \uB05D\uC778 \uC904 \uC54C\uC558\uC18C."
  companyQuestion:
  companyPlayerLine:
  choices:
  - choiceText: "\uB0A8\uC740 \uC815\uB9AC \uBE44\uC6A9\uBD80\uD130 \uB098\uB208\uB2E4"
    choiceDescription:
    playerLine: "\uB05D\uB09C \uD604\uC7A5\uC5D0\uC11C \uC544\uC9C1 \uB098\uAC08
      \uB3C8\uBD80\uD130 \uB530\uB85C \uBCF4\uC8E0. \uC0C8 \uACF5\uC0AC \uC218\uC775\uC73C\uB85C
      \uBA54\uC6B8 \uC218 \uC788\uB2E4\uACE0 \uC7A1\uC9C0\uB294 \uB9D0\uC544\uC8FC\uC2ED\uC2DC\uC624."
    resultDialogue: "\uADF8\uAC8C \uB9DE\uC544\uC694. \uC815\uB9AC \uBE44\uC6A9\uC744
      \uAC00\uB824\uB193\uC73C\uBA74 \uB2E4\uC74C \uD604\uC7A5\uB3C4 \uAC19\uC740
      \uBD80\uB2F4\uC744 \uB5A0\uC548\uAC8C \uB418\uB2C8\uAE4C\uC694. \uC9C0\uAE09
      \uC2DC\uAE30\uBD80\uD130 \uB098\uB220\uBCFC\uAC8C\uC694."
    resultValue: answer_0
