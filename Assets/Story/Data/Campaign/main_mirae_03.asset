  title: "\uB05D\uB0B8 \uACF5\uC0AC\uB294 \uC65C \uB05D\uB098\uC9C0 \uC54A\uC558\uB098"
  image: {fileID: 21300000, guid: e4f06f328acf53c4385995fb1f2c1e65, type: 3}
  cardImage: {fileID: 21300000, guid: d04aa39026668454991718ef00702904, type: 3}
  npcArts: []
  highlightImage: {fileID: 0}
  negotiationBackground: {fileID: 0}
  description: "\uB05D\uB0B8 \uACF5\uC0AC\uB294 \uC65C \uB05D\uB098\uC9C0 \uC54A\uC558\uB098\uC5D0
    \uAD00\uD55C \uBA74\uB2F4 \uC694\uCCAD\uC785\uB2C8\uB2E4. \uB0B4\uC6A9\uACFC
    \uBE44\uC6A9\uC744 \uD655\uC778\uD55C \uB4A4 \uB9CC\uB098\uC2ED\uC2DC\uC624."
  apCost: 0
  startButtonText: "\uB9CC\uB098\uAE30"
  companyIds:
  - mirae-construction
  speakerNpcId: npc-mirae-construction-cfo-seo-jia
  speakerName: "\uC11C\uC9C0\uC544"
  speakerRole:
  dialogue: "\uB3D9\uBC29 \uCABD\uB3C4 \uBCF4\uC2E0\uB2E4\uC9C0\uC694. \uC6B0\uB9AC
    \uACF5\uC0AC\uAC00 \uB05D\uB098\uBA74 \uADF8\uCABD \uC6B4\uC601\uC774 \uC2DC\uC791\uB420
    \uAC70\uB77C\uB358 \uB54C\uAC00 \uC788\uC5C8\uC2B5\uB2C8\uB2E4. \uB09C \uACF5\uC0AC\uB9CC
    \uB05D\uB0B4\uBA74 \uC6B0\uB9AC \uC77C\uC740 \uB05D\uC778 \uC904 \uC54C\uC558\uC18C."
  companyQuestion:
  companyPlayerLine:
  choices:
  - choiceText: "\uC794\uC5EC \uC815\uB9AC \uBE44\uC6A9\uC744 \uBA3C\uC800 \uBD84\uB9AC\uD55C\uB2E4"
    choiceDescription: "\uC774\uBC88 \uB300\uD654\uC758 \uC120\uD0DD\uACFC \uAD00\uCC30
      \uC0AC\uC2E4\uC744 \uAE30\uB85D\uD569\uB2C8\uB2E4. \uD604\uAE08\xB7\uC9C0\uBD84
      \uBCC0\uD654 \uC5C6\uC74C."
    playerLine: "\uC794\uC5EC \uC815\uB9AC \uBE44\uC6A9\uC744 \uBA3C\uC800 \uBD84\uB9AC\uD55C\uB2E4"
    resultDialogue: "\uB124. \uC9C0\uAE08 \uB0A8\uC740 \uBD80\uB2F4\uACFC \uC0C8
      \uC218\uC8FC\uC5D0\uC11C \uAE30\uB300\uD558\uB294 \uC218\uC775\uC744 \uB530\uB85C
      \uC815\uB9AC\uD560\uAC8C\uC694."
    resultValue: answer_0
    npcResult:
      eventId:
      companyId:
      actorId:
      actionId:
