  - npcId: npc-mirae-construction-cfo-seo-jia
    text: "\uC900\uACF5 \uCC98\uB9AC\uC640 \uB3C8\uC774 \uC815\uB9AC\uB418\uB294
      \uB0A0\uC740 \uB2EC\uB790\uC5B4\uC694. \uD604\uC7A5\uC744 \uB118\uAE34 \uB4A4\uC5D0
      \uB0A8\uC740 \uC7A5\uBE44\uC640 \uC791\uC5C5\uC744 \uB204\uAC00 \uBD80\uB2F4\uD560\uC9C0\uAC00
      \uACC4\uC18D \uBC14\uB00C\uC5C8\uC8E0."
    player: 0
    narration: 0
    scene: 0
  - npcId: npc-mirae-construction-field-director-park-dosik
    text: "\uC0AC\uB78C\uC740 \uCCA0\uC218\uD588\uB294\uB370 \uC7A5\uBE44\uB97C \uBABB
      \uBE90\uC2B5\uB2C8\uB2E4. \uBC1B\uC744 \uC0AC\uB78C\uC774 \uC5C6\uC5C8\uC73C\uB2C8\uAE4C\uC694.
      \uC77C \uB05D\uB0AC\uB2E4\uACE0 \uC885\uC774 \uD55C \uC7A5 \uBC1B\uC73C\uBA74
      \uC7A5\uBE44\uB3C4 \uC800\uC808\uB85C \uB098\uC624\uB294 \uC904 \uC544\uB294
      \uC0AC\uB78C\uC774 \uB9CE\uC544\uC694."
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uC6B4\uC601\uD558\uB294 \uCABD\uC774 \uC548 \uBC1B\uC558\uC2B5\uB2C8\uAE4C?"
    player: 1
    narration: 0
    scene: 0
  - npcId: npc-mirae-construction-field-director-park-dosik
    text: "\uADF8\uCABD\uB3C4 \uC544\uC9C1 \uBC1B\uC73C\uB780 \uD1B5\uBCF4\uAC00
      \uC5C6\uB2E4\uACE0 \uD588\uC2B5\uB2C8\uB2E4. \uB204\uAD6C \uC798\uBABB\uC778\uC9C0
      \uBB3B\uAE30 \uC804\uC5D0, \uADF8\uB0A0 \uB204\uAD6C\uD55C\uD14C \uBB58 \uB4E4\uC5C8\uB294\uC9C0\uBD80\uD130
      \uC801\uC5B4\uC57C \uD569\uB2C8\uB2E4."
    player: 0
    narration: 0
    scene: 0
  - npcId: npc-mirae-construction-ceo-kang-junhyeok
    text: "\uADF8\uB798\uC11C \uC0C8 \uACF5\uC0AC\uBD80\uD130 \uB530\uC790\uB294
      \uB9D0\uC774 \uB9C8\uC74C \uD3B8\uD588\uC744\uC9C0\uB3C4 \uBAA8\uB974\uACA0\uC18C.
      \uB05D\uB09C \uAC83 \uBD99\uC7A1\uACE0 \uC788\uB290\uB2C8 \uC55E\uC73C\uB85C
      \uAC00\uC790\uACE0."
    player: 0
    narration: 0
    scene: 0
  - npcId: npc-mirae-construction-cfo-seo-jia
    text: "\uC55E\uC73C\uB85C \uAC00\uB294 \uB3C8\uC73C\uB85C \uB4A4\uB97C \uACC4\uC18D
      \uBA54\uC6B0\uBA74, \uB2E4\uC74C \uACF5\uC0AC\uB3C4 \uAC19\uC740 \uC790\uB9AC\uC5D0\uC11C
      \uC2DC\uC791\uD574\uC694."
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uC774\uBC88\uC5D0\uB294 \uB0A8\uC740 \uC815\uB9AC \uBE44\uC6A9\uACFC
      \uC0C8 \uC218\uC8FC\uC758 \uC218\uC775\uC744 \uB098\uB220\uBCF4\uC8E0. \uB3D9\uBC29\uC758
      \uB2F9\uC2DC \uC778\uC218\uC778\uACC4 \uC124\uBA85\uB3C4 \uAC19\uC740 \uB0A0\uC9DC\uB85C
      \uD655\uC778\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    player: 1
