  - choiceText: "\uC77C\uC815\uACFC \uBE44\uC6A9\uC744 \uB2E4\uC2DC \uB4E3\uB294\uB2E4"
    choiceDescription:
    playerLine: "\uD68C\uC0AC\uC5D0\uC11C \uCC45\uC784\uC9C8 \uC77C\uC815\uACFC \uC8FC\uC8FC\uAC00
