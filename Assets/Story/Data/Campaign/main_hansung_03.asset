  title: "\uD55C\uC131\uACF5\uC5C5 \u2014 \uB2E4\uC74C \uAD50\uB300\uC870\uC758 \uCCAB
    \uC0DD\uC0B0"
  image: {fileID: 21300000, guid: e4f06f328acf53c4385995fb1f2c1e65, type: 3}
  cardImage: {fileID: 21300000, guid: d04aa39026668454991718ef00702904, type: 3}
  npcArts: []
  highlightImage: {fileID: 0}
  negotiationBackground: {fileID: 0}
  description: "\uC870\uBBFC\uC11D\uC774 \uB3C4\uBA74\uC5D0 \uCE58\uC218\uB97C \uBC14\uAFBC
    \uC774\uC720\uAE4C\uC9C0 \uC801\uC5B4\uB480\uB2E4. \uADF8 \uB3C4\uBA74\uC73C\uB85C
    \uB2E4\uB978 \uAD50\uB300\uC870\uAC00 \uC2E4\uC81C\uB85C \uAC19\uC740 \uBD80\uD488\uC744
    \uB9CC\uB4E4 \uC218 \uC788\uB294\uC9C0, \uB0A9\uAE30 \uC804\uC5D0 \uBCFC \uC218
    \uC788\uC744\uAE4C."
  apCost: 0
  startButtonText: "\uB9CC\uB098\uAE30"
  companyIds:
  - hansung-industry
  speakerNpcId: npc-hansung-industry-labor-director-choi-mijeong
  speakerName: "\uCD5C\uBBF8\uC815"
  speakerRole:
  dialogue: "\uC774 \uCE58\uC218\uB97C \uC65C \uBC14\uAFE8\uB294\uC9C0 \uC801\uC73C\uB824\uB2C8
    \uB0B4\uAC00 \uCC98\uC74C\uBD80\uD130 \uB2E4\uC2DC \uC124\uBA85\uD574\uC57C \uD558\uB354\uAD70\uC694."
  companyQuestion:
  companyPlayerLine:
  choices:
  - choiceText: "\uC804\uC218\uB97C \uD655\uC778\uD55C \uB4A4 \uC804\uD658\uD55C\uB2E4"
    choiceDescription:
    playerLine: "\uB2E4\uC74C \uC0AC\uB78C\uC774 \uAC19\uC740 \uD488\uC9C8\uB85C
      \uB9CC\uB4E4 \uC218 \uC788\uB294\uC9C0 \uD655\uC778\uD55C \uB4A4\uC5D0 \uC0DD\uC0B0\uC744
      \uC62E\uAE30\uC8E0. \uB204\uAC00 \uBB34\uC5C7\uC744 \uD574\uBCFC\uC9C0 \uACC4\uD68D\uC5D0
      \uB123\uC5B4\uC8FC\uC2ED\uC2DC\uC624."
    resultDialogue: "\uC606\uC5D0\uC11C \uBD24\uB2E4\uACE0 \uBC30\uC6E0\uB2E4\uACE0
      \uCE58\uC9C0\uB294 \uC54A\uC744\uAC8C\uC694. \uC9C1\uC811 \uB9CC\uB4E4\uACE0
      \uACE0\uCCD0\uBCFC \uC2DC\uAC04\uC744 \uB0A8\uACA8\uB450\uACA0\uC2B5\uB2C8\uB2E4."
    resultValue: answer_0
    npcResult:
