  - choiceText: "\uB0A9\uAE30\uC640 \uC804\uC218\uB97C \uD568\uAED8 \uC810\uAC80\uD55C\uB2E4"
    choiceDescription:
    playerLine: "\uB0A9\uAE30\uB97C \uC9C0\uD0A4\uBA74\uC11C \uAC00\uB974\uCE60 \uC2DC\uAC04\uC774
      \uC2E4\uC81C\uB85C \uB0A8\uC2B5\uB2C8\uAE4C? \uC77C\uC774 \uB05D\uB09C \uB4A4\uC5D0
      \uC54C\uC544\uC11C \uD558\uB77C\uB294 \uACC4\uD68D\uC740 \uD53C\uD558\uACE0
      \uC2F6\uC2B5\uB2C8\uB2E4."
    resultDialogue: "\uADF8\uB807\uAC8C \uC7A1\uC73C\uBA74 \uB298 \uBC30\uC6B8 \uC2DC\uAC04\uC774
      \uBA3C\uC800 \uC0AC\uB77C\uC838\uC694. \uC804\uC218 \uC2DC\uAC04\uC744 \uC77C\uC815\uC5D0
      \uB123\uACE0, \uBE60\uC9C0\uBA74 \uC5B4\uB290 \uB0A9\uAE30\uC640 \uBD80\uB52A\uD788\uB294\uC9C0
      \uBCF4\uC5EC\uB4DC\uB9B4\uAC8C\uC694."
