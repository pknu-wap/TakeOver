  - npcId: npc-hansung-industry-labor-director-choi-mijeong
    text: "\uADF8 \uC124\uBA85\uC744 \uB4E4\uC744 \uC2DC\uAC04\uC744 \uC7A1\uB294
      \uAC8C \uC774\uBC88 \uACC4\uD68D\uC774\uC5D0\uC694. \uC77C \uB05D\uB098\uACE0
      \uB0A8\uB294 \uC2DC\uAC04 \uB9D0\uACE0\uC694."
    player: 0
    narration: 0
    scene: 0
  - npcId: npc-hansung-industry-labor-director-choi-mijeong
    text: "\uC608\uC804\uC5D4 \uAC80\uC218 \uC77C\uC815\uC774 \uBBF8\uB904\uC9C8
      \uB54C\uB9C8\uB2E4 \uB300\uD45C\uB2D8\uB9CC \uB2E4\uC2DC \uBD88\uB800\uC5B4\uC694.
      \uACB0\uAD6D \uADF8\uBD84\uC774 \uB9E1\uB358 \uB2E4\uB978 \uB77C\uC778 \uC0AC\uB78C\uB4E4\uC740
      \uC774\uC720\uB3C4 \uBAA8\uB974\uACE0 \uAE30\uB2E4\uB838\uACE0\uC694."
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uC774\uBC88\uC5D4 \uB300\uD45C\uB2D8 \uC5C6\uC774 \uB2E4\uC74C \uC870\uAC00
      \uC2DC\uD5D8 \uC0DD\uC0B0\uC744 \uD558\uBA74 \uC5B4\uB5BB\uC2B5\uB2C8\uAE4C?
      \uCE58\uC218\uAC00 \uC5B4\uAE0B\uB0AC\uC744 \uB54C \uB3C4\uBA74\uC5D0\uC11C
      \uC5B4\uB514\uB85C \uB3CC\uC544\uAC00\uB294\uC9C0\uB3C4 \uBCF4\uBA74 \uC88B\uACA0\uC2B5\uB2C8\uB2E4."
    player: 1
    narration: 0
    scene: 0
  - npcId: npc-hansung-industry-ceo-jo-minseok
    text: "\uADF8\uB7EC\uC9C0\uC694. \uB9C8\uC9C0\uB9C9 \uACF5\uCC28\uB97C \uC190\uC73C\uB85C
      \uB9DE\uCDC4\uB358 \uC774\uC720\uBD80\uD130 \uC801\uACA0\uC2B5\uB2C8\uB2E4.
      \uB2E4\uC74C \uC870\uAC00 \uAC70\uAE30\uC11C \uB9C9\uD788\uBA74, \uB0A9\uAE30\uB97C
      \uC7A1\uAE30 \uC804\uC5D0 \uB0B4\uAC00 \uD560 \uC77C\uC774 \uBCF4\uC774\uACA0\uC18C."
    player: 0
    narration: 0
    scene: 0
  - npcId: npc-hansung-industry-labor-director-choi-mijeong
    text: "\uB2E4\uC74C \uC870\uAC00 \uC9C1\uC811 \uB9CC\uB4DC\uB294 \uC2DC\uAC04\uC744
      \uADFC\uBB34\uD45C\uC5D0 \uB123\uC5B4\uB480\uC2B5\uB2C8\uB2E4. \uADF8\uB0A0\uC740
      \uB2E4\uB978 \uC8FC\uBB38\uBD80\uD130 \uB35C \uBC1B\uC544\uC57C \uD569\uB2C8\uB2E4.
      \uC601\uC5C5 \uCABD\uC5D0\uB3C4 \uC774\uBBF8 \uC598\uAE30\uD588\uACE0\uC694."
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uADF8\uB7EC\uBA74 \uB2F9\uC7A5\uC740 \uC0DD\uC0B0 \uC2DC\uAC04\uC774
      \uC904\uACA0\uAD70\uC694."
    player: 1
    narration: 0
    scene: 0
  - npcId: npc-hansung-industry-ceo-jo-minseok
    text: "\uC904\uC5B4\uB4ED\uB2C8\uB2E4. \uADF8\uB798\uB3C4 \uB098 \uD558\uB098
      \uBE44\uBA74 \uBA48\uCD94\uB294 \uD68C\uC0AC\uB97C \uAE30\uC220 \uC788\uB2E4\uACE0
