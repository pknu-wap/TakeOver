  speakerNpcId: npc-dongbang-trading-ceo-kang-jaehyeon
  speakerName: "\uAC15\uC7AC\uD604"
  speakerRole:
  dialogue: "\uC624\uC168\uC2B5\uB2C8\uAE4C. \uC124\uBA85\uC740 \uBCF4\uBA74\uC11C
    \uD558\uC8E0. \uC5EC\uAE30 \uC549\uC544\uC11C \uC5F4 \uC7A5 \uC77D\uB294 \uAC83\uBCF4\uB2E4
    \uD55C \uBC88 \uBCF4\uB294 \uAC8C \uBE60\uB985\uB2C8\uB2E4."
  companyQuestion:
  companyPlayerLine:
  choices:
  - choiceText: "\uD604\uC7AC \uC0AC\uC5C5\uACFC \uACFC\uAC70 \uC190\uC2E4\uC744
      \uD568\uAED8 \uBCF8\uB2E4"
    choiceDescription: "\uC774\uBC88 \uB300\uD654\uC758 \uC120\uD0DD\uACFC \uAD00\uCC30
      \uC0AC\uC2E4\uC744 \uAE30\uB85D\uD569\uB2C8\uB2E4. \uD604\uAE08\xB7\uC9C0\uBD84
      \uBCC0\uD654 \uC5C6\uC74C."
    playerLine: "\uD604\uC7AC \uC0AC\uC5C5\uACFC \uACFC\uAC70 \uC190\uC2E4\uC744
      \uD568\uAED8 \uBCF8\uB2E4"
    resultDialogue: "\uC88B\uC2B5\uB2C8\uB2E4. \uACFC\uAC70\uC5D0 \uB2F9\uD588\uB2E4\uB294
      \uC124\uBA85\uC73C\uB85C \uB05D\uB0B4\uC9C0\uB294 \uC54A\uACA0\uC18C. \uC9C0\uAE08\uC740
      \uBB34\uC5C7\uC774 \uB2EC\uB77C\uC84C\uB294\uC9C0\uC640 \uB2E4\uC74C \uD22C\uC790
      \uBE44\uC6A9\uC744 \uD568\uAED8 \uBCF4\uC2DC\uC8E0."
    resultValue: answer_0
    npcResult:
