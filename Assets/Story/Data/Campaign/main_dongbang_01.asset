  openingLines:
  - npcId:
    text: "\uC2DC\uC5F0 \uAD6C\uC5ED\uC5D0 \uB4E4\uC5B4\uAC00\uAE30 \uC804\uC5D0
      \uCD9C\uC785\uC120\uC744 \uC548\uB0B4\uBC1B\uC558\uB2E4. \uAC15\uC7AC\uD604\uC740
      \uC2DC\uACC4\uB97C \uD55C \uBC88 \uBCF4\uACE0 \uC790\uB8CC\uB97C \uB36E\uC5C8\uB2E4.
