    player: 0
    narration: 1
  - npcId: npc-dongbang-trading-ceo-kang-jaehyeon
    text: "\uC624\uC168\uC2B5\uB2C8\uAE4C. \uC124\uBA85\uC740 \uBCF4\uBA74\uC11C
      \uD558\uC8E0. \uC5EC\uAE30 \uC549\uC544\uC11C \uC5F4 \uC7A5 \uC77D\uB294 \uAC83\uBCF4\uB2E4
      \uD55C \uBC88 \uBCF4\uB294 \uAC8C \uBE60\uB985\uB2C8\uB2E4."
    player: 0
    narration: 0
  - npcId: npc-dongbang-trading-hr-director-park-minu
    text: "\uC120\uC740 \uB118\uC9C0 \uB9D0\uC544\uC8FC\uC138\uC694. \uB300\uD45C\uB2D8
      \uC124\uBA85\uC774 \uBE68\uB77C\uC838\uB3C4 \uBC1C\uAC78\uC74C\uAE4C\uC9C0
      \uB530\uB77C\uAC00\uC2E4 \uD544\uC694\uB294 \uC5C6\uC2B5\uB2C8\uB2E4."
    player: 0
    narration: 0
  - npcId: npc-dongbang-trading-ceo-kang-jaehyeon
    text: "\uB0B4\uAC00 \uADF8\uB807\uAC8C \uBE60\uB985\uB2C8\uAE4C?"
    player: 0
    narration: 0
  - npcId: npc-dongbang-trading-hr-director-park-minu
    text: "\uC548\uB0B4 \uB3D9\uC120\uBCF4\uB2E4 \uBA3C\uC800 \uAC00\uC2E4 \uB54C\uAC00
      \uC788\uC8E0. \uBC29\uBB38\uAC1D\uD55C\uD14C\uB294 \uC81C\uAC00 \uCC9C\uCC9C\uD788
      \uBCF4\uC2DC\uB77C\uACE0 \uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
    player: 0
    narration: 0
  - npcId:
    text: "\uB450 \uBD84 \uC5ED\uD560\uC774 \uD655\uC2E4\uD558\uAD70\uC694."
    player: 1
    narration: 0
  - npcId: npc-dongbang-trading-ceo-kang-jaehyeon
    text: "\uC800\uB294 \uC804\uCCB4\uAC00 \uC5BC\uB9C8\uB098 \uBE68\uB77C\uC9C0\uB294\uC9C0
      \uBD05\uB2C8\uB2E4. \uBBFC\uC6B0 \uC528\uB294 \uADF8 \uC18D\uB3C4\uB85C \uC0AC\uB78C\uB4E4\uC774
      \uB530\uB77C\uC624\uB294\uC9C0 \uBCF4\uACE0\uC694. \uB458 \uB2E4 \uC548 \uB9DE\uC73C\uBA74
      \uBB3C\uAC74\uC774 \uC548 \uB098\uAC00\uC8E0."
    player: 0
    narration: 0
  - npcId:
    text: "\uC0C1\uC790\uAC00 \uC9C0\uB098\uAC08 \uB54C\uB9C8\uB2E4 \uD654\uBA74\uC758
      \uC22B\uC790\uAC00 \uBC14\uB00C\uC5C8\uB2E4. \uB300\uBD80\uBD84\uC740 \uBA48\uCDA4
      \uC5C6\uC774 \uD758\uB7EC\uAC14\uC9C0\uB9CC \uD55C \uC0C1\uC790\uAC00 \uC606
      \uAD6C\uC5ED\uC73C\uB85C \uBE60\uC84C\uB2E4."
    player: 0
    narration: 1
  - npcId:
    text: "\uC800\uAC74 \uC5B4\uB514\uB85C \uAC00\uB294 \uAC81\uB2C8\uAE4C?"
    player: 1
    narration: 0
  - npcId: npc-dongbang-trading-hr-director-park-minu
    text: "\uC608\uC678 \uCC98\uB9AC \uCABD\uC774\uC694. \uBC14\uCF54\uB4DC\uAC00
      \uC811\uD788\uAC70\uB098 \uD3EC\uC7A5\uC774 \uB2E4\uB974\uBA74 \uC0AC\uB78C\uC774
      \uD655\uC778\uD569\uB2C8\uB2E4. \uC624\uB298 \uC81C\uC77C \uB208\uC5D0 \uB744\uB294
      \uC0C1\uC790\uAC00 \uD558\uD544 \uC800\uAE30 \uAC14\uB124\uC694."
    player: 0
    narration: 0
  - npcId: npc-dongbang-trading-ceo-kang-jaehyeon
    text: "\uC800\uB7F0 \uBE44\uC728\uC744 \uC904\uC774\uB294 \uAC8C \uC790\uB3D9\uD654\uC758
      \uD6A8\uACFC\uC785\uB2C8\uB2E4. \uB9E4\uBC88 \uC0AC\uB78C\uC774 \uB2E4 \uD655\uC778\uD560
      \uB54C\uBCF4\uB2E4 \uC804\uCCB4\uAC00 \uBE68\uB77C\uC9C0\uC8E0."
    player: 0
    narration: 0
  - npcId:
    text: "\uB9C8\uC9C0\uB9C9 \uD55C \uC0C1\uC790\uAC00 \uB2A6\uC73C\uBA74 \uADF8
      \uC8FC\uBB38\uC740 \uC544\uC9C1 \uC548 \uB05D\uB09C \uAC70\uAD70\uC694."
    player: 1
    narration: 0
  - npcId: npc-dongbang-trading-ceo-kang-jaehyeon
    text: "\uB9DE\uC2B5\uB2C8\uB2E4. \uADF8\uB798\uC11C \uC608\uC678\uB97C \uC904\uC5EC\uC57C\uC8E0.
      \uB290\uB9B0 \uBA87 \uAC74 \uB54C\uBB38\uC5D0 \uC804\uCCB4 \uC124\uBE44\uB97C
      \uB290\uB9AC\uAC8C \uB3CC\uB9B4 \uC218\uB294 \uC5C6\uC5B4\uC694."
    player: 0
    narration: 0
  - npcId: npc-dongbang-trading-hr-director-park-minu
    text: "\uB2E4\uB9CC \u2018\uC0AC\uB78C\uC774 \uBCF4\uBA74 \uB41C\uB2E4\u2019\uACE0
      \uC801\uC5B4\uB450\uBA74 \uADF8 \uC0AC\uB78C \uC77C\uC774 \uD45C\uC5D0\uC11C
      \uBE60\uC9C0\uAE30 \uC27D\uC2B5\uB2C8\uB2E4. \uD3C9\uC18C\uC5D0\uB294 \uB418\uB294\uB370
      \uBAB0\uB9B4 \uB54C\uB294 \uADF8\uCABD \uC904\uC774 \uAE38\uC5B4\uC838\uC694."
    player: 0
    narration: 0
  - npcId: npc-dongbang-trading-ceo-kang-jaehyeon
    text: "\uADF8\uB798\uC11C \uBC14\uC05C \uC2DC\uAC04\uB300 \uC790\uB8CC\uB3C4
      \uAC19\uC774 \uBCF4\uACE0 \uC788\uC796\uC2B5\uB2C8\uAE4C. \uB0B4\uAC00 \uD3C9\uADE0\uB9CC
      \uBCF4\uC5EC\uB4DC\uB9AC\uB77C\uACE0 \uD558\uC9C4 \uC54A\uC558\uC744 \uD150\uB370."
    player: 0
    narration: 0
  - npcId: npc-dongbang-trading-hr-director-park-minu
    text: "\uB124. \uC624\uB298 \uC790\uB8CC \uB4A4\uCABD\uC5D0 \uB123\uC5C8\uC2B5\uB2C8\uB2E4.
      \uB300\uD45C\uB2D8\uAED8\uC11C \uC55E\uC7A5 \uB118\uAE30\uC2DC\uB294 \uC18D\uB3C4\uAC00
      \uBE68\uB77C\uC11C \uC81C\uAC00 \uBD99\uC7A1\uC544\uC57C \uD560 \uBFD0\uC774\uC8E0."
    player: 0
    narration: 0
  - npcId:
    text: "\uAC15\uC7AC\uD604\uC774 \uD45C\uB97C \uB2E4\uC2DC \uD3C8\uB2E4. \uBC18\uBC15\uC744
      \uD53C\uD558\uB824\uB294 \uD45C\uC815\uBCF4\uB2E4\uB294 \uB354 \uC815\uD655\uD55C
      \uACB0\uACFC\uB97C \uC694\uAD6C\uD558\uB294 \uCABD\uC5D0 \uAC00\uAE4C\uC6E0\uB2E4."
    player: 0
    narration: 1
  - npcId: npc-dongbang-trading-ceo-kang-jaehyeon
    text: "\uC88B\uC2B5\uB2C8\uB2E4. \uBB58 \uBCF4\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?
      \uC124\uBE44 \uCC98\uB9AC\uB7C9, \uC8FC\uBB38 \uC644\uB8CC \uC2DC\uAC04, \uC0AC\uB78C
      \uD22C\uC785. \uD55C\uAEBC\uBC88\uC5D0 \uC88B\uC544\uC9C0\uBA74 \uC88B\uACA0\uC9C0\uB9CC
      \uCC98\uC74C\uC5D0\uB294 \uB2E4\uB974\uAC8C \uC6C0\uC9C1\uC785\uB2C8\uB2E4."
    player: 0
    narration: 0
  - npcId: npc-dongbang-trading-ceo-kang-jaehyeon
    text: "\uACFC\uAC70 \uC6B4\uC601 \uAC70\uC810\uB3C4 \uBB3C\uC5B4\uBCF4\uC168\uC8E0.
      \uBA3C\uC800 \uB9D0\uD558\uACA0\uC2B5\uB2C8\uB2E4. \uADF8\uB54C \uC190\uD574\uB97C
      \uBD24\uB2E4\uACE0 \uC9C0\uAE08\uB3C4 \uAC19\uC740 \uD68C\uC0AC\uB294 \uC544\uB2D9\uB2C8\uB2E4.
      \uC9C0\uAE08 \uC218\uC775\uACFC \uC6B4\uC601\uBD80\uD130 \uBCF4\uC154\uC57C
      \uD569\uB2C8\uB2E4."
    player: 0
    narration: 0
  - npcId:
    text: "\uADF8\uB798\uC11C \uD604\uC7AC \uC790\uB8CC\uB3C4 \uBCF4\uACE0 \uC788\uC2B5\uB2C8\uB2E4.
      \uACE0\uAC1D\uC744 \uB098\uB204\uACE0 \uD655\uC7A5\uC744 \uC11C\uB450\uB974\uB294
      \uC774\uC720\uC5D0 \uADF8\uB54C \uC77C\uC774 \uC5BC\uB9C8\uB098 \uB0A8\uC558\uB294\uC9C0
      \uC54C\uACE0 \uC2F6\uC2B5\uB2C8\uB2E4."
    player: 1
    narration: 0
  - npcId: npc-dongbang-trading-ceo-kang-jaehyeon
    text: "\uB0A8\uC758 \uBB3C\uB7C9 \uACC4\uD68D\uC744 \uBBFF\uACE0 \uC124\uBE44\uB97C
      \uB9DE\uCDC4\uC2B5\uB2C8\uB2E4. \uC815\uD574\uC9C4 \uAE30\uAC04\uAE4C\uC9C0
      \uB3CC\uB9B4 \uAC70\uB77C\uACE0 \uBD24\uC8E0. \uB9C9\uC0C1 \uBB3C\uB7C9\uC774
      \uC904\uC790 \uCC45\uC784\uC740 \uB2E4\uB978 \uCC3D\uAD6C\uD558\uACE0 \uC774\uC57C\uAE30\uD558\uB77C\uACE0
      \uD558\uB354\uAD70\uC694. \uADF8 \uB4A4\uB85C \uD55C \uC0C1\uB300\uC758 \uB9D0\uB9CC
      \uBCF4\uACE0 \uC18D\uB3C4\uB97C \uB9DE\uCD94\uC9C0\uB294 \uC54A\uC2B5\uB2C8\uB2E4."
    player: 0
    narration: 0
  - npcId: npc-dongbang-trading-hr-director-park-minu
    text: "\uBC14\uB010 \uAC74 \uD68C\uC0AC \uBC29\uD5A5\uB9CC\uC774 \uC544\uB2C8\uC5D0\uC694.
      \uADF8 \uAC70\uC810\uC5D0 \uB9DE\uCDB0 \uC77C\uC744 \uC62E\uAE34 \uC0AC\uB78C\uB4E4\uB3C4
      \uC788\uC5C8\uC2B5\uB2C8\uB2E4. \uC0AC\uC5C5\uC774 \uC904\uBA74 \uB2E4\uB978
      \uC790\uB9AC\uB85C \uB3CC\uB9AC\uBA74 \uB41C\uB2E4\uACE0 \uD588\uC9C0\uB9CC,
      \uBAA8\uB4E0 \uC0AC\uB78C\uC774 \uAC19\uC740 \uB0A0 \uC62E\uAE38 \uC218\uB294
      \uC5C6\uC5C8\uC5B4\uC694."
    player: 0
    narration: 0
  - npcId:
    text: "\uBB3C\uB7C9\uC774 \uC904\uC5B4\uB4E0 \uAC8C \uC6B4\uC601 \uBB38\uC81C
      \uB54C\uBB38\uC740 \uC544\uB2C8\uC5C8\uC2B5\uB2C8\uAE4C?"
    player: 1
    narration: 0
  - npcId: npc-dongbang-trading-ceo-kang-jaehyeon
    text: "\uC6B0\uB9AC\uB3C4 \uBD80\uC871\uD55C \uAC8C \uC788\uC5C8\uC8E0. \uD558\uC9C0\uB9CC
      \uC5EC\uAE30\uC11C \uAC1C\uC120\uD55C\uB2E4\uACE0 \uB3CC\uC544\uC62C \uBB3C\uB7C9\uC740
      \uC544\uB2C8\uC5C8\uC2B5\uB2C8\uB2E4. \uC0C1\uB300 \uC0AC\uC5C5 \uBC94\uC704
      \uC790\uCCB4\uAC00 \uBC14\uB010 \uAC70\uB2C8\uAE4C. \uC800\uB294 \uADF8 \uACB0\uC815\uC744
      \uD604\uC7A5 \uBB38\uC81C\uB85C\uB9CC \uC124\uBA85\uD558\uB294 \uB370 \uB3D9\uC758\uD558\uC9C0
      \uC54A\uC558\uC2B5\uB2C8\uB2E4."
    player: 0
    narration: 0
  - npcId: npc-dongbang-trading-hr-director-park-minu
    text: "\uC2E4\uBB34 \uD1B5\uBCF4\uC5D0 \uC788\uB294 \uC0AC\uC720\uD558\uACE0
      \uADF8 \uB4A4 \uC815\uC0B0\uC5D0\uC11C \uB098\uC628 \uC124\uBA85\uB3C4 \uB2EC\uB790\uC2B5\uB2C8\uB2E4.
      \uADF8\uB54C \uACF5\uAC1C\uC801\uC73C\uB85C \uC124\uBA85\uD55C \uBC94\uC704\uB294
      \uD68C\uC0AC \uC790\uB8CC\uB85C \uB0A8\uC544 \uC788\uC2B5\uB2C8\uB2E4."
    player: 0
    narration: 0
  - npcId:
    text: "\uD558\uB298\uC2DD\uD488\uC5D0\uC11C\uB3C4 \uC870\uAC74\uC744 \uBC14\uAFB8\uB294
      \uCC3D\uAD6C\uAC00 \uBCC4\uB3C4\uB85C \uC788\uC5C8\uB2E4\uACE0 \uD588\uC2B5\uB2C8\uB2E4.
      \uC5EC\uAE30\uC11C\uB3C4 \uCD5C\uC885 \uACB0\uC815\uC740 \uB2E4\uB978 \uB370\uC11C
      \uD588\uB2E4\uB294 \uAC81\uB2C8\uAE4C?"
    player: 1
    narration: 0
  - npcId: npc-dongbang-trading-ceo-kang-jaehyeon
    text: "\uC801\uC5B4\uB3C4 \uC6B0\uB9AC\uAC00 \uD611\uC758\uD558\uB358 \uC0C1\uB300\uB294
      \uACB0\uC815\uC744 \uBC14\uAFC0 \uC218 \uC5C6\uB2E4\uACE0 \uD588\uC2B5\uB2C8\uB2E4.
      \uBCF8\uC778\uB4E4\uB3C4 \uAC11\uC790\uAE30 \uD1B5\uBCF4\uBC1B\uC558\uB2E4\uACE0\uC694.
      \uADF8\uAC8C \uC0AC\uC2E4\uC778\uC9C0 \uCC45\uC784\uC744 \uD53C\uD558\uB294
      \uB9D0\uC778\uC9C0\uB294 \uC81C\uAC00 \uB2E4 \uC54C \uC218 \uC5C6\uC8E0."
    player: 0
    narration: 0
  - npcId: npc-dongbang-trading-hr-director-park-minu
    text: "\uB2E4\uB9CC \uD55C \uAC00\uC9C0\uB294 \uD655\uC778\uD560 \uC218 \uC788\uC5B4\uC694.
      \uAC70\uC810 \uC6B4\uC601\uC774 \uC904\uAE30 \uC804\uBD80\uD130 \uC0C8 \uC124\uBE44
      \uAC80\uC218\uC640 \uC774\uD6C4 \uBC1C\uC8FC\uB97C \uBA48\uCD94\uB77C\uB294
      \uC548\uB0B4\uAC00 \uC654\uC2B5\uB2C8\uB2E4. \uBB3C\uB958 \uD604\uC7A5 \uBB38\uC81C\uAC00
      \uACB0\uC815\uC758 \uC2DC\uC791\uC774\uC5C8\uB2E4\uBA74 \uC21C\uC11C\uAC00
      \uB9DE\uC9C0 \uC54A\uB294 \uBD80\uBD84\uC774 \uC788\uC8E0."
    player: 0
    narration: 0
  - npcId:
    text: "\uBB3C\uAC74\uC774 \uB35C \uB098\uAC00\uC11C \uBA48\uCD98 \uAC83\uACFC,
      \uBA48\uCD94\uAE30\uB85C \uD574\uC11C \uBB3C\uAC74\uC774 \uB35C \uB098\uC628
      \uAC74 \uB2E4\uB974\uAD70\uC694."
    player: 1
    narration: 0
  - npcId: npc-dongbang-trading-ceo-kang-jaehyeon
    text: "\uADF8\uB807\uC2B5\uB2C8\uB2E4. \uB2F9\uC2DC\uC5D0\uB3C4 \uADF8\uAC78
      \uC124\uBA85\uD558\uB824\uACE0 \uD588\uC18C. \uC774\uBC88\uC5D4 \uAC19\uC740
      \uB9D0\uC744 \uC880 \uB354 \uCC28\uBD84\uD788 \uD558\uB294 \uAC81\uB2C8\uB2E4."
    player: 0
    narration: 0
  - npcId: npc-dongbang-trading-ceo-kang-jaehyeon
    text: "\uAC70\uC810\uC740 \uC900\uBE44\uB3FC \uC788\uC5C8\uC2B5\uB2C8\uB2E4.
      \uBB3C\uB7C9\uC740 \uB098\uC911\uC5D0 \uC628\uB2E4\uACE0 \uD588\uACE0, \uC0AC\uB78C\uB3C4
      \uBA3C\uC800 \uC62E\uACBC\uC8E0. \uC774\uBC88\uC5D0\uB294 \uC6B0\uB9AC \uACE0\uAC1D\uBD80\uD130
      \uB298\uB9AC\uACE0 \uC2F6\uC2B5\uB2C8\uB2E4. \uB0A8\uC758 \uC77C\uC815 \uAE30\uB2E4\uB9AC\uB2E4
      \uD68C\uC0AC\uAC00 \uB299\uB294 \uAC74 \uD55C \uBC88\uC774\uBA74 \uB429\uB2C8\uB2E4."
    player: 0
    narration: 0
  - npcId: npc-dongbang-trading-hr-director-park-minu
    text: "\uD68C\uC0AC\uB294 \uD55C \uBC88\uC774\uB77C\uACE0 \uD558\uC9C0\uB9CC
      \uC9C1\uC6D0\uB4E4\uD55C\uD14C\uB294 \uC774\uC0AC\uB3C4 \uC788\uC5C8\uACE0
      \uD1B5\uADFC\uB3C4 \uC788\uC5C8\uC8E0. \uC0C8 \uAC70\uC810\uC774\uB77C\uACE0
      \uD558\uBA74 \uC81C\uC77C \uBA3C\uC800 \uADF8\uB54C\uBD80\uD130 \uBB3B\uC2B5\uB2C8\uB2E4."
    player: 0
    narration: 0
  - npcId:
    text: "\uC9C0\uAE08 \uC81C\uC2DC\uD55C \uACE0\uAC1D \uC218\uBA74 \uC0C8 \uAC70\uC810\uC774
      \uD544\uC694\uD569\uB2C8\uAE4C?"
    player: 1
    narration: 0
  - npcId: npc-dongbang-trading-ceo-kang-jaehyeon
    text: "\uC9C0\uAE08 \uC22B\uC790\uB9CC \uBCF4\uBA74 \uB0A8\uC2B5\uB2C8\uB2E4.
      \uC55E\uC73C\uB85C \uB298\uB9B4 \uBAAB\uAE4C\uC9C0 \uC900\uBE44\uD558\uB294
      \uAC81\uB2C8\uB2E4."
    player: 0
    narration: 0
  - npcId: npc-dongbang-trading-hr-director-park-minu
    text: "\uADF8\uB798\uC11C \uC81C\uAC00 \uD45C\uB97C \uB450 \uC7A5 \uB9CC\uB4E4\uC5C8\uC5B4\uC694.
      \uACC4\uC57D\uB41C \uBB3C\uB7C9\uD558\uACE0, \uC798\uB418\uBA74 \uB4E4\uC5B4\uC62C
      \uBB3C\uB7C9. \uD569\uCCD0 \uB193\uC73C\uBA74 \uCC3D\uACE0\uAC00 \uBC8C\uC368
      \uAF49 \uCC39\uB2C8\uB2E4. \uC544\uC9C1\uC740 \uC544\uB2CC\uB370\uC694."
    player: 0
    narration: 0
  - npcId:
    text: "\uACFC\uAC70\uC5D0\uB294 \uC5B4\uB290 \uD45C\uB97C \uAE30\uC900\uC73C\uB85C
      \uC0AC\uB78C\uACFC \uC124\uBE44\uB97C \uC62E\uACBC\uC2B5\uB2C8\uAE4C?"
    player: 1
    narration: 0
  - npcId: npc-dongbang-trading-ceo-kang-jaehyeon
    text: "\u2026\uB450 \uBC88\uC9F8\uC600\uC18C. \uB0A8\uC758 \uC57D\uC18D\uC774\uC5C8\uC9C0\uB9CC,
      \uADF8\uAC78 \uACC4\uD68D\uC73C\uB85C \uC4F4 \uAC74 \uC6B0\uB9AC \uACB0\uC815\uC774\uC5C8\uC9C0."
    player: 0
    narration: 0
  companyVariants: []
