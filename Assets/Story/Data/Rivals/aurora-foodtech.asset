  - {fileID: 11400000, guid: b620f8628c96078469b2989908b924a0, type: 2}
  affiliationKind: 4
  groupRelationship: "\uC131\uC7A5 \uC790\uAE08\uACFC \uC720\uD1B5 \uC9C0\uC6D0\uC744
    \uC704\uD574 \uADF8\uB8F9 \uD22C\uC790\uB97C \uBC1B\uC740 \uC804\uB7B5\uC801
    \uD22C\uC790 \uC790\uD68C\uC0AC\uB2E4. \uC5F0\uAD6C\uC758 \uB3C5\uC790\uC131\uACFC
    \uD22C\uC790\xB7\uD310\uB9E4 \uC758\uBB34\uAC00 \uB3D9\uC2DC\uC5D0 \uC874\uC7AC\uD55C\uB2E4."
  pressureStrategy: "\uAE40\uC11C\uD6C4\uB294 \uADF8\uB8F9 \uC9C0\uC6D0\uC73C\uB85C
    \uC2E0\uC81C\uD488\xB7\uD2B9\uD5C8\xB7\uC120\uAD6C\uB9E4\uACC4\uC57D\uC744 \uC120\uC810\uD55C\uB2E4.
    \uAE30\uC220\uC801 \uC2E0\uB8B0\uC640 \uACC4\uC57D\uC0C1 \uC81C\uC57D\uC744 \uB3CC\uD30C\uD558\uC9C0
    \uBABB\uD558\uBA74 \uCD9C\uC2DC \uC18D\uB3C4\uB9CC\uC73C\uB85C \uACC4\uC18D \uC555\uBC15\uD560
    \uC218\uB294 \uC5C6\uB2E4."
  internalConflict: "\uAE40\uC11C\uD6C4\uB294 \uD68C\uC0AC \uC0DD\uC874\uACFC \uC120\uC810
    \uAE30\uD68C, \uC815\uD558\uB9B0\uC740 \uC790\uC2E0\uC758 \uC5F0\uAD6C\uAC00
    \uC4F0\uC774\uB294 \uBC29\uC2DD, \uD55C\uC720\uB098\uB294 \uB9E4\uCD9C\uACFC
    \uD611\uC0C1\uAD8C\uC744 \uC9C0\uD0A8\uB2E4. \uC138 \uC0AC\uB78C \uBAA8\uB450
    \uD68C\uC0AC\uC758 \uC131\uACF5\uC744 \uBC14\uB77C\uC9C0\uB9CC \uC131\uACF5\uC758
    \uC758\uBBF8\uC640 \uAC10\uC218\uD560 \uC704\uD5D8\uC774 \uB2E4\uB974\uB2E4."
  negotiationOpening: "\uC5F0\uAD6C \uAC80\uC99D\uC744 \uBCF4\uC7A5\uD558\uB294 \uC790\uAE08\uC774\uB098
    \uBE44\uB3C5\uC810 \uC0C1\uC6A9\uD654 \uACC4\uC57D\uC740 \uB0B4\uBD80 \uC778\uBB3C\uC758
    \uD611\uC870 \uADFC\uAC70\uAC00 \uB41C\uB2E4. \uAE40\uC11C\uD6C4\uB294 \uB354
    \uB192\uC740 \uAC1C\uC778 \uBCF4\uC218\uB85C \uADF8\uB8F9\uC744 \uBC30\uC2E0\uD558\uC9C0
    \uC54A\uC73C\uBA70 \uAE30\uC220 \uD310\uB9E4\xB7\uC5F0\uAD6C \uC790\uB8CC \uC81C\uACF5\xB7\uC0AC\uC5C5
    \uC81C\uD734\uC758 \uAD8C\uD55C\uC744 \uAD6C\uBD84\uD55C\uB2E4."
  loyaltyStructure: "\uAE40\uC11C\uD6C4\uB294 \uADF8\uB8F9\uC758 \uC9C0\uC6D0\uC73C\uB85C
    \uD68C\uC0AC\uB97C \uC9C0\uCF30\uB2E4\uB294 \uD655\uC2E0\uACFC \uCC3D\uC5C5\uC790
    \uD1B5\uC81C\uAD8C \uB54C\uBB38\uC5D0 \uB9C8\uC9C0\uB9C9\uAE4C\uC9C0 \uADF8\uB8F9
    \uCE21\uC5D0 \uB0A8\uB294\uB2E4. \uC815\uD558\uB9B0\uC758 \uC99D\uAC70 \uD611\uC870\uC640
    \uD55C\uC720\uB098\uC758 \uACC4\uC57D \uC7AC\uD3B8\uC740 \uB300\uD45C\uC758 \uC9C4\uC601
    \uC120\uD0DD\uACFC \uBCC4\uAC1C\uB2E4."
  cooperationBoundaries: "\uC5F0\uAD6C \uACB0\uACFC\uC758 \uC120\uD0DD\uC801 \uAC80\uC99D\uACFC
    \uAD8C\uD55C\uC744 \uD655\uBCF4\uD55C \uB77C\uC774\uC120\uC2A4 \uD611\uC0C1\uB9CC
    \uAC00\uB2A5\uD558\uB2E4. \uC5F0\uAD6C\uC790\uC758 \uD638\uAC10\uC73C\uB85C \uD2B9\uD5C8
    \uC18C\uC720\uAD8C\uC744 \uB118\uAE30\uAC70\uB098, \uC131\uACFC\uBCF4\uC218\uB9CC\uC73C\uB85C
    \uAC80\uC99D\uB418\uC9C0 \uC54A\uC740 \uAE30\uC220\uC744 \uC720\uCD9C\uD558\uC9C0
    \uC54A\uB294\uB2E4."
  provisionalFinancials: 1
