  - {fileID: 11400000, guid: 6b55ef445e6e69b409286b6acf5474e5, type: 2}
  affiliationKind: 1
  groupRelationship: "\uADF8\uB8F9\uC758 \uC790\uAE08 \uC6B4\uC6A9\xB7\uC778\uC218
    \uAE08\uC735\uC744 \uB9E1\uB294 \uB3C5\uB9BD \uD611\uB825\uC0AC\uB2E4. \uC9C0\uBC30
    \uACC4\uC5F4\uC0AC\uB85C \uC124\uC815\uD558\uC9C0 \uC54A\uB294\uB2E4. \uC548\uC815\uC801\uC778
    \uB300\uD615 \uAC70\uB798\uC640 \uC218\uC218\uB8CC\uB97C \uC5BB\uB294 \uB300\uC2E0
    \uADF8\uB8F9 \uC9D1\uC911 \uC704\uD5D8\uC744 \uB5A0\uC548\uB294\uB2E4."
  pressureStrategy: "\uACBD\uC7C1 \uB9E4\uC218\uC790 \uAE08\uC735 \uC9C0\uC6D0, \uB2F4\uBCF4\xB7\uC9C0\uBD84
    \uC635\uC158 \uC694\uAD6C, \uCC28\uD658 \uC77C\uC815 \uC555\uBC15\uC73C\uB85C
    \uC8FC\uC778\uACF5\uC758 \uC778\uC218 \uBE44\uC6A9\uACFC \uC790\uAE08 \uC6B4\uC6A9\uC744
    \uC81C\uC57D\uD55C\uB2E4. \uC790\uCCB4 \uC190\uC2E4 \uC704\uD5D8\uC774 \uCEE4\uC9C0\uBA74
    \uC555\uBC15\uC744 \uBB34\uC870\uAC74 \uACC4\uC18D\uD558\uC9C0 \uC54A\uB294\uB2E4."
  internalConflict: "\uC784\uB3C4\uD604\uC740 \uD68C\uC218 \uAC00\uB2A5\uD55C \uC774\uC775,
    \uC1A1\uD604\uC11D\uC740 \uCD5C\uC545\uC758 \uC190\uC2E4, \uC815\uC720\uB77C\uB294
    \uAC70\uB798 \uC131\uC0AC\uC640 \uC790\uC2E0\uC758 \uD611\uC0C1 \uC8FC\uB3C4\uAD8C\uC744
    \uC911\uC2DC\uD55C\uB2E4. \uB300\uD45C\uAC00 \uB3D9\uC758\uD574\uB3C4 \uB9AC\uC2A4\uD06C
    \uC2EC\uC0AC\uB97C \uD1B5\uACFC\uD558\uC9C0 \uBABB\uD55C \uC815\uBCF4\xB7\uC790\uAE08
    \uAC70\uB798\uB294 \uC131\uB9BD\uD558\uC9C0 \uC54A\uB294\uB2E4."
  negotiationOpening: "\uADF8\uB8F9\uC758 \uC190\uC2E4 \uC804\uAC00\uB098 \uC131\uACFC\uBCF4\uC218
    \uBBF8\uC9C0\uAE09\uC774 \uD655\uC778\uB418\uACE0, \uC8FC\uC778\uACF5\uC774 \uAC80\uC99D
    \uAC00\uB2A5\uD55C \uB2F4\uBCF4\xB7\uC218\uC775\xB7\uB3C5\uB9BD \uAC70\uB798\uB9DD\uC744
    \uC81C\uC2DC\uD560 \uB54C \uADF8\uB8F9\uACFC\uC758 \uAC70\uB798\uB97C \uC77C\uBD80
    \uB04A\uC744 \uC218 \uC788\uB2E4. \uC778\uC218 \uAE08\uC735 \uCC38\uC5EC\uC640
    \uC815\uBCF4 \uC81C\uACF5\uC758 \uB300\uAC00\uB294 \uBCC4\uB3C4 \uACC4\uC57D\uC73C\uB85C
    \uC815\uD55C\uB2E4."
  loyaltyStructure: "\uCDA9\uC131\uC758 \uB300\uC0C1\uC740 \uADF8\uB8F9 \uD68C\uC7A5\uC774
    \uC544\uB2C8\uB77C \uD3F4\uB77C\uB9AC\uC2A4\uC758 \uC790\uBCF8\uACFC \uAC01\uC790\uC758
    \uAC70\uB798 \uC9C0\uC704\uB2E4. \uCE5C\uBC00\uAC10 \uD558\uB098\uB85C \uC804\uD5A5\uD558\uC9C0
    \uC54A\uB294\uB2E4. \uC1A1\uD604\uC11D\uC758 \uC804\uBB38\uC801 \uAC70\uC808\uC744
    \uB300\uD45C\uC758 \uD638\uAC10\uC73C\uB85C \uBB34\uC2DC\uD558\uC9C0 \uC54A\uB294\uB2E4."
  cooperationBoundaries: "\uC8FC\uC778\uACF5\uC5D0\uAC8C \uADF8\uB8F9\uC758 \uBE44\uACF5\uAC1C
    \uC790\uAE08\xB7\uC778\uC218 \uC77C\uC815\uC744 \uC81C\uACF5\uD558\uB294 \uBC30\uC2E0
    \uACBD\uB85C\uAC00 \uC788\uC9C0\uB9CC \uB3C5\uC810\uC131\uACFC \uB300\uAC00\uAC00
    \uB530\uB978\uB2E4. \uACE0\uAC1D \uAC1C\uC778\uC815\uBCF4\xB7\uACC4\uC815 \uC811\uADFC
    \uAD8C\uD55C\xB7\uC804\uC0AC \uC790\uB8CC \uC804\uCCB4\uB294 \uC81C\uACF5\uD558\uC9C0
    \uC54A\uB294\uB2E4. \uAC70\uB798 \uC885\uB8CC \uB4A4 \uB2E4\uC2DC \uACBD\uC7C1\uD560
    \uC218 \uC788\uB2E4."
  provisionalFinancials: 1
