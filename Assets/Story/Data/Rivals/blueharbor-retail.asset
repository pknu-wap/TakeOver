  - {fileID: 11400000, guid: 3086a794e1de4d343950a47a011b03f6, type: 2}
  affiliationKind: 2
  groupRelationship: "\uADF8\uB8F9\uC758 \uC0C1\uD488 \uACF5\uAE09\uACFC \uB300\uADDC\uBAA8
    \uC790\uBCF8\uC744 \uBC14\uD0D5\uC73C\uB85C \uC804\uAD6D \uD310\uB9E4\uB9DD\uC744
    \uC6B4\uC601\uD558\uB294 \uC720\uD1B5 \uACC4\uC5F4\uC0AC\uB2E4. \uACE0\uAC1D\xB7\uB0A9\uD488\uC5C5\uCCB4\xB7\uB9E4\uC7A5\uC758
    \uC57D\uC18D\uC774 \uADF8\uB8F9 \uB0B4 \uC9C0\uC704\uC640 \uC5BD\uD600 \uC788\uB2E4."
  pressureStrategy: "\uC11C\uC720\uC9C4\uC740 \uC0C1\uD488 \uAD6C\uC131\xB7\uD504\uB85C\uBAA8\uC158\xB7\uC785\uC810
    \uC870\uAC74\uC744 \uC870\uC815\uD574 \uC8FC\uC778\uACF5 \uC18C\uC720 \uAE30\uC5C5\uC758
    \uC2DC\uC7A5 \uC9C4\uC785\uC744 \uACAC\uC81C\uD55C\uB2E4. \uB370\uC774\uD130\uC640
    \uD604\uC7A5 \uC6B4\uC601 \uC5ED\uB7C9\uB3C4 \uBC29\uC5B4 \uC218\uB2E8\uC774\uC9C0\uB9CC
    \uAC1C\uC778\uC815\uBCF4 \uC720\uCD9C\uC744 \uAE30\uBCF8 \uC804\uB7B5\uC73C\uB85C
    \uC0BC\uC9C0 \uC54A\uB294\uB2E4."
  internalConflict: "\uC11C\uC720\uC9C4\uC740 \uC804\uAD6D \uACE0\uAC1D \uC811\uC810\uACFC
    \uC9C4\uC5F4\uAD8C, \uD55C\uB3C4\uACBD\uC740 \uBD84\uC11D\uC758 \uC2E0\uB8B0,
    \uAE40\uB3D9\uC11D\uC740 \uB9E4\uC7A5 \uC6B4\uC601\uC758 \uC9C0\uC18D\uC131\uC744
    \uC9C0\uD0A8\uB2E4. \uB4A4\uC758 \uB450 \uC0AC\uB78C\uB3C4 \uC218\uC775 \uC9C0\uD45C\uB97C
    \uC774\uC720\uB85C \uBB38\uC81C\uB97C \uBBF8\uB918\uB358 \uACBD\uD5D8\uC744 \uAC00\uC9C4\uB2E4."
  negotiationOpening: "\uC11C\uC720\uC9C4\uACFC\uB294 \uACF5\uAE09\xB7\uAC00\uACA9\xB7\uACE0\uAC1D
    \uC11C\uBE44\uC2A4\uC5D0 \uAD00\uD55C \uAC70\uB798\uAC00 \uAC00\uB2A5\uD558\uB2E4.
    \uB370\uC774\uD130 \uC65C\uACE1\uC774\uB098 \uD604\uC7A5 \uC190\uC2E4 \uC804\uAC00\uC758
    \uC99D\uAC70\uAC00 \uB4DC\uB7EC\uB098\uBA74 \uC2E4\uBB34\uC790\uC758 \uC81C\uD55C\uC801
    \uC790\uB8CC \uD611\uC870 \uACBD\uB85C\uAC00 \uC5F4\uB9AC\uC9C0\uB9CC \uB300\uD45C\uC758
    \uC9C4\uC601 \uC804\uD658\uC73C\uB85C \uC774\uC5B4\uC9C0\uC9C0 \uC54A\uB294\uB2E4."
  loyaltyStructure: "\uC11C\uC720\uC9C4\uC740 \uCD5C\uC885\uAE4C\uC9C0 \uADF8\uB8F9
    \uD310\uB9E4\uB9DD\uC744 \uBC29\uC5B4\uD558\uB294 \uACBD\uC601\uC790\uB2E4. \uC0C1\uB300\uB97C
    \uC778\uC815\uD558\uAC70\uB098 \uC0C1\uD488\uC744 \uAC70\uB798\uD558\uB294 \uAC83\uACFC
    \uADF8\uB8F9\uC5D0\uC11C \uB4F1\uC744 \uB3CC\uB9AC\uB294 \uAC83\uC744 \uAD6C\uBD84\uD55C\uB2E4.
    \uD55C\uB3C4\uACBD\xB7\uAE40\uB3D9\uC11D\uC758 \uBB38\uC81C \uC81C\uAE30\uAC00
    \uC804\uC0AC\uC801 \uBC30\uC2E0\uC744 \uB73B\uD558\uC9C0 \uC54A\uB294\uB2E4."
  cooperationBoundaries: "\uD611\uC870 \uC790\uB8CC\uB294 \uAC1C\uC778\uC744 \uC2DD\uBCC4\uD560
    \uC218 \uC5C6\uB294 \uC815\uCC45\xB7\uC9D1\uACC4\xB7\uC6B4\uC601 \uADFC\uAC70\uB85C
    \uC81C\uD55C\uD55C\uB2E4. \uACE0\uAC1D \uAC1C\uC778\uC815\uBCF4 \uD310\uB9E4,
    \uC804\uAD6D \uACE0\uAC1D \uBA85\uB2E8 \uC81C\uACF5, \uB9E4\uC7A5 \uC18C\uC18D
    \uBCC0\uACBD\uC744 \uD611\uC870 \uBCF4\uC0C1\uC73C\uB85C \uC790\uB3D9 \uC81C\uACF5\uD558\uC9C0
    \uC54A\uB294\uB2E4."
  provisionalFinancials: 1
