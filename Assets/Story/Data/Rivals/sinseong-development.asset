  - {fileID: 11400000, guid: e8db3700ecdd9bc47aaeea93b22c8941, type: 2}
  affiliationKind: 3
  groupRelationship: "\uADF8\uB8F9\uACFC \uC790\uBCF8\xB7\uC0AC\uC5C5\uAD8C\uC744
    \uAD50\uD658\uD558\uB294 \uACF5\uB3D9\uC0AC\uC5C5 \uD30C\uD2B8\uB108\uB2E4. \uC815\uD655\uD55C
    \uC9C0\uBD84\xB7\uC18C\uC720 \uAD6C\uC870\uB294 \uBBF8\uC815\uC73C\uB85C \uC720\uC9C0\uD558\uBA70
    \uADF8\uB8F9\uC758 \uC9C0\uBC30 \uACC4\uC5F4\uC0AC\uB77C\uACE0 \uB2E8\uC815\uD558\uC9C0
    \uC54A\uB294\uB2E4."
  pressureStrategy: "\uBBF8\uB798\uAC74\uC124\uC758 \uD6C4\uBCF4 \uBD80\uC9C0\xB7\uC785\uCC30\xB7\uAC1C\uBC1C
    \uC77C\uC815\uC5D0 \uBA3C\uC800 \uAC1C\uC785\uD55C\uB2E4. \uC9C0\uC5ED \uAC08\uB4F1\uACFC
    \uC778\uD5C8\uAC00 \uC77C\uC815\uC744 \uD611\uC0C1\uB825\uC73C\uB85C \uC774\uC6A9\uD558\uC9C0\uB9CC
    \uC7A5\uAE30 \uC784\uB300\uAC00\uCE58\uAC00 \uBB34\uB108\uC9C8 \uC815\uB3C4\uC758
    \uAC08\uB4F1\uC740 \uB0B4\uBD80 \uBC18\uBC1C\uC744 \uBD80\uB978\uB2E4."
  internalConflict: "\uC815\uB3C4\uD604\uC740 \uC790\uC0B0\uAC00\uACA9\uACFC \uC77C\uC815,
    \uC720\uC815\uBBFC\uC740 \uC790\uC2E0\uC774 \uC124\uACC4\uD55C \uB3C4\uC2DC\uC758
    \uC7A5\uAE30 \uAC00\uCE58, \uAC15\uBBFC\uC9C0\uB294 \uC8FC\uBBFC\xB7\uC784\uCC28\uC778\uC5D0\uAC8C
    \uD55C \uC124\uBA85\uC758 \uC2E0\uB8B0\uB97C \uC911\uC2DC\uD55C\uB2E4. \uB450
    \uC2E4\uBB34\uC790\uB3C4 \uAE30\uC874 \uAC1C\uBC1C \uC555\uBC15\uC5D0 \uAD00\uC5EC\uD55C
    \uCC45\uC784\uC774 \uC788\uB2E4."
  negotiationOpening: "\uADF8\uB8F9\uC774 \uACF5\uB3D9\uC0AC\uC5C5 \uC190\uC2E4\uC744
    \uC804\uAC00\uD558\uAC70\uB098 \uC57D\uC18D\uD55C \uC9C0\uC5ED \uC870\uAC74\uC744
    \uB4A4\uC9D1\uC5C8\uC744 \uB54C, \uAD8C\uB9AC\xB7\uC815\uC0B0\xB7\uC9C0\uC5ED
    \uD569\uC758\uAC00 \uD3EC\uD568\uB41C \uB300\uC548 \uACC4\uC57D\uC73C\uB85C \uC0AC\uC5C5\uBCC4
    \uD611\uC870\uB97C \uB04C\uC5B4\uB0BC \uC218 \uC788\uB2E4."
  loyaltyStructure: "\uADF8\uB8F9\uC5D0 \uB300\uD55C \uACF5\uB3D9 \uCDA9\uC131\uBCF4\uB2E4
    \uACC4\uC57D\uACFC \uAC1C\uBCC4 \uD504\uB85C\uC81D\uD2B8\uC758 \uC774\uD574\uAC00
    \uC6B0\uC120\uD55C\uB2E4. \uB300\uD45C\uC758 \uC218\uC775 \uD569\uC758\uC640
    \uC2E4\uBB34\uC790\uC758 \uC124\uACC4\xB7\uC9C0\uC5ED \uC870\uAC74\uC744 \uAC01\uAC01
    \uCDA9\uC871\uD574\uC57C \uD558\uBA70 \uD55C \uC0AC\uB78C\uC758 \uD638\uAC10\uC73C\uB85C
    \uC804\uC6D0\uC744 \uC6C0\uC9C1\uC774\uC9C0 \uC54A\uB294\uB2E4."
  cooperationBoundaries: "\uADF8\uB8F9\uC758 \uBE44\uACF5\uAC1C \uC785\uCC30\xB7\uACC4\uD68D
    \uBCC0\uACBD \uC790\uB8CC\uAC00 \uD611\uC870 \uC218\uB2E8\uC774 \uB420 \uC218
    \uC788\uC9C0\uB9CC \uC2E0\uC131\uC758 \uD1A0\uC9C0\xB7\uC0AC\uC5C5\uAD8C\uC744
    \uBB34\uC0C1\uC73C\uB85C \uC8FC\uC9C0\uB294 \uC54A\uB294\uB2E4. \uAC19\uC740
    \uBD80\uC9C0\uC758 \uC774\uD574\uAC00 \uCDA9\uB3CC\uD558\uBA74 \uC8FC\uC778\uACF5\uACFC\uB3C4
    \uC7AC\uB300\uB9BD\uD55C\uB2E4."
  provisionalFinancials: 1
