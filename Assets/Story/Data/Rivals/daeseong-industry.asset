  - {fileID: 11400000, guid: a3ca1f1656002ba4f9d62ba0d4c4d554, type: 2}
  affiliationKind: 2
  groupRelationship: "\uB3C5\uB9BD \uACBD\uC601 \uC870\uC9C1\uC744 \uC720\uC9C0\uD558\uB294
    \uADF8\uB8F9\uC758 \uC81C\uC870\xB7\uC124\uBE44 \uD575\uC2EC \uACC4\uC5F4\uC0AC\uB2E4.
    \uB300\uD615 \uC218\uC8FC\xB7\uACF5\uB3D9 \uBCF4\uC99D\xB7\uACC4\uC5F4 \uACF5\uAE09\uB9DD\uC774
    \uC870\uC9C1\uC758 \uC0DD\uC874\uACFC \uACB0\uD569\uB418\uC5B4 \uC788\uB2E4."
  pressureStrategy: "\uAE40\uC131\uD638\uC758 \uC9C0\uBD84 \uC5F0\uB300\uC640 \uACF5\uAE09\uB9DD
    \uBC29\uC5B4, \uC624\uC9C4\uC6B0\uC758 \uACBD\uC7C1 \uC778\uC218\xB7\uC2DC\uC124
    \uC120\uC810\uC73C\uB85C \uCD5C\uC885 \uAD6D\uBA74\uAE4C\uC9C0 \uC8FC\uC778\uACF5\uC744
    \uC555\uBC15\uD55C\uB2E4. \uC2E4\uBB34 \uBD80\uC11C\uB294 \uC7AC\uBB34\xB7\uC778\uB825
    \uADFC\uAC70\uB97C \uAC16\uCDB0 \uD611\uC0C1 \uBE44\uC6A9\uC744 \uB192\uC778\uB2E4."
  internalConflict: "\uAE40\uC131\uD638\uC758 \uC870\uC9C1 \uC218\uD638\uC640 \uC624\uC9C4\uC6B0\uC758
    \uD655\uC7A5 \uACBD\uC7C1\uC740 \uAC19\uC740 \uC9C4\uC601\uC774\uC9C0\uB9CC \uC18D\uB3C4\uC5D0\uC11C
    \uCDA9\uB3CC\uD55C\uB2E4. \uB178\uD604\uC815\uC740 \uACC4\uC5F4 \uC790\uAE08
    \uC9C0\uC6D0\uC758 \uD55C\uB3C4, \uCD5C\uC740\uC218\uB294 \uD1B5\uD569 \uACFC\uC815\uC758
    \uC778\uB825 \uBE44\uC6A9\uC744 \uC694\uAD6C\uD55C\uB2E4."
  negotiationOpening: "\uC9C0\uAE09\xB7\uACE0\uC6A9\xB7\uD1B5\uD569 \uBB38\uC81C\uC758
    \uC81C\uD55C \uD611\uC0C1\uC740 \uAC00\uB2A5\uD558\uB098 \uB354 \uB192\uC740
    \uBCF4\uC218\uB098 \uD638\uAC10\uB9CC\uC73C\uB85C \uAE40\uC131\uD638\xB7\uC624\uC9C4\uC6B0\uAC00
    \uADF8\uB8F9\uC744 \uBC30\uC2E0\uD558\uB294 \uACBD\uB85C\uB294 \uB450\uC9C0 \uC54A\uB294\uB2E4.
    \uC2E4\uBB34 \uD611\uC870\uAC00 \uC9C0\uBD84 \uC5F0\uB300\uC758 \uD574\uCCB4\uB97C
    \uB73B\uD558\uC9C0 \uC54A\uB294\uB2E4."
  loyaltyStructure: "\uAE40\uC131\uD638\uC640 \uC624\uC9C4\uC6B0\uB294 \uB05D\uAE4C\uC9C0
    \uADF8\uB8F9 \uCE21\uC758 \uC778\uC218\uC804 \uC0C1\uB300\uB2E4. \uADF8\uB8F9
    \uB0B4\uBD80\uC758 \uC798\uBABB\uC744 \uBE44\uD310\uD558\uAC70\uB098 \uD53C\uD574
    \uCD95\uC18C \uD611\uC0C1\uC744 \uD558\uB354\uB77C\uB3C4 \uCD5C\uC885 \uC9C0\uBD84
    \uB300\uACB0\uC5D0\uC11C\uB294 \uC18C\uC18D \uC9C4\uC601\uC744 \uC9C0\uD0A8\uB2E4."
  cooperationBoundaries: "\uB178\uD604\uC815\xB7\uCD5C\uC740\uC218\uB294 \uC9C1\uBB34\uC0C1
    \uAC80\uC99D\xB7\uC9C0\uAE09\xB7\uACE0\uC6A9 \uC870\uC815\uC5D0 \uD55C\uD574
    \uC0C1\uB300\uC640 \uD611\uB825\uD55C\uB2E4. \uC801\uB300 \uC9C4\uC601\uC758
    \uD575\uC2EC \uAC00\uACA9 \uC815\uBCF4\xB7\uC9C0\uBD84 \uC791\uC804\xB7\uC9C1\uC6D0
    \uBA85\uBD80\uB97C \uB118\uAE30\uB294 \uD3EC\uAD04\uC801 \uBC30\uC2E0\uC790\uB85C
    \uCDE8\uAE09\uD558\uC9C0 \uC54A\uB294\uB2E4."
  provisionalFinancials: 1
