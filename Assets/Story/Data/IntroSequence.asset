  - id: lesson-007
    sceneTitle: "\uB458\uC9F8 \uB0A0 / \uC11C\uC9C0\uC544\uC758 \uC790\uB8CC \uD655\uC778"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 4
    npcId:
    voiceLabel:
    text: "\uD604\uC7AC \uD589\uB3D9 \uD3EC\uC778\uD2B8\uB294 {ap}/{maxAp}\uC785\uB2C8\uB2E4.
      \uC774 \uBA74\uB2F4\uC744 \uC2DC\uC791\uD558\uBA74 {apCost}\uAC00 \uC18C\uBAA8\uB418\uBA70
      \uB2F5\uBCC0 \uC120\uD0DD\uC5D0\uB294 \uCD94\uAC00\uB85C \uC18C\uBAA8\uB418\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4.\n\n\uD589\uB3D9 \uD3EC\uC778\uD2B8\uAC00 \uBD80\uC871\uD558\uBA74
      \uBA74\uB2F4\uC744 \uC2DC\uC791\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uD558\uB8E8\uB97C
      \uC885\uB8CC\uD558\uBA74 \uB2E4\uC74C \uB0A0 \uCD5C\uB300\uCE58\uAE4C\uC9C0
      \uD68C\uBCF5\uB429\uB2C8\uB2E4."
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle: "\uC77C\uC815\uACFC \uD589\uB3D9 \uD3EC\uC778\uD2B8"
