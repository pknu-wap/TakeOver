    speaker: 4
    npcId:
    voiceLabel: ""
    text: "\ub9e4\ub3c4 \ud6c4 \uc904\uc5b4\ub4e0 \ubcf4\uc720 \uc8fc\uc2dd\uacfc \uc9c0\ubd84\uc728\uc744 \ub2e4\uc2dc \ud655\uc778\ud558\uc138\uc694."
    showPlayer: 0
