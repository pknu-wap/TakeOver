    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 1
    npcId:
    voiceLabel:
    text: "\uC9C1\uC6D0\uC740 \uC544\uB2D9\uB2C8\uB2E4. \uD68C\uC0AC \uC774\uC57C\uAE30\uB97C
      \uB4E4\uC73C\uB7EC \uC654\uC2B5\uB2C8\uB2E4."
