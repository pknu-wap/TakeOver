  - id: intro-085
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uD68C\uC758\uC2E4 \uBC16\uC758
      \uD68C\uC0AC"
    background: {fileID: 21300000, guid: cd737e0de23899c4b9fc897defc1bbbb, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-mirae-construction-field-director-park-dosik
    voiceLabel:
    text: "\uC0AC\uB78C \uC904\uC774\uB294 \uC774\uC57C\uAE30\uAC00 \uB098\uC62C
      \uB54C\uB9C8\uB2E4 \uACF5\uC0AC \uC77C\uC815\uC740 \uADF8\uB300\uB85C\uB354\uAD70\uC694.
      \uC774\uBC88\uC5D0\uB3C4 \uADF8\uB7EC\uB294\uC9C0 \uAD81\uAE08\uD569\uB2C8\uB2E4."
    showPlayer: 1
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices:
    - title: "\uC791\uC5C5\uB7C9\uACFC \uC77C\uC815\uBD80\uD130 \uD655\uC778\uD55C\uB2E4"
      description: "\uD604\uC7A5\uC5D0\uC11C \uAC10\uB2F9\uD560 \uC791\uC5C5\uB7C9\uACFC \uC77C\uC815\uC744 \uBB3B\uC2B5\uB2C8\uB2E4."
      playerLine: "\uC778\uC6D0\uC744 \uC5B4\uB5BB\uAC8C \uD558\uACA0\uB2E4\uACE0
        \uC57D\uC18D\uD558\uAE30 \uC804\uC5D0, \uC77C\uBD80\uD130 \uC880 \uBCF4\uACA0\uC2B5\uB2C8\uB2E4.
        \uC5B4\uB514\uAC00 \uAC00\uC7A5 \uBE60\uB4EF\uD55C\uAC00\uC694?"
      response: "\uC774\uCABD\uBD80\uD130 \uBCF4\uC2DC\uC8E0. \uC11C\uB958\uC5D0
        \uC801\uD78C \uC778\uC6D0\uD558\uACE0 \uC2E4\uC81C\uB85C \uB098\uC62C \uC218
        \uC788\uB294 \uC778\uC6D0\uC774 \uB2E4\uB985\uB2C8\uB2E4."
      targetNpcId: npc-mirae-construction-field-director-park-dosik
      memoryType: 8
      interpretation: "\uC778\uC6D0\uC744 \uC57D\uC18D\uD558\uAE30 \uC804\uC5D0 \uC791\uC5C5\uB7C9\uACFC
        \uC2E4\uC81C \uD22C\uC785 \uC5EC\uAC74\uC744 \uD655\uC778\uD558\uACA0\uB2E4\uACE0
        \uD588\uB2E4."
      relationDelta:
        trust: 0
        respect: 2
        closeness: 0
    - title: "\uACE0\uC6A9 \uC548\uC815\uC744 \uC911\uC694\uD558\uAC8C \uBCF8\uB2E4"
      description: "\uACE0\uC6A9\uC744 \uC9C0\uD0A4\uB294 \uC77C\uC744 \uC6B0\uC120\uD55C\uB2E4\uACE0 \uBC1D\uD799\uB2C8\uB2E4."
      playerLine: "\uC624\uB798 \uC77C\uD574\uC628 \uBD84\uB4E4\uC758 \uC790\uB9AC\uAC00
        \uC27D\uAC8C \uD754\uB4E4\uB9AC\uB294 \uD68C\uC0AC\uB294 \uC800\uB3C4 \uB9C8\uC74C\uC774
        \uC4F0\uC785\uB2C8\uB2E4. \uD604\uC7A5 \uC774\uC57C\uAE30\uB97C \uB4E3\uACE0
        \uC2F6\uC2B5\uB2C8\uB2E4."
      response: "\uADF8\uB807\uAC8C \uBD10\uC8FC\uC2DC\uBA74 \uC88B\uACA0\uC2B5\uB2C8\uB2E4.
        \uC5EC\uAE30\uC11C \uC624\uB798 \uBC84\uD2F4 \uC0AC\uB78C\uB4E4\uC774 \uC5B4\uB5A4
        \uC77C\uC744 \uD558\uB294\uC9C0\uBD80\uD130 \uB4E4\uC5B4\uBCF4\uC2ED\uC2DC\uC624."
      targetNpcId: npc-mirae-construction-field-director-park-dosik
      memoryType: 8
      interpretation: "\uCCAB \uD604\uC7A5 \uBC29\uBB38\uC5D0\uC11C \uACE0\uC6A9
        \uC548\uC815\uC5D0 \uAD00\uC2EC\uC744 \uD45C\uD604\uD588\uB2E4. \uCC44\uC6A9
        \uC720\uC9C0 \uC57D\uC18D\uC774\uB098 \uC778\uC0AC \uACB0\uC815\uC740 \uD558\uC9C0
        \uC54A\uC558\uB2E4."
