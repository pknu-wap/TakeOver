    voiceLabel:
    text: "\uB300\uC2DC\uBCF4\uB4DC\uC758 \uC774\uBCA4\uD2B8 \uCE74\uB4DC\uC5D0\uC11C
      \u2018\uC790\uC138\uD788 \uBCF4\uAE30\u2019\uB97C \uC120\uD0DD\uD558\uBA74
      \uC694\uCCAD \uB0B4\uC6A9\uACFC \uBA74\uB2F4 \uBE44\uC6A9\uC744 \uD655\uC778\uD558\uC2E4
      \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uB0B4\uC6A9 \uD655\uC778\uB9CC\uC73C\uB85C\uB294
      \uD589\uB3D9 \uD3EC\uC778\uD2B8\uAC00 \uC18C\uBAA8\uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
