    npcId: npc-mirae-construction-field-director-park-dosik
    voiceLabel:
    text: "\uc624\ub298 \ub098\ub208 \uc598\uae30\ub294 \uae30\uc5b5\ud574\ub450\uaca0\uc2b5\ub2c8\ub2e4. \ub2e4\uc74c\uc5d0 \uc624\uc2e4 \ub54c\ub3c4 \ud604\uc7a5 \uc0ac\ub78c\ub4e4 \uc598\uae30\ubd80\ud130 \ub4e4\uc5b4\uc8fc\uc168\uc73c\uba74 \ud569\ub2c8\ub2e4."
    showPlayer: 1
