  - id: intro-093
    sceneTitle: "\uB3C4\uC785\uBD80 \uC644\uB8CC  /  \uCCAB \uBC88\uC9F8 \uC8FC\uC8FC"
    background: {fileID: 21300000, guid: f2ae5346af09a0045b072d43aaad3d54, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 4
    npcId:
    voiceLabel:
    text: "\uD29C\uD1A0\uB9AC\uC5BC\uC744 \uC644\uB8CC\uD558\uC600\uC2B5\uB2C8\uB2E4.
      \uD604\uC7AC {turn}\uC77C\uC774\uBA70, \uBBF8\uB798\uAC74\uC124 \uC8FC\uC2DD
      {shares}\uC8FC\uC640 \uC9C0\uBD84 {stake}%\uB97C \uBCF4\uC720\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4.
      \uB0A8\uC740 \uC790\uAE08\uC740 {cash}\uC6D0, \uD589\uB3D9 \uD3EC\uC778\uD2B8\uB294
      {ap}/{maxAp}\uC785\uB2C8\uB2E4. \uB2E4\uC74C \uC77C\uC815\uACFC \uAC70\uB798\uB97C
      \uC790\uC720\uB86D\uAC8C \uC9C4\uD589\uD558\uC2E4 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    showPlayer: 0
