  - id: lesson-042
    sceneTitle: "\ub458\uc9f8 \ub0a0  /  \ud604\uae08\uc73c\ub85c \ub3cc\ub824\ub193\uae30"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel: ""
    text: "\uacc4\uc18d \uc0ac\uae30\ub9cc \ud560 \uc218\ub294 \uc5c6\uc8e0. \ub2e4\ub978 \uac70\ub798\uc5d0 \uc4f8 \ub3c8\ub3c4 \ud544\uc694\ud560 \ud14c\ub2c8\uae4c\uc694."
    showPlayer: 1
    goal: 0
    companyId:
    choices: []
    skipDefaultChoice: 0
  - id: lesson-043
    sceneTitle: "\ub458\uc9f8 \ub0a0  /  \ud604\uae08\uc73c\ub85c \ub3cc\ub824\ub193\uae30"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 1
    npcId: npc-broker-yoon-hajin
    voiceLabel: ""
    text: "\uadf8\ub7fc \uc0b0 \uac83 \uc911\uc5d0 \uc77c\ubd80\ub9cc \ub2e4\uc2dc \ud314\uc544\ubcf4\uc8e0. \uc4f8 \ub3c8\uc740 \ub0a8\uaca8\ub46c\uc57c\uaca0\ub124\uc694."
    showPlayer: 1
    goal: 0
    companyId:
    choices: []
    skipDefaultChoice: 0
  - id: lesson-044
    sceneTitle: "\ub458\uc9f8 \ub0a0  /  \ud604\uae08\uc73c\ub85c \ub3cc\ub824\ub193\uae30"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel: ""
    text: "\ud55c \uc8fc\ub9cc \ud314\uc544\ubcf4\uc2dc\uc8e0. \uc9c0\uae08 \ud314\uba74 \uc5bc\ub9c8\uac00 \ub3cc\uc544\uc624\ub294\uc9c0\ub3c4 \ubcf4\uace0\uc694."
    showPlayer: 1
    goal: 0
    companyId:
    choices: []
    skipDefaultChoice: 0
  - id: lesson-045
    sceneTitle: "\ub458\uc9f8 \ub0a0  /  \ud604\uae08\uc73c\ub85c \ub3cc\ub824\ub193\uae30"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel: ""
    text: "\uc5bc\ub9c8\uc5d0 \uc0c0\ub294\uc9c0\ub9cc \uc0dd\uac01\ud558\uc9c0 \ub9c8\uc138\uc694. \uc9c0\uae08 \uc5bc\ub9c8\uc5d0 \ud314 \uc218 \uc788\ub294\uc9c0\uac00 \uc911\uc694\ud558\uc8e0. \ud314\uc558\ub2e4\uace0 \ub2e4 \ub3c8\uc744 \ubc88 \uac74 \uc544\ub2c8\ub2c8\uae4c\uc694."
    showPlayer: 1
    goal: 0
    companyId:
    choices: []
    skipDefaultChoice: 0
  - id: lesson-047
    sceneTitle: "\ub458\uc9f8 \ub0a0  /  \ud604\uae08\uc73c\ub85c \ub3cc\ub824\ub193\uae30"
    background: {fileID: 21300000, guid: f2ae5346af09a0045b072d43aaad3d54, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 4
    npcId:
    voiceLabel: ""
    text: "\ubbf8\ub798\uac74\uc124 1\uc8fc\ub97c \ub9e4\ub3c4\ud558\uc138\uc694. \uc608\uc0c1 \ub300\uae08\uacfc \ub9e4\ub3c4 \ud6c4 \ubcf4\uc720\ub7c9\uc744 \ud655\uc778\ud558\uc138\uc694."
    showPlayer: 0
    goal: 12
    companyId:
    tutorialTitle: "\uc8fc\uc2dd \ub9e4\ub3c4"
    tutorialText: "\uc218\ub7c9\uc5d0 1\uc744 \uc785\ub825\ud558\uace0 \ub9e4\ub3c4\ud558\uae30\ub97c \uc120\ud0dd\ud574 \uc8fc\uc2ed\uc2dc\uc624. \ub9e4\ub3c4\ud558\uba74 \uc790\uae08\uc774 \ub298\uace0 \uc8fc\uc2dd\uacfc \uc9c0\ubd84\uc728\uc740 \uc904\uc5b4\ub4ed\ub2c8\ub2e4. \uc9c0\ubd84 \uc870\uac74\uc744 \uc783\uc740 \uc774\ubca4\ud2b8\ub294 \ubaa9\ub85d\uc5d0\uc11c \uc81c\uc678\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
    choices: []
    skipDefaultChoice: 0
