  - id: neutral-intro-T1-tail-3
    sceneTitle: "\uC774\uBBFC\uADDC \u2014 \uC8FC\uC8FC\uB2D8\uC774\uB77C\uACE0 \uBD88\uB7EC\uB3C4
      \uB418\uB098\uC694"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\uC774\uBBFC\uADDC\uAC00 \uD1B5\uB85C\uB97C \uBE44\uCF30\uB2E4. \uC8FC\uC2DD\uC744
      \uC0B0 \uC77C\uBCF4\uB2E4, \uADF8 \uC774\uC720\uB97C \uBC16\uC5D0\uC11C \uC5B4\uB5BB\uAC8C
      \uB9D0\uD560\uC9C0\uAC00 \uBA3C\uC800 \uBB34\uAC70\uC6CC\uC84C\uB2E4."
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: neutral-intro-T1-help
    sceneTitle: "\uC774\uBBFC\uADDC \u2014 \uC8FC\uC8FC\uB2D8\uC774\uB77C\uACE0 \uBD88\uB7EC\uB3C4
      \uB418\uB098\uC694"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 4
    npcId:
    voiceLabel:
    text: "\uC77C\uBD80 \uC778\uBB3C\uC740 \uD2B9\uC815 \uD68C\uC0AC\uC5D0 \uC18C\uC18D\uB418\uC9C0
      \uC54A\uACE0 \uCDE8\uC7AC\xB7\uD22C\uC790\xB7\uC815\uCC45 \uC815\uBCF4 \uB4F1
      \uC790\uC2E0\uC758 \uBAA9\uC801\uC744 \uAC16\uACE0 \uC5F0\uB77D\uD569\uB2C8\uB2E4.
      \uC774\uB4E4\uC744 \uC774 \uD29C\uD1A0\uB9AC\uC5BC\uC5D0\uC11C\uB294 \u2018\uC911\uB9BD
      NPC\u2019\uB77C\uACE0 \uBD80\uB985\uB2C8\uB2E4. \uC911\uB9BD\uC740 \uD50C\uB808\uC774\uC5B4\uC5D0\uAC8C
      \uD56D\uC0C1 \uC6B0\uD638\uC801\uC774\uB77C\uB294 \uB73B\uC774 \uC544\uB2D9\uB2C8\uB2E4.
      \uAC01 \uC81C\uC548\uC758 \uBC1C\uC2E0\uC790\xB7\uB0B4\uC6A9\xB7\uC870\uAC74\uC744
      \uD655\uC778\uD558\uACE0 \uB2F5\uBCC0\uD558\uC2ED\uC2DC\uC624. \uC774\uBC88
      \uC7A5\uBA74\uC740 \uC18C\uAC1C \uB300\uD654\uC774\uBA70 \uD589\uB3D9 \uD3EC\uC778\uD2B8\uB97C
      \uC18C\uBE44\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle: "\uC678\uBD80 \uC778\uBB3C\uACFC\uC758 \uB9CC\uB0A8"
    tutorialText: "\uC77C\uBD80 \uC778\uBB3C\uC740 \uD2B9\uC815 \uD68C\uC0AC\uC5D0
      \uC18C\uC18D\uB418\uC9C0 \uC54A\uACE0 \uCDE8\uC7AC\xB7\uD22C\uC790\xB7\uC815\uCC45
      \uC815\uBCF4 \uB4F1 \uC790\uC2E0\uC758 \uBAA9\uC801\uC744 \uAC16\uACE0 \uC5F0\uB77D\uD569\uB2C8\uB2E4.
      \uC774\uB4E4\uC744 \uC774 \uD29C\uD1A0\uB9AC\uC5BC\uC5D0\uC11C\uB294 \u2018\uC911\uB9BD
      NPC\u2019\uB77C\uACE0 \uBD80\uB985\uB2C8\uB2E4. \uC911\uB9BD\uC740 \uD50C\uB808\uC774\uC5B4\uC5D0\uAC8C
      \uD56D\uC0C1 \uC6B0\uD638\uC801\uC774\uB77C\uB294 \uB73B\uC774 \uC544\uB2D9\uB2C8\uB2E4.
      \uAC01 \uC81C\uC548\uC758 \uBC1C\uC2E0\uC790\xB7\uB0B4\uC6A9\xB7\uC870\uAC74\uC744
      \uD655\uC778\uD558\uACE0 \uB2F5\uBCC0\uD558\uC2ED\uC2DC\uC624. \uC774\uBC88
      \uC7A5\uBA74\uC740 \uC18C\uAC1C \uB300\uD654\uC774\uBA70 \uD589\uB3D9 \uD3EC\uC778\uD2B8\uB97C
      \uC18C\uBE44\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    choices: []
    skipDefaultChoice: 0
  - id: intro-074
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uAC15\uC900\uD601\uC758 \uC9C8\uBB38"
    background: {fileID: 21300000, guid: 3da8335e8f928b04ea9542177aaee968, type: 3}
