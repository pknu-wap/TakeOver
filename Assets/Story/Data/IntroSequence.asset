--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e1f1787036245c448a03807b70d741e5, type: 3}
  m_Name: IntroSequence
  m_EditorClassIdentifier: Assembly-CSharp::TakeOver.Story.StorySequence
  fadeSeconds: 0.45
  font: {fileID: 12800000, guid: e921fcde249fb4244bcfbf3bb484830a, type: 3}
  playerStanding: {fileID: 21300000, guid: 2e26f4928160a7d429af82e49f52d353, type: 3}
  playerDimmed: {fileID: 21300000, guid: 64ed30aa8e3c5f04eb485ec5fd247f50, type: 3}
  dialoguePanel: {fileID: 0}
  beats:
  - id: intro-001
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uB9C8\uC9C0\uB9C9 \uB0A9\uD488"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId: 
    voiceLabel: 
    text: "\uACFC\uAC70, \uAC00\uC871 \uD68C\uC0AC\uC758 \uC0AC\uBB34\uC2E4. \uBB38
      \uB108\uBA38\uC5D0\uC11C\uB294 \uB9C8\uC9C0\uB9C9 \uB0A9\uD488\uC744 \uC900\uBE44\uD558\uB294
      \uC18C\uB9AC\uAC00 \uB4E4\uB9B0\uB2E4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-002
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uB9C8\uC9C0\uB9C9 \uB0A9\uD488"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 3
    npcId: 
    voiceLabel: "\uAC00\uC871"
    text: "\uC774\uBC88 \uBB3C\uB7C9\uAE4C\uC9C0 \uB9C8\uCE58\uBA74 \uD55C\uC228
      \uB3CC\uB9AC\uACA0\uB124. \uBC00\uB9B0 \uC815\uBE44\uB3C4 \uD558\uACE0."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-003
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uB9C8\uC9C0\uB9C9 \uB0A9\uD488"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 1
    npcId: 
    voiceLabel: 
    text: "\uC785\uAE08\uC740 \uC608\uC815\uB300\uB85C \uB41C\uB300\uC694?"
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-004
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uB9C8\uC9C0\uB9C9 \uB0A9\uD488"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 3
    npcId: 
    voiceLabel: "\uAC00\uC871"
    text: "\uACC4\uC57D\uC11C\uC5D0 \uC801\uD600 \uC788\uC796\uC544. \uC6B0\uB9B0
      \uB0A0\uC9DC \uB9DE\uCDB0 \uBCF4\uB0C8\uC73C\uB2C8, \uC800\uCABD\uB3C4 \uC9C0\uD0A4\uACA0\uC9C0."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-005
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uB9C8\uC9C0\uB9C9 \uB0A9\uD488"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId: 
    voiceLabel: 
    text: "\uC804\uD654\uAC00 \uC6B8\uB9B0\uB2E4. \uAC00\uC871\uC758 \uD45C\uC815\uC774
      \uAD73\uB294\uB2E4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-006
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uB9C8\uC9C0\uB9C9 \uB0A9\uD488"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 3
    npcId: 
    voiceLabel: "\uADF8\uB8F9 \uB2F4\uB2F9\uC790 \xB7 \uC804\uD654"
    text: "\uAC80\uC218\uAC00 \uCD94\uAC00\uB85C \uD544\uC694\uD569\uB2C8\uB2E4.
      \uC9C0\uAE09 \uC77C\uC815\uC740 \uB2E4\uC2DC \uC548\uB0B4\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-007
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uB9C8\uC9C0\uB9C9 \uB0A9\uD488"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 3
    npcId: 
    voiceLabel: "\uAC00\uC871"
    text: "\uCD94\uAC00 \uAC80\uC218\uC694? \uC9C0\uB09C\uC8FC\uC5D0 \uD655\uC778\uAE4C\uC9C0
      \uB05D\uB0AC\uB294\uB370\uC694. \uC774\uBC88 \uC8FC\uAC00 \uAE09\uC5EC\uC77C\uC785\uB2C8\uB2E4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-008
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uB9C8\uC9C0\uB9C9 \uB0A9\uD488"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 3
    npcId: 
    voiceLabel: "\uADF8\uB8F9 \uB2F4\uB2F9\uC790 \xB7 \uC804\uD654"
    text: "\uB0B4\uBD80 \uAE30\uC900\uC774 \uBCC0\uACBD\uB410\uC2B5\uB2C8\uB2E4.
      \uC800\uD76C \uCABD\uC5D0\uC11C\uB3C4 \uC2B9\uC778 \uC5C6\uC774\uB294 \uC9C4\uD589\uD560
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-009
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uB9C8\uC9C0\uB9C9 \uB0A9\uD488"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId: 
    voiceLabel: 
    text: "\uD1B5\uD654\uAC00 \uB05D\uB0AC\uB2E4. \uAC00\uC871\uC740 \uB2EC\uB825\uC5D0
      \uADF8\uB824 \uB454 \uC9C0\uAE09\uC77C\uC758 \uB3D9\uADF8\uB77C\uBBF8\uB97C
      \uC9C0\uC6B0\uC9C0 \uBABB\uD588\uB2E4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-010
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uB9C8\uC9C0\uB9C9 \uB0A9\uD488"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId: 
    voiceLabel: 
    text: "\uADF8\uB0A0 \uCC98\uC74C \uC54C\uC558\uB2E4. \uACC4\uC57D\uC11C\uC5D0
      \uC801\uD78C \uB0A0\uC9DC\uB3C4, \uB204\uAD70\uAC00\uC5D0\uAC8C\uB294 \uBBF8\uB8F0
      \uC218 \uC788\uB294 \uC22B\uC790\uB77C\uB294 \uAC78."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-011
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uC81C\uC548\uC11C"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 0.65, g: 0.68, b: 0.75, a: 1}
    speaker: 0
    npcId: 
    voiceLabel: 
    text: "\uB3C5\uCD09 \uBB38\uC11C\uC640 \uC9C0\uAE09 \uBCF4\uB958 \uD1B5\uC9C0\uAC00
      \uCC45\uC0C1 \uC704\uC5D0 \uC313\uC600\uB2E4. \uADF8 \uC704\uB85C \uC0C8\uB85C\uC6B4
      \uBB38\uC11C\uAC00 \uB193\uC600\uB2E4.\n\u300C\uC790\uC0B0 \uC591\uC218 \uC81C\uC548\u300D"
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-012
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uC81C\uC548\uC11C"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 3
    npcId: 
    voiceLabel: "\uADF8\uB8F9 \uB2F4\uB2F9\uC790"
    text: "\uC124\uBE44\uC640 \uBD80\uC9C0\uB97C \uB118\uAE30\uC2DC\uB294 \uBC29\uD5A5\uC785\uB2C8\uB2E4.
      \uC774 \uC870\uAC74\uC774\uBA74 \uB0A8\uC740 \uBD80\uB2F4\uC744 \uC77C\uBD80
      \uC815\uB9AC\uD558\uC2E4 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-013
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uC81C\uC548\uC11C"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 3
    npcId: 
    voiceLabel: "\uAC00\uC871"
    text: "\uBC1B\uC544\uC57C \uD560 \uB3C8\uC774 \uB4E4\uC5B4\uC624\uBA74 \uC815\uB9AC\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uADF8\uAC74 \uC65C \uC774\uC57C\uAE30\uD558\uC9C0
      \uC54A\uC2B5\uB2C8\uAE4C?"
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-014
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uC81C\uC548\uC11C"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 3
    npcId: 
    voiceLabel: "\uADF8\uB8F9 \uB2F4\uB2F9\uC790"
    text: "\uB300\uAE08 \uAD00\uB828 \uAC74\uACFC \uC774\uBC88 \uC81C\uC548\uC740
      \uBCC4\uAC1C\uC785\uB2C8\uB2E4. \uD310\uB2E8\uC740 \uB300\uD45C\uB2D8\uAED8\uC11C
      \uD558\uC2DC\uB294 \uAC81\uB2C8\uB2E4. \uC81C\uC548 \uAE30\uD55C\uC740 \uC774\uBC88
      \uC8FC\uAE4C\uC9C0\uC785\uB2C8\uB2E4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-015
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uC81C\uC548\uC11C"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId: 
    voiceLabel: 
    text: "\uB2F4\uB2F9\uC790\uB294 \uBB38\uC11C\uB97C \uB0A8\uAE30\uACE0 \uB5A0\uB0AC\uB2E4.
      \uAC00\uC871\uC740 \uC624\uB798\uB3C4\uB85D \uADF8 \uC790\uB9AC\uC5D0 \uC549\uC544
      \uC788\uC5C8\uB2E4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-016
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uC81C\uC548\uC11C"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 3
    npcId: 
    voiceLabel: "\uAC00\uC871"
    text: "\uC9C1\uC6D0\uB4E4\uD55C\uD14C\uB294 \uB0B4\uAC00 \uC774\uC57C\uAE30\uD560\uAC8C."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-017
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uC81C\uC548\uC11C"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 1
    npcId: 
    voiceLabel: 
    text: "\uC544\uC9C1 \uB2E4\uB978 \uBC29\uBC95\uC774 \uC788\uC744 \uAC70\uC608\uC694."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-018
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uC81C\uC548\uC11C"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 3
    npcId: 
    voiceLabel: "\uAC00\uC871"
    text: "\u2026\uC788\uC73C\uBA74 \uC88B\uACA0\uB2E4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-019
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBE48\uC790\uB9AC"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 0.42, g: 0.48, b: 0.57, a: 1}
    speaker: 0
    npcId: 
    voiceLabel: 
    text: "\uACF5\uAD6C\uD568\uC774 \uB2EB\uD614\uB2E4. \uC774\uB984\uD45C\uAC00
      \uB5BC\uC5B4\uC84C\uB2E4. \uAC04\uD310\uC774 \uB0B4\uB824\uC624\uACE0, \uB9E4\uC77C
      \uBCF4\uB358 \uC0AC\uB78C\uB4E4\uC740 \uAC01\uC790\uC758 \uC0B4\uAE38\uC744
      \uCC3E\uC544 \uB5A0\uB0AC\uB2E4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-020
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBE48\uC790\uB9AC"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 3
    npcId: 
    voiceLabel: "\uC9C1\uC6D0"
    text: "\uC5F0\uB77D \uC8FC\uC138\uC694. \uB098\uC911\uC5D0 \uB2E4\uC2DC \uC2DC\uC791\uD558\uC2DC\uBA74\uC694."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-021
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBE48\uC790\uB9AC"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId: 
    voiceLabel: 
    text: "\uD68C\uC0AC\uB294 \uBB38\uC744 \uB2EB\uC558\uB2E4. \uC9D1\uB3C4 \uC815\uB9AC\uD588\uB2E4.
      \uC6B0\uB9AC\uC5D0\uAC8C\uB294 \uBAA8\uB4E0 \uAC83\uC774 \uB05D\uB09C \uB0A0\uC774\uC5C8\uB2E4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-022
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBE48\uC790\uB9AC"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId: 
    voiceLabel: 
    text: "\uBC16\uC5D0\uC11C\uB294 \uC791\uC740 \uD68C\uC0AC \uD558\uB098\uAC00
      \uBB34\uB9AC\uD558\uAC8C \uC0AC\uC5C5\uC744 \uBC8C\uC600\uB2E4\uAC00 \uC2E4\uD328\uD588\uB2E4\uACE0
      \uD588\uB2E4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-023
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBE48\uC790\uB9AC"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 3
    npcId: 
    voiceLabel: "\uADF8\uB8F9 \uD68C\uC7A5 \xB7 \uB274\uC2A4"
    text: "\uAE30\uC5C5\uC758 \uCC45\uC784\uC740 \uC9C0\uC18D \uAC00\uB2A5\uD55C
      \uC131\uC7A5\uC744 \uB9CC\uB4DC\uB294 \uB370 \uC788\uC2B5\uB2C8\uB2E4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-024
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBE48\uC790\uB9AC"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId: 
    voiceLabel: 
    text: "\uADF8 \uC0AC\uB78C\uC5D0\uAC8C \uC6B0\uB9AC \uD68C\uC0AC\uB294 \uBCF4\uACE0\uC11C
      \uD55C \uC904\uC774\uC5C8\uC744 \uAC83\uC774\uB2E4.\n\uB098\uB294 \uADF8 \uD55C
      \uC904\uC774 \uC5B4\uB5BB\uAC8C \uB9CC\uB4E4\uC5B4\uC84C\uB294\uC9C0 \uC54C\uACE0
      \uC2F6\uC5C8\uB2E4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-025
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uB2E4\uC2DC \uC2DC\uC791\uD558\uB294
      \uBC29\uBC95"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId: 
    voiceLabel: 
    text: "\uBA87 \uB144 \uD6C4.\n\uC77C\uD55C \uD754\uC801\uC774 \uB0A8\uC740 \uCC45\uC0C1
      \uC704\uC5D0 \uD68C\uACC4 \uCC45\uACFC \uAE30\uC5C5 \uBD84\uC11D \uBA54\uBAA8\uAC00
      \uB193\uC600\uB2E4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-026
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uB2E4\uC2DC \uC2DC\uC791\uD558\uB294
      \uBC29\uBC95"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId: 
    voiceLabel: 
    text: "\uB2F9\uC7A5 \uB418\uAC1A\uC744 \uD798\uC740 \uC5C6\uC5C8\uB2E4. \uBA3C\uC800
      \uC0B4\uC544\uC57C \uD588\uB2E4.\n\uC77C\uD588\uACE0, \uB3C8\uC744 \uBAA8\uC558\uB2E4.
      \uD68C\uC0AC\uAC00 \uBB34\uB108\uC9C0\uB294 \uC774\uC720\uC640, \uB204\uAD70\uAC00
      \uADF8 \uD68C\uC0AC\uB97C \uC0AC\uB4E4\uC774\uB294 \uC774\uC720\uB97C \uBC30\uC6E0\uB2E4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-027
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uB2E4\uC2DC \uC2DC\uC791\uD558\uB294
      \uBC29\uBC95"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId: 
    voiceLabel: 
    text: "\uBAA8\uB4E0 \uD68C\uC0AC\uB97C \uC0B4 \uC218\uB294 \uC5C6\uB2E4. \uD558\uC9C0\uB9CC
      \uCCAB \uAC70\uB798\uB97C \uC2DC\uC791\uD560 \uB9CC\uD07C\uC740 \uB9C8\uB828\uD588\uB2E4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-028
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uB2E4\uC2DC \uC2DC\uC791\uD558\uB294
      \uBC29\uBC95"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId: 
    voiceLabel: 
    text: "\uC791\uC740 \uD22C\uC790\uD68C\uC0AC\uC758 \uB4F1\uB85D \uC11C\uB958\uB97C
      \uB0B4\uB824\uB193\uC558\uB2E4.\n\uC11C\uB78D\uC5D0\uB294 \uC61B \uD68C\uC0AC\uC758
      \uC0AC\uC9C4\uC744, \uBCBD\uC5D0\uB294 \uADF8\uB8F9\uC758 \uAE30\uC5C5 \uC790\uB8CC\uB97C
      \uB450\uC5C8\uB2E4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-029
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uB2E4\uC2DC \uC2DC\uC791\uD558\uB294
      \uBC29\uBC95"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId: 
    voiceLabel: 
    text: "\uC5B8\uC820\uAC00 \uC800 \uD68C\uC0AC\uB97C \uC778\uC218\uD55C\uB2E4.\n\uC6B0\uB9AC\uC5D0\uAC8C
      \uB0A8\uACA8\uC9C4 \uC120\uD0DD\uC9C0\uB97C \uC138\uB358 \uC0AC\uB78C\uB4E4\uC774,
      \uB0B4 \uACB0\uC815\uC744 \uAE30\uB2E4\uB9AC\uAC8C \uB420 \uB54C\uAE4C\uC9C0."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-030
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId: 
    voiceLabel: 
    text: "\uC774\uB984 \uC5C6\uB294 \uBD09\uD22C\uC5D0\uB294 \uBBF8\uB798\uAC74\uC124\uC758
      \uACF5\uAC1C \uC790\uB8CC\uC640 \uBA54\uBAA8\uAC00 \uC788\uC5C8\uB2E4.\n\u300C\uD68C\uC0AC\uB97C
      \uC0B4 \uC0DD\uAC01\uC774\uB77C\uBA74, \uACF5\uAC1C \uC790\uB8CC\uB9CC\uC73C\uB85C
      \uD310\uB2E8\uD558\uC9C0 \uB9C8\uC2ED\uC2DC\uC624. \uC724\uD558\uC9C4.\u300D"
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-031
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId: 
    voiceLabel: 
    text: "\uC2E0\uC6D0\uC744 \uD655\uC778\uD55C \uB4A4, \uC0AC\uB78C\uC774 \uBD90\uBE44\uC9C0
      \uC54A\uB294 \uD638\uD154 \uB77C\uC6B4\uC9C0\uC5D0\uC11C \uADF8\uB97C \uB9CC\uB0AC\uB2E4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-032
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel: 
    text: "\uD734\uB300\uC804\uD654\uB294 \uC7A0\uAE50 \uAEBC\uB450\uC2DC\uC8E0.
      \uC5EC\uAE30\uC120 \uB179\uC74C\uD558\uB294 \uC0AC\uB78C\uB3C4, \uB4E3\uB294
      \uC0AC\uB78C\uB3C4 \uB9CE\uC73C\uB2C8\uAE4C."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-033
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 1
    npcId: npc-broker-yoon-hajin
    voiceLabel: 
    text: "\uBA3C\uC800 \uC5F0\uB77D\uD558\uC2E0 \uC774\uC720\uBD80\uD130 \uB4E3\uACE0
      \uC2F6\uC2B5\uB2C8\uB2E4."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-034
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel: 
    text: "\uC0C8 \uD22C\uC790\uD68C\uC0AC\uB97C \uC138\uC6B0\uC168\uB354\uAD70\uC694.
      \uAC00\uC9C4 \uB3C8\uC740 \uB9CE\uC9C0 \uC54A\uC740\uB370 \uCD5C\uC885 \uBAA9\uD45C\uB294
      \uAF64 \uD06C\uACE0\uC694."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-035
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 1
    npcId: npc-broker-yoon-hajin
    voiceLabel: 
    text: "\uC81C \uC790\uB8CC\uB97C \uC5B4\uB514\uC11C \uC5BB\uC5C8\uC8E0?"
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-036
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel: 
    text: "\uC5C5\uACC4\uC5D0\uC120 \uC0C8 \uD68C\uC0AC\uAC00 \uC0DD\uAE30\uBA74
      \uC18C\uBB38\uC774 \uB0A9\uB2C8\uB2E4. \uADF8 \uADF8\uB8F9\uC744 \uC778\uC218\uD558\uACE0
      \uC2F6\uB2E4\uACE0\uC694? \uC9C0\uAE08 \uC790\uAE08\uC73C\uB85C\uB294 \uD611\uC0C1
      \uD14C\uC774\uBE14\uC5D0 \uC549\uAE30\uB3C4 \uC5B4\uB835\uC2B5\uB2C8\uB2E4."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-037
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 1
    npcId: npc-broker-yoon-hajin
    voiceLabel: 
    text: "\uADF8\uB798\uC11C \uCCAB \uAC70\uB798\uBD80\uD130 \uC2DC\uC791\uD558\uB824\uB294
      \uAC81\uB2C8\uB2E4."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-038
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel: 
    text: "\uD070 \uBAA9\uD45C\uB97C \uAC00\uC9C4 \uACE0\uAC1D\uC740 \uBC18\uAC11\uC8E0.
      \uAC70\uB798\uAC00 \uC131\uC0AC\uB418\uBA74 \uC81C \uC218\uC218\uB8CC\uB3C4
      \uC0DD\uAE30\uB2C8\uAE4C\uC694."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-039
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 1
    npcId: npc-broker-yoon-hajin
    voiceLabel: 
    text: "\uC65C \uC800\uB97C \uB3D5\uC2B5\uB2C8\uAE4C?"
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-040
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel: 
    text: "\uC608\uC804\uC5D4 \uC800\uB3C4 \uC791\uC740 \uB0A9\uD488\uC5C5\uCCB4\uC640
      \uC77C\uD588\uC2B5\uB2C8\uB2E4. \uADF8\uB8F9 \uACC4\uC5F4\uC0AC\uC5D0 \uBC1B\uC744
      \uB3C8\uC774 \uC788\uC5C8\uC8E0. \uB300\uAE08\uC740 \uBBF8\uB904\uC84C\uACE0,
      \uC81C \uAC70\uB798\uCC98\uB294 \uBC84\uD2F0\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-041
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 1
    npcId: npc-broker-yoon-hajin
    voiceLabel: 
    text: "\uB2F9\uC2E0\uB3C4 \uADF8 \uADF8\uB8F9 \uB54C\uBB38\uC5D0 \uD53C\uD574\uB97C
      \uBD24\uB2E4\uB294 \uAC81\uB2C8\uAE4C?"
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-042
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel: 
    text: "\uD53C\uD574\uB97C \uBCF8 \uAC74 \uB9DE\uC2B5\uB2C8\uB2E4. \uADF8\uB807\uB2E4\uACE0
      \uC81C\uAC00 \uAE68\uB057\uD588\uB2E4\uB294 \uB73B\uC740 \uC544\uB2C8\uC5D0\uC694."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-043
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel: 
    text: "\uAC70\uB798\uCC98\uB97C \uC9C0\uD0A4\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4.
      \uB300\uC2E0 \uB0B4\uBD80\uC5D0\uC11C \uC0C8\uC5B4\uB098\uC628 \uACB0\uC81C
      \uC77C\uC815\uC744 \uB2E4\uB978 \uB9E4\uC218\uC790\uC5D0\uAC8C \uB118\uACA8
      \uC218\uC218\uB8CC\uB97C \uCC59\uACBC\uC8E0. \uADF8 \uB3C8\uC73C\uB85C \uBC84\uD17C\uC2B5\uB2C8\uB2E4."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-044
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 1
    npcId: npc-broker-yoon-hajin
    voiceLabel: 
    text: "\uADF8 \uC815\uBCF4\uB294 \uD569\uBC95\uC801\uC73C\uB85C \uC5BB\uC740
      \uAC81\uB2C8\uAE4C?"
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-045
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel: 
    text: "\uADF8 \uC9C8\uBB38\uC744 \uAF2D \uAE30\uB85D\uC73C\uB85C \uB0A8\uAE30\uACE0
      \uC2F6\uC73C\uC2ED\uB2C8\uAE4C?"
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-046
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId: 
    voiceLabel: 
    text: "\uC724\uD558\uC9C4\uC740 \uD68C\uC0AC \uC774\uB984\uB3C4 \uC791\uC131\uC790\uB3C4
      \uC5C6\uB294 \uC11C\uB958\uCCA0\uC744 \uBC00\uC5C8\uB2E4. \uADF8\uB7EC\uB098
      \uC544\uC9C1 \uC190\uC744 \uB193\uC9C0\uB294 \uC54A\uC558\uB2E4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-047
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel: 
    text: "\uC815\uC758\uB97C \uC704\uD574 \uB3D5\uB294\uB2E4\uACE0 \uBBFF\uC9C0\uB294
      \uB9C8\uC138\uC694. \uB2F9\uC2E0\uC740 \uC790\uBCF8\uACFC \uBAA9\uD45C\uAC00
      \uC788\uACE0, \uC800\uB294 \uAC70\uB798\uB9DD\uACFC \uC815\uBCF4\uAC00 \uC788\uC2B5\uB2C8\uB2E4."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-048
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel: 
    text: "\uAC70\uB798\uAC00 \uC131\uC0AC\uB418\uBA74 \uB3C8\uC744 \uBC95\uB2C8\uB2E4.
      \uADF8 \uADF8\uB8F9\uC774 \uD754\uB4E4\uB9AC\uBA74 \uAC1C\uC778\uC801\uC778
      \uBE5A\uB3C4 \uC870\uAE08 \uAC1A\uB294 \uC148\uC774\uACE0\uC694."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-049
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 1
    npcId: npc-broker-yoon-hajin
    voiceLabel: 
    text: "\uC774\uAC74 \uACF5\uAC1C \uC790\uB8CC\uAC00 \uC544\uB2C8\uAD70\uC694."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-050
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel: 
    text: "\uC5B4\uB514\uC11C \uC5BB\uC5C8\uB294\uC9C0\uB294 \uBB3B\uC9C0 \uC54A\uB294
      \uAC8C \uC88B\uC2B5\uB2C8\uB2E4. \uC9C4\uC704\uB97C \uD655\uC778\uD558\uB294
      \uAC74 \uB2F9\uC2E0 \uBAAB\uC785\uB2C8\uB2E4."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-051
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 1
    npcId: npc-broker-yoon-hajin
    voiceLabel: 
    text: "\uD655\uC778 \uC804\uC5D0\uB294 \uC544\uBB34 \uAC70\uB798\uB3C4 \uD558\uC9C0
      \uC54A\uACA0\uC2B5\uB2C8\uB2E4."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-052
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel: 
    text: "\uC88B\uC2B5\uB2C8\uB2E4. \uBBF8\uB798\uAC74\uC124\uC740 \uB2F9\uC2E0\uC5D0\uAC8C
      \uCCAB\uAC78\uC74C\uC774\uACE0, \uC81C\uAC90 \uC218\uC218\uB8CC\uAC00 \uAC78\uB9B0
      \uAE30\uD68C\uC785\uB2C8\uB2E4. \uC11C\uB85C \uC6D0\uD558\uB294 \uAC8C \uB9DE\uC73C\uBA74
      \uB2E4\uC2DC \uC5F0\uB77D\uD558\uC8E0."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-053
    sceneTitle: "TAKEOVER  /  \uCCAB \uBC88\uC9F8 \uC8FC\uC8FC"
    background: {fileID: 21300000, guid: f2ae5346af09a0045b072d43aaad3d54, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId: 
    voiceLabel: 
    text: "\uB0B4\uAC00 \uC0AC\uB824\uB294 \uAC83\uC740 \uC8FC\uC2DD\uC774\uB2E4.\n\uD558\uC9C0\uB9CC
      \uADF8 \uC22B\uC790 \uB4A4\uC5D0\uB294, \uB204\uAD70\uAC00\uAC00 \uC9C0\uCF1C
      \uC628 \uD68C\uC0AC\uAC00 \uC788\uB2E4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-054
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uCC98\uC74C \uBCF4\uB294 \uB3C4\uC2DC"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel: 
    text: "\uC0AC\uBB34\uC2E4\uC740 \uAD6C\uD558\uC168\uB124\uC694. \uC774\uC81C
      \uC5EC\uAE30\uC11C \uBB34\uC2A8 \uAC70\uB798\uAC00 \uB098\uC624\uB294\uC9C0
      \uBCF4\uC5EC\uC904 \uCC28\uB840\uAD70\uC694."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-055
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uCC98\uC74C \uBCF4\uB294 \uB3C4\uC2DC"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 1
    npcId: npc-broker-yoon-hajin
    voiceLabel: 
    text: "\uC18C\uAC1C\uD560 \uD68C\uC0AC\uAC00 \uC788\uB2E4\uACE0 \uD588\uC8E0."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-056
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uCC98\uC74C \uBCF4\uB294 \uB3C4\uC2DC"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel: 
    text: "\uBBF8\uB798\uAC74\uC124\uC785\uB2C8\uB2E4. \uACF5\uC0AC\uB294 \uB3CC\uC544\uAC00\uB294\uB370
      \uB3C8\uC774 \uC81C\uB54C \uB3CC\uC9C0 \uC54A\uC544\uC694. \uC774\uB7F0 \uD68C\uC0AC\uB294
      \uD22C\uC790\uC790\uB97C \uCC3E\uC2B5\uB2C8\uB2E4."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-057
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uCC98\uC74C \uBCF4\uB294 \uB3C4\uC2DC"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 1
    npcId: npc-broker-yoon-hajin
    voiceLabel: 
    text: "\uB300\uD45C\uAC00 \uD68C\uC0AC\uB97C \uD314\uACA0\uB2F5\uB2C8\uAE4C?"
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-058
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uCC98\uC74C \uBCF4\uB294 \uB3C4\uC2DC"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel: 
    text: "\uC544\uC9C1 \uADF8\uB7F0 \uB9D0\uC740 \uC548 \uD588\uC2B5\uB2C8\uB2E4.
      \uC7AC\uBB34 \uB2F4\uB2F9\uC790\uB294 \uC774\uC57C\uAE30\uAC00 \uD1B5\uD560
      \uAC70\uC608\uC694."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-059
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uCC98\uC74C \uBCF4\uB294 \uB3C4\uC2DC"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId: 
    voiceLabel: 
    text: "\uC775\uC219\uD55C \uB9D0\uC774\uB2E4. \uADF8\uB807\uB2E4\uACE0 \uAC19\uC740
      \uD68C\uC0AC\uB294 \uC544\uB2C8\uB2E4. \uC774\uBC88\uC5D0\uB294 \uC790\uB8CC\uBD80\uD130
      \uBCF4\uC790."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-060
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uCC98\uC74C \uBCF4\uB294 \uB3C4\uC2DC"
    background: {fileID: 21300000, guid: f2ae5346af09a0045b072d43aaad3d54, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId: 
    voiceLabel: 
    text: "\uB3C4\uC2DC\uB9F5\uC5D0\uC11C \uAE08\uC0C9\uC73C\uB85C \uAC15\uC870\uB41C
      \uBBF8\uB798\uAC74\uC124\uC744 \uC120\uD0DD\uD558\uC138\uC694."
    showPlayer: 0
    goal: 1
    choices: []
    skipDefaultChoice: 0
  - id: intro-061
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uC11C\uC9C0\uC544\uC758 \uC22B\uC790"
    background: {fileID: 21300000, guid: 3da8335e8f928b04ea9542177aaee968, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-mirae-construction-cfo-seo-jia
    voiceLabel: 
    text: "\uD22C\uC790\uB97C \uAC80\uD1A0\uD558\uC2E0\uB2E4\uACE0 \uB4E4\uC5C8\uC2B5\uB2C8\uB2E4.
      \uC218\uC775\uC131\uACFC \uD604\uAE08 \uC0AC\uC815\uBD80\uD130 \uAD6C\uBD84\uD574\uC11C
      \uBCF4\uC168\uC73C\uBA74 \uD569\uB2C8\uB2E4."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-062
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uC11C\uC9C0\uC544\uC758 \uC22B\uC790"
    background: {fileID: 21300000, guid: 3da8335e8f928b04ea9542177aaee968, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 1
    npcId: npc-mirae-construction-cfo-seo-jia
    voiceLabel: 
    text: "\uACF5\uC0AC\uAC00 \uC9C4\uD589 \uC911\uC778\uB370 \uC790\uAE08\uC774
      \uBD80\uC871\uD55C \uAC81\uB2C8\uAE4C?"
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-063
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uC11C\uC9C0\uC544\uC758 \uC22B\uC790"
    background: {fileID: 21300000, guid: 3da8335e8f928b04ea9542177aaee968, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-mirae-construction-cfo-seo-jia
    voiceLabel: 
    text: "\uBC1B\uC744 \uB3C8\uACFC \uC624\uB298 \uC9C0\uAE09\uD560 \uB3C8\uC740
      \uB2E4\uB974\uB2C8\uAE4C\uC694. \uC77C\uC815\uC774 \uBC00\uB9AC\uBA74 \uBE44\uC6A9\uC740
      \uACC4\uC18D \uB098\uAC11\uB2C8\uB2E4."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-064
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uC11C\uC9C0\uC544\uC758 \uC22B\uC790"
    background: {fileID: 21300000, guid: 3da8335e8f928b04ea9542177aaee968, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId: 
    voiceLabel: 
    text: "\uACF5\uAC1C \uC790\uB8CC \uD655\uC778\n\uBBF8\uB798\uAC74\uC124 \uD604\uC7AC
      \uC8FC\uAC00 {price} \xB7 \uBCF4\uC720 \uC790\uAE08 {cash}\n\uB9E4\uC218 \uB300\uAE08\uC740
      \uAE30\uC874 \uC8FC\uC2DD\uC758 \uB9E4\uB3C4\uC790\uC5D0\uAC8C \uC9C0\uAE09\uB418\uBA70
      \uD68C\uC0AC \uC6B4\uC601\uC790\uAE08\uC5D0 \uBC14\uB85C \uB4E4\uC5B4\uAC00\uB294
      \uB3C8\uC774 \uC544\uB2C8\uB2E4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-065
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uC11C\uC9C0\uC544\uC758 \uC22B\uC790"
    background: {fileID: 21300000, guid: 3da8335e8f928b04ea9542177aaee968, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-mirae-construction-cfo-seo-jia
    voiceLabel: 
    text: "\uC790\uB8CC\uB97C \uBCF4\uC2DC\uACE0 \uC5B4\uB5A4 \uC810\uC744 \uBA3C\uC800
      \uD655\uC778\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
    showPlayer: 1
    goal: 0
    choices:
    - title: "\uC790\uAE08 \uC0C1\uD669\uC744 \uBB3B\uB294\uB2E4"
      playerLine: "\uAC00\uC7A5 \uBA3C\uC800 \uC9C0\uAE09\uD574\uC57C \uD560 \uBE44\uC6A9\uACFC,
        \uD68C\uC218\uD560 \uB3C8\uC758 \uC2DC\uC810\uC744 \uD655\uC778\uD558\uACE0
        \uC2F6\uC2B5\uB2C8\uB2E4."
      response: "\uC88B\uC2B5\uB2C8\uB2E4. \uADF8 \uB458\uC744 \uAC19\uC740 \uD45C\uC5D0
        \uB193\uACE0 \uBCF4\uC8E0."
      targetNpcId: npc-mirae-construction-cfo-seo-jia
      memoryType: 8
      interpretation: "\uCCAB \uBA74\uB2F4\uC5D0\uC11C \uC790\uAE08 \uC9C0\uAE09\uACFC
        \uD68C\uC218 \uC2DC\uC810\uC744 \uD655\uC778\uD588\uB2E4."
      relationDelta:
        trust: 0
        respect: 2
        fear: 0
        hostility: 0
        dependency: 0
        interest: 1
    - title: "\uC131\uC7A5 \uAC00\uB2A5\uC131\uC744 \uBB3B\uB294\uB2E4"
      playerLine: "\uC9C4\uD589 \uC911\uC778 \uC0AC\uC5C5\uC774 \uC815\uC0C1\uD654\uB418\uBA74
        \uC5B4\uB290 \uC815\uB3C4\uAE4C\uC9C0 \uD68C\uBCF5\uD560 \uC218 \uC788\uC2B5\uB2C8\uAE4C?"
      response: "\uAC00\uB2A5\uC131\uC740 \uC788\uC2B5\uB2C8\uB2E4. \uB2E4\uB9CC
        \uC815\uC0C1\uD654\uC5D0 \uD544\uC694\uD55C \uC790\uAE08\uBD80\uD130 \uACC4\uC0B0\uD574\uC57C
        \uD569\uB2C8\uB2E4."
      targetNpcId: npc-mirae-construction-cfo-seo-jia
      memoryType: 8
      interpretation: "\uCCAB \uBA74\uB2F4\uC5D0\uC11C \uC815\uC0C1\uD654\uC640 \uC131\uC7A5\uC758
        \uC870\uAC74\uC744 \uBB3C\uC5C8\uB2E4."
      relationDelta:
        trust: 0
        respect: 0
        fear: 0
        hostility: 0
        dependency: 0
        interest: 2
    - title: "\uAC00\uACA9\uACFC \uBD80\uB2F4\uC744 \uBB3B\uB294\uB2E4"
      playerLine: "\uC9C0\uAE08 \uC0C1\uD669\uC774\uB77C\uBA74 \uB0AE\uC740 \uAC00\uACA9\uB3C4
        \uAC80\uD1A0\uD558\uC2DC\uACA0\uAD70\uC694."
      response: "\uAC80\uD1A0\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uB300\uC2E0
        \uC5B4\uB5A4 \uBD80\uB2F4\uAE4C\uC9C0 \uB9E1\uC73C\uC2E4\uC9C0\uB3C4 \uD568\uAED8
        \uB9D0\uC500\uD574 \uC8FC\uC138\uC694."
      targetNpcId: npc-mirae-construction-cfo-seo-jia
      memoryType: 8
      interpretation: "\uCCAB \uBA74\uB2F4\uC5D0\uC11C \uAC00\uACA9\uACFC \uD568\uAED8
        \uC778\uC218\uC790\uAC00 \uB9E1\uC744 \uBD80\uB2F4\uC744 \uB17C\uC758\uD588\uB2E4."
      relationDelta:
        trust: 0
        respect: 0
        fear: 0
        hostility: 0
        dependency: 0
        interest: 1
    skipDefaultChoice: 0
  - id: intro-066
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uC11C\uC9C0\uC544\uC758 \uC22B\uC790"
    background: {fileID: 21300000, guid: 3da8335e8f928b04ea9542177aaee968, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId: 
    voiceLabel: 
    text: "\uC608\uC804\uC5D0\uB294 \uC800 \uC885\uC774\uB4E4 \uC55E\uC5D0\uC11C
      \uD560 \uC218 \uC788\uB294 \uB9D0\uC774 \uC5C6\uC5C8\uB2E4.\n\uC9C0\uAE08\uC740
      \uBB3B\uACE0, \uB530\uC838\uBCFC \uC218 \uC788\uB2E4. \uD310\uB2E8\uC740 \uADF8\uB2E4\uC74C\uC774\uB2E4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-067
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uCCAB \uC9C0\uBD84"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 1
    npcId: npc-broker-yoon-hajin
    voiceLabel: 
    text: "\uC6B0\uC120 \uC18C\uB7C9\uB9CC \uC0AC\uACA0\uC2B5\uB2C8\uB2E4. \uB354
      \uC54C\uC544\uBCFC \uD544\uC694\uAC00 \uC788\uC5B4\uC694."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-068
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uCCAB \uC9C0\uBD84"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel: 
    text: "\uC88B\uC2B5\uB2C8\uB2E4. \uC218\uB7C9\uACFC \uB9E4\uC218 \uD6C4 \uB0A8\uB294
      \uC790\uAE08\uC744 \uD655\uC778\uD558\uC138\uC694. \uCC98\uC74C\uC5D0\uB294
      1\uC8FC\uB85C \uC2DC\uC791\uD574\uB3C4 \uB429\uB2C8\uB2E4."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-069
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uCCAB \uC9C0\uBD84"
    background: {fileID: 21300000, guid: f2ae5346af09a0045b072d43aaad3d54, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId: 
    voiceLabel: 
    text: "\uC218\uB7C9\xB7\uBCF4\uC720 \uC790\uAE08\uC744 \uD655\uC778\uD55C \uB4A4
      \uBBF8\uB798\uAC74\uC124 \uC8FC\uC2DD\uC744 \uB9E4\uC218\uD558\uC138\uC694."
    showPlayer: 0
    goal: 2
    choices: []
    skipDefaultChoice: 0
  - id: intro-070
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uCCAB \uC9C0\uBD84"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel: 
    text: "\uC774\uC81C \uBBF8\uB798\uAC74\uC124 \uC8FC\uC8FC\uAD70\uC694. \uC2E4\uC81C
      \uBCF4\uC720 \uC8FC\uC2DD\uC740 {shares}\uC8FC, \uB0A8\uC740 \uC790\uAE08\uC740
      {cash}\uC785\uB2C8\uB2E4."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-071
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uCCAB \uC9C0\uBD84"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 1
    npcId: npc-broker-yoon-hajin
    voiceLabel: 
    text: "\uC774 \uC815\uB3C4\uB85C \uB2EC\uB77C\uC9C0\uB294 \uAC8C \uC788\uC2B5\uB2C8\uAE4C?"
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-072
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uCCAB \uC9C0\uBD84"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel: 
    text: "\uB2F9\uC2E0\uC5D0\uAC8C\uB294 \uC788\uC8E0. \uB0B4\uC77C\uBD80\uD130
      \uC800 \uD68C\uC0AC \uC18C\uC2DD\uC744 \uC870\uAE08 \uB354 \uC2E0\uACBD \uC4F0\uAC8C
      \uB420 \uAC81\uB2C8\uB2E4."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-073
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uCCAB \uC9C0\uBD84"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId: 
    voiceLabel: 
    text: "\uC800\uAE30\uAE4C\uC9C0 \uAC00\uB824\uBA74 \uC544\uC9C1 \uBA40\uC5C8\uB2E4.
      \uADF8\uB798\uB3C4 \uC624\uB298\uC740 \uCCAB \uC9C0\uBD84\uC774 \uC0DD\uACBC\uB2E4.\n\uCCAB
      \uC9C0\uBD84 \uB9E4\uC218\uB294 \uACBD\uC601\uAD8C \uC778\uC218 \uC644\uB8CC\uC640
      \uB2E4\uB974\uB2E4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-074
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uAC15\uC900\uD601\uC758 \uC9C8\uBB38"
    background: {fileID: 21300000, guid: 3da8335e8f928b04ea9542177aaee968, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId: 
    voiceLabel: 
    text: "\uB300\uD45C \uBA74\uB2F4\uC740 \uC8FC\uC2DD\uC744 \uC0C0\uB2E4\uB294
      \uC774\uC720\uB85C \uC790\uB3D9 \uBCF4\uC7A5\uB418\uB294 \uC790\uB9AC\uAC00
      \uC544\uB2C8\uB2E4.\n\uC774\uBC88 \uBA74\uB2F4\uC740 \uC724\uD558\uC9C4\uC758
      \uC18C\uAC1C\uB85C \uB9C8\uB828\uB418\uC5C8\uB2E4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-075
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uAC15\uC900\uD601\uC758 \uC9C8\uBB38"
    background: {fileID: 21300000, guid: 3da8335e8f928b04ea9542177aaee968, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-mirae-construction-ceo-kang-junhyeok
    voiceLabel: 
    text: "\uC8FC\uC2DD\uC744 \uC0AC\uC168\uB2E4\uACE0 \uB4E4\uC5C8\uC2B5\uB2C8\uB2E4.
      \uC6B0\uB9AC \uD68C\uC0AC\uC5D0\uC11C \uBB34\uC5C7\uC744 \uBCF4\uC168\uC2B5\uB2C8\uAE4C?"
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-076
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uAC15\uC900\uD601\uC758 \uC9C8\uBB38"
    background: {fileID: 21300000, guid: 3da8335e8f928b04ea9542177aaee968, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 1
    npcId: npc-mirae-construction-ceo-kang-junhyeok
    voiceLabel: 
    text: "\uC9C1\uC811 \uD655\uC778\uD558\uACE0 \uC2F6\uC5B4\uC11C \uC654\uC2B5\uB2C8\uB2E4."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-077
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uAC15\uC900\uD601\uC758 \uC9C8\uBB38"
    background: {fileID: 21300000, guid: 3da8335e8f928b04ea9542177aaee968, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-mirae-construction-ceo-kang-junhyeok
    voiceLabel: 
    text: "\uADF8\uB7FC \uC800\uB3C4 \uD655\uC778\uD558\uC8E0. \uC774 \uD68C\uC0AC\uC5D0
      \uC5BC\uB9C8\uB098 \uC624\uB798 \uACC4\uC2E4 \uC0DD\uAC01\uC785\uB2C8\uAE4C?"
    showPlayer: 1
    goal: 0
    choices:
    - title: "\uC7A5\uAE30\uC801\uC778 \uACBD\uC601 \uCC38\uC5EC"
      playerLine: "\uC131\uC7A5\uC2DC\uD0AC \uC218 \uC788\uB2E4\uB294 \uD310\uB2E8\uC774
        \uC11C\uBA74 \uC624\uB798 \uCC38\uC5EC\uD560 \uC0DD\uAC01\uC785\uB2C8\uB2E4.
        \uC9C0\uAE08\uC740 \uADF8 \uD310\uB2E8\uC5D0 \uD544\uC694\uD55C \uAC83\uC744
        \uD655\uC778\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
      response: "\uADF8 \uC815\uB3C4 \uB2F5\uC774\uBA74 \uB410\uC2B5\uB2C8\uB2E4.
        \uC624\uB298 \uCC98\uC74C \uBCF8 \uC0AC\uB78C\uC5D0\uAC8C \uD3C9\uC0DD \uD568\uAED8\uD558\uACA0\uB2E4\uB294
        \uB9D0\uAE4C\uC9C0 \uB4E3\uACE0 \uC2F6\uC9C4 \uC54A\uC73C\uB2C8\uAE4C\uC694."
      targetNpcId: npc-mirae-construction-ceo-kang-junhyeok
      memoryType: 8
      interpretation: "\uC7A5\uAE30 \uCC38\uC5EC\uB97C \uAC80\uD1A0\uD558\uB418 \uC544\uC9C1
        \uAC80\uC99D\uC774 \uD544\uC694\uD558\uB2E4\uACE0 \uBC1D\uD614\uB2E4."
      relationDelta:
        trust: 0
        respect: 1
        fear: 0
        hostility: 0
        dependency: 0
        interest: 2
    - title: "\uC218\uC775 \uC911\uC2EC\uC758 \uD22C\uC790"
      playerLine: "\uBAA9\uD45C\uD55C \uC218\uC775\uC774 \uB098\uBA74 \uB9E4\uAC01\uD560
        \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4. \uADF8 \uC810\uC740 \uBBF8\uB9AC \uB9D0\uC500\uB4DC\uB9AC\uB294
        \uAC8C \uB9DE\uACA0\uC8E0."
      response: "\uC54C\uACA0\uC2B5\uB2C8\uB2E4. \uADF8\uB7FC \uC6B0\uB9AC\uAC00
        \uD568\uAED8\uD560 \uC218 \uC788\uB294 \uAE30\uAC04\uACFC \uC870\uAC74\uC744
        \uBD84\uBA85\uD788 \uD574\uC57C\uACA0\uAD70\uC694."
      targetNpcId: npc-mirae-construction-ceo-kang-junhyeok
      memoryType: 8
      interpretation: "\uC218\uC775 \uBAA9\uD45C\uC640 \uB9E4\uAC01 \uAC00\uB2A5\uC131\uC744
        \uC194\uC9C1\uD788 \uC54C\uB838\uB2E4."
      relationDelta:
        trust: 0
        respect: 1
        fear: 0
        hostility: 0
        dependency: 0
        interest: 0
    - title: "\uACBD\uC601\uAD8C \uD655\uBCF4 \uAC80\uD1A0"
      playerLine: "\uC5EC\uAC74\uC774 \uB9DE\uC73C\uBA74 \uACBD\uC601\uAD8C \uD655\uBCF4\uAE4C\uC9C0
        \uAC80\uD1A0\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
      response: "\u2026\uADF8\uB807\uB2E4\uBA74 \uC81C\uAC00 \uB9CC\uB4E0 \uD68C\uC0AC\uB97C
        \uC5B4\uB5BB\uAC8C \uC6B4\uC601\uD560 \uC0DD\uAC01\uC778\uC9C0, \uB2E4\uC74C\uC5D0\uB294
        \uC900\uBE44\uD574 \uC624\uC2ED\uC2DC\uC624."
      targetNpcId: npc-mirae-construction-ceo-kang-junhyeok
      memoryType: 8
      interpretation: "\uACBD\uC601\uAD8C \uD655\uBCF4 \uC758\uC0AC\uB97C \uC54C\uB838\uC73C\uBA70
        \uC6B4\uC601 \uACC4\uD68D\uC744 \uC694\uAD6C\uBC1B\uC558\uB2E4."
      relationDelta:
        trust: 0
        respect: 0
        fear: 0
        hostility: 0
        dependency: 0
        interest: 2
    skipDefaultChoice: 0
  - id: intro-078
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uAC15\uC900\uD601\uC758 \uC9C8\uBB38"
    background: {fileID: 21300000, guid: 3da8335e8f928b04ea9542177aaee968, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-mirae-construction-ceo-kang-junhyeok
    voiceLabel: 
    text: "\uD68C\uC0AC \uC774\uB984\uC774 \uC801\uD78C \uACC4\uC57D\uB4E4\uC774
      \uC788\uC2B5\uB2C8\uB2E4. \uADF8 \uACC4\uC57D\uC744 \uBBFF\uACE0 \uD604\uC7A5\uC5D0
      \uB098\uC628 \uC0AC\uB78C\uB4E4\uB3C4 \uC788\uACE0\uC694. \uC55E\uC73C\uB85C
      \uBB34\uC5C7\uC744 \uBC14\uAFB8\uB4E0, \uADF8 \uC0AC\uC2E4\uBD80\uD130 \uC54C\uC544\uC8FC\uC168\uC73C\uBA74
      \uD569\uB2C8\uB2E4."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-079
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uAC15\uC900\uD601\uC758 \uC9C8\uBB38"
    background: {fileID: 21300000, guid: 3da8335e8f928b04ea9542177aaee968, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId: 
    voiceLabel: 
    text: "\uC800 \uC0AC\uB78C\uB3C4 \uC9C0\uD0A4\uB824\uB294 \uAC8C \uC788\uB2E4.
      \uB0B4\uAC00 \uC5EC\uAE30 \uC628 \uC774\uC720\uC640\uB294 \uB2E4\uB978 \uC774\uC720\uB85C."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-080
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uAC15\uC900\uD601\uC758 \uC9C8\uBB38"
    background: {fileID: 21300000, guid: 3da8335e8f928b04ea9542177aaee968, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId: 
    voiceLabel: 
    text: "\uAC15\uC900\uD601\uC758 \uC778\uBB3C \uC815\uBCF4\uB97C \uD655\uC778\uD558\uC138\uC694.
      \uC778\uBB3C\uB9C8\uB2E4 \uC911\uC694\uD558\uAC8C \uC5EC\uAE30\uB294 \uC870\uAC74\uC774
      \uB2E4\uB985\uB2C8\uB2E4."
    showPlayer: 0
    goal: 3
    choices: []
    skipDefaultChoice: 0
  - id: intro-081
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uD68C\uC758\uC2E4 \uBC16\uC758
      \uD68C\uC0AC"
    background: {fileID: 21300000, guid: cd737e0de23899c4b9fc897defc1bbbb, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-mirae-construction-field-director-park-dosik
    voiceLabel: 
    text: "\uC774\uAC70 \uC4F0\uC2ED\uC2DC\uC624. \uC548\uC73C\uB85C \uB4E4\uC5B4\uC624\uC2E4
      \uAC70\uBA74\uC694."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-082
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uD68C\uC758\uC2E4 \uBC16\uC758
