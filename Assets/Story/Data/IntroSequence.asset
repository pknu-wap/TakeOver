  - id: intro-089
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uCCAB\uB0A0\uC758 \uB05D"
    background: {fileID: 21300000, guid: f2ae5346af09a0045b072d43aaad3d54, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 4
    npcId:
    voiceLabel:
    text: "\uB300\uC2DC\uBCF4\uB4DC\uC758 \uD558\uB8E8 \uC885\uB8CC \uBC84\uD2BC\uC744
      \uB20C\uB7EC \uB2E4\uC74C \uB0A0\uB85C \uC9C4\uD589\uD558\uC138\uC694."
    showPlayer: 0
    goal: 5
    companyId:
    tutorialTitle: "\uD558\uB8E8 \uC885\uB8CC"
    tutorialText: "\uD558\uB8E8 \uB9C8\uAC10\uC744 \uB204\uB974\uBA74 \uB2E4\uC74C
      \uB0A0\uB85C \uB118\uC5B4\uAC11\uB2C8\uB2E4. \uD589\uB3D9 \uD3EC\uC778\uD2B8\uAC00
      \uD68C\uBCF5\uB418\uACE0 \uD68C\uC0AC\uC640 \uC0AC\uAC74\uC774 \uAC31\uC2E0\uB429\uB2C8\uB2E4."
