  - id: neutral-intro-T3-help
    sceneTitle: "\uAE40\uD0DC\uC131 \u2014 \uC88B\uC544 \uBCF4\uC774\uB294\uB370
      \uC65C \uC548 \uC0AC\uC2ED\uB2C8\uAE4C"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 4
    npcId:
    voiceLabel:
    text: "\uAE40\uD0DC\uC131\uCC98\uB7FC \uC678\uBD80 \uC790\uBCF8\uC744 \uB2E4\uB8E8\uB294
      \uC778\uBB3C\uACFC\uB3C4 \uC0AC\uAC74\uC744 \uC9C4\uD589\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
      \uCCAB \uB9CC\uB0A8\uC774\uB098 \uC88B\uC740 \uAD00\uACC4\uB9CC\uC73C\uB85C
      \uD22C\uC790\uAE08\uC774 \uC9C0\uAE09\uB418\uC9C0\uB294 \uC54A\uC2B5\uB2C8\uB2E4.
      \uC2E4\uC81C \uC790\uAE08 \uAC70\uB798\uAC00 \uD3EC\uD568\uB41C \uC81C\uC548\uC740
      \uBE44\uC6A9\xB7\uC870\uAC74\xB7\uACB0\uACFC\uB97C \uBCC4\uB3C4\uB85C \uD655\uC778\uD574\uC57C
      \uD569\uB2C8\uB2E4. \uC774\uBC88 \uC7A5\uBA74\uC5D0\uC11C\uB294 \uD604\uAE08\uACFC
      \uC9C0\uBD84\uC774 \uBCC0\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle: "\uC678\uBD80 \uC778\uBB3C\uACFC\uC758 \uB9CC\uB0A8"
    tutorialText: "\uAE40\uD0DC\uC131\uCC98\uB7FC \uC678\uBD80 \uC790\uBCF8\uC744
      \uB2E4\uB8E8\uB294 \uC778\uBB3C\uACFC\uB3C4 \uC0AC\uAC74\uC744 \uC9C4\uD589\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uCCAB \uB9CC\uB0A8\uC774\uB098 \uC88B\uC740
      \uAD00\uACC4\uB9CC\uC73C\uB85C \uD22C\uC790\uAE08\uC774 \uC9C0\uAE09\uB418\uC9C0\uB294
      \uC54A\uC2B5\uB2C8\uB2E4. \uC2E4\uC81C \uC790\uAE08 \uAC70\uB798\uAC00 \uD3EC\uD568\uB41C
      \uC81C\uC548\uC740 \uBE44\uC6A9\xB7\uC870\uAC74\xB7\uACB0\uACFC\uB97C \uBCC4\uB3C4\uB85C
      \uD655\uC778\uD574\uC57C \uD569\uB2C8\uB2E4. \uC774\uBC88 \uC7A5\uBA74\uC5D0\uC11C\uB294
      \uD604\uAE08\uACFC \uC9C0\uBD84\uC774 \uBCC0\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    choices: []
    skipDefaultChoice: 0
  - id: lesson-033
    sceneTitle: "\uB458\uC9F8 \uB0A0  /  \uD68C\uC0AC\uC758 \uC22B\uC790"
