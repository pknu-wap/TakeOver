    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uCCAB\uB0A0\uC758 \uB05D"
    background: {fileID: 21300000, guid: f2ae5346af09a0045b072d43aaad3d54, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 4
    npcId:
    voiceLabel:
    text: "\ub300\uc2dc\ubcf4\ub4dc\uc758 \ud558\ub8e8 \uc885\ub8cc \ubc84\ud2bc\uc744 \ub20c\ub7ec \ub2e4\uc74c \ub0a0\ub85c \uc9c4\ud589\ud558\uc138\uc694."
    showPlayer: 0
    goal: 5
    tutorialTitle: "\ud558\ub8e8 \uc885\ub8cc"
    tutorialText: "\uc77c\uc815\uc744 \ub9c8\ucce4\ub2e4\uba74 \ub300\uc2dc\ubcf4\ub4dc\uc758 \ud558\ub8e8 \uc885\ub8cc\ub97c \uc120\ud0dd\ud574 \uc8fc\uc2ed\uc2dc\uc624. \ub2e4\uc74c \ub0a0\uc5d0\ub294 \uae30\uc5c5 \uc815\ubcf4\uc640 \uc774\ubca4\ud2b8\uac00 \uac31\uc2e0\ub418\uba70 \ud589\ub3d9 \ud3ec\uc778\ud2b8\uac00 \ucd5c\ub300\uce58\uae4c\uc9c0 \ud68c\ubcf5\ub429\ub2c8\ub2e4. \ub300\ud654\uc640 \uc7a5\uba74 \uc804\ud658 \uc790\uccb4\uc5d0\ub294 \ub0a0\uc9dc\uc640 \ud589\ub3d9 \ud3ec\uc778\ud2b8\uac00 \uc18c\ubaa8\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
    choices: []
    skipDefaultChoice: 0
  - id: intro-090
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uCCAB\uB0A0\uC758 \uB05D"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-mirae-construction-cfo-seo-jia
    voiceLabel:
    text: "\ub0b4\uc77c \ub2e4\uc2dc \ubcf4\uc2dc\uc8e0. \uc624\ub298 \ubabb \ubcf8 \uc790\ub8cc\ub3c4 \ucc59\uaca8\ub458\uac8c\uc694. \uc8fc\uc2dd\uc744 \uc0c0\ub2e4\uace0 \ud68c\uc0ac \uc0ac\uc815\uc744 \ub2e4 \uc544\ub294 \uac74 \uc544\ub2c8\ub2c8\uae4c\uc694."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-091
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uCCAB\uB0A0\uC758 \uB05D"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel:
    text: "\ubbf8\ub798\uac74\uc124 \ub9d0\uace0\ub3c4 \ubcfc \ud68c\uc0ac\ub294 \uc788\uc2b5\ub2c8\ub2e4. \ud558\ub298\uc2dd\ud488, \ub3d9\ubc29\ubb3c\uc0b0, \ud55c\uc131\uacf5\uc5c5. \uac01\uc790 \uc6d0\ud558\ub294 \uac83\uc774 \ub2e4\ub974\uc8e0."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-092
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uCCAB\uB0A0\uC758 \uB05D"
    background: {fileID: 21300000, guid: f2ae5346af09a0045b072d43aaad3d54, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\ub354 \ud070 \uac70\ub798\uc5d0\ub294 \ub2e4\uc12f \uac08\ub798\uc758 \uacbd\uc7c1\uc774 \uae30\ub2e4\ub9b0\ub2e4. \ud3f4\ub77c\ub9ac\uc2a4\uc758 \uc790\uae08, \ub300\uc131\uc758 \uacf5\uae09\ub9dd, \uc2e0\uc131\uc758 \uac1c\ubc1c\uad8c, \ube14\ub8e8\ud558\ubc84\uc758 \ud310\ub9e4\ub9dd, \uc624\ub85c\ub77c\uc758 \uc2e0\uae30\uc220. \uac01 \ud68c\uc0ac\uc758 \uc778\ubb3c\ub4e4\uc740 \uc11c\ub85c \ub2e4\ub978 \uc774\ud574\uad00\uacc4\ub97c \uac00\uc9c0\uace0 \uc788\ub2e4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: lesson-001
    sceneTitle: "\ub458\uc9f8 \ub0a0  /  \ub4e4\uc5b4\uc628 \uc5f0\ub77d"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel: ""
    text: "\uc11c\uc9c0\uc544 \uc528\ud55c\ud14c \ub610 \uc5f0\ub77d\uc774 \uc654\ub124\uc694. \uc5b4\uc81c \ubabb \ud55c \uc598\uae30\uac00 \uc788\ub098 \ubd05\ub2c8\ub2e4."
    showPlayer: 1
    goal: 0
    companyId:
    choices: []
    skipDefaultChoice: 0
  - id: lesson-002
    sceneTitle: "\ub458\uc9f8 \ub0a0  /  \ub4e4\uc5b4\uc628 \uc5f0\ub77d"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 1
    npcId: npc-broker-yoon-hajin
    voiceLabel: ""
    text: "\ubb34\uc2a8 \uc598\uae34\uc9c0\ubd80\ud130 \uc77d\uc5b4\ubcf4\uc8e0. \ub9cc\ub0a0\uc9c0\ub294 \uadf8\ub2e4\uc74c\uc5d0 \uc815\ud558\uace0\uc694."
    showPlayer: 1
    goal: 0
    companyId:
    choices: []
    skipDefaultChoice: 0
  - id: lesson-003
    sceneTitle: "\ub458\uc9f8 \ub0a0  /  \ub4e4\uc5b4\uc628 \uc5f0\ub77d"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 4
    npcId:
    voiceLabel: ""
    text: "\ub300\uc2dc\ubcf4\ub4dc\uc758 \uc774\ubca4\ud2b8 \uce74\ub4dc\uc5d0\uc11c \u2018\uc790\uc138\ud788 \ubcf4\uae30\u2019\ub97c \uc120\ud0dd\ud558\uba74 \uc694\uccad \ub0b4\uc6a9\uacfc \uba74\ub2f4 \ube44\uc6a9\uc744 \ud655\uc778\ud558\uc2e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub0b4\uc6a9 \ud655\uc778\ub9cc\uc73c\ub85c\ub294 \ud589\ub3d9 \ud3ec\uc778\ud2b8\uac00 \uc18c\ubaa8\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle: "\uc774\ubca4\ud2b8 \ud655\uc778"
    choices: []
    skipDefaultChoice: 0
  - id: lesson-004
    sceneTitle: "\ub458\uc9f8 \ub0a0  /  \ub4e4\uc5b4\uc628 \uc5f0\ub77d"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel: ""
    text: "\uc11c\uc9c0\uc544 \uc528\uac00 {eventDays}\uc77c \uc548\uc5d0 \ub2f5\uc744 \ub2ec\ub78d\ub2c8\ub2e4. \ub108\ubb34 \ubbf8\ub918\ub2e4\uac00 \uae30\ud68c\ub97c \ub193\uce58\uc9c4 \ub9c8\uc138\uc694."
    showPlayer: 1
    goal: 0
    companyId:
    choices: []
    skipDefaultChoice: 0
  - id: lesson-006
    sceneTitle: "\ub458\uc9f8 \ub0a0  /  \uc624\ub298 \uc4f8 \uc2dc\uac04"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 1
    npcId: npc-broker-yoon-hajin
    voiceLabel: ""
    text: "\uc624\ub298 \uc57d\uc18d\uc744 \uba87 \uac1c\ub098 \ub354 \uc7a1\uc744 \uc218 \uc788\uc744\uae4c\uc694?"
    showPlayer: 1
    goal: 0
    companyId:
    choices: []
    skipDefaultChoice: 0
  - id: lesson-007
    sceneTitle: "\ub458\uc9f8 \ub0a0  /  \uc624\ub298 \uc4f8 \uc2dc\uac04"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 4
    npcId:
    voiceLabel: ""
    text: "\ud604\uc7ac \ud589\ub3d9 \ud3ec\uc778\ud2b8\ub294 {ap}/{maxAp}\uc785\ub2c8\ub2e4. \uc774 \uba74\ub2f4\uc744 \uc2dc\uc791\ud558\uba74 {apCost}\uac00 \uc18c\ubaa8\ub418\uba70 \ub2f5\ubcc0 \uc120\ud0dd\uc5d0\ub294 \ucd94\uac00\ub85c \uc18c\ubaa8\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.\n\n\ud589\ub3d9 \ud3ec\uc778\ud2b8\uac00 \ubd80\uc871\ud558\uba74 \uba74\ub2f4\uc744 \uc2dc\uc791\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \ud558\ub8e8\ub97c \uc885\ub8cc\ud558\uba74 \ub2e4\uc74c \ub0a0 \ucd5c\ub300\uce58\uae4c\uc9c0 \ud68c\ubcf5\ub429\ub2c8\ub2e4."
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle: "\uc77c\uc815\uacfc \ud589\ub3d9 \ud3ec\uc778\ud2b8"
    choices: []
    skipDefaultChoice: 0
  - id: lesson-008
    sceneTitle: "\ub458\uc9f8 \ub0a0  /  \uc624\ub298 \uc4f8 \uc2dc\uac04"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 1
    npcId: npc-broker-yoon-hajin
    voiceLabel: ""
    text: "\uc9c1\uc811 \ub4e4\uc5b4\ubd24\ub294\ub370 \ub9c8\uc74c\uc5d0 \uc548 \ub4e4\uba74, \uadf8 \uc790\ub9ac\uc5d0\uc11c \uac70\uc808\ud574\ub3c4 \ub418\uaca0\uc8e0?"
    showPlayer: 1
    goal: 0
    companyId:
    choices: []
    skipDefaultChoice: 0
  - id: lesson-009
    sceneTitle: "\ub458\uc9f8 \ub0a0  /  \uc624\ub298 \uc4f8 \uc2dc\uac04"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel: ""
    text: "\uadf8\ub7fc\uc694. \ub2e4\ub9cc \ub9cc\ub098\ub7ec \ub2e4\ub140\uc628 \uc2dc\uac04\uae4c\uc9c0 \ub3cc\ub824\ubc1b\uc744 \uc21c \uc5c6\uc8e0. \uc598\uae30\ub97c \ub4e4\uc5b4\ubcfc \ub9cc\ud55c \uc0ac\ub78c\uc778\uc9c0 \uba3c\uc800 \uc0b4\ud3b4\ubcf4\uc138\uc694."
    showPlayer: 1
    goal: 0
    companyId:
    choices: []
    skipDefaultChoice: 0
  - id: lesson-011
    sceneTitle: "\ub458\uc9f8 \ub0a0  /  \uc624\ub298 \uc4f8 \uc2dc\uac04"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel: ""
    text: "\uc77d\uc5b4\ubcf4\uace0 \uc598\uae30\ub97c \ub098\ub20c \ub9cc\ud558\ub2e4 \uc2f6\uc73c\uba74 \ub9cc\ub098\ubcf4\uc138\uc694. \ub2f5\uc740 \uc9c1\uc811 \uc815\ud558\uc2dc\uace0\uc694. \ub2e4\ub140\uc624\uc2dc\uba74 \uc5b4\ub5bb\uac8c \ub410\ub294\uc9c0 \uac19\uc774 \ubcf4\uc8e0."
    showPlayer: 1
    goal: 0
    companyId:
    choices: []
    skipDefaultChoice: 0
  - id: lesson-005
    sceneTitle: "\ub458\uc9f8 \ub0a0  /  \ub4e4\uc5b4\uc628 \uc5f0\ub77d"
    background: {fileID: 21300000, guid: f2ae5346af09a0045b072d43aaad3d54, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 4
    npcId:
    voiceLabel: ""
    text: "\uc11c\uc9c0\uc544\uc758 \uc774\ubca4\ud2b8 \uce74\ub4dc\ub97c \uc5f4\uc5b4 \uc694\uccad \ub0b4\uc6a9\uc744 \ud655\uc778\ud558\uc138\uc694."
    showPlayer: 0
    goal: 6
    companyId:
    choices: []
    skipDefaultChoice: 0
  - id: lesson-012
    sceneTitle: "\ub458\uc9f8 \ub0a0  /  \uc624\ub298 \uc4f8 \uc2dc\uac04"
    background: {fileID: 21300000, guid: f2ae5346af09a0045b072d43aaad3d54, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 4
    npcId:
    voiceLabel: ""
    text: "\uc11c\uc9c0\uc544\uc640 \ub9cc\ub098 \uc9c1\uc811 \ub2f5\ubcc0\ud558\uace0, \uc751\ub2f5\uc744 \ud655\uc778\ud55c \ub4a4 \ub300\ud654\ub97c \ub2eb\uc73c\uc138\uc694."
    showPlayer: 0
    goal: 7
    companyId:
    choices: []
    skipDefaultChoice: 0
  - id: lesson-013
    sceneTitle: "\ub458\uc9f8 \ub0a0  /  \ub9d0\uc774 \ub0a8\uae34 \uac83"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel: ""
    text: "\uc5b4\ub5bb\uac8c \ub410\uc2b5\ub2c8\uae4c? \uc88b\uac8c \uc778\uc0ac\ud588\ub2e4\uace0 \uc18d\ub9c8\uc74c\uae4c\uc9c0 \uc54c \uc218 \uc788\ub294 \uac74 \uc544\ub2c8\uc8e0. \uc5b4\ub5a4 \uc598\uae30\ub97c \ub098\ub234\ub294\uc9c0\ubd80\ud130 \ubd05\uc2dc\ub2e4."
    showPlayer: 1
    goal: 0
    companyId:
    choices: []
    skipDefaultChoice: 0
  - id: lesson-014
    sceneTitle: "\ub458\uc9f8 \ub0a0  /  \ub9d0\uc774 \ub0a8\uae34 \uac83"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
