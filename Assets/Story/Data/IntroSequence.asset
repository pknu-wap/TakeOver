  - id: neutral-intro-T4-choice
    sceneTitle: "\uBC15\uC0C1\uD604 \u2014 \uC548\uB0B4\uD574 \uB4DC\uB9B4 \uC218
      \uC788\uB294 \uAC83"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-political-lobbyist-park-sanghyeon
    voiceLabel:
    text: "\uC5B4\uB5A4 \uC0DD\uAC01\uC774\uC2E0\uC9C0 \uB4E3\uACE0 \uC2F6\uC2B5\uB2C8\uB2E4."
    showPlayer: 1
