  - id: intro-085
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uD68C\uC758\uC2E4 \uBC16\uC758
      \uD68C\uC0AC"
    background: {fileID: 21300000, guid: cd737e0de23899c4b9fc897defc1bbbb, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-mirae-construction-field-director-park-dosik
    voiceLabel: 
    text: "\uC0AC\uB78C \uC904\uC774\uB294 \uC774\uC57C\uAE30\uAC00 \uB098\uC62C
      \uB54C\uB9C8\uB2E4 \uACF5\uC0AC \uC77C\uC815\uC740 \uADF8\uB300\uB85C\uB354\uAD70\uC694.
      \uC774\uBC88\uC5D0\uB3C4 \uADF8\uB7EC\uB294\uC9C0 \uAD81\uAE08\uD569\uB2C8\uB2E4."
    showPlayer: 1
    goal: 0
    choices:
    - title: "\uC791\uC5C5\uB7C9\uACFC \uC77C\uC815\uBD80\uD130 \uD655\uC778\uD55C\uB2E4"
      playerLine: "\uC778\uC6D0\uC5D0 \uB300\uD574 \uC57D\uC18D\uD558\uAE30 \uC804\uC5D0
        \uC791\uC5C5\uB7C9\uACFC \uC77C\uC815\uC744 \uBCF4\uACA0\uC2B5\uB2C8\uB2E4.
        \uC5B4\uB5A4 \uBB38\uC81C\uAC00 \uC788\uB294\uC9C0 \uC124\uBA85\uD574 \uC8FC\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
      response: "\uC608. \uC774\uCABD\uBD80\uD130 \uBCF4\uC2DC\uC8E0. \uC11C\uB958\uC5D0
        \uC801\uD78C \uC778\uC6D0\uD558\uACE0 \uC2E4\uC81C\uB85C \uD22C\uC785\uD560
        \uC218 \uC788\uB294 \uC778\uC6D0\uC774 \uB2E4\uB985\uB2C8\uB2E4."
      targetNpcId: npc-mirae-construction-field-director-park-dosik
      memoryType: 8
      interpretation: "\uC778\uC6D0\uC744 \uC57D\uC18D\uD558\uAE30 \uC804\uC5D0 \uC791\uC5C5\uB7C9\uACFC
        \uC2E4\uC81C \uD22C\uC785 \uC5EC\uAC74\uC744 \uD655\uC778\uD558\uACA0\uB2E4\uACE0
        \uD588\uB2E4."
      relationDelta:
        trust: 0
        respect: 2
        fear: 0
        hostility: 0
        dependency: 0
        interest: 0
    - title: "\uACE0\uC6A9 \uC720\uC9C0\uB97C \uC6B0\uC120\uD558\uACA0\uB2E4\uACE0
        \uC57D\uC18D\uD55C\uB2E4"
      playerLine: "\uC81C\uAC00 \uACBD\uC601\uC5D0 \uCC38\uC5EC\uD558\uAC8C \uB41C\uB2E4\uBA74
        \uD604\uC7A5 \uACE0\uC6A9\uC744 \uC9C0\uD0A4\uB294 \uAC78 \uC6B0\uC120\uD558\uACA0\uC2B5\uB2C8\uB2E4."
      response: "\uADF8 \uB9D0\uC500\uC740 \uAE30\uC5B5\uD558\uACA0\uC2B5\uB2C8\uB2E4.
        \uC544\uC9C1 \uACB0\uC815\uD560 \uC704\uCE58\uAC00 \uC544\uB2C8\uC2DC\uB77C\uB294
        \uAC83\uB3C4\uC694."
      targetNpcId: npc-mirae-construction-field-director-park-dosik
      memoryType: 8
      interpretation: "\uACBD\uC601 \uCC38\uC5EC \uC2DC \uACE0\uC6A9 \uC720\uC9C0\uB97C
        \uC6B0\uC120\uD558\uACA0\uB2E4\uACE0 \uC57D\uC18D\uD588\uB2E4. \uC2E4\uC81C
        \uC774\uD589\uC740 \uC544\uC9C1 \uD655\uC778\uB418\uC9C0 \uC54A\uC558\uB2E4."
      relationDelta:
        trust: 0
        respect: 0
        fear: 0
        hostility: 0
        dependency: 0
        interest: 1
    - title: "\uD604\uC7A5 \uC0C1\uD669\uACFC \uBE44\uC6A9\uC744 \uD568\uAED8 \uAC80\uD1A0\uD55C\uB2E4"
      playerLine: "\uC778\uAC74\uBE44\uB3C4 \uAC80\uD1A0\uD574\uC57C \uD569\uB2C8\uB2E4.
        \uB2E4\uB9CC \uD604\uC7A5 \uC0C1\uD669\uC744 \uB4E3\uACE0 \uD310\uB2E8\uD558\uACA0\uC2B5\uB2C8\uB2E4."
      response: "\uAC80\uD1A0\uD558\uC2ED\uC2DC\uC624. \uB300\uC2E0 \uC0AC\uB78C\uC774
        \uBE60\uC9C0\uBA74 \uC5B4\uB5A4 \uC791\uC5C5\uC774 \uBA48\uCD94\uB294\uC9C0\uB3C4
        \uAC19\uC774 \uC801\uC5B4\uC8FC\uC2ED\uC2DC\uC624."
      targetNpcId: npc-mirae-construction-field-director-park-dosik
      memoryType: 8
      interpretation: "\uBE44\uC6A9\uC744 \uAC80\uD1A0\uD558\uB418 \uD604\uC7A5 \uC0C1\uD669\uC744
        \uB4E3\uACE0 \uD310\uB2E8\uD558\uACA0\uB2E4\uACE0 \uD588\uB2E4."
      relationDelta:
        trust: 0
        respect: 0
        fear: 0
        hostility: 0
        dependency: 0
        interest: 1
    skipDefaultChoice: 0
  - id: intro-086
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uD68C\uC758\uC2E4 \uBC16\uC758
      \uD68C\uC0AC"
    background: {fileID: 21300000, guid: cd737e0de23899c4b9fc897defc1bbbb, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId: 
    voiceLabel: 
    text: "\uB098\uC5D0\uAC8C\uB294 \uCCAB \uD22C\uC790\uB2E4. \uC774 \uC0AC\uB78C\uB4E4\uC5D0\uAC8C\uB294
      \uB0B4\uC77C\uB3C4 \uB098\uC640\uC57C \uD558\uB294 \uC9C1\uC7A5\uC774\uB2E4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-087
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uD68C\uC758\uC2E4 \uBC16\uC758
      \uD68C\uC0AC"
    background: {fileID: 21300000, guid: cd737e0de23899c4b9fc897defc1bbbb, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId: 
    voiceLabel: 
    text: "\uBC15\uB3C4\uC2DD\uC758 \uC778\uBB3C \uC815\uBCF4\uB97C \uC5F4\uC5B4
      \uC774\uBC88 \uB300\uD654\uC758 \uAD00\uACC4 \uBCC0\uD654\uC640 \uAE30\uC5B5\uC744
      \uD655\uC778\uD558\uC138\uC694."
    showPlayer: 0
    goal: 4
    choices: []
    skipDefaultChoice: 0
  - id: intro-088
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uCCAB\uB0A0\uC758 \uB05D"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId: 
    voiceLabel: 
    text: "\uB300\uD654\uC640 \uC7A5\uBA74 \uC804\uD658\uB9CC\uC73C\uB85C \uB0A0\uC9DC\uB098
      \uD589\uB3D9\uB825\uC740 \uC18C\uBE44\uB418\uC9C0 \uC54A\uC558\uB2E4.\n\uC774\uC81C
      \uC2E4\uC81C \uD558\uB8E8\uB97C \uB9C8\uAC10\uD574 \uAE30\uC5C5 \uC815\uBCF4\uC640
      \uD589\uB3D9\uB825\uC774 \uAC31\uC2E0\uB418\uB294 \uAC83\uC744 \uD655\uC778\uD558\uC790."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-089
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uCCAB\uB0A0\uC758 \uB05D"
    background: {fileID: 21300000, guid: f2ae5346af09a0045b072d43aaad3d54, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId: 
    voiceLabel: 
    text: "\uB300\uC2DC\uBCF4\uB4DC\uC758 \uD558\uB8E8 \uC885\uB8CC \uBC84\uD2BC\uC744
      \uB20C\uB7EC \uB2E4\uC74C \uB0A0\uB85C \uC9C4\uD589\uD558\uC138\uC694."
    showPlayer: 0
    goal: 5
    choices: []
    skipDefaultChoice: 0
  - id: intro-090
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uCCAB\uB0A0\uC758 \uB05D"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-mirae-construction-cfo-seo-jia
    voiceLabel: 
    text: "\uB2E4\uC74C \uD68C\uC758\uC5D0\uC11C\uB294 \uACBD\uC601 \uCC38\uC5EC
      \uC870\uAC74\uC744 \uC774\uC57C\uAE30\uD558\uC8E0. \uCCAB \uAC70\uB798\uAC00
      \uB05D\uB0AC\uB2E4\uACE0 \uD68C\uC0AC\uC758 \uBB38\uC81C\uAC00 \uB05D\uB09C
      \uAC74 \uC544\uB2C8\uB2C8\uAE4C\uC694."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-091
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uCCAB\uB0A0\uC758 \uB05D"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel: 
    text: "\uBBF8\uB798\uAC74\uC124 \uB9D0\uACE0\uB3C4 \uBCFC \uD68C\uC0AC\uB294
      \uC788\uC2B5\uB2C8\uB2E4. \uD558\uB298\uC2DD\uD488, \uB3D9\uBC29\uBB3C\uC0B0,
      \uD55C\uC131\uACF5\uC5C5. \uAC01\uC790 \uC6D0\uD558\uB294 \uAC83\uC774 \uB2E4\uB974\uC8E0."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-092
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uCCAB\uB0A0\uC758 \uB05D"
    background: {fileID: 21300000, guid: f2ae5346af09a0045b072d43aaad3d54, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId: 
    voiceLabel: 
    text: "\uB354 \uD070 \uAC70\uB798\uC5D0\uB294 \uB2E4\uC12F \uAC08\uB798\uC758
      \uACBD\uC7C1\uC774 \uAE30\uB2E4\uB9B0\uB2E4.\n\uD3F4\uB77C\uB9AC\uC2A4\uC758
      \uC790\uAE08, \uB300\uC131\uC758 \uACF5\uAE09\uB9DD, \uC2E0\uC131\uC758 \uAC1C\uBC1C\uAD8C,
      \uBE14\uB8E8\uD558\uBC84\uC758 \uD310\uB9E4\uB9DD, \uC624\uB85C\uB77C\uC758
      \uC2E0\uAE30\uC220.\n\uAC01 \uD68C\uC0AC\uC758 \uC778\uBB3C\uB4E4\uC740 \uC11C\uB85C
      \uB2E4\uB978 \uC774\uD574\uAD00\uACC4\uB97C \uAC00\uC9C0\uACE0 \uC788\uB2E4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-093
    sceneTitle: "\uB3C4\uC785\uBD80 \uC644\uB8CC  /  \uCCAB \uBC88\uC9F8 \uC8FC\uC8FC"
    background: {fileID: 21300000, guid: f2ae5346af09a0045b072d43aaad3d54, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId: 
    voiceLabel: 
    text: "\uD604\uC7AC {turn}\uC77C \xB7 \uBBF8\uB798\uAC74\uC124 {shares}\uC8FC
      \xB7 \uBCF4\uC720 \uC790\uAE08 {cash}\n\uC774\uC81C \uB3C4\uC2DC\uB9F5\uACFC
      \uC778\uBB3C \uC815\uBCF4, \uD611\uC0C1\uC744 \uC790\uC720\uB86D\uAC8C \uD0D0\uC0C9\uD560
      \uC218 \uC788\uB2E4.\n\uC5B4\uB5A4 \uAC70\uB798\uB85C \uBAA9\uD45C\uC5D0 \uB2E4\uAC00\uAC08\uC9C0\uB294
      \uB0B4 \uC120\uD0DD\uC5D0 \uB2EC\uB824 \uC788\uB2E4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
