    npcId: npc-broker-yoon-hajin
    voiceLabel:
    text: "\uC18C\uAC1C \uC815\uB3C4\uB9CC \uD574\uB4DC\uB838\uC5B4\uC694. \uBB34\uC2A8
      \uC77C\uC744 \uD558\uC2DC\uB294\uC9C0\uB294 \uC9C1\uC811 \uB9D0\uC500\uD558\uC2DC\uC8E0."
