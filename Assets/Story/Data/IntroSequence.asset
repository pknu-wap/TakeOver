  dialoguePanel: {fileID: 0}
  beats:
  - id: intro-001
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uB9C8\uC9C0\uB9C9 \uB0A9\uD488"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\uACFC\uAC70, \uAC00\uC871 \uD68C\uC0AC\uC758 \uC0AC\uBB34\uC2E4. \uBB38
      \uB108\uBA38\uC5D0\uC11C\uB294 \uB9C8\uC9C0\uB9C9 \uB0A9\uD488\uC744 \uC900\uBE44\uD558\uB294
      \uC18C\uB9AC\uAC00 \uB4E4\uB9B0\uB2E4."
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: intro-002
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uB9C8\uC9C0\uB9C9 \uB0A9\uD488"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 3
    npcId:
    voiceLabel: "\uAC00\uC871"
    text: "\uC774\uBC88 \uBB3C\uB7C9\uAE4C\uC9C0 \uB9C8\uCE58\uBA74 \uD55C\uC228
      \uB3CC\uB9AC\uACA0\uB124. \uBC00\uB9B0 \uC815\uBE44\uB3C4 \uD558\uACE0."
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: intro-003
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uB9C8\uC9C0\uB9C9 \uB0A9\uD488"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 1
    npcId:
    voiceLabel:
    text: "\uC785\uAE08\uC740 \uC608\uC815\uB300\uB85C \uB41C\uB300\uC694?"
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: intro-004
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uB9C8\uC9C0\uB9C9 \uB0A9\uD488"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 3
    npcId:
    voiceLabel: "\uAC00\uC871"
    text: "\uACC4\uC57D\uC11C\uC5D0 \uC801\uD600 \uC788\uC796\uC544. \uC6B0\uB9B0
      \uB0A0\uC9DC \uB9DE\uCDB0 \uBCF4\uB0C8\uC73C\uB2C8, \uC800\uCABD\uB3C4 \uC9C0\uD0A4\uACA0\uC9C0."
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: intro-005
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uB9C8\uC9C0\uB9C9 \uB0A9\uD488"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\uC804\uD654\uAC00 \uC6B8\uB9B0\uB2E4. \uAC00\uC871\uC758 \uD45C\uC815\uC774
      \uAD73\uB294\uB2E4."
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: intro-006
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uB9C8\uC9C0\uB9C9 \uB0A9\uD488"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 3
    npcId:
    voiceLabel: "\uADF8\uB8F9 \uB2F4\uB2F9\uC790 \xB7 \uC804\uD654"
    text: "\uAC80\uC218\uAC00 \uCD94\uAC00\uB85C \uD544\uC694\uD569\uB2C8\uB2E4.
      \uC9C0\uAE09 \uC77C\uC815\uC740 \uB2E4\uC2DC \uC548\uB0B4\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4."
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: intro-007
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uB9C8\uC9C0\uB9C9 \uB0A9\uD488"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 3
    npcId:
    voiceLabel: "\uAC00\uC871"
    text: "\uCD94\uAC00 \uAC80\uC218\uC694? \uC9C0\uB09C\uC8FC\uC5D0 \uD655\uC778\uAE4C\uC9C0
      \uB05D\uB0AC\uB294\uB370\uC694. \uC774\uBC88 \uC8FC\uAC00 \uAE09\uC5EC\uC77C\uC785\uB2C8\uB2E4."
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: intro-008
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uB9C8\uC9C0\uB9C9 \uB0A9\uD488"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 3
    npcId:
    voiceLabel: "\uADF8\uB8F9 \uB2F4\uB2F9\uC790 \xB7 \uC804\uD654"
    text: "\uB0B4\uBD80 \uAE30\uC900\uC774 \uBCC0\uACBD\uB410\uC2B5\uB2C8\uB2E4.
      \uC800\uD76C \uCABD\uC5D0\uC11C\uB3C4 \uC2B9\uC778 \uC5C6\uC774\uB294 \uC9C4\uD589\uD560
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: intro-009
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uB9C8\uC9C0\uB9C9 \uB0A9\uD488"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\uD1B5\uD654\uAC00 \uB05D\uB0AC\uB2E4. \uAC00\uC871\uC740 \uB2EC\uB825\uC5D0
      \uADF8\uB824 \uB454 \uC9C0\uAE09\uC77C\uC758 \uB3D9\uADF8\uB77C\uBBF8\uB97C
      \uC9C0\uC6B0\uC9C0 \uBABB\uD588\uB2E4."
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: intro-010
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uB9C8\uC9C0\uB9C9 \uB0A9\uD488"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\uADF8\uB0A0 \uCC98\uC74C \uC54C\uC558\uB2E4. \uACC4\uC57D\uC11C\uC5D0
      \uC801\uD78C \uB0A0\uC9DC\uB3C4, \uB204\uAD70\uAC00\uC5D0\uAC8C\uB294 \uBBF8\uB8F0
      \uC218 \uC788\uB294 \uC22B\uC790\uB77C\uB294 \uAC78."
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: intro-011
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uC81C\uC548\uC11C"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 0.65, g: 0.68, b: 0.75, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\uB3C5\uCD09 \uBB38\uC11C\uC640 \uC9C0\uAE09 \uBCF4\uB958 \uD1B5\uC9C0\uAC00
      \uCC45\uC0C1 \uC704\uC5D0 \uC313\uC600\uB2E4. \uADF8 \uC704\uB85C \uC0C8\uB85C\uC6B4
      \uBB38\uC11C\uAC00 \uB193\uC600\uB2E4. \u300C\uC790\uC0B0 \uC591\uC218 \uC81C\uC548\u300D"
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: intro-012
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uC81C\uC548\uC11C"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 3
    npcId:
    voiceLabel: "\uADF8\uB8F9 \uB2F4\uB2F9\uC790"
    text: "\uC124\uBE44\uC640 \uBD80\uC9C0\uB97C \uB118\uAE30\uC2DC\uB294 \uBC29\uD5A5\uC785\uB2C8\uB2E4.
      \uC774 \uC870\uAC74\uC774\uBA74 \uB0A8\uC740 \uBD80\uB2F4\uC744 \uC77C\uBD80
      \uC815\uB9AC\uD558\uC2E4 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: intro-013
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uC81C\uC548\uC11C"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 3
    npcId:
    voiceLabel: "\uAC00\uC871"
    text: "\uBC1B\uC544\uC57C \uD560 \uB3C8\uC774 \uB4E4\uC5B4\uC624\uBA74 \uC815\uB9AC\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uADF8\uAC74 \uC65C \uC774\uC57C\uAE30\uD558\uC9C0
      \uC54A\uC2B5\uB2C8\uAE4C?"
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: intro-014
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uC81C\uC548\uC11C"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 3
    npcId:
    voiceLabel: "\uADF8\uB8F9 \uB2F4\uB2F9\uC790"
    text: "\uB300\uAE08 \uAD00\uB828 \uAC74\uACFC \uC774\uBC88 \uC81C\uC548\uC740
      \uBCC4\uAC1C\uC785\uB2C8\uB2E4. \uD310\uB2E8\uC740 \uB300\uD45C\uB2D8\uAED8\uC11C
      \uD558\uC2DC\uB294 \uAC81\uB2C8\uB2E4. \uC81C\uC548 \uAE30\uD55C\uC740 \uC774\uBC88
      \uC8FC\uAE4C\uC9C0\uC785\uB2C8\uB2E4."
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: intro-015
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uC81C\uC548\uC11C"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\uB2F4\uB2F9\uC790\uB294 \uBB38\uC11C\uB97C \uB0A8\uAE30\uACE0 \uB5A0\uB0AC\uB2E4.
      \uAC00\uC871\uC740 \uC624\uB798\uB3C4\uB85D \uADF8 \uC790\uB9AC\uC5D0 \uC549\uC544
      \uC788\uC5C8\uB2E4."
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: intro-016
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uC81C\uC548\uC11C"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 3
    npcId:
    voiceLabel: "\uAC00\uC871"
    text: "\uC9C1\uC6D0\uB4E4\uD55C\uD14C\uB294 \uB0B4\uAC00 \uC774\uC57C\uAE30\uD560\uAC8C."
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: intro-017
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uC81C\uC548\uC11C"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 1
    npcId:
    voiceLabel:
    text: "\uC544\uC9C1 \uB2E4\uB978 \uBC29\uBC95\uC774 \uC788\uC744 \uAC70\uC608\uC694."
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: intro-018
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uC81C\uC548\uC11C"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 3
    npcId:
    voiceLabel: "\uAC00\uC871"
    text: "\u2026\uC788\uC73C\uBA74 \uC88B\uACA0\uB2E4."
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: intro-019
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBE48\uC790\uB9AC"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 0.42, g: 0.48, b: 0.57, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\uACF5\uAD6C\uD568\uC774 \uB2EB\uD614\uB2E4. \uC774\uB984\uD45C\uAC00
      \uB5BC\uC5B4\uC84C\uB2E4. \uAC04\uD310\uC774 \uB0B4\uB824\uC624\uACE0, \uB9E4\uC77C
      \uBCF4\uB358 \uC0AC\uB78C\uB4E4\uC740 \uAC01\uC790\uC758 \uC0B4\uAE38\uC744
      \uCC3E\uC544 \uB5A0\uB0AC\uB2E4."
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: intro-020
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBE48\uC790\uB9AC"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 3
    npcId:
    voiceLabel: "\uC9C1\uC6D0"
    text: "\uC5F0\uB77D \uC8FC\uC138\uC694. \uB098\uC911\uC5D0 \uB2E4\uC2DC \uC2DC\uC791\uD558\uC2DC\uBA74\uC694."
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: intro-021
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBE48\uC790\uB9AC"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\uD68C\uC0AC\uB294 \uBB38\uC744 \uB2EB\uC558\uB2E4. \uC9D1\uB3C4 \uC815\uB9AC\uD588\uB2E4.
      \uC6B0\uB9AC\uC5D0\uAC8C\uB294 \uBAA8\uB4E0 \uAC83\uC774 \uB05D\uB09C \uB0A0\uC774\uC5C8\uB2E4."
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: intro-022
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBE48\uC790\uB9AC"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\uBC16\uC5D0\uC11C\uB294 \uC791\uC740 \uD68C\uC0AC \uD558\uB098\uAC00
      \uBB34\uB9AC\uD558\uAC8C \uC0AC\uC5C5\uC744 \uBC8C\uC600\uB2E4\uAC00 \uC2E4\uD328\uD588\uB2E4\uACE0
      \uD588\uB2E4."
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: intro-023
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBE48\uC790\uB9AC"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 3
    npcId:
    voiceLabel: "\uADF8\uB8F9 \uD68C\uC7A5 \xB7 \uB274\uC2A4"
    text: "\uAE30\uC5C5\uC758 \uCC45\uC784\uC740 \uC9C0\uC18D \uAC00\uB2A5\uD55C
      \uC131\uC7A5\uC744 \uB9CC\uB4DC\uB294 \uB370 \uC788\uC2B5\uB2C8\uB2E4."
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: intro-024
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBE48\uC790\uB9AC"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\uADF8 \uC0AC\uB78C\uC5D0\uAC8C \uC6B0\uB9AC \uD68C\uC0AC\uB294 \uBCF4\uACE0\uC11C
      \uD55C \uC904\uC774\uC5C8\uC744 \uAC83\uC774\uB2E4. \uB098\uB294 \uADF8 \uD55C
      \uC904\uC774 \uC5B4\uB5BB\uAC8C \uB9CC\uB4E4\uC5B4\uC84C\uB294\uC9C0 \uC54C\uACE0
      \uC2F6\uC5C8\uB2E4."
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: intro-025
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uB2E4\uC2DC \uC2DC\uC791\uD558\uB294
      \uBC29\uBC95"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\uBA87 \uB144 \uD6C4. \uC77C\uD55C \uD754\uC801\uC774 \uB0A8\uC740 \uCC45\uC0C1
      \uC704\uC5D0 \uD68C\uACC4 \uCC45\uACFC \uAE30\uC5C5 \uBD84\uC11D \uBA54\uBAA8\uAC00
      \uB193\uC600\uB2E4."
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: intro-026
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uB2E4\uC2DC \uC2DC\uC791\uD558\uB294
      \uBC29\uBC95"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\uB2F9\uC7A5 \uB418\uAC1A\uC744 \uD798\uC740 \uC5C6\uC5C8\uB2E4. \uBA3C\uC800
      \uC0B4\uC544\uC57C \uD588\uB2E4. \uC77C\uD588\uACE0, \uB3C8\uC744 \uBAA8\uC558\uB2E4.
      \uD68C\uC0AC\uAC00 \uBB34\uB108\uC9C0\uB294 \uC774\uC720\uC640, \uB204\uAD70\uAC00
      \uADF8 \uD68C\uC0AC\uB97C \uC0AC\uB4E4\uC774\uB294 \uC774\uC720\uB97C \uBC30\uC6E0\uB2E4."
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: intro-027
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uB2E4\uC2DC \uC2DC\uC791\uD558\uB294
      \uBC29\uBC95"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\uBAA8\uB4E0 \uD68C\uC0AC\uB97C \uC0B4 \uC218\uB294 \uC5C6\uB2E4. \uD558\uC9C0\uB9CC
      \uCCAB \uAC70\uB798\uB97C \uC2DC\uC791\uD560 \uB9CC\uD07C\uC740 \uB9C8\uB828\uD588\uB2E4."
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: intro-028
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uB2E4\uC2DC \uC2DC\uC791\uD558\uB294
      \uBC29\uBC95"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\uC791\uC740 \uD22C\uC790\uD68C\uC0AC\uC758 \uB4F1\uB85D \uC11C\uB958\uB97C
      \uB0B4\uB824\uB193\uC558\uB2E4. \uC11C\uB78D\uC5D0\uB294 \uC61B \uD68C\uC0AC\uC758
      \uC0AC\uC9C4\uC744, \uBCBD\uC5D0\uB294 \uADF8\uB8F9\uC758 \uAE30\uC5C5 \uC790\uB8CC\uB97C
      \uB450\uC5C8\uB2E4."
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: company-premise-0
    sceneTitle: "\uB0B4 \uD68C\uC0AC\uC758 \uB2E4\uC74C \uC7A5"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\uB4F1\uB85D \uC11C\uB958 \uC606\uC5D0 \uCD9C\uC790 \uC57D\uC815\uC11C\uAC00 \uC788\uC5C8\uB2E4. \uB300\uD45C\uC790 \uCE78\uC5D4 \uB0B4 \uC774\uB984\uC774, \uC8FC\uC8FC\uBA85\uBD80\uC5D4 \uB2E4\uB978 \uC774\uB984\uB4E4\uB3C4 \uC788\uC5C8\uB2E4."
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: company-premise-1
    sceneTitle: "\uB0B4 \uD68C\uC0AC\uC758 \uB2E4\uC74C \uC7A5"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\uB0B4 \uB3C8\uB9CC\uC73C\uB85C \uAFB8\uB9B0 \uD68C\uC0AC\uB294 \uC544\uB2C8\uC57C. \uCCAB \uD22C\uC790\uB294 \uB0B4\uAC00 \uB9E1\uAE30\uB85C \uD588\uC9C0."
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: company-premise-2
    sceneTitle: "\uB0B4 \uD68C\uC0AC\uC758 \uB2E4\uC74C \uC7A5"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\uACB0\uACFC\uB97C \uBCF4\uC5EC\uC8FC\uBA74 \uB2E4\uC74C\uC5D0\uB3C4 \uB3C8\uC744 \uBCF4\uD0DC\uACA0\uB2E4\uACE0 \uD588\uB2E4."
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: company-premise-3
    sceneTitle: "\uB0B4 \uD68C\uC0AC\uC758 \uB2E4\uC74C \uC7A5"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\uC800 \uC0AC\uB78C\uB4E4\uC774 \uBCF4\uACE0 \uC2F6\uC740 \uAC74 \uB0B4\uAC00 \uC65C \uC2DC\uC791\uD588\uB290\uB0D0\uAC00 \uC544\uB2C8\uC57C. \uC774 \uD68C\uC0AC\uB85C \uBB58 \uD560 \uC218 \uC788\uB290\uB0D0\uC9C0."
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: company-premise-4
    sceneTitle: "\uB0B4 \uD68C\uC0AC\uC758 \uB2E4\uC74C \uC7A5"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\uADF8\uB7EC\uB824\uBA74 \uB0B4\uAC00 \uC0AC\uACE0 \uC2F6\uC740 \uD68C\uC0AC\uBD80\uD130 \uACE0\uB974\uBA74 \uC548 \uB3FC. \uC0B4 \uB9CC\uD55C \uD68C\uC0AC\uB97C \uCC3E\uC544\uC57C \uD574."
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: company-premise-5
    sceneTitle: "\uB0B4 \uD68C\uC0AC\uC758 \uB2E4\uC74C \uC7A5"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\uCCAB \uBCF4\uACE0 \uB0A0\uC9DC\uC5D0 \uBC11\uC904\uC744 \uADF8\uC5C8\uB2E4. \uADF8\uB0A0\uAE4C\uC9C0 \uB0B4\uAC00 \uBB58 \uBD24\uACE0 \uC65C \uB3C8\uC744 \uB123\uC5C8\uB294\uC9C0 \uC124\uBA85\uD574\uC57C \uD55C\uB2E4."
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: company-premise-6
    sceneTitle: "\uB0B4 \uD68C\uC0AC\uC758 \uB2E4\uC74C \uC7A5"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\uACB0\uACFC\uB97C \uBABB \uBCF4\uC5EC\uC8FC\uBA74 \uB2E4\uC74C \uCD9C\uC790\uB294 \uC5B4\uB824\uC6B8 \uAC70\uC57C. \uADF8\uB54C\uB3C4 \uB0B4\uAC8C \uD68C\uC0AC\uB97C \uB9E1\uACA8 \uC904\uC9C0\uB294 \uBAA8\uB974\uACA0\uACE0."
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: intro-029
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uB2E4\uC2DC \uC2DC\uC791\uD558\uB294
      \uBC29\uBC95"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\uC5B8\uC820\uAC00 \uC800 \uD68C\uC0AC\uB97C \uC778\uC218\uD55C\uB2E4.
      \uC6B0\uB9AC\uC5D0\uAC8C \uB0A8\uACA8\uC9C4 \uC120\uD0DD\uC9C0\uB97C \uC138\uB358
      \uC0AC\uB78C\uB4E4\uC774, \uB0B4 \uACB0\uC815\uC744 \uAE30\uB2E4\uB9AC\uAC8C
      \uB420 \uB54C\uAE4C\uC9C0."
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: intro-030
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\uC774\uB984 \uC5C6\uB294 \uBD09\uD22C\uC5D0\uB294 \uBBF8\uB798\uAC74\uC124\uC758
      \uACF5\uAC1C \uC790\uB8CC\uC640 \uBA54\uBAA8\uAC00 \uC788\uC5C8\uB2E4. \u300C\uD68C\uC0AC\uB97C
      \uC0B4 \uC0DD\uAC01\uC774\uB77C\uBA74, \uACF5\uAC1C \uC790\uB8CC\uB9CC\uC73C\uB85C
      \uD310\uB2E8\uD558\uC9C0 \uB9C8\uC2ED\uC2DC\uC624. \uC724\uD558\uC9C4.\u300D"
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: intro-031
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\uC2E0\uC6D0\uC744 \uD655\uC778\uD55C \uB4A4, \uC0AC\uB78C\uC774 \uBD90\uBE44\uC9C0
      \uC54A\uB294 \uD638\uD154 \uB77C\uC6B4\uC9C0\uC5D0\uC11C \uADF8\uB97C \uB9CC\uB0AC\uB2E4."
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: intro-032
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel:
    text: "\uD734\uB300\uC804\uD654\uB294 \uC7A0\uAE50 \uAEBC\uB450\uC2DC\uC8E0.
      \uC5EC\uAE30\uC120 \uB179\uC74C\uD558\uB294 \uC0AC\uB78C\uB3C4, \uB4E3\uB294
      \uC0AC\uB78C\uB3C4 \uB9CE\uC73C\uB2C8\uAE4C."
    showPlayer: 1
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: intro-033
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 1
    npcId: npc-broker-yoon-hajin
    voiceLabel:
    text: "\uBA3C\uC800 \uC5F0\uB77D\uD558\uC2E0 \uC774\uC720\uBD80\uD130 \uB4E3\uACE0
      \uC2F6\uC2B5\uB2C8\uB2E4."
    showPlayer: 1
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: intro-034
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel:
    text: "\uC0C8 \uD22C\uC790\uD68C\uC0AC\uB97C \uC138\uC6B0\uC168\uB354\uAD70\uC694.
      \uAC00\uC9C4 \uB3C8\uC740 \uB9CE\uC9C0 \uC54A\uC740\uB370 \uCD5C\uC885 \uBAA9\uD45C\uB294
      \uAF64 \uD06C\uACE0\uC694."
    showPlayer: 1
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: intro-035
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 1
    npcId: npc-broker-yoon-hajin
    voiceLabel:
    text: "\uC81C \uC790\uB8CC\uB97C \uC5B4\uB514\uC11C \uC5BB\uC5C8\uC8E0?"
    showPlayer: 1
    goal: 0
