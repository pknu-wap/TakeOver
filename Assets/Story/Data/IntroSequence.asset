    text: "\ud29c\ud1a0\ub9ac\uc5bc\uc744 \uc644\ub8cc\ud558\uc600\uc2b5\ub2c8\ub2e4. \ud604\uc7ac {turn}\uc77c\uc774\uba70, \ubbf8\ub798\uac74\uc124 \uc8fc\uc2dd {shares}\uc8fc\uc640 \uc9c0\ubd84 {stake}%\ub97c \ubcf4\uc720\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4. \ub0a8\uc740 \uc790\uae08\uc740 {cash}\uc6d0, \ud589\ub3d9 \ud3ec\uc778\ud2b8\ub294 {ap}/{maxAp}\uc785\ub2c8\ub2e4. \ub2e4\uc74c \uc77c\uc815\uacfc \uac70\ub798\ub97c \uc790\uc720\ub86d\uac8c \uc9c4\ud589\ud558\uc2e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
