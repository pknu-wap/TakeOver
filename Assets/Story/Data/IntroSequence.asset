    speaker: 0
    npcId:
    voiceLabel:
    text: "\ub098\uc5d0\uac8c\ub294 \uccab \ud22c\uc790\ub2e4. \uc774 \uc0ac\ub78c\ub4e4\uc5d0\uac8c\ub294 \ub0b4\uc77c\ub3c4 \ub098\uc640\uc57c \ud558\ub294 \uc9c1\uc7a5\uc774\ub2e4."
    showPlayer: 0
