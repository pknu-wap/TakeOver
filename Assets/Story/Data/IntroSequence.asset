  - id: intro-072
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uCCAB \uC9C0\uBD84"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel:
    text: "\uC774\uC81C \uC8FC\uC8FC\uAC00 \uB41C \uAC70\uC8E0. \uD68C\uC0AC\uB97C
      \uB9C8\uC74C\uB300\uB85C \uC6C0\uC9C1\uC77C \uC218 \uC788\uB294 \uAC74 \uC544\uB2C8\uACE0\uC694.
      \uADF8\uB798\uB3C4 \uB0B4 \uB3C8\uC774 \uB4E4\uC5B4\uAC14\uC73C\uB2C8, \uB0B4\uC77C\uBD80\uD130\uB294
      \uC774 \uD68C\uC0AC \uC18C\uC2DD\uC774 \uB2E4\uB974\uAC8C \uB4E4\uB9B4 \uAC81\uB2C8\uB2E4."
    showPlayer: 1
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: intro-073
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uCCAB \uC9C0\uBD84"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\uC800\uAE30\uAE4C\uC9C0 \uAC00\uB824\uBA74 \uC544\uC9C1 \uBA40\uC5C8\uB2E4.
      \uADF8\uB798\uB3C4 \uC624\uB298\uC740 \uCCAB \uC9C0\uBD84\uC774 \uC0DD\uACBC\uB2E4."
