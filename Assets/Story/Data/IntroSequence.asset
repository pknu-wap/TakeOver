    npcId:
    voiceLabel: ""
    text: "{eventResult}"
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle: "\uba74\ub2f4 \uacb0\uacfc"
    choices: []
    skipDefaultChoice: 0
  - id: lesson-019
    sceneTitle: "\ub458\uc9f8 \ub0a0  /  \ub9d0\uc774 \ub0a8\uae34 \uac83"
    background: {fileID: 21300000, guid: f2ae5346af09a0045b072d43aaad3d54, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 4
    npcId:
    voiceLabel: ""
    text: "\uc11c\uc9c0\uc544\uc758 \uad00\uacc4\uc640 \uc774\ubc88 \ub9cc\ub0a8\uc758 \uae30\uc5b5\uc744 \ud655\uc778\ud558\uc138\uc694."
    showPlayer: 0
    goal: 8
    companyId:
    tutorialTitle: "\uc131\ud5a5\uacfc \ubc18\uc751 \uae30\ub85d"
    tutorialText: "\uc2e0\ub8b0\ub294 \ub9d0\uc744 \ubbff\ub294 \uc815\ub3c4, \uc874\uc911\uc740 \ub2a5\ub825\uc744 \uc778\uc815\ud558\ub294 \uc815\ub3c4\uc785\ub2c8\ub2e4. \ub450\ub824\uc6c0\u00b7\uc801\ub300\uac10\u00b7\uc758\uc874\ub3c4\u00b7\uad00\uc2ec\ub3c4 \ud568\uaed8 \ud655\uc778\ud558\uc2e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\ucd5c\uadfc \uae30\uc5b5\uc5d0\ub294 \uc5b4\ub5a4 \ub9d0\uc744 \ud588\uace0 \uc0c1\ub300\uac00 \uc5b4\ub5bb\uac8c \ubc1b\uc544\ub4e4\uc600\ub294\uc9c0\uac00 \ub0a8\uc2b5\ub2c8\ub2e4. \uc131\ud5a5\uacfc \ubc18\uc751\uc744 \ud568\uaed8 \uc0b4\ud3b4 \ub2e4\uc74c \ud611\uc0c1\uc5d0 \ud65c\uc6a9\ud574 \uc8fc\uc2ed\uc2dc\uc624."
    choices: []
    skipDefaultChoice: 0
  - id: lesson-020
    sceneTitle: "\ub458\uc9f8 \ub0a0  /  \ub9d0\uc774 \ub0a8\uae34 \uac83"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 1
    npcId: npc-broker-yoon-hajin
    voiceLabel: ""
    text: "\uc774\ub807\uac8c \ub0a8\uaca8\ub450\uba74 \ub2e4\uc74c\uc5d0 \ub9cc\ub0a0 \ub54c \ub3c4\uc6c0\uc774 \ub418\uaca0\ub124\uc694."
    showPlayer: 1
    goal: 0
    companyId:
    choices: []
    skipDefaultChoice: 0
  - id: lesson-021
    sceneTitle: "\ub458\uc9f8 \ub0a0  /  \ub9d0\uc774 \ub0a8\uae34 \uac83"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel: ""
    text: "\uc0ac\ub78c\ub9c8\ub2e4 \ubc18\uae30\ub294 \ub9d0\uc774 \ub2e4\ub974\uc796\uc2b5\ub2c8\uae4c. \uc131\ud5a5\uc774\ub791 \ubc18\uc751\uc744 \uc801\uc5b4\ub480\ub2e4\uac00 \uaebc\ub0b4\ubcf4\uba74, \ub2e4\uc74c\uc5d0 \uc598\uae30\ud560 \ub54c \ud6e8\uc52c \uc218\uc6d4\ud558\uc8e0."
    showPlayer: 1
    goal: 0
    companyId:
    choices: []
    skipDefaultChoice: 0
  - id: lesson-024
    sceneTitle: "\ub458\uc9f8 \ub0a0  /  \ud68c\uc0ac\uc758 \uc22b\uc790"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 1
    npcId: npc-broker-yoon-hajin
    voiceLabel: ""
    text: "\ubbf8\ub798\uac74\uc124 \uc8fc\uc2dd\uc744 \uc880 \ub354 \uc0b4\uae4c \ud569\ub2c8\ub2e4. \uac00\uaca9\ubd80\ud130 \ub2e4\uc2dc \ubcfc\uae4c\uc694?"
    showPlayer: 1
    goal: 0
    companyId:
    choices: []
    skipDefaultChoice: 0
  - id: lesson-025
    sceneTitle: "\ub458\uc9f8 \ub0a0  /  \ud68c\uc0ac\uc758 \uc22b\uc790"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel: ""
    text: "\uac00\uaca9\ub9cc \ubcf4\uace0 \uc815\ud558\uc2dc\uac8c\uc694? \ub3c8\uc740 \uc798 \ubc84\ub294\uc9c0, \ube5a\uc740 \uc5bc\ub9c8\ub098 \uc788\ub294\uc9c0\ub3c4 \ubd10\uc57c\uc8e0. \uc2f8\uac8c \ub098\uc628 \ub370\ub294 \uc774\uc720\uac00 \uc788\uc744 \uc218\ub3c4 \uc788\uc73c\ub2c8\uae4c\uc694."
    showPlayer: 1
    goal: 0
    companyId:
    choices: []
    skipDefaultChoice: 0
  - id: lesson-026
    sceneTitle: "\ub458\uc9f8 \ub0a0  /  \ud68c\uc0ac\uc758 \uc22b\uc790"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel: ""
    text: "\ub4e4\uc5b4\uc62c \ub3c8\ud558\uace0 \ub2f9\uc7a5 \uc4f8 \uc218 \uc788\ub294 \ub3c8\uc740 \ub2e4\ub974\uc8e0. \uc7a5\ubd80\ub97c \uac19\uc774 \ubcf4\uc2dc\uc8e0."
    showPlayer: 1
