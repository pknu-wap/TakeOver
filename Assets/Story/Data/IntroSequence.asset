  - id: neutral-intro-T4-help
    sceneTitle: "\uBC15\uC0C1\uD604 \u2014 \uC548\uB0B4\uD574 \uB4DC\uB9B4 \uC218
      \uC788\uB294 \uAC83"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 4
    npcId:
    voiceLabel:
    text: "\uD29C\uD1A0\uB9AC\uC5BC\uC744 \uB9C8\uCE58\uBA74 \uC624\uB298 \uB9CC\uB09C
      \uC678\uBD80 \uC778\uBB3C\uB4E4\uC758 \uCCAB \uC5F0\uB77D\uC744 \uD655\uC778\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uBC14\uB85C \uBAA8\uB450 \uB9CC\uB0A0 \uD544\uC694\uB294
      \uC5C6\uC2B5\uB2C8\uB2E4. \uCE74\uB4DC\uC758 \uC694\uCCAD\xB7\uC720\uD6A8\uAE30\uAC04\xB7\uB9CC\uB0A8
      \uBE44\uC6A9\uC744 \uD655\uC778\uD558\uACE0 \uC77C\uC815\uC744 \uC120\uD0DD\uD558\uC2ED\uC2DC\uC624.
      \uC778\uBB3C\uC5D0 \uB530\uB77C \uC9C0\uBD84\uACFC \uBB34\uAD00\uD55C \uC0AC\uAC74\uB3C4
      \uC788\uACE0, \uC774\uD6C4 \uAD00\uACC4\xB7\uACFC\uAC70 \uC120\uD0DD\xB7\uB2E4\uB978
      \uC870\uAC74\uC744 \uC694\uAD6C\uD558\uB294 \uC81C\uC548\uB3C4 \uC788\uC2B5\uB2C8\uB2E4.
      \uBBF8\uB798\uAC74\uC124\uC758 \uD544\uC218 \uBAA9\uD45C\uC640 \uB0A8\uC740
      \uAE30\uD55C\uB3C4 \uD568\uAED8 \uD655\uC778\uD558\uC2ED\uC2DC\uC624."
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle: "\uC678\uBD80 \uC778\uBB3C\uACFC\uC758 \uB9CC\uB0A8"
    tutorialText: "\uD29C\uD1A0\uB9AC\uC5BC\uC744 \uB9C8\uCE58\uBA74 \uC624\uB298
      \uB9CC\uB09C \uC678\uBD80 \uC778\uBB3C\uB4E4\uC758 \uCCAB \uC5F0\uB77D\uC744
      \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uBC14\uB85C \uBAA8\uB450
      \uB9CC\uB0A0 \uD544\uC694\uB294 \uC5C6\uC2B5\uB2C8\uB2E4. \uCE74\uB4DC\uC758
      \uC694\uCCAD\xB7\uC720\uD6A8\uAE30\uAC04\xB7\uB9CC\uB0A8 \uBE44\uC6A9\uC744
      \uD655\uC778\uD558\uACE0 \uC77C\uC815\uC744 \uC120\uD0DD\uD558\uC2ED\uC2DC\uC624.
      \uC778\uBB3C\uC5D0 \uB530\uB77C \uC9C0\uBD84\uACFC \uBB34\uAD00\uD55C \uC0AC\uAC74\uB3C4
      \uC788\uACE0, \uC774\uD6C4 \uAD00\uACC4\xB7\uACFC\uAC70 \uC120\uD0DD\xB7\uB2E4\uB978
      \uC870\uAC74\uC744 \uC694\uAD6C\uD558\uB294 \uC81C\uC548\uB3C4 \uC788\uC2B5\uB2C8\uB2E4.
      \uBBF8\uB798\uAC74\uC124\uC758 \uD544\uC218 \uBAA9\uD45C\uC640 \uB0A8\uC740
      \uAE30\uD55C\uB3C4 \uD568\uAED8 \uD655\uC778\uD558\uC2ED\uC2DC\uC624."
    choices: []
    skipDefaultChoice: 0
