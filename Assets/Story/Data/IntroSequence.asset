    companyId:
    tutorialTitle:
    tutorialText:
    choices:
    - title: "\uACF5\uAC1C \uC790\uB8CC\uC640 \uC808\uCC28\uB9CC \uBC1B\uB294\uB2E4"
      description: "\uACF5\uAC1C \uC124\uBA85\uD68C \uC790\uB8CC\uC640 \uACF5\uC2DD \uC808\uCC28\uB9CC \uD655\uC778\uD569\uB2C8\uB2E4."
      playerLine: "\uC6B0\uC120 \uACF5\uAC1C \uC790\uB8CC\uBD80\uD130 \uBCF4\uACA0\uC2B5\uB2C8\uB2E4.
        \uD68C\uC0AC \uC774\uB984\uC73C\uB85C \uC6C0\uC9C1\uC77C \uC77C\uC740 \uAD8C\uD55C\uC744
        \uD655\uC778\uD55C \uB4A4\uC5D0 \uD558\uACE0\uC694."
      response: "\uC88B\uC2B5\uB2C8\uB2E4. \uB204\uAC00 \uC2E0\uCCAD\uD560 \uC218
        \uC788\uB294\uC9C0\uBD80\uD130 \uBCF4\uC138\uC694. \uB9E8 \uC55E \uC18C\uAC1C\uBB38\uC740
        \uB2E4\uB4E4 \uC77D\uB294\uB370 \uB4A4\uCABD \uC81C\uD55C \uC870\uAC74\uC740
        \uC798 \uC548 \uC77D\uC73C\uC2DC\uB354\uB77C\uACE0\uC694.\n\n\uAC70\uAE30\uC5D0
        \uC81C \uC2DC\uAC04\uC744 \uBD99\uC774\uBA74 \uC77C\uC774 \uB418\uB294 \uAC70\uC8E0.
        \uC624\uB298\uC740 \uCCAB \uC778\uC0AC\uB2C8\uAE4C \uC548\uB0B4\uBB38\uB9CC
        \uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4."
      targetNpcId: npc-political-lobbyist-park-sanghyeon
      memoryType: 8
      interpretation: "\uACF5\uAC1C \uC808\uCC28 \uC790\uB8CC\uB97C \uC694\uCCAD\uD588\uB2E4.
        \uC790\uBB38 \uACC4\uC57D\xB7\uC2E0\uCCAD \uB300\uD589\xB7\uC815\uCE58 \uAC70\uB798\uB294
        \uC131\uB9BD\uD558\uC9C0 \uC54A\uC558\uB2E4."
      relationDelta:
        trust: 0
        respect: 1
        closeness: 0
    - title: "\uC790\uBB38\uC758 \uB300\uAC00\uC640 \uACF5\uAC1C \uBC94\uC704\uB97C
        \uBB3B\uB294\uB2E4"
      description: "\uC790\uBB38\uB8CC\uC640 \uACF5\uC720\uD560 \uC218 \uC788\uB294 \uC815\uBCF4\uC758 \uBC94\uC704\uB97C \uBB3B\uC2B5\uB2C8\uB2E4."
      playerLine: "\uC815\uC2DD\uC73C\uB85C \uBD80\uD0C1\uB4DC\uB9AC\uBA74 \uBB34\uC5C7\uC744
        \uD574\uC8FC\uC2DC\uACE0, \uBE44\uC6A9\uACFC \uAE30\uB85D\uC740 \uC5B4\uB5BB\uAC8C
        \uB0A8\uC2B5\uB2C8\uAE4C?"
      response: "\uC5C5\uBB34 \uBC94\uC704\uB97C \uBA3C\uC800 \uC801\uC8E0. \uC790\uB8CC
        \uAC80\uD1A0\uC778\uC9C0, \uC9C8\uC758 \uC900\uBE44\uC778\uC9C0, \uB300\uD589\uC778\uC9C0.
        \uBE44\uC6A9\uB3C4 \uADF8 \uB4A4\uC5D0 \uC815\uD558\uACE0\uC694. \uB0A8\uB294
        \uAE30\uB85D\uC774 \uACE4\uB780\uD55C \uBD80\uD0C1\uC740 \uCC98\uC74C\uBD80\uD130
        \uB530\uB85C \uC0DD\uAC01\uD558\uC154\uC57C \uD569\uB2C8\uB2E4.\n\n\uADF8\uB7FC
        \uC11C\uB85C \uC124\uBA85\uD560 \uB9D0\uC774 \uC904\uACA0\uB124\uC694. \uAD6C\uCCB4\uC801\uC778
        \uC77C\uC774 \uC0DD\uAE30\uBA74 \uADF8\uB54C \uBD05\uC2DC\uB2E4."
      targetNpcId: npc-political-lobbyist-park-sanghyeon
      memoryType: 8
      interpretation: "\uC790\uBB38 \uBC94\uC704\xB7\uBE44\uC6A9\xB7\uAE30\uB85D\uC744
        \uC9C8\uBB38\uD588\uB2E4. \uC790\uBB38\uC744 \uBC1C\uC8FC\uD558\uC9C0 \uC54A\uC558\uB2E4."
      relationDelta:
        trust: 0
        respect: 0
        closeness: 0
    - title: "\uC18C\uAC1C\uB294 \uBC1B\uB418 \uC81C\uC548\uC740 \uBCF4\uB958\uD55C\uB2E4"
      description: "\uC18C\uAC1C\uB294 \uBC1B\uC544 \uB450\uACE0 \uAD6C\uCCB4\uC801\uC778 \uC81C\uC548\uC740 \uBCF4\uB958\uD569\uB2C8\uB2E4."
      playerLine: "\uC9C0\uAE08\uC740 \uD68C\uC0AC \uC0AC\uC815\uC744 \uD30C\uC545\uD558\uB294
        \uAC8C \uBA3C\uC800 \uAC19\uC2B5\uB2C8\uB2E4. \uD544\uC694\uD574\uC9C0\uBA74
        \uC5F0\uB77D\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4."
      response: "\uADF8\uB7EC\uC138\uC694. \uB300\uC2E0 \uC5B4\uB514\uC11C \uD655\uC778\uD560
        \uC218 \uC788\uB294\uC9C0\uB9CC \uC54C\uC544\uB450\uC138\uC694. \uC81C\uB3C4\uB97C
        \uBAB0\uB77C\uC11C \uC2DC\uAC04\uC744 \uB193\uCE58\uB294 \uAC74 \uC544\uAE5D\uC796\uC2B5\uB2C8\uAE4C.\n\n\uB124.
        \uADF8 \uC815\uB3C4\uBA74 \uC624\uB298 \uC778\uC0AC\uB294 \uB410\uC8E0."
      targetNpcId: npc-political-lobbyist-park-sanghyeon
      memoryType: 8
      interpretation: "\uCD94\uAC00 \uC790\uBB38\uC744 \uBCF4\uB958\uD588\uB2E4.
        \uC801\uB300\xB7\uACE0\uBC1C\xB7\uAC70\uB798 \uD30C\uAE30\uB85C \uCC98\uB9AC\uD558\uC9C0
        \uC54A\uB294\uB2E4."
      relationDelta:
        trust: 0
        respect: 0
        closeness: 0
    skipDefaultChoice: 0
