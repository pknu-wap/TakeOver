    speaker: 0
    npcId:
    voiceLabel:
    text: "\uC0AC\uBB34\uC2E4\uB85C \uB3CC\uC544\uAC00\uAE30 \uC804 \uC724\uD558\uC9C4\uC774
      \uC804\uD654 \uD55C \uD1B5\uC744 \uBC1B\uC558\uB2E4. \uD1B5\uD654\uB97C \uB9C8\uCE5C
      \uB4A4 \uC624\uB298 \uD655\uC778\uD574\uB450\uBA74 \uC88B\uC744 \uC790\uB8CC\uAC00
