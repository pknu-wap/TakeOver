  - id: intro-077
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uAC15\uC900\uD601\uC758 \uC9C8\uBB38"
    background: {fileID: 21300000, guid: 3da8335e8f928b04ea9542177aaee968, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-mirae-construction-ceo-kang-junhyeok
    voiceLabel:
    text: "\uC624\uB298\uC740 \uC5B4\uB5A4 \uC810\uC744 \uBCF4\uACE0 \uC2F6\uC5B4\uC11C
      \uC624\uC168\uC2B5\uB2C8\uAE4C?"
    showPlayer: 1
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices:
    - title: "\uC7A5\uAE30 \uD22C\uC790\uB97C \uAC80\uD1A0\uD55C\uB2E4"
      description: "\uD68C\uC0AC\uB97C \uC624\uB798 \uC9C0\uCF1C\uBCFC \uC758\uD5A5\uC744 \uBC1D\uD799\uB2C8\uB2E4."
      playerLine: "\uC624\uB798 \uD568\uAED8\uD560 \uB9CC\uD55C \uD68C\uC0AC\uC778\uC9C0
        \uBCF4\uACE0 \uC2F6\uC2B5\uB2C8\uB2E4. \uC624\uB298\uC740 \uC5B4\uB5A4 \uACF3\uC778\uC9C0\uBD80\uD130
        \uC54C\uC544\uBCF4\uB824\uACE0\uC694."
      response: "\uC88B\uC2B5\uB2C8\uB2E4. \uC544\uC9C1 \uBAA8\uB974\uB294 \uAC8C
        \uB9CE\uC73C\uC2E4 \uD14C\uB2C8, \uAD81\uAE08\uD55C \uAC83\uBD80\uD130 \uBB3C\uC5B4\uBCF4\uC2ED\uC2DC\uC624."
      targetNpcId: npc-mirae-construction-ceo-kang-junhyeok
      memoryType: 8
      interpretation: "\uCCAB \uC18C\uAC1C \uC790\uB9AC\uC5D0\uC11C \uC7A5\uAE30
        \uD22C\uC790\uC5D0 \uAD00\uC2EC\uC744 \uBCF4\uC600\uB2E4. \uBCF4\uC720 \uAE30\uAC04\uC774\uB098
        \uACBD\uC601 \uCC38\uC5EC\uB97C \uD655\uC57D\uD55C \uAC83\uC740 \uC544\uB2C8\uB2E4."
      relationDelta:
        trust: 0
        respect: 1
        closeness: 2
    - title: "\uC218\uC775 \uC911\uC2EC\uC758 \uD22C\uC790"
      description: "\uC218\uC775\uC744 \uAE30\uC900\uC73C\uB85C \uD310\uB2E8\uD558\uACA0\uB2E4\uACE0 \uB9D0\uD569\uB2C8\uB2E4."
      playerLine: "\uC6D0\uD558\uB294 \uB9CC\uD07C \uC218\uC775\uC774 \uB098\uBA74
        \uD314 \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4. \uADF8\uAC74 \uBBF8\uB9AC \uB9D0\uC500\uB4DC\uB9AC\uB294
        \uAC8C \uB9DE\uACA0\uC8E0."
      response: "\uC54C\uACA0\uC2B5\uB2C8\uB2E4. \uADF8\uB7FC \uC5B8\uC81C\uAE4C\uC9C0,
        \uC5B4\uB5A4 \uC870\uAC74\uC73C\uB85C \uD568\uAED8\uD560 \uC218 \uC788\uC744\uC9C0
        \uBD84\uBA85\uD788 \uD574\uC57C\uACA0\uAD70\uC694."
      targetNpcId: npc-mirae-construction-ceo-kang-junhyeok
      memoryType: 8
      interpretation: "\uC218\uC775 \uBAA9\uD45C\uC640 \uB9E4\uAC01 \uAC00\uB2A5\uC131\uC744
        \uC194\uC9C1\uD788 \uC54C\uB838\uB2E4."
      relationDelta:
        trust: 0
        respect: 1
        closeness: 0
    - title: "\uC7A5\uCC28 \uC778\uC218\uB97C \uAC80\uD1A0\uD55C\uB2E4"
      description: "\uC7A5\uAE30\uC801\uC73C\uB85C \uC778\uC218\uB3C4 \uAC80\uD1A0\uD560 \uC218 \uC788\uB2E4\uACE0 \uC54C\uB9BD\uB2C8\uB2E4."
      playerLine: "\uC5B8\uC820\uAC00\uB294 \uC9C1\uC811 \uD68C\uC0AC\uB97C \uC6B4\uC601\uD574\uBCF4\uACE0
        \uC2F6\uC2B5\uB2C8\uB2E4. \uADF8\uB7EC\uB824\uBA74 \uC5B4\uB5A4 \uACF3\uC778\uC9C0
        \uBA3C\uC800 \uC54C\uC544\uC57C\uACA0\uC8E0."
      response: "\uADF8\uB807\uB2E4\uBA74 \uB354 \uAF3C\uAF3C\uD788 \uBCF4\uC2ED\uC2DC\uC624.
        \uC9C1\uC811 \uB9E1\uACA0\uB2E4\uB294 \uB9D0\uC740 \uD68C\uC0AC \uC0AC\uC815\uC744
        \uC54C\uACE0 \uB098\uC11C \uD574\uB3C4 \uB2A6\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
      targetNpcId: npc-mirae-construction-ceo-kang-junhyeok
      memoryType: 8
      interpretation: "\uC7A5\uB798 \uC778\uC218\uC5D0 \uAD00\uC2EC\uC744 \uD45C\uD604\uD588\uB2E4.
        \uD604\uC7AC \uACBD\uC601\uAD8C\uC774\uB098 \uC6B4\uC601 \uAD8C\uD55C\uC744
        \uC5BB\uC740 \uAC83\uC740 \uC544\uB2C8\uB2E4."
      relationDelta:
        trust: 0
        respect: 0
        closeness: 2
    skipDefaultChoice: 0
  - id: intro-078
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uAC15\uC900\uD601\uC758 \uC9C8\uBB38"
