  - id: intro-069
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uCCAB \uC9C0\uBD84"
    background: {fileID: 21300000, guid: f2ae5346af09a0045b072d43aaad3d54, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 4
    npcId:
    voiceLabel:
    text: "\uC218\uB7C9\uC5D0 1\uC744 \uC785\uB825\uD558\uACE0 \uBBF8\uB798\uAC74\uC124
      \uC8FC\uC2DD 1\uC8FC\uB97C \uB9E4\uC218\uD558\uC138\uC694."
    showPlayer: 0
    goal: 2
    companyId:
    tutorialTitle: "\uC8FC\uC2DD \uB9E4\uC218"
    tutorialText: "\uC218\uB7C9\uC744 \uC785\uB825\uD558\uACE0 \uB9E4\uC218\uD558\uAE30\uB97C
      \uB204\uB974\uC138\uC694. \uD544\uC694\uD55C \uB300\uAE08\uACFC \uB0A8\uC744
      \uC790\uAE08\uC744 \uD568\uAED8 \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
