    npcId: npc-broker-yoon-hajin
    voiceLabel:
    text: "\uADF8\uB7FC \uD55C \uC8FC\uB9CC \uC0AC\uBCF4\uC2DC\uC8E0. \uC0AC\uACE0
      \uB098\uC11C\uB3C4 \uC4F8 \uB3C8\uC774 \uB0A8\uB294\uC9C0 \uBCF4\uACE0\uC694.
      \uCC98\uC74C\uBD80\uD130 \uC11C\uB450\uB97C \uAC74 \uC5C6\uC73C\uB2C8\uAE4C\uC694."
