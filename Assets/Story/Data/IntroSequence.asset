    choices: []
    skipDefaultChoice: 0
  - id: intro-085
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uD68C\uC758\uC2E4 \uBC16\uC758
      \uD68C\uC0AC"
    background: {fileID: 21300000, guid: cd737e0de23899c4b9fc897defc1bbbb, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-mirae-construction-field-director-park-dosik
    voiceLabel:
    text: "\uc0ac\ub78c \uc904\uc774\ub294 \uc774\uc57c\uae30\uac00 \ub098\uc62c \ub54c\ub9c8\ub2e4 \uacf5\uc0ac \uc77c\uc815\uc740 \uadf8\ub300\ub85c\ub354\uad70\uc694. \uc774\ubc88\uc5d0\ub3c4 \uadf8\ub7ec\ub294\uc9c0 \uad81\uae08\ud569\ub2c8\ub2e4."
    showPlayer: 1
    goal: 0
    choices:
    - title: "\uC791\uC5C5\uB7C9\uACFC \uC77C\uC815\uBD80\uD130 \uD655\uC778\uD55C\uB2E4"
      playerLine: "\uc778\uc6d0\uc744 \uc5b4\ub5bb\uac8c \ud558\uaca0\ub2e4\uace0 \uc57d\uc18d\ud558\uae30 \uc804\uc5d0, \uc77c\ubd80\ud130 \uc880 \ubcf4\uaca0\uc2b5\ub2c8\ub2e4. \uc5b4\ub514\uac00 \uac00\uc7a5 \ube60\ub4ef\ud55c\uac00\uc694?"
      response: "\uc774\ucabd\ubd80\ud130 \ubcf4\uc2dc\uc8e0. \uc11c\ub958\uc5d0 \uc801\ud78c \uc778\uc6d0\ud558\uace0 \uc2e4\uc81c\ub85c \ub098\uc62c \uc218 \uc788\ub294 \uc778\uc6d0\uc774 \ub2e4\ub985\ub2c8\ub2e4."
      targetNpcId: npc-mirae-construction-field-director-park-dosik
      memoryType: 8
      interpretation: "\uC778\uC6D0\uC744 \uC57D\uC18D\uD558\uAE30 \uC804\uC5D0 \uC791\uC5C5\uB7C9\uACFC
        \uC2E4\uC81C \uD22C\uC785 \uC5EC\uAC74\uC744 \uD655\uC778\uD558\uACA0\uB2E4\uACE0
        \uD588\uB2E4."
      relationDelta:
        trust: 0
        respect: 2
        fear: 0
        hostility: 0
        dependency: 0
        interest: 0
    - title: "\uACE0\uC6A9 \uC720\uC9C0\uB97C \uC6B0\uC120\uD558\uACA0\uB2E4\uACE0
        \uC57D\uC18D\uD55C\uB2E4"
      playerLine: "\uc81c\uac00 \uacbd\uc601\uc744 \ub9e1\uac8c \ub418\uba74, \ud604\uc7a5\uc5d0\uc11c \uc77c\ud558\uc2dc\ub294 \ubd84\ub4e4 \uc790\ub9ac\ub294 \uba3c\uc800 \uc9c0\ud0a4\uace0 \uc2f6\uc2b5\ub2c8\ub2e4."
      response: "\uadf8 \ub9d0\uc500\uc740 \uae30\uc5b5\ud558\uaca0\uc2b5\ub2c8\ub2e4. \uc544\uc9c1 \uacb0\uc815\ud558\uc2e4 \uc790\ub9ac\uac00 \uc544\ub2c8\ub77c\ub294 \uac83\ub3c4\uc694."
      targetNpcId: npc-mirae-construction-field-director-park-dosik
      memoryType: 8
      interpretation: "\uACBD\uC601 \uCC38\uC5EC \uC2DC \uACE0\uC6A9 \uC720\uC9C0\uB97C
        \uC6B0\uC120\uD558\uACA0\uB2E4\uACE0 \uC57D\uC18D\uD588\uB2E4. \uC2E4\uC81C
        \uC774\uD589\uC740 \uC544\uC9C1 \uD655\uC778\uB418\uC9C0 \uC54A\uC558\uB2E4."
      relationDelta:
        trust: 0
        respect: 0
        fear: 0
        hostility: 0
        dependency: 0
        interest: 1
    - title: "\uD604\uC7A5 \uC0C1\uD669\uACFC \uBE44\uC6A9\uC744 \uD568\uAED8 \uAC80\uD1A0\uD55C\uB2E4"
      playerLine: "\uc778\uac74\ube44\ub3c4 \ubd10\uc57c\uaca0\uc8e0. \uadf8\ub798\ub3c4 \ud604\uc7a5\uc774 \uc5b4\ub5a4\uc9c0 \ub4e4\uc5b4\ubcf4\uace0 \uc815\ud558\uaca0\uc2b5\ub2c8\ub2e4."
      response: "\ubcf4\uc2ed\uc2dc\uc624. \ub300\uc2e0 \uc0ac\ub78c\uc774 \ube60\uc9c0\uba74 \uc5b4\ub290 \uc77c\uc774 \uba48\ucd94\ub294\uc9c0\ub3c4 \uac19\uc774 \uc801\uc5b4\uc8fc\uc138\uc694."
      targetNpcId: npc-mirae-construction-field-director-park-dosik
      memoryType: 8
      interpretation: "\uBE44\uC6A9\uC744 \uAC80\uD1A0\uD558\uB418 \uD604\uC7A5 \uC0C1\uD669\uC744
        \uB4E3\uACE0 \uD310\uB2E8\uD558\uACA0\uB2E4\uACE0 \uD588\uB2E4."
      relationDelta:
        trust: 0
        respect: 0
        fear: 0
        hostility: 0
        dependency: 0
        interest: 1
    skipDefaultChoice: 0
  - id: intro-086
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uD68C\uC758\uC2E4 \uBC16\uC758
      \uD68C\uC0AC"
