  - id: intro-063
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uC11C\uC9C0\uC544\uC758 \uC22B\uC790"
    background: {fileID: 21300000, guid: 3da8335e8f928b04ea9542177aaee968, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-mirae-construction-cfo-seo-jia
    voiceLabel:
    text: "\uBC1B\uC744 \uB3C8\uC774 \uC788\uC5B4\uB3C4 \uC624\uB298 \uC904 \uB3C8\uC774
      \uC5C6\uC744 \uC218 \uC788\uAC70\uB4E0\uC694. \uACF5\uC0AC\uAC00 \uB2A6\uC5B4\uC9C0\uBA74
      \uADF8\uB3D9\uC548 \uB098\uAC08 \uB3C8\uC740 \uACC4\uC18D \uC313\uC774\uACE0\uC694."
    showPlayer: 1
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: intro-065
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uC11C\uC9C0\uC544\uC758 \uC22B\uC790"
    background: {fileID: 21300000, guid: 3da8335e8f928b04ea9542177aaee968, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-mirae-construction-cfo-seo-jia
    voiceLabel:
    text: "\uC5B4\uB514\uBD80\uD130 \uBCFC\uAE4C\uC694? \uAD81\uAE08\uD558\uC2E0
      \uAC83\uBD80\uD130 \uB9D0\uC500\uD558\uC138\uC694."
    showPlayer: 1
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices:
    - title: "\uC790\uAE08 \uC0C1\uD669\uC744 \uBB3B\uB294\uB2E4"
      description: "\uB2F9\uC7A5 \uAC1A\uC544\uC57C \uD560 \uB3C8\uACFC \uD604\uAE08 \uC0AC\uC815\uC744 \uC0B4\uD54D\uB2C8\uB2E4."
      playerLine: "\uB2F9\uC7A5 \uAC1A\uC544\uC57C \uD560 \uB3C8\uC774 \uC5BC\uB9C8\uB098
        \uB418\uC8E0? \uC9C0\uAE08 \uAC00\uC9C4 \uB3C8\uC73C\uB85C \uBC84\uD2F8 \uC218
        \uC788\uB294\uC9C0\uB3C4 \uAD81\uAE08\uD569\uB2C8\uB2E4."
      response: "\uACE7 \uB098\uAC08 \uB3C8\uBD80\uD130 \uBCFC\uAE4C\uC694? \uC774
        \uD45C\uC5D0 \uB0A0\uC9DC\uBCC4\uB85C \uC801\uC5B4\uB480\uC5B4\uC694."
      targetNpcId: npc-mirae-construction-cfo-seo-jia
      memoryType: 8
      interpretation: "\uCCAB \uBA74\uB2F4\uC5D0\uC11C \uC790\uAE08 \uC9C0\uAE09\uACFC
        \uD68C\uC218 \uC2DC\uC810\uC744 \uD655\uC778\uD588\uB2E4."
      relationDelta:
        trust: 0
        respect: 2
        closeness: 1
    - title: "\uC131\uC7A5 \uAC00\uB2A5\uC131\uC744 \uBB3B\uB294\uB2E4"
      description: "\uD68C\uC0AC\uAC00 \uB2E4\uC2DC \uC131\uC7A5\uD560 \uC5EC\uC9C0\uAC00 \uC788\uB294\uC9C0 \uBB3B\uC2B5\uB2C8\uB2E4."
      playerLine: "\uBC00\uB9B0 \uB300\uAE08\uC774 \uB4E4\uC5B4\uC624\uBA74 \uB2E4\uC2DC
        \uBC84\uD2F8 \uC218 \uC788\uACA0\uC2B5\uB2C8\uAE4C?"
      response: "\uAC00\uB2A5\uC740 \uD574\uC694. \uB2E4\uB9CC \uADF8\uB54C\uAE4C\uC9C0
        \uBC84\uD2F8 \uB3C8\uB3C4 \uC788\uC5B4\uC57C\uACA0\uC8E0."
      targetNpcId: npc-mirae-construction-cfo-seo-jia
      memoryType: 8
      interpretation: "\uCCAB \uBA74\uB2F4\uC5D0\uC11C \uC815\uC0C1\uD654\uC640 \uC131\uC7A5\uC758
        \uC870\uAC74\uC744 \uBB3C\uC5C8\uB2E4."
      relationDelta:
        trust: 0
        respect: 0
        closeness: 2
    - title: "\uAC00\uACA9\uACFC \uBD80\uB2F4\uC744 \uBB3B\uB294\uB2E4"
      description: "\uD604\uC7AC \uAC00\uACA9\uC5D0 \uC5B4\uB5A4 \uBD80\uB2F4\uC774 \uBC18\uC601\uB410\uB294\uC9C0 \uC0B4\uD54D\uB2C8\uB2E4."
      playerLine: "\uC0AC\uC815\uC774 \uC774\uB7EC\uBA74 \uAC00\uACA9\uB3C4 \uC880
        \uC598\uAE30\uD574\uBCFC \uC218 \uC788\uACA0\uB124\uC694."
      response: "\uC598\uAE30\uB294 \uD574\uBCFC \uC218 \uC788\uC8E0. \uB300\uC2E0
        \uC5B4\uB5A4 \uBD80\uB2F4\uAE4C\uC9C0 \uB9E1\uC73C\uC2E4 \uAC74\uC9C0\uB3C4
        \uAC19\uC774 \uBD10\uC8FC\uC138\uC694."
      targetNpcId: npc-mirae-construction-cfo-seo-jia
      memoryType: 8
      interpretation: "\uCCAB \uC18C\uAC1C \uC790\uB9AC\uC5D0\uC11C \uD22C\uC790
        \uAC00\uACA9\uACFC \uD68C\uC0AC\uC758 \uBD80\uB2F4\uC744 \uBB3C\uC5C8\uB2E4.
        \uC778\uC218 \uACC4\uC57D\uC744 \uCCB4\uACB0\uD55C \uAC83\uC740 \uC544\uB2C8\uB2E4."
      relationDelta:
        trust: 0
        respect: 0
        closeness: 1
    skipDefaultChoice: 0
  - id: intro-066
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uC11C\uC9C0\uC544\uC758 \uC22B\uC790"
    background: {fileID: 21300000, guid: 3da8335e8f928b04ea9542177aaee968, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\uC608\uC804\uC5D0\uB294 \uC800 \uC885\uC774\uB4E4 \uC55E\uC5D0\uC11C
      \uD560 \uC218 \uC788\uB294 \uB9D0\uC774 \uC5C6\uC5C8\uB2E4. \uC9C0\uAE08\uC740
      \uBB3B\uACE0, \uB530\uC838\uBCFC \uC218 \uC788\uB2E4. \uD310\uB2E8\uC740 \uADF8\uB2E4\uC74C\uC774\uB2E4."
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle:
