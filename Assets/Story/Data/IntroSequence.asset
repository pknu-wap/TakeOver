--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e1f1787036245c448a03807b70d741e5, type: 3}
  m_Name: IntroSequence
  m_EditorClassIdentifier: Assembly-CSharp::TakeOver.Story.StorySequence
  fadeSeconds: 0.45
  font: {fileID: 12800000, guid: e921fcde249fb4244bcfbf3bb484830a, type: 3}
  playerStanding: {fileID: 21300000, guid: 2e26f4928160a7d429af82e49f52d353, type: 3}
  playerDimmed: {fileID: 21300000, guid: 64ed30aa8e3c5f04eb485ec5fd247f50, type: 3}
  dialoguePanel: {fileID: 0}
  beats:
  - id: intro-001
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uB9C8\uC9C0\uB9C9 \uB0A9\uD488"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\uacfc\uac70, \uac00\uc871 \ud68c\uc0ac\uc758 \uc0ac\ubb34\uc2e4. \ubb38 \ub108\uba38\uc5d0\uc11c\ub294 \ub9c8\uc9c0\ub9c9 \ub0a9\ud488\uc744 \uc900\ube44\ud558\ub294 \uc18c\ub9ac\uac00 \ub4e4\ub9b0\ub2e4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-002
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uB9C8\uC9C0\uB9C9 \uB0A9\uD488"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 3
    npcId:
    voiceLabel: "\uAC00\uC871"
    text: "\uc774\ubc88 \ubb3c\ub7c9\uae4c\uc9c0 \ub9c8\uce58\uba74 \ud55c\uc228 \ub3cc\ub9ac\uaca0\ub124. \ubc00\ub9b0 \uc815\ube44\ub3c4 \ud558\uace0."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-003
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uB9C8\uC9C0\uB9C9 \uB0A9\uD488"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 1
    npcId:
    voiceLabel:
    text: "\uc785\uae08\uc740 \uc608\uc815\ub300\ub85c \ub41c\ub300\uc694?"
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-004
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uB9C8\uC9C0\uB9C9 \uB0A9\uD488"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 3
    npcId:
    voiceLabel: "\uAC00\uC871"
    text: "\uacc4\uc57d\uc11c\uc5d0 \uc801\ud600 \uc788\uc796\uc544. \uc6b0\ub9b0 \ub0a0\uc9dc \ub9de\ucdb0 \ubcf4\ub0c8\uc73c\ub2c8, \uc800\ucabd\ub3c4 \uc9c0\ud0a4\uaca0\uc9c0."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-005
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uB9C8\uC9C0\uB9C9 \uB0A9\uD488"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\uc804\ud654\uac00 \uc6b8\ub9b0\ub2e4. \uac00\uc871\uc758 \ud45c\uc815\uc774 \uad73\ub294\ub2e4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-006
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uB9C8\uC9C0\uB9C9 \uB0A9\uD488"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 3
    npcId:
    voiceLabel: "\uADF8\uB8F9 \uB2F4\uB2F9\uC790 \xB7 \uC804\uD654"
    text: "\uac80\uc218\uac00 \ucd94\uac00\ub85c \ud544\uc694\ud569\ub2c8\ub2e4. \uc9c0\uae09 \uc77c\uc815\uc740 \ub2e4\uc2dc \uc548\ub0b4\ub4dc\ub9ac\uaca0\uc2b5\ub2c8\ub2e4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-007
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uB9C8\uC9C0\uB9C9 \uB0A9\uD488"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 3
    npcId:
    voiceLabel: "\uAC00\uC871"
    text: "\ucd94\uac00 \uac80\uc218\uc694? \uc9c0\ub09c\uc8fc\uc5d0 \ud655\uc778\uae4c\uc9c0 \ub05d\ub0ac\ub294\ub370\uc694. \uc774\ubc88 \uc8fc\uac00 \uae09\uc5ec\uc77c\uc785\ub2c8\ub2e4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-008
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uB9C8\uC9C0\uB9C9 \uB0A9\uD488"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 3
    npcId:
    voiceLabel: "\uADF8\uB8F9 \uB2F4\uB2F9\uC790 \xB7 \uC804\uD654"
    text: "\ub0b4\ubd80 \uae30\uc900\uc774 \ubcc0\uacbd\ub410\uc2b5\ub2c8\ub2e4. \uc800\ud76c \ucabd\uc5d0\uc11c\ub3c4 \uc2b9\uc778 \uc5c6\uc774\ub294 \uc9c4\ud589\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-009
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uB9C8\uC9C0\uB9C9 \uB0A9\uD488"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\ud1b5\ud654\uac00 \ub05d\ub0ac\ub2e4. \uac00\uc871\uc740 \ub2ec\ub825\uc5d0 \uadf8\ub824 \ub454 \uc9c0\uae09\uc77c\uc758 \ub3d9\uadf8\ub77c\ubbf8\ub97c \uc9c0\uc6b0\uc9c0 \ubabb\ud588\ub2e4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-010
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uB9C8\uC9C0\uB9C9 \uB0A9\uD488"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\uadf8\ub0a0 \ucc98\uc74c \uc54c\uc558\ub2e4. \uacc4\uc57d\uc11c\uc5d0 \uc801\ud78c \ub0a0\uc9dc\ub3c4, \ub204\uad70\uac00\uc5d0\uac8c\ub294 \ubbf8\ub8f0 \uc218 \uc788\ub294 \uc22b\uc790\ub77c\ub294 \uac78."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-011
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uC81C\uC548\uC11C"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 0.65, g: 0.68, b: 0.75, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\ub3c5\ucd09 \ubb38\uc11c\uc640 \uc9c0\uae09 \ubcf4\ub958 \ud1b5\uc9c0\uac00 \ucc45\uc0c1 \uc704\uc5d0 \uc313\uc600\ub2e4. \uadf8 \uc704\ub85c \uc0c8\ub85c\uc6b4 \ubb38\uc11c\uac00 \ub193\uc600\ub2e4. \u300c\uc790\uc0b0 \uc591\uc218 \uc81c\uc548\u300d"
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-012
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uC81C\uC548\uC11C"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 3
    npcId:
    voiceLabel: "\uADF8\uB8F9 \uB2F4\uB2F9\uC790"
    text: "\uc124\ube44\uc640 \ubd80\uc9c0\ub97c \ub118\uae30\uc2dc\ub294 \ubc29\ud5a5\uc785\ub2c8\ub2e4. \uc774 \uc870\uac74\uc774\uba74 \ub0a8\uc740 \ubd80\ub2f4\uc744 \uc77c\ubd80 \uc815\ub9ac\ud558\uc2e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-013
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uC81C\uC548\uC11C"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 3
    npcId:
    voiceLabel: "\uAC00\uC871"
    text: "\ubc1b\uc544\uc57c \ud560 \ub3c8\uc774 \ub4e4\uc5b4\uc624\uba74 \uc815\ub9ac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uadf8\uac74 \uc65c \uc774\uc57c\uae30\ud558\uc9c0 \uc54a\uc2b5\ub2c8\uae4c?"
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-014
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uC81C\uC548\uC11C"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 3
    npcId:
    voiceLabel: "\uADF8\uB8F9 \uB2F4\uB2F9\uC790"
    text: "\ub300\uae08 \uad00\ub828 \uac74\uacfc \uc774\ubc88 \uc81c\uc548\uc740 \ubcc4\uac1c\uc785\ub2c8\ub2e4. \ud310\ub2e8\uc740 \ub300\ud45c\ub2d8\uaed8\uc11c \ud558\uc2dc\ub294 \uac81\ub2c8\ub2e4. \uc81c\uc548 \uae30\ud55c\uc740 \uc774\ubc88 \uc8fc\uae4c\uc9c0\uc785\ub2c8\ub2e4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-015
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uC81C\uC548\uC11C"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\ub2f4\ub2f9\uc790\ub294 \ubb38\uc11c\ub97c \ub0a8\uae30\uace0 \ub5a0\ub0ac\ub2e4. \uac00\uc871\uc740 \uc624\ub798\ub3c4\ub85d \uadf8 \uc790\ub9ac\uc5d0 \uc549\uc544 \uc788\uc5c8\ub2e4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-016
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uC81C\uC548\uC11C"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 3
    npcId:
    voiceLabel: "\uAC00\uC871"
    text: "\uc9c1\uc6d0\ub4e4\ud55c\ud14c\ub294 \ub0b4\uac00 \uc774\uc57c\uae30\ud560\uac8c."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-017
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uC81C\uC548\uC11C"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 1
    npcId:
    voiceLabel:
    text: "\uc544\uc9c1 \ub2e4\ub978 \ubc29\ubc95\uc774 \uc788\uc744 \uac70\uc608\uc694."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-018
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uC81C\uC548\uC11C"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 3
    npcId:
    voiceLabel: "\uAC00\uC871"
    text: "\u2026\uc788\uc73c\uba74 \uc88b\uaca0\ub2e4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-019
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBE48\uC790\uB9AC"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 0.42, g: 0.48, b: 0.57, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\uacf5\uad6c\ud568\uc774 \ub2eb\ud614\ub2e4. \uc774\ub984\ud45c\uac00 \ub5bc\uc5b4\uc84c\ub2e4. \uac04\ud310\uc774 \ub0b4\ub824\uc624\uace0, \ub9e4\uc77c \ubcf4\ub358 \uc0ac\ub78c\ub4e4\uc740 \uac01\uc790\uc758 \uc0b4\uae38\uc744 \ucc3e\uc544 \ub5a0\ub0ac\ub2e4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-020
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBE48\uC790\uB9AC"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 3
    npcId:
    voiceLabel: "\uC9C1\uC6D0"
    text: "\uc5f0\ub77d \uc8fc\uc138\uc694. \ub098\uc911\uc5d0 \ub2e4\uc2dc \uc2dc\uc791\ud558\uc2dc\uba74\uc694."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-021
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBE48\uC790\uB9AC"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\ud68c\uc0ac\ub294 \ubb38\uc744 \ub2eb\uc558\ub2e4. \uc9d1\ub3c4 \uc815\ub9ac\ud588\ub2e4. \uc6b0\ub9ac\uc5d0\uac8c\ub294 \ubaa8\ub4e0 \uac83\uc774 \ub05d\ub09c \ub0a0\uc774\uc5c8\ub2e4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-022
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBE48\uC790\uB9AC"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\ubc16\uc5d0\uc11c\ub294 \uc791\uc740 \ud68c\uc0ac \ud558\ub098\uac00 \ubb34\ub9ac\ud558\uac8c \uc0ac\uc5c5\uc744 \ubc8c\uc600\ub2e4\uac00 \uc2e4\ud328\ud588\ub2e4\uace0 \ud588\ub2e4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-023
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBE48\uC790\uB9AC"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 3
    npcId:
    voiceLabel: "\uADF8\uB8F9 \uD68C\uC7A5 \xB7 \uB274\uC2A4"
    text: "\uae30\uc5c5\uc758 \ucc45\uc784\uc740 \uc9c0\uc18d \uac00\ub2a5\ud55c \uc131\uc7a5\uc744 \ub9cc\ub4dc\ub294 \ub370 \uc788\uc2b5\ub2c8\ub2e4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-024
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBE48\uC790\uB9AC"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\uadf8 \uc0ac\ub78c\uc5d0\uac8c \uc6b0\ub9ac \ud68c\uc0ac\ub294 \ubcf4\uace0\uc11c \ud55c \uc904\uc774\uc5c8\uc744 \uac83\uc774\ub2e4. \ub098\ub294 \uadf8 \ud55c \uc904\uc774 \uc5b4\ub5bb\uac8c \ub9cc\ub4e4\uc5b4\uc84c\ub294\uc9c0 \uc54c\uace0 \uc2f6\uc5c8\ub2e4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-025
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uB2E4\uC2DC \uC2DC\uC791\uD558\uB294
      \uBC29\uBC95"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\uba87 \ub144 \ud6c4. \uc77c\ud55c \ud754\uc801\uc774 \ub0a8\uc740 \ucc45\uc0c1 \uc704\uc5d0 \ud68c\uacc4 \ucc45\uacfc \uae30\uc5c5 \ubd84\uc11d \uba54\ubaa8\uac00 \ub193\uc600\ub2e4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-026
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uB2E4\uC2DC \uC2DC\uC791\uD558\uB294
      \uBC29\uBC95"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\ub2f9\uc7a5 \ub418\uac1a\uc744 \ud798\uc740 \uc5c6\uc5c8\ub2e4. \uba3c\uc800 \uc0b4\uc544\uc57c \ud588\ub2e4. \uc77c\ud588\uace0, \ub3c8\uc744 \ubaa8\uc558\ub2e4. \ud68c\uc0ac\uac00 \ubb34\ub108\uc9c0\ub294 \uc774\uc720\uc640, \ub204\uad70\uac00 \uadf8 \ud68c\uc0ac\ub97c \uc0ac\ub4e4\uc774\ub294 \uc774\uc720\ub97c \ubc30\uc6e0\ub2e4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-027
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uB2E4\uC2DC \uC2DC\uC791\uD558\uB294
      \uBC29\uBC95"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\ubaa8\ub4e0 \ud68c\uc0ac\ub97c \uc0b4 \uc218\ub294 \uc5c6\ub2e4. \ud558\uc9c0\ub9cc \uccab \uac70\ub798\ub97c \uc2dc\uc791\ud560 \ub9cc\ud07c\uc740 \ub9c8\ub828\ud588\ub2e4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-028
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uB2E4\uC2DC \uC2DC\uC791\uD558\uB294
      \uBC29\uBC95"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\uc791\uc740 \ud22c\uc790\ud68c\uc0ac\uc758 \ub4f1\ub85d \uc11c\ub958\ub97c \ub0b4\ub824\ub193\uc558\ub2e4. \uc11c\ub78d\uc5d0\ub294 \uc61b \ud68c\uc0ac\uc758 \uc0ac\uc9c4\uc744, \ubcbd\uc5d0\ub294 \uadf8\ub8f9\uc758 \uae30\uc5c5 \uc790\ub8cc\ub97c \ub450\uc5c8\ub2e4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-029
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uB2E4\uC2DC \uC2DC\uC791\uD558\uB294
      \uBC29\uBC95"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\uc5b8\uc820\uac00 \uc800 \ud68c\uc0ac\ub97c \uc778\uc218\ud55c\ub2e4. \uc6b0\ub9ac\uc5d0\uac8c \ub0a8\uaca8\uc9c4 \uc120\ud0dd\uc9c0\ub97c \uc138\ub358 \uc0ac\ub78c\ub4e4\uc774, \ub0b4 \uacb0\uc815\uc744 \uae30\ub2e4\ub9ac\uac8c \ub420 \ub54c\uae4c\uc9c0."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-030
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\uc774\ub984 \uc5c6\ub294 \ubd09\ud22c\uc5d0\ub294 \ubbf8\ub798\uac74\uc124\uc758 \uacf5\uac1c \uc790\ub8cc\uc640 \uba54\ubaa8\uac00 \uc788\uc5c8\ub2e4. \u300c\ud68c\uc0ac\ub97c \uc0b4 \uc0dd\uac01\uc774\ub77c\uba74, \uacf5\uac1c \uc790\ub8cc\ub9cc\uc73c\ub85c \ud310\ub2e8\ud558\uc9c0 \ub9c8\uc2ed\uc2dc\uc624. \uc724\ud558\uc9c4.\u300d"
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-031
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\uc2e0\uc6d0\uc744 \ud655\uc778\ud55c \ub4a4, \uc0ac\ub78c\uc774 \ubd90\ube44\uc9c0 \uc54a\ub294 \ud638\ud154 \ub77c\uc6b4\uc9c0\uc5d0\uc11c \uadf8\ub97c \ub9cc\ub0ac\ub2e4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-032
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel:
    text: "\ud734\ub300\uc804\ud654\ub294 \uc7a0\uae50 \uaebc\ub450\uc2dc\uc8e0. \uc5ec\uae30\uc120 \ub179\uc74c\ud558\ub294 \uc0ac\ub78c\ub3c4, \ub4e3\ub294 \uc0ac\ub78c\ub3c4 \ub9ce\uc73c\ub2c8\uae4c."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-033
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 1
    npcId: npc-broker-yoon-hajin
    voiceLabel:
    text: "\uba3c\uc800 \uc5f0\ub77d\ud558\uc2e0 \uc774\uc720\ubd80\ud130 \ub4e3\uace0 \uc2f6\uc2b5\ub2c8\ub2e4."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-034
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel:
    text: "\uc0c8 \ud22c\uc790\ud68c\uc0ac\ub97c \uc138\uc6b0\uc168\ub354\uad70\uc694. \uac00\uc9c4 \ub3c8\uc740 \ub9ce\uc9c0 \uc54a\uc740\ub370 \ucd5c\uc885 \ubaa9\ud45c\ub294 \uaf64 \ud06c\uace0\uc694."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-035
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 1
    npcId: npc-broker-yoon-hajin
    voiceLabel:
    text: "\uc81c \uc790\ub8cc\ub97c \uc5b4\ub514\uc11c \uc5bb\uc5c8\uc8e0?"
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-036
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel:
    text: "\uc5c5\uacc4\uc5d0\uc120 \uc0c8 \ud68c\uc0ac\uac00 \uc0dd\uae30\uba74 \uc18c\ubb38\uc774 \ub0a9\ub2c8\ub2e4. \uadf8 \uadf8\ub8f9\uc744 \uc778\uc218\ud558\uace0 \uc2f6\ub2e4\uace0\uc694? \uc9c0\uae08 \uc790\uae08\uc73c\ub85c\ub294 \ud611\uc0c1 \ud14c\uc774\ube14\uc5d0 \uc549\uae30\ub3c4 \uc5b4\ub835\uc2b5\ub2c8\ub2e4."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-037
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 1
    npcId: npc-broker-yoon-hajin
    voiceLabel:
    text: "\uadf8\ub798\uc11c \uccab \uac70\ub798\ubd80\ud130 \uc2dc\uc791\ud558\ub824\ub294 \uac81\ub2c8\ub2e4."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-038
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel:
    text: "\ud070 \ubaa9\ud45c\ub97c \uac00\uc9c4 \uace0\uac1d\uc740 \ubc18\uac11\uc8e0. \uac70\ub798\uac00 \uc131\uc0ac\ub418\uba74 \uc81c \uc218\uc218\ub8cc\ub3c4 \uc0dd\uae30\ub2c8\uae4c\uc694."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-039
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 1
    npcId: npc-broker-yoon-hajin
    voiceLabel:
    text: "\uc65c \uc800\ub97c \ub3d5\uc2b5\ub2c8\uae4c?"
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-040
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel:
    text: "\uc608\uc804\uc5d4 \uc800\ub3c4 \uc791\uc740 \ub0a9\ud488\uc5c5\uccb4\uc640 \uc77c\ud588\uc2b5\ub2c8\ub2e4. \uadf8\ub8f9 \uacc4\uc5f4\uc0ac\uc5d0 \ubc1b\uc744 \ub3c8\uc774 \uc788\uc5c8\uc8e0. \ub300\uae08\uc740 \ubbf8\ub904\uc84c\uace0, \uc81c \uac70\ub798\ucc98\ub294 \ubc84\ud2f0\uc9c0 \ubabb\ud588\uc2b5\ub2c8\ub2e4."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-041
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 1
    npcId: npc-broker-yoon-hajin
    voiceLabel:
    text: "\ub2f9\uc2e0\ub3c4 \uadf8 \uadf8\ub8f9 \ub54c\ubb38\uc5d0 \ud53c\ud574\ub97c \ubd24\ub2e4\ub294 \uac81\ub2c8\uae4c?"
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-042
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel:
    text: "\ud53c\ud574\ub97c \ubcf8 \uac74 \ub9de\uc2b5\ub2c8\ub2e4. \uadf8\ub807\ub2e4\uace0 \uc81c\uac00 \uae68\ub057\ud588\ub2e4\ub294 \ub73b\uc740 \uc544\ub2c8\uc5d0\uc694."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-043
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel:
    text: "\uac70\ub798\ucc98\ub97c \uc9c0\ud0a4\uc9c0 \ubabb\ud588\uc2b5\ub2c8\ub2e4. \ub300\uc2e0 \ub0b4\ubd80\uc5d0\uc11c \uc0c8\uc5b4\ub098\uc628 \uacb0\uc81c \uc77c\uc815\uc744 \ub2e4\ub978 \ub9e4\uc218\uc790\uc5d0\uac8c \ub118\uaca8 \uc218\uc218\ub8cc\ub97c \ucc59\uacbc\uc8e0. \uadf8 \ub3c8\uc73c\ub85c \ubc84\ud17c\uc2b5\ub2c8\ub2e4."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-044
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 1
    npcId: npc-broker-yoon-hajin
    voiceLabel:
    text: "\uadf8 \uc815\ubcf4\ub294 \ud569\ubc95\uc801\uc73c\ub85c \uc5bb\uc740 \uac81\ub2c8\uae4c?"
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-045
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel:
    text: "\uadf8 \uc9c8\ubb38\uc744 \uaf2d \uae30\ub85d\uc73c\ub85c \ub0a8\uae30\uace0 \uc2f6\uc73c\uc2ed\ub2c8\uae4c?"
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-046
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\uc724\ud558\uc9c4\uc740 \ud68c\uc0ac \uc774\ub984\ub3c4 \uc791\uc131\uc790\ub3c4 \uc5c6\ub294 \uc11c\ub958\ucca0\uc744 \ubc00\uc5c8\ub2e4. \uadf8\ub7ec\ub098 \uc544\uc9c1 \uc190\uc744 \ub193\uc9c0\ub294 \uc54a\uc558\ub2e4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-047
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel:
    text: "\uc815\uc758\ub97c \uc704\ud574 \ub3d5\ub294\ub2e4\uace0 \ubbff\uc9c0\ub294 \ub9c8\uc138\uc694. \ub2f9\uc2e0\uc740 \uc790\ubcf8\uacfc \ubaa9\ud45c\uac00 \uc788\uace0, \uc800\ub294 \uac70\ub798\ub9dd\uacfc \uc815\ubcf4\uac00 \uc788\uc2b5\ub2c8\ub2e4."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-048
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel:
    text: "\uac70\ub798\uac00 \uc131\uc0ac\ub418\uba74 \ub3c8\uc744 \ubc95\ub2c8\ub2e4. \uadf8 \uadf8\ub8f9\uc774 \ud754\ub4e4\ub9ac\uba74 \uac1c\uc778\uc801\uc778 \ube5a\ub3c4 \uc870\uae08 \uac1a\ub294 \uc148\uc774\uace0\uc694."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-049
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 1
    npcId: npc-broker-yoon-hajin
    voiceLabel:
    text: "\uc774\uac74 \uacf5\uac1c \uc790\ub8cc\uac00 \uc544\ub2c8\uad70\uc694."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-050
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel:
    text: "\uc5b4\ub514\uc11c \uc5bb\uc5c8\ub294\uc9c0\ub294 \ubb3b\uc9c0 \uc54a\ub294 \uac8c \uc88b\uc2b5\ub2c8\ub2e4. \uc9c4\uc704\ub97c \ud655\uc778\ud558\ub294 \uac74 \ub2f9\uc2e0 \ubaab\uc785\ub2c8\ub2e4."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-051
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 1
    npcId: npc-broker-yoon-hajin
    voiceLabel:
    text: "\ud655\uc778 \uc804\uc5d0\ub294 \uc544\ubb34 \uac70\ub798\ub3c4 \ud558\uc9c0 \uc54a\uaca0\uc2b5\ub2c8\ub2e4."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-052
    sceneTitle: "\uD504\uB864\uB85C\uADF8  /  \uBA3C\uC800 \uC628 \uC5F0\uB77D"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel:
    text: "\uc88b\uc2b5\ub2c8\ub2e4. \ubbf8\ub798\uac74\uc124\uc740 \ub2f9\uc2e0\uc5d0\uac8c \uccab\uac78\uc74c\uc774\uace0, \uc81c\uac90 \uc218\uc218\ub8cc\uac00 \uac78\ub9b0 \uae30\ud68c\uc785\ub2c8\ub2e4. \uc11c\ub85c \uc6d0\ud558\ub294 \uac8c \ub9de\uc73c\uba74 \ub2e4\uc2dc \uc5f0\ub77d\ud558\uc8e0."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-053
    sceneTitle: "TAKEOVER  /  \uCCAB \uBC88\uC9F8 \uC8FC\uC8FC"
    background: {fileID: 21300000, guid: f2ae5346af09a0045b072d43aaad3d54, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\ub0b4\uac00 \uc0ac\ub824\ub294 \uac83\uc740 \uc8fc\uc2dd\uc774\ub2e4. \ud558\uc9c0\ub9cc \uadf8 \uc22b\uc790 \ub4a4\uc5d0\ub294, \ub204\uad70\uac00\uac00 \uc9c0\ucf1c \uc628 \ud68c\uc0ac\uac00 \uc788\ub2e4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-054
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uCC98\uC74C \uBCF4\uB294 \uB3C4\uC2DC"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel:
    text: "\uc0ac\ubb34\uc2e4\uc740 \uad6c\ud558\uc168\ub124\uc694. \uc774\uc81c \uc5ec\uae30\uc11c \ubb34\uc2a8 \uac70\ub798\uac00 \ub098\uc624\ub294\uc9c0 \ubcf4\uc5ec\uc904 \ucc28\ub840\uad70\uc694."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-055
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uCC98\uC74C \uBCF4\uB294 \uB3C4\uC2DC"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 1
    npcId: npc-broker-yoon-hajin
    voiceLabel:
    text: "\uc18c\uac1c\ud560 \ud68c\uc0ac\uac00 \uc788\ub2e4\uace0 \ud588\uc8e0."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-056
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uCC98\uC74C \uBCF4\uB294 \uB3C4\uC2DC"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel:
    text: "\ubbf8\ub798\uac74\uc124\uc785\ub2c8\ub2e4. \uacf5\uc0ac\ub294 \ub3cc\uc544\uac00\ub294\ub370 \ub3c8\uc774 \uc81c\ub54c \ub3cc\uc9c0 \uc54a\uc544\uc694. \uc774\ub7f0 \ud68c\uc0ac\ub294 \ud22c\uc790\uc790\ub97c \ucc3e\uc2b5\ub2c8\ub2e4."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-057
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uCC98\uC74C \uBCF4\uB294 \uB3C4\uC2DC"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 1
    npcId: npc-broker-yoon-hajin
    voiceLabel:
    text: "\ub300\ud45c\uac00 \ud68c\uc0ac\ub97c \ud314\uaca0\ub2f5\ub2c8\uae4c?"
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-058
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uCC98\uC74C \uBCF4\uB294 \uB3C4\uC2DC"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel:
    text: "\uc544\uc9c1 \uadf8\ub7f0 \ub9d0\uc740 \uc548 \ud588\uc2b5\ub2c8\ub2e4. \uc7ac\ubb34 \ub2f4\ub2f9\uc790\ub294 \uc774\uc57c\uae30\uac00 \ud1b5\ud560 \uac70\uc608\uc694."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-059
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uCC98\uC74C \uBCF4\uB294 \uB3C4\uC2DC"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\uc775\uc219\ud55c \ub9d0\uc774\ub2e4. \uadf8\ub807\ub2e4\uace0 \uac19\uc740 \ud68c\uc0ac\ub294 \uc544\ub2c8\ub2e4. \uc774\ubc88\uc5d0\ub294 \uc790\ub8cc\ubd80\ud130 \ubcf4\uc790."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-060
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uCC98\uC74C \uBCF4\uB294 \uB3C4\uC2DC"
    background: {fileID: 21300000, guid: f2ae5346af09a0045b072d43aaad3d54, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 4
    npcId:
    voiceLabel:
    text: "\ub3c4\uc2dc\ub9f5\uc5d0\uc11c \uae08\uc0c9\uc73c\ub85c \uac15\uc870\ub41c \ubbf8\ub798\uac74\uc124\uc744 \uc120\ud0dd\ud558\uc138\uc694."
    showPlayer: 0
    goal: 1
    tutorialTitle: "\ud68c\uc0ac \uc0b4\ud3b4\ubcf4\uae30"
    tutorialText: "\ub3c4\uc2dc\ub9f5\uc5d0\uc11c \ud68c\uc0ac\ub97c \uc120\ud0dd\ud558\uba74 \uc0ac\uc5c5 \ub0b4\uc6a9\uacfc \uc7ac\ubb34 \uc815\ubcf4, \uc8fc\uc2dd \uac70\ub798 \ud654\uba74\uc744 \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
    choices: []
    skipDefaultChoice: 0
  - id: intro-061
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uC11C\uC9C0\uC544\uC758 \uC22B\uC790"
    background: {fileID: 21300000, guid: 3da8335e8f928b04ea9542177aaee968, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-mirae-construction-cfo-seo-jia
    voiceLabel:
    text: "\ud22c\uc790\ub97c \uc0dd\uac01\ud558\uace0 \uacc4\uc2dc\ub2e4\uace0\uc694. \uc7a5\ubd80\ub294 \uac00\uc838\uc654\uc5b4\uc694. \ub3c8\uc744 \ubc84\ub294 \uac83\ud558\uace0, \ub2f9\uc7a5 \uc4f8 \ub3c8\uc774 \uc788\ub294 \uac74 \uc880 \ub2e4\ub974\ub2c8 \uac19\uc774 \ubcf4\uc2dc\uc8e0."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-062
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uC11C\uC9C0\uC544\uC758 \uC22B\uC790"
    background: {fileID: 21300000, guid: 3da8335e8f928b04ea9542177aaee968, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 1
    npcId: npc-mirae-construction-cfo-seo-jia
    voiceLabel:
    text: "\uacf5\uc0ac\uac00 \uc9c4\ud589 \uc911\uc778\ub370 \uc790\uae08\uc774 \ubd80\uc871\ud55c \uac81\ub2c8\uae4c?"
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-063
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uC11C\uC9C0\uC544\uC758 \uC22B\uC790"
    background: {fileID: 21300000, guid: 3da8335e8f928b04ea9542177aaee968, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-mirae-construction-cfo-seo-jia
    voiceLabel:
    text: "\ubc1b\uc744 \ub3c8\uc774 \uc788\uc5b4\ub3c4 \uc624\ub298 \uc904 \ub3c8\uc774 \uc5c6\uc744 \uc218 \uc788\uac70\ub4e0\uc694. \uacf5\uc0ac\uac00 \ub2a6\uc5b4\uc9c0\uba74 \uadf8\ub3d9\uc548 \ub098\uac08 \ub3c8\uc740 \uacc4\uc18d \uc313\uc774\uace0\uc694."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-065
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uC11C\uC9C0\uC544\uC758 \uC22B\uC790"
    background: {fileID: 21300000, guid: 3da8335e8f928b04ea9542177aaee968, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-mirae-construction-cfo-seo-jia
    voiceLabel:
    text: "\uc5b4\ub514\ubd80\ud130 \ubcfc\uae4c\uc694? \uad81\uae08\ud558\uc2e0 \uac83\ubd80\ud130 \ub9d0\uc500\ud558\uc138\uc694."
    showPlayer: 1
    goal: 0
    choices:
    - title: "\uC790\uAE08 \uC0C1\uD669\uC744 \uBB3B\uB294\uB2E4"
      playerLine: "\ub2f9\uc7a5 \uac1a\uc544\uc57c \ud560 \ub3c8\uc774 \uc5bc\ub9c8\ub098 \ub418\uc8e0? \uc9c0\uae08 \uac00\uc9c4 \ub3c8\uc73c\ub85c \ubc84\ud2f8 \uc218 \uc788\ub294\uc9c0\ub3c4 \uad81\uae08\ud569\ub2c8\ub2e4."
      response: "\uace7 \ub098\uac08 \ub3c8\ubd80\ud130 \ubcfc\uae4c\uc694? \uc774 \ud45c\uc5d0 \ub0a0\uc9dc\ubcc4\ub85c \uc801\uc5b4\ub480\uc5b4\uc694."
      targetNpcId: npc-mirae-construction-cfo-seo-jia
      memoryType: 8
      interpretation: "\uCCAB \uBA74\uB2F4\uC5D0\uC11C \uC790\uAE08 \uC9C0\uAE09\uACFC
        \uD68C\uC218 \uC2DC\uC810\uC744 \uD655\uC778\uD588\uB2E4."
      relationDelta:
        trust: 0
        respect: 2
        fear: 0
        hostility: 0
        dependency: 0
        interest: 1
    - title: "\uC131\uC7A5 \uAC00\uB2A5\uC131\uC744 \uBB3B\uB294\uB2E4"
      playerLine: "\ubc00\ub9b0 \ub300\uae08\uc774 \ub4e4\uc5b4\uc624\uba74 \ub2e4\uc2dc \ubc84\ud2f8 \uc218 \uc788\uaca0\uc2b5\ub2c8\uae4c?"
      response: "\uac00\ub2a5\uc740 \ud574\uc694. \ub2e4\ub9cc \uadf8\ub54c\uae4c\uc9c0 \ubc84\ud2f8 \ub3c8\ub3c4 \uc788\uc5b4\uc57c\uaca0\uc8e0."
      targetNpcId: npc-mirae-construction-cfo-seo-jia
      memoryType: 8
      interpretation: "\uCCAB \uBA74\uB2F4\uC5D0\uC11C \uC815\uC0C1\uD654\uC640 \uC131\uC7A5\uC758
        \uC870\uAC74\uC744 \uBB3C\uC5C8\uB2E4."
      relationDelta:
        trust: 0
        respect: 0
        fear: 0
        hostility: 0
        dependency: 0
        interest: 2
    - title: "\uAC00\uACA9\uACFC \uBD80\uB2F4\uC744 \uBB3B\uB294\uB2E4"
      playerLine: "\uc0ac\uc815\uc774 \uc774\ub7ec\uba74 \uac00\uaca9\ub3c4 \uc880 \uc598\uae30\ud574\ubcfc \uc218 \uc788\uaca0\ub124\uc694."
      response: "\uc598\uae30\ub294 \ud574\ubcfc \uc218 \uc788\uc8e0. \ub300\uc2e0 \uc5b4\ub5a4 \ubd80\ub2f4\uae4c\uc9c0 \ub9e1\uc73c\uc2e4 \uac74\uc9c0\ub3c4 \uac19\uc774 \ubd10\uc8fc\uc138\uc694."
      targetNpcId: npc-mirae-construction-cfo-seo-jia
      memoryType: 8
      interpretation: "\uCCAB \uBA74\uB2F4\uC5D0\uC11C \uAC00\uACA9\uACFC \uD568\uAED8
        \uC778\uC218\uC790\uAC00 \uB9E1\uC744 \uBD80\uB2F4\uC744 \uB17C\uC758\uD588\uB2E4."
      relationDelta:
        trust: 0
        respect: 0
        fear: 0
        hostility: 0
        dependency: 0
        interest: 1
    skipDefaultChoice: 0
  - id: intro-066
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uC11C\uC9C0\uC544\uC758 \uC22B\uC790"
    background: {fileID: 21300000, guid: 3da8335e8f928b04ea9542177aaee968, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\uc608\uc804\uc5d0\ub294 \uc800 \uc885\uc774\ub4e4 \uc55e\uc5d0\uc11c \ud560 \uc218 \uc788\ub294 \ub9d0\uc774 \uc5c6\uc5c8\ub2e4. \uc9c0\uae08\uc740 \ubb3b\uace0, \ub530\uc838\ubcfc \uc218 \uc788\ub2e4. \ud310\ub2e8\uc740 \uadf8\ub2e4\uc74c\uc774\ub2e4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-067
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uCCAB \uC9C0\uBD84"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 1
    npcId: npc-broker-yoon-hajin
    voiceLabel:
    text: "\uc6b0\uc120 \uc18c\ub7c9\ub9cc \uc0ac\uaca0\uc2b5\ub2c8\ub2e4. \ub354 \uc54c\uc544\ubcfc \ud544\uc694\uac00 \uc788\uc5b4\uc694."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-068
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uCCAB \uC9C0\uBD84"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel:
    text: "\uadf8\ub7fc \ud55c \uc8fc\ub9cc \uc0ac\ubcf4\uc2dc\uc8e0. \uc0ac\uace0 \ub098\uc11c\ub3c4 \uc4f8 \ub3c8\uc774 \ub0a8\ub294\uc9c0 \ubcf4\uace0\uc694. \ucc98\uc74c\ubd80\ud130 \uc11c\ub450\ub97c \uac74 \uc5c6\uc73c\ub2c8\uae4c\uc694."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-069
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uCCAB \uC9C0\uBD84"
    background: {fileID: 21300000, guid: f2ae5346af09a0045b072d43aaad3d54, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 4
    npcId:
    voiceLabel:
    text: "\uc218\ub7c9\uc5d0 1\uc744 \uc785\ub825\ud558\uace0 \ubbf8\ub798\uac74\uc124 \uc8fc\uc2dd 1\uc8fc\ub97c \ub9e4\uc218\ud558\uc138\uc694."
    showPlayer: 0
    goal: 2
    tutorialTitle: "\uc8fc\uc2dd \ub9e4\uc218"
    tutorialText: "\uc218\ub7c9\uc5d0 1\uc744 \uc785\ub825\ud55c \ub4a4 \ub9e4\uc218\ud558\uae30\ub97c \uc120\ud0dd\ud574 \uc8fc\uc2ed\uc2dc\uc624. \ub9e4\uc218 \ub300\uae08\uacfc \ub0a8\ub294 \uc790\uae08\uc744 \ud568\uaed8 \ud655\uc778\ud558\uc2e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc8fc\uc2dd \ub9e4\uc218 \ub300\uae08\uc740 \uae30\uc874 \uc8fc\uc8fc\uc5d0\uac8c \uc9c0\uae09\ub418\uba70 \ud68c\uc0ac \uc6b4\uc601\uc790\uae08\uc5d0 \uc9c1\uc811 \ub4e4\uc5b4\uac00\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
    choices: []
    skipDefaultChoice: 0
  - id: intro-070
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uCCAB \uC9C0\uBD84"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 4
    npcId:
    voiceLabel:
    text: "{tradeResult}"
    showPlayer: 0
    goal: 0
    tutorialTitle: "\uac70\ub798 \uacb0\uacfc"
    choices: []
    skipDefaultChoice: 0
  - id: intro-071
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uCCAB \uC9C0\uBD84"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 1
    npcId: npc-broker-yoon-hajin
    voiceLabel:
    text: "\uc774 \uc815\ub3c4\ub85c \ub2ec\ub77c\uc9c0\ub294 \uac8c \uc788\uc2b5\ub2c8\uae4c?"
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-072
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uCCAB \uC9C0\uBD84"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel:
    text: "\uc774\uc81c \uc8fc\uc8fc\uac00 \ub41c \uac70\uc8e0. \ud68c\uc0ac\ub97c \ub9c8\uc74c\ub300\ub85c \uc6c0\uc9c1\uc77c \uc218 \uc788\ub294 \uac74 \uc544\ub2c8\uace0\uc694. \uadf8\ub798\ub3c4 \ub0b4 \ub3c8\uc774 \ub4e4\uc5b4\uac14\uc73c\ub2c8, \ub0b4\uc77c\ubd80\ud130\ub294 \uc774 \ud68c\uc0ac \uc18c\uc2dd\uc774 \ub2e4\ub974\uac8c \ub4e4\ub9b4 \uac81\ub2c8\ub2e4."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-073
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uCCAB \uC9C0\uBD84"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\uc800\uae30\uae4c\uc9c0 \uac00\ub824\uba74 \uc544\uc9c1 \uba40\uc5c8\ub2e4. \uadf8\ub798\ub3c4 \uc624\ub298\uc740 \uccab \uc9c0\ubd84\uc774 \uc0dd\uacbc\ub2e4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-074
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uAC15\uC900\uD601\uC758 \uC9C8\uBB38"
    background: {fileID: 21300000, guid: 3da8335e8f928b04ea9542177aaee968, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\uc724\ud558\uc9c4\uc774 \uc57d\uc18d\uc744 \uc7a1\uc544\ub454 \ub355\ubd84\uc5d0 \ub300\ud45c\uc640 \uc9c1\uc811 \ub9c8\uc8fc \uc549\uc558\ub2e4."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-075
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uAC15\uC900\uD601\uC758 \uC9C8\uBB38"
    background: {fileID: 21300000, guid: 3da8335e8f928b04ea9542177aaee968, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-mirae-construction-ceo-kang-junhyeok
    voiceLabel:
    text: "\uc8fc\uc2dd\uc744 \uc0ac\uc168\ub2e4\uace0 \ub4e4\uc5c8\uc2b5\ub2c8\ub2e4. \uc6b0\ub9ac \ud68c\uc0ac\uc5d0\uc11c \ubb34\uc5c7\uc744 \ubcf4\uc168\uc2b5\ub2c8\uae4c?"
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-076
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uAC15\uC900\uD601\uC758 \uC9C8\uBB38"
    background: {fileID: 21300000, guid: 3da8335e8f928b04ea9542177aaee968, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 1
    npcId: npc-mirae-construction-ceo-kang-junhyeok
    voiceLabel:
    text: "\uc9c1\uc811 \ud655\uc778\ud558\uace0 \uc2f6\uc5b4\uc11c \uc654\uc2b5\ub2c8\ub2e4."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-077
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uAC15\uC900\uD601\uC758 \uC9C8\uBB38"
    background: {fileID: 21300000, guid: 3da8335e8f928b04ea9542177aaee968, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-mirae-construction-ceo-kang-junhyeok
    voiceLabel:
    text: "\uadf8\ub7fc \uc800\ub3c4 \ud655\uc778\ud558\uc8e0. \uc774 \ud68c\uc0ac\uc5d0 \uc5bc\ub9c8\ub098 \uc624\ub798 \uacc4\uc2e4 \uc0dd\uac01\uc785\ub2c8\uae4c?"
    showPlayer: 1
    goal: 0
    choices:
    - title: "\uC7A5\uAE30\uC801\uC778 \uACBD\uC601 \uCC38\uC5EC"
      playerLine: "\ud0a4\uc6cc\ubcfc \ub9cc\ud55c \ud68c\uc0ac\ub77c\uba74 \uc624\ub798 \ud568\uaed8\ud560 \uc0dd\uac01\uc785\ub2c8\ub2e4. \uadf8\ub798\uc11c \uc9c1\uc811 \ubcf4\ub7ec \uc628 \uac70\uace0\uc694."
      response: "\uadf8 \uc815\ub3c4\uba74 \ub410\uc2b5\ub2c8\ub2e4. \uc624\ub298 \ucc98\uc74c \ubcf8 \ubd84\ud55c\ud14c \ud3c9\uc0dd \ud568\uaed8\ud558\uaca0\ub2e4\ub294 \ub9d0\uae4c\uc9c0 \ub4e3\uace0 \uc2f6\uc9c4 \uc54a\uc73c\ub2c8\uae4c\uc694."
      targetNpcId: npc-mirae-construction-ceo-kang-junhyeok
      memoryType: 8
      interpretation: "\uC7A5\uAE30 \uCC38\uC5EC\uB97C \uAC80\uD1A0\uD558\uB418 \uC544\uC9C1
        \uAC80\uC99D\uC774 \uD544\uC694\uD558\uB2E4\uACE0 \uBC1D\uD614\uB2E4."
      relationDelta:
        trust: 0
        respect: 1
        fear: 0
        hostility: 0
        dependency: 0
        interest: 2
    - title: "\uC218\uC775 \uC911\uC2EC\uC758 \uD22C\uC790"
      playerLine: "\uc6d0\ud558\ub294 \ub9cc\ud07c \uc218\uc775\uc774 \ub098\uba74 \ud314 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4. \uadf8\uac74 \ubbf8\ub9ac \ub9d0\uc500\ub4dc\ub9ac\ub294 \uac8c \ub9de\uaca0\uc8e0."
      response: "\uc54c\uaca0\uc2b5\ub2c8\ub2e4. \uadf8\ub7fc \uc5b8\uc81c\uae4c\uc9c0, \uc5b4\ub5a4 \uc870\uac74\uc73c\ub85c \ud568\uaed8\ud560 \uc218 \uc788\uc744\uc9c0 \ubd84\uba85\ud788 \ud574\uc57c\uaca0\uad70\uc694."
      targetNpcId: npc-mirae-construction-ceo-kang-junhyeok
      memoryType: 8
      interpretation: "\uC218\uC775 \uBAA9\uD45C\uC640 \uB9E4\uAC01 \uAC00\uB2A5\uC131\uC744
        \uC194\uC9C1\uD788 \uC54C\uB838\uB2E4."
      relationDelta:
        trust: 0
        respect: 1
        fear: 0
        hostility: 0
        dependency: 0
        interest: 0
    - title: "\uACBD\uC601\uAD8C \uD655\uBCF4 \uAC80\uD1A0"
      playerLine: "\uc5ec\uac74\uc774 \ub9de\uc73c\uba74 \uacbd\uc601\uad8c\uae4c\uc9c0 \uc0dd\uac01\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4."
      response: "\u2026\uadf8\ub807\ub2e4\uba74 \uc81c\uac00 \ub9cc\ub4e0 \ud68c\uc0ac\ub97c \uc5b4\ub5bb\uac8c \uafb8\ub824\uac08 \uc0dd\uac01\uc778\uc9c0, \ub2e4\uc74c\uc5d4 \uadf8 \uc598\uae30\ub3c4 \uc900\ube44\ud574 \uc624\uc2ed\uc2dc\uc624."
      targetNpcId: npc-mirae-construction-ceo-kang-junhyeok
      memoryType: 8
      interpretation: "\uACBD\uC601\uAD8C \uD655\uBCF4 \uC758\uC0AC\uB97C \uC54C\uB838\uC73C\uBA70
        \uC6B4\uC601 \uACC4\uD68D\uC744 \uC694\uAD6C\uBC1B\uC558\uB2E4."
      relationDelta:
        trust: 0
        respect: 0
        fear: 0
        hostility: 0
        dependency: 0
        interest: 2
    skipDefaultChoice: 0
  - id: intro-078
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uAC15\uC900\uD601\uC758 \uC9C8\uBB38"
    background: {fileID: 21300000, guid: 3da8335e8f928b04ea9542177aaee968, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-mirae-construction-ceo-kang-junhyeok
    voiceLabel:
    text: "\ud68c\uc0ac \uc774\ub984\uc774 \uc801\ud78c \uacc4\uc57d\ub4e4\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uadf8 \uacc4\uc57d\uc744 \ubbff\uace0 \ud604\uc7a5\uc5d0 \ub098\uc628 \uc0ac\ub78c\ub4e4\ub3c4 \uc788\uace0\uc694. \uc55e\uc73c\ub85c \ubb34\uc5c7\uc744 \ubc14\uafb8\ub4e0, \uadf8 \uc0ac\uc2e4\ubd80\ud130 \uc54c\uc544\uc8fc\uc168\uc73c\uba74 \ud569\ub2c8\ub2e4."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-079
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uAC15\uC900\uD601\uC758 \uC9C8\uBB38"
    background: {fileID: 21300000, guid: 3da8335e8f928b04ea9542177aaee968, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\uc800 \uc0ac\ub78c\ub3c4 \uc9c0\ud0a4\ub824\ub294 \uac8c \uc788\ub2e4. \ub0b4\uac00 \uc5ec\uae30 \uc628 \uc774\uc720\uc640\ub294 \ub2e4\ub978 \uc774\uc720\ub85c."
    showPlayer: 0
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-080
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uAC15\uC900\uD601\uC758 \uC9C8\uBB38"
    background: {fileID: 21300000, guid: 3da8335e8f928b04ea9542177aaee968, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 4
    npcId:
    voiceLabel:
    text: "\uac15\uc900\ud601\uc758 \uc778\ubb3c \uc815\ubcf4\ub97c \ud655\uc778\ud558\uc138\uc694. \uc778\ubb3c\ub9c8\ub2e4 \uc911\uc694\ud558\uac8c \uc5ec\uae30\ub294 \uc870\uac74\uc774 \ub2e4\ub985\ub2c8\ub2e4."
    showPlayer: 0
    goal: 3
    tutorialTitle: "\uc778\ubb3c \uc815\ubcf4"
    tutorialText: "\uc778\ubb3c\uc758 \uc131\uaca9\uacfc \uc911\uc694\ud558\uac8c \uc5ec\uae30\ub294 \uc870\uac74\uc744 \ud655\uc778\ud558\uc2e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac19\uc740 \ud589\ub3d9\uc774\ub77c\ub3c4 \uc0c1\ub300\uc758 \uc131\ud5a5\uc5d0 \ub530\ub77c \ubc18\uc751\uc774 \ub2ec\ub77c\uc9d1\ub2c8\ub2e4. \uc774\ubc88 \uba74\ub2f4\uc740 \uc724\ud558\uc9c4\uc758 \uc18c\uac1c\ub85c \ub9c8\ub828\ub418\uc5c8\uc2b5\ub2c8\ub2e4."
    choices: []
    skipDefaultChoice: 0
  - id: intro-081
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uD68C\uC758\uC2E4 \uBC16\uC758
      \uD68C\uC0AC"
    background: {fileID: 21300000, guid: cd737e0de23899c4b9fc897defc1bbbb, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-mirae-construction-field-director-park-dosik
    voiceLabel:
    text: "\uc774\uac70 \uc4f0\uc2ed\uc2dc\uc624. \uc548\uc73c\ub85c \ub4e4\uc5b4\uc624\uc2e4 \uac70\uba74\uc694."
    showPlayer: 1
    goal: 0
    choices: []
    skipDefaultChoice: 0
  - id: intro-082
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uD68C\uC758\uC2E4 \uBC16\uC758
      \uD68C\uC0AC"
    background: {fileID: 21300000, guid: cd737e0de23899c4b9fc897defc1bbbb, type: 3}
