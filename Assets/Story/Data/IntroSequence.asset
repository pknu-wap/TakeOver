  - id: neutral-intro-T1-12
    sceneTitle: "\uC774\uBBFC\uADDC \u2014 \uC8FC\uC8FC\uB2D8\uC774\uB77C\uACE0 \uBD88\uB7EC\uB3C4
      \uB418\uB098\uC694"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-economic-reporter-lee-mingyu
    voiceLabel:
    text: "\uD68C\uC0AC\uAC00 \uD55C \uB9D0\uD558\uACE0 \uC2E4\uC81C \uB098\uC628
      \uC22B\uC790\uAC00 \uB2E4\uB97C \uB54C\uC694. \uD22C\uC790\uC790\uB4E4\uC740
      \uBB58 \uBCF4\uACE0 \uB4E4\uC5B4\uC654\uB294\uC9C0\uB3C4 \uAD81\uAE08\uD558\uACE0\uC694.
      \uC624\uB298\uC740 \uD55C \uAC00\uC9C0\uB9CC \uBB3B\uC8E0. \uC774 \uD68C\uC0AC\uC5D0\uC11C
      \uBB58 \uBCF4\uC168\uC5B4\uC694?"
    showPlayer: 1
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: neutral-intro-T1-choice
    sceneTitle: "\uC774\uBBFC\uADDC \u2014 \uC8FC\uC8FC\uB2D8\uC774\uB77C\uACE0 \uBD88\uB7EC\uB3C4
      \uB418\uB098\uC694"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-economic-reporter-lee-mingyu
    voiceLabel:
    text: "\uC5B4\uB5A4 \uC0DD\uAC01\uC774\uC2E0\uC9C0 \uB4E3\uACE0 \uC2F6\uC2B5\uB2C8\uB2E4."
    showPlayer: 1
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices:
    - title: "\uC544\uC9C1 \uD655\uC778 \uC911\uC774\uB77C\uACE0 \uB9D0\uD55C\uB2E4"
      description: "\uD655\uC778\uD55C \uC0AC\uC2E4\uACFC \uD310\uB2E8\uC744 \uAD6C\uBD84\uD574 \uB2F5\uD569\uB2C8\uB2E4."
      playerLine: "\uACF5\uC0AC\uB294 \uACC4\uC18D\uD558\uB294\uB370 \uB3C8\uC774
        \uB2A6\uAC8C \uB3C8\uB2E4\uB294 \uC774\uC57C\uAE30\uB97C \uB4E4\uC5C8\uC2B5\uB2C8\uB2E4.
        \uADF8 \uB9D0\uC774 \uC790\uB8CC\uD558\uACE0 \uB9DE\uB294\uC9C0 \uBCF4\uB294
        \uC911\uC785\uB2C8\uB2E4."
      response: "\uC544\uC9C1 \uBAA8\uB978\uB2E4\uB294 \uB9D0, \uC758\uC678\uB85C
        \uB4E3\uAE30 \uC5B4\uB835\uC2B5\uB2C8\uB2E4. \uB2E4\uB4E4 \uBC8C\uC368 \uB2F5\uC744
        \uC815\uD574\uB193\uACE0 \uC624\uC2DC\uAC70\uB4E0\uC694.\n\n\uC88B\uC544\uC694.
        \uB098\uC911\uC5D0 \uB2F5\uC774 \uB2EC\uB77C\uC9C0\uBA74 \uBB34\uC5C7\uC744
        \uBCF4\uACE0 \uB2EC\uB77C\uC84C\uB294\uC9C0\uB9CC \uC54C\uB824\uC8FC\uC138\uC694.
        \uC81C\uAC00 \uADF8 \uC0AC\uC774\uB97C \uBE7C\uBA39\uC9C0 \uC54A\uAC8C\uC694."
      targetNpcId: npc-economic-reporter-lee-mingyu
      memoryType: 8
      interpretation: "\uCCAB \uBC29\uBB38\uC5D0\uC11C \uD68C\uC218 \uC77C\uC815\uACFC
        \uACF5\uAC1C \uC790\uB8CC\uB97C \uD655\uC778 \uC911\uC774\uB77C\uACE0 \uC124\uBA85\uD588\uB2E4.
        \uD68C\uC0AC \uC815\uC0C1\uD654\uB098 \uACBD\uC601 \uCC38\uC5EC\uB97C \uC57D\uC18D\uD558\uC9C0
        \uC54A\uC558\uB2E4."
      relationDelta:
        trust: 0
        respect: 1
        closeness: 0
    - title: "\uC800\uD3C9\uAC00 \uAC00\uB2A5\uC131\uC744 \uBCF4\uACE0 \uC788\uB2E4\uACE0
        \uB9D0\uD55C\uB2E4"
      description: "\uD604\uC7AC \uC8FC\uAC00\uB97C \uC5B4\uB5BB\uAC8C \uBCF4\uACE0 \uC788\uB294\uC9C0 \uBC1D\uD799\uB2C8\uB2E4."
      playerLine: "\uC2DC\uC7A5\uC5D0\uC11C \uBCF4\uB294 \uAC00\uACA9\uBCF4\uB2E4
        \uBC84\uD2F8 \uD798\uC774 \uC788\uC744 \uC218 \uC788\uB2E4\uACE0 \uC0DD\uAC01\uD569\uB2C8\uB2E4.
        \uADF8\uAC78 \uD655\uC778\uD558\uB7EC \uC654\uC2B5\uB2C8\uB2E4."
      response: "\uADF8\uB7FC \uC2FC \uC774\uC720\uB3C4 \uAC19\uC774 \uCC3E\uC544\uBCF4\uC154\uC57C\uACA0\uB124\uC694.
        \uC2F8\uAC8C \uBCF4\uC774\uB294 \uB370\uB294 \uB300\uCCB4\uB85C \uC774\uC720\uAC00
        \uC788\uC5B4\uC11C.\n\n\uB9DE\uC544\uC694. \uADF8 \uCC28\uC774\uB97C \uD655\uC778\uD558\uC2DC\uBA74
        \uC5F0\uB77D \uC8FC\uC138\uC694. \u2018\uACE7 \uC624\uB978\uB2E4\u2019\uB294
        \uB9D0 \uB9D0\uACE0, \uBB58 \uACFC\uD558\uAC8C \uBD24\uB294\uC9C0 \uB4E3\uACE0
        \uC2F6\uC2B5\uB2C8\uB2E4."
      targetNpcId: npc-economic-reporter-lee-mingyu
      memoryType: 8
      interpretation: "\uC800\uD3C9\uAC00 \uAC00\uB2A5\uC131\uC744 \uAC80\uD1A0\uD55C\uB2E4\uACE0
        \uB9D0\uD588\uB2E4. \uC8FC\uAC00 \uC0C1\uC2B9 \uBCF4\uC7A5\uC774\uB098 \uCD94\uCC9C
        \uBC1C\uC5B8\uC740 \uD558\uC9C0 \uC54A\uC558\uB2E4."
      relationDelta:
        trust: 0
        respect: 0
        closeness: 0
    - title: "\uC9C0\uAE08\uC740 \uCDE8\uC7AC\uC5D0 \uB2F5\uD558\uC9C0 \uC54A\uB294\uB2E4"
      description: "\uCDE8\uC7AC \uC694\uCCAD\uC744 \uC815\uC911\uD788 \uBCF4\uB958\uD569\uB2C8\uB2E4."
      playerLine: "\uC544\uC9C1 \uBC16\uC5D0 \uB9D0\uC500\uB4DC\uB9B4 \uB9CC\uD55C
        \uD310\uB2E8\uC774 \uC5C6\uC2B5\uB2C8\uB2E4. \uC624\uB298\uC740 \uC778\uC0AC\uB9CC
        \uD558\uACA0\uC2B5\uB2C8\uB2E4."
      response: "\uB124, \uADF8\uB7FC \uC5EC\uAE30\uAE4C\uC9C0. \uC5F0\uB77D\uCC98\uB9CC
        \uB4DC\uB9B4\uAC8C\uC694. \uB098\uC911\uC5D0 \uB2F5\uD558\uC2E4 \uB54C\uB3C4
        \uB9D0\uD558\uAE30 \uC5B4\uB824\uC6B4 \uBC94\uC704\uBD80\uD130 \uC815\uD574\uC8FC\uC2DC\uBA74
        \uB429\uB2C8\uB2E4.\n\n\uC5EC\uAE30\uC11C \uAE30\uBD84 \uC0C1\uD558\uBA74
        \uCD9C\uADFC\uC744 \uBABB \uD558\uC8E0. \uBB34\uC2A8 \uB9D0\uC744 \uB4E4\uC5C8\uB294\uC9C0
        \uD5F7\uAC08\uB9AC\uB294 \uAC83\uBCF4\uB2E4 \uD6E8\uC52C \uB0AB\uC2B5\uB2C8\uB2E4."
      targetNpcId: npc-economic-reporter-lee-mingyu
      memoryType: 8
      interpretation: "\uCCAB \uB9CC\uB0A8\uC5D0\uC11C \uCDE8\uC7AC \uB2F5\uBCC0\uC744
        \uC815\uC911\uD788 \uC720\uBCF4\uD588\uB2E4. \uBE44\uD611\uC870\xB7\uD5C8\uC704
        \uD574\uBA85\xB7\uAD00\uACC4 \uB2E8\uC808\uB85C \uAE30\uB85D\uD558\uC9C0
        \uC54A\uB294\uB2E4."
      relationDelta:
        trust: 0
        respect: 0
        closeness: 0
    skipDefaultChoice: 0
  - id: neutral-intro-T1-tail-0
    sceneTitle: "\uC774\uBBFC\uADDC \u2014 \uC8FC\uC8FC\uB2D8\uC774\uB77C\uACE0 \uBD88\uB7EC\uB3C4
      \uB418\uB098\uC694"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-economic-reporter-lee-mingyu
    voiceLabel:
    text: "\uC544, \uADF8\uB9AC\uACE0 \uC9C0\uAE08 \uB098\uB208 \uB9D0\uC740 \uB9D0\uC500\uB4DC\uB9B0
      \uB300\uB85C \uAE30\uC0AC\uC5D0 \uC548 \uC501\uB2C8\uB2E4. \uB2E4\uC74C\uC5D0
      \uC815\uC2DD\uC73C\uB85C \uC5EC\uCB50 \uB550 \uC774\uB984\uC744 \uB123\uC5B4\uB3C4
      \uB418\uB294\uC9C0\uBD80\uD130 \uD655\uC778\uD560\uAC8C\uC694."
