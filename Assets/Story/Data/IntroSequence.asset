      \uD1B5\uC81C\uD560 \uC218 \uC788\uB294 \uAC74 \uB9CE\uC9C0 \uC54A\uC73C\uB2C8\uAE4C\uC694.
      \uC81C\uAC00 \uBC84\uD2F8 \uC218 \uC788\uB294 \uC2DC\uAC04\uC740 \uC801\uC5B4\uB3C4
      \uC54C\uACE0 \uC788\uC5B4\uC57C \uD569\uB2C8\uB2E4."
    showPlayer: 1
    goal: 0
    companyId:
    tutorialTitle:
