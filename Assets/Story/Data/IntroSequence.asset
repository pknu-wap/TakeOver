    npcId: npc-broker-yoon-hajin
    voiceLabel:
    text: "\uAE30\uC5C5 \uC9C0\uC6D0 \uC808\uCC28\uB97C \uC124\uBA85\uD558\uB294
      \uC790\uB8CC\uAC00 \uB098\uC654\uB300\uC694. \uC544\uB294 \uC790\uBB38\uAC00\uAC00
      \uADFC\uCC98\uC5D0 \uC788\uC5B4\uC11C \uBC1B\uC544\uAC00\uB824\uACE0\uC694.
      \uD68C\uC0AC \uC77C\uC744 \uBCF4\uC2DC\uB2E4 \uBCF4\uBA74 \uC81C\uB3C4\uB098
      \uC2E0\uCCAD \uC77C\uC815\uB3C4 \uB9CC\uB098\uAC8C \uB420 \uD14C\uB2C8 \uC778\uC0AC\uB9CC
