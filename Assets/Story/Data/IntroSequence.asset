  - id: neutral-intro-T1-10
    sceneTitle: "\uC774\uBBFC\uADDC \u2014 \uC8FC\uC8FC\uB2D8\uC774\uB77C\uACE0 \uBD88\uB7EC\uB3C4
      \uB418\uB098\uC694"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-economic-reporter-lee-mingyu
    voiceLabel:
    text: "\uC81C\uBAA9\uC740 \uB9E8 \uB098\uC911\uC5D0 \uBD99\uC785\uB2C8\uB2E4.
      \uC790\uC8FC \uAC08\uC544\uC5CE\uC5B4\uC11C \uBB38\uC81C\uC9C0. \uC9C0\uAE08
      \uB9D0\uC500\uC740 \uCDE8\uC7AC \uB2F5\uBCC0\uC73C\uB85C \uC4F0\uC9C0 \uC54A\uC744\uAC8C\uC694.
      \uC55E\uC73C\uB85C \uC5F0\uB77D\uB4DC\uB824\uB3C4 \uB418\uB294\uC9C0 \uADF8
      \uC815\uB3C4\uB9CC \uC5EC\uCB59\uACA0\uC2B5\uB2C8\uB2E4."
    showPlayer: 1
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: neutral-intro-T1-11
    sceneTitle: "\uC774\uBBFC\uADDC \u2014 \uC8FC\uC8FC\uB2D8\uC774\uB77C\uACE0 \uBD88\uB7EC\uB3C4
