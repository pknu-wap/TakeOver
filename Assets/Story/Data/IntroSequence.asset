    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 1
    npcId: npc-broker-yoon-hajin
    voiceLabel: ""
    text: "\uc774\uc81c \uc870\uae08 \uc54c\uaca0\ub124\uc694. \ud68c\uc0ac \uc0ac\uc815\ub3c4 \ubcf4\uace0, \uc4f8 \ub3c8\ub3c4 \ub0a8\uaca8\ub450\uace0, \ub204\uad6c\ud55c\ud14c \ubb34\uc2a8 \ub9d0\uc744 \ud588\ub294\uc9c0\ub3c4 \ucc59\uaca8\uc57c\uaca0\uad70\uc694."
    showPlayer: 1
