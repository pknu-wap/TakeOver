    choices: []
    skipDefaultChoice: 0
  - id: intro-087
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uD68C\uC758\uC2E4 \uBC16\uC758
      \uD68C\uC0AC"
    background: {fileID: 21300000, guid: cd737e0de23899c4b9fc897defc1bbbb, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 4
    npcId:
    voiceLabel:
    text: "\ubc15\ub3c4\uc2dd\uc758 \uc778\ubb3c \uc815\ubcf4\ub97c \uc5f4\uc5b4 \uc774\ubc88 \ub300\ud654\uc758 \uad00\uacc4 \ubcc0\ud654\uc640 \uae30\uc5b5\uc744 \ud655\uc778\ud558\uc138\uc694."
    showPlayer: 0
    goal: 4
    tutorialTitle: "\uad00\uacc4\uc640 \uae30\uc5b5"
    tutorialText: "\ub300\ud654\uc640 \uc120\ud0dd\uc740 \uc0c1\ub300\uc640\uc758 \uad00\uacc4\ub97c \ubc14\uafb8\uace0 \uae30\uc5b5\uc73c\ub85c \ub0a8\uc2b5\ub2c8\ub2e4. \uc0c1\ub300\uc758 \uc131\ud5a5\uacfc \uc774\uc804 \ubc18\uc751\uc744 \ud568\uaed8 \ud655\uc778\ud558\uba74 \ub2e4\uc74c \ub9cc\ub0a8\uc744 \uc900\ube44\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub429\ub2c8\ub2e4.\n\n\ube44\uc601\uad6c \uae30\uc5b5\uc740 \uc2dc\uac04\uc774 \uc9c0\ub098\uba74 \uc601\ud5a5\ub825\uc774 \uc904\uace0 \uae30\ud55c\uc774 \ub05d\ub098\uba74 \uc0ad\uc81c\ub429\ub2c8\ub2e4. \uc774\ubbf8 \ubc18\uc601\ub41c \uad00\uacc4 \ubcc0\ud654\ub294 \ub418\ub3cc\uc544\uac00\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
    choices: []
    skipDefaultChoice: 0
  - id: intro-087-summary
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uD68C\uC758\uC2E4 \uBC16\uC758
      \uD68C\uC0AC"
    background: {fileID: 21300000, guid: cd737e0de23899c4b9fc897defc1bbbb, type: 3}
