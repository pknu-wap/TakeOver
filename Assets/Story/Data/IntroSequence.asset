    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel:
    text: "\uAC19\uC740 \uC790\uB8CC\uB97C \uBCF4\uACE0\uB3C4 \uB2E4\uB978 \uC9C8\uBB38\uC744
      \uD558\uB294 \uBD84\uC744 \uB9CC\uB098\uBCF4\uC8E0. \uAE30\uAD00\uD22C\uC790\uC790
