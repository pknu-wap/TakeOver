    npcId:
    voiceLabel:
    text: "\uC8FC\uC2DD\uC744 \uC870\uAE08 \uC0C0\uB2E4\uACE0 \uBC14\uB85C \uC778\uC218 \uC774\uC57C\uAE30\uAC00 \uB098\uC635\uB2C8\uAE4C?"
