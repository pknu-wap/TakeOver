    speaker: 0
    npcId:
    voiceLabel:
    text: "\uC724\uD558\uC9C4\uC774 \uC57D\uC18D\uC744 \uC7A1\uC544\uB454 \uB355\uBD84\uC5D0
      \uB300\uD45C\uC640 \uC9C1\uC811 \uB9C8\uC8FC \uC549\uC558\uB2E4."
