    npcId: npc-broker-yoon-hajin
    voiceLabel: ""
    text: "\ube5a\uc774 \uc5bc\ub9c8\ub098 \ub07c\uc5b4 \uc788\ub294\uc9c0\ub3c4 \ube7c\ub193\uc73c\uba74 \uc548 \ub418\uace0\uc694."
    showPlayer: 1
    goal: 0
    companyId:
    choices: []
    skipDefaultChoice: 0
  - id: lesson-028
    sceneTitle: "\ub458\uc9f8 \ub0a0  /  \ud68c\uc0ac\uc758 \uc22b\uc790"
    background: {fileID: 21300000, guid: f2ae5346af09a0045b072d43aaad3d54, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 4
    npcId:
    voiceLabel: ""
    text: "\ubbf8\ub798\uac74\uc124\uc758 \ub9e4\ucd9c\u00b7\uc21c\uc774\uc775\u00b7\ud604\uae08\u00b7\ubd80\ucc44\ube44\uc728\uc744 \ud655\uc778\ud558\uc138\uc694."
    showPlayer: 0
    goal: 9
    companyId:
    tutorialTitle: "\uc7ac\ubb34 \uc815\ubcf4 \uc77d\uae30"
    tutorialText: "\ub9e4\ucd9c\uc740 \ud310\ub9e4 \uaddc\ubaa8, \uc21c\uc774\uc775\uc740 \ube44\uc6a9\uc744 \ubc18\uc601\ud55c \uacb0\uacfc\uc785\ub2c8\ub2e4. \ud68c\uc0ac \ud604\uae08\uc740 \ub2f9\uc7a5 \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294 \ub3c8\uc774\uba70 \ud50c\ub808\uc774\uc5b4\uc758 \uc794\uc561\uacfc \uad6c\ubd84\ub429\ub2c8\ub2e4. \ubd80\ucc44\ube44\uc728\uc740 \ube4c\ub9b0 \ub3c8\uc758 \ubd80\ub2f4\uc744 \uc0b4\ud3b4\ubcf4\ub294 \uc9c0\ud45c\uc785\ub2c8\ub2e4."
    choices: []
    skipDefaultChoice: 0
  - id: lesson-029
    sceneTitle: "\ub458\uc9f8 \ub0a0  /  \ud68c\uc0ac\uc758 \uc22b\uc790"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel: ""
    text: "\uc9c0\uae08 \uc6b0\ub9ac\uac00 \ub0b4\ub294 \ub3c8\uc740 \ud30c\ub294 \uc8fc\uc8fc\ud55c\ud14c \uac00\ub294 \uac81\ub2c8\ub2e4. \ud68c\uc0ac \ud1b5\uc7a5\uc5d0 \ubc14\ub85c \ub123\uc5b4\uc8fc\ub294 \ub3c8\uc740 \uc544\ub2c8\uace0\uc694."
    showPlayer: 1
    goal: 0
    companyId:
    choices: []
    skipDefaultChoice: 0
  - id: lesson-030
    sceneTitle: "\ub458\uc9f8 \ub0a0  /  \ud68c\uc0ac\uc758 \uc22b\uc790"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 1
    npcId: npc-broker-yoon-hajin
    voiceLabel: ""
    text: "\uadf8\ub7fc \ub2e4\ub978 \ud68c\uc0ac\ub3c4 \uac19\uc774 \ubd10\uc57c\uaca0\uad70\uc694. \uc5b4\ub290 \ucabd \uc0ac\uc815\uc774 \ub098\uc740\uc9c0."
    showPlayer: 1
    goal: 0
    companyId:
    choices: []
    skipDefaultChoice: 0
  - id: lesson-031
    sceneTitle: "\ub458\uc9f8 \ub0a0  /  \ud68c\uc0ac\uc758 \uc22b\uc790"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel: ""
    text: "\ud558\ub298\uc2dd\ud488\ub3c4 \ud55c\ubc88 \ubcf4\uc2dc\uc8e0. \ubb34\uc2a8 \uc7a5\uc0ac\ub97c \ud558\ub294\uc9c0\ubd80\ud130 \ubcf4\uace0, \uac19\uc740 \uc22b\uc790\ub07c\ub9ac \ub098\ub780\ud788 \ub193\uace0 \ubcf4\uc138\uc694. \ud55c \uc8fc\uac00 \uc2f8\ub2e4\uace0 \ubb34\uc870\uac74 \uc2fc \ud68c\uc0ac\ub294 \uc544\ub2c8\ub2c8\uae4c\uc694."
    showPlayer: 1
    goal: 0
    companyId:
    choices: []
    skipDefaultChoice: 0
  - id: lesson-032
    sceneTitle: "\ub458\uc9f8 \ub0a0  /  \ud68c\uc0ac\uc758 \uc22b\uc790"
    background: {fileID: 21300000, guid: f2ae5346af09a0045b072d43aaad3d54, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 4
    npcId:
    voiceLabel: ""
    text: "\ud558\ub298\uc2dd\ud488\uc758 \uc18c\uac1c\uc640 \uac19\uc740 \uc7ac\ubb34 \uc9c0\ud45c\ub97c \ud655\uc778\ud558\uc138\uc694."
    showPlayer: 0
    goal: 10
    companyId: haneul-food
    tutorialTitle: "\ud68c\uc0ac \ube44\uad50"
    tutorialText: "\ub2e4\ub978 \ud68c\uc0ac\ub3c4 \uac19\uc740 \uc9c0\ud45c\ub85c \ube44\uad50\ud558\uc2e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc5c5\uc885\uacfc \uc0ac\uc5c5 \ub0b4\uc6a9\uc744 \ud568\uaed8 \uc0b4\ud3b4\ubcf4\uc2dc\uace0, \uc8fc\uac00 \ud558\ub098\ub9cc\uc73c\ub85c \ud310\ub2e8\ud558\uc9c0 \uc54a\ub3c4\ub85d \ud574 \uc8fc\uc2ed\uc2dc\uc624."
    choices: []
    skipDefaultChoice: 0
  - id: lesson-033
    sceneTitle: "\ub458\uc9f8 \ub0a0  /  \ud68c\uc0ac\uc758 \uc22b\uc790"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 1
    npcId: npc-broker-yoon-hajin
    voiceLabel: ""
    text: "\ubc84\ub294 \ub3c8\ub3c4, \uc190\uc5d0 \uc954 \ub3c8\ub3c4 \uaf64 \ub2e4\ub974\ub124\uc694. \uadf8\ub798\ub3c4 \uc774\ubc88\uc5d4 \ubbf8\ub798\uac74\uc124\uc744 \uc870\uae08 \ub354 \uc0ac\ubcf4\uaca0\uc2b5\ub2c8\ub2e4."
    showPlayer: 1
    goal: 0
    companyId:
    choices: []
    skipDefaultChoice: 0
  - id: lesson-034
    sceneTitle: "\ub458\uc9f8 \ub0a0  /  \uc9c0\ubd84\uc744 \ub298\ub9ac\ub294 \uc120\ud0dd"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel: ""
    text: "\uc9c0\uae08 \uac00\uc9c4 \uac8c \uc804\uccb4 \uc8fc\uc2dd\uc758 \uc5bc\ub9c8\ub098 \ub418\ub294\uc9c0\ub294 \uc544\uc2ed\ub2c8\uae4c? \ub611\uac19\uc774 \ud55c \uc8fc\ub97c \uc0ac\ub3c4, \ud68c\uc0ac\ub9c8\ub2e4 \ub0b4 \ubaab\uc774 \uc5bc\ub9c8\ub098 \ub298\uc5b4\ub098\ub294\uc9c0\ub294 \ub2e4\ub974\uac70\ub4e0\uc694."
    showPlayer: 1
    goal: 0
    companyId:
    choices: []
    skipDefaultChoice: 0
  - id: lesson-035
    sceneTitle: "\ub458\uc9f8 \ub0a0  /  \uc9c0\ubd84\uc744 \ub298\ub9ac\ub294 \uc120\ud0dd"
    background: {fileID: 21300000, guid: f2ae5346af09a0045b072d43aaad3d54, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 4
    npcId:
    voiceLabel: ""
    text: "\ubbf8\ub798\uac74\uc124\uc758 \ubcf4\uc720 \uc8fc\uc2dd \uc218\uc640 \uc9c0\ubd84\uc728\uc744 \ud655\uc778\ud558\uc138\uc694."
    showPlayer: 0
    goal: 13
    companyId:
    tutorialTitle: "\ubcf4\uc720 \uc8fc\uc2dd\uacfc \uc9c0\ubd84"
    tutorialText: "\uc9c0\ubd84\uc728\uc740 \uc804\uccb4 \uc8fc\uc2dd \uac00\uc6b4\ub370 \ubcf4\uc720 \uc8fc\uc2dd\uc774 \ucc28\uc9c0\ud558\ub294 \ube44\uc728\uc785\ub2c8\ub2e4. \uc9c0\ubd84 \ub4f1 \uc870\uac74\uc744 \ucda9\uc871\ud558\uba74 \ub2e4\uc74c \ub0a0 \uc0c8\ub85c\uc6b4 \uc774\ubca4\ud2b8\uac00 \ubc1c\uc0dd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc81c\uc548\ub9c8\ub2e4 \ucd94\uac00 \uc870\uac74\uacfc \uc720\ud6a8\uae30\uac04\uc774 \uc801\uc6a9\ub429\ub2c8\ub2e4."
    choices: []
    skipDefaultChoice: 0
  - id: lesson-037
    sceneTitle: "\ub458\uc9f8 \ub0a0  /  \uc9c0\ubd84\uc744 \ub298\ub9ac\ub294 \uc120\ud0dd"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel: ""
    text: "\ub0b4 \ubaab\uc774 \ucee4\uc9c0\uba74 \ub9d0\uc744 \uac78\uc5b4\uc624\ub294 \uc0ac\ub78c\ub3c4 \ub2ec\ub77c\uc9c8 \uac81\ub2c8\ub2e4. \uadf8\ub807\ub2e4\uace0 \ub204\uad6c\ub098 \ub9cc\ub098\uc900\ub2e4\uac70\ub098, \ubc14\ub85c \ud68c\uc0ac \uc8fc\uc778\uc774 \ub418\ub294 \uac74 \uc544\ub2c8\uc8e0."
    showPlayer: 1
    goal: 0
    companyId:
    choices: []
    skipDefaultChoice: 0
  - id: lesson-038
    sceneTitle: "\ub458\uc9f8 \ub0a0  /  \uc9c0\ubd84\uc744 \ub298\ub9ac\ub294 \uc120\ud0dd"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 1
    npcId: npc-broker-yoon-hajin
    voiceLabel: ""
    text: "\ub2f9\uc7a5 \uc4f8 \ub3c8\uc740 \ub0a8\uaca8\ub46c\uc57c\uaca0\ub124\uc694. \uc774\ubc88\uc5d0\ub3c4 \ud55c \uc8fc\ub9cc \ub354 \uc0ac\uc8e0."
    showPlayer: 1
    goal: 0
    companyId:
    choices: []
    skipDefaultChoice: 0
  - id: lesson-039
    sceneTitle: "\ub458\uc9f8 \ub0a0  /  \uc9c0\ubd84\uc744 \ub298\ub9ac\ub294 \uc120\ud0dd"
    background: {fileID: 21300000, guid: 8e830160013dd9a47b8a42d41ba282ff, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel: ""
    text: "\ud55c \uc8fc\uc5d0 \uc5bc\ub9c8\uc778\uc9c0, \uc0ac\uace0 \ub098\uba74 \uc5bc\ub9c8\uac00 \ub0a8\ub294\uc9c0 \ubcf4\uace0 \uc815\ud558\uc2dc\uc8e0. \uae09\ud55c \ub370 \uc4f8 \ub3c8\uae4c\uc9c0 \ubb36\uc5b4\ub450\uba74 \uace4\ub780\ud558\ub2c8\uae4c\uc694."
    showPlayer: 1
    goal: 0
    companyId:
    choices: []
    skipDefaultChoice: 0
  - id: lesson-040
    sceneTitle: "\ub458\uc9f8 \ub0a0  /  \uc9c0\ubd84\uc744 \ub298\ub9ac\ub294 \uc120\ud0dd"
    background: {fileID: 21300000, guid: f2ae5346af09a0045b072d43aaad3d54, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 4
    npcId:
    voiceLabel: ""
    text: "\ubbf8\ub798\uac74\uc124 1\uc8fc\ub97c \ucd94\uac00 \ub9e4\uc218\ud558\uc138\uc694. \uc608\uc0c1 \ub300\uae08\uacfc \ub0a8\ub294 \uc790\uae08\uc744 \ud655\uc778\ud558\uc138\uc694."
    showPlayer: 0
    goal: 11
    companyId:
    tutorialTitle: "\ucd94\uac00 \ub9e4\uc218"
    tutorialText: "\uc774\ubc88\uc5d0\ub294 \ubbf8\ub798\uac74\uc124 1\uc8fc\ub97c \ub354 \ub9e4\uc218\ud569\ub2c8\ub2e4. \uc608\uc0c1 \ub300\uae08\uacfc \uac70\ub798 \ud6c4 \ub0a8\ub294 \uc790\uae08\uc744 \ud655\uc778\ud55c \ub4a4 \ub9e4\uc218\ud558\uae30\ub97c \uc120\ud0dd\ud574 \uc8fc\uc2ed\uc2dc\uc624."
    choices: []
    skipDefaultChoice: 0
  - id: lesson-041
    sceneTitle: "\ub458\uc9f8 \ub0a0  /  \uc9c0\ubd84\uc744 \ub298\ub9ac\ub294 \uc120\ud0dd"
