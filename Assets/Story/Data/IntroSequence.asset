  - id: neutral-intro-T2-15
    sceneTitle: "\uC815\uC218\uC544 \u2014 \uB05D\uB09C \uC77C\uC774\uB77C\uACE0
      \uBD80\uB974\uB294 \uC0AC\uB78C\uB4E4"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-investigative-reporter-jung-sua
    voiceLabel:
    text: "\uB124. \uADF8\uB7F0 \uC57D\uC18D\uC744 \uBC1B\uC73C\uB824\uB294 \uC9C8\uBB38\uC740
      \uC544\uB2C8\uC5C8\uC5B4\uC694. \uC5B4\uB5A4 \uBD80\uBD84\uC744 \uBCF4\uACE0
      \uD22C\uC790\uD558\uC2DC\uB294\uC9C0 \uAD81\uAE08\uD574\uC11C\uC694."
    showPlayer: 1
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: neutral-intro-T2-choice
    sceneTitle: "\uC815\uC218\uC544 \u2014 \uB05D\uB09C \uC77C\uC774\uB77C\uACE0
      \uBD80\uB974\uB294 \uC0AC\uB78C\uB4E4"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-investigative-reporter-jung-sua
    voiceLabel:
    text: "\uC5B4\uB5A4 \uC0DD\uAC01\uC774\uC2E0\uC9C0 \uB4E3\uACE0 \uC2F6\uC2B5\uB2C8\uB2E4."
    showPlayer: 1
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices:
    - title: "\uD68C\uC0AC\uAC00 \uBC84\uD2F0\uB294 \uC870\uAC74\uBD80\uD130 \uC54C\uC544\uBCF4\uACA0\uB2E4\uACE0
        \uD55C\uB2E4"
      description: "\uD68C\uC0AC\uAC00 \uBC84\uD2F0\uB294 \uB370 \uD544\uC694\uD55C \uC870\uAC74\uC744 \uC9DA\uC2B5\uB2C8\uB2E4."
      playerLine: "\uD604\uC7A5\uC774 \uB3CC\uC544\uAC00\uB294\uB370\uB3C4 \uBC84\uD2F0\uAE30
        \uC5B4\uB835\uB2E4\uB294 \uC810\uC774 \uAD81\uAE08\uD588\uC2B5\uB2C8\uB2E4.
        \uB3C8\uC774 \uC5B4\uB514\uC11C \uB9C9\uD788\uB294\uC9C0\uBD80\uD130 \uBCF4\uB824\uACE0
        \uD569\uB2C8\uB2E4."
      response: "\uADF8 \uC774\uC720\uB97C \uC54C\uC544\uB0B4\uBA74 \uC800\uB3C4
        \uB4E3\uACE0 \uC2F6\uB124\uC694. \uBB3C\uB860 \uD68C\uC0AC\uAC00 \uACF5\uC720\uD574\uB3C4
        \uB418\uB294 \uB0B4\uC6A9 \uC548\uC5D0\uC11C\uC694. \uD604\uC7A5\uC5D0 \uACC4\uC2E0
        \uBD84\uB4E4\uD55C\uD14C \uBCF4\uC774\uB294 \uC774\uC720\uC640 \uB2E4\uB97C
        \uC218 \uC788\uC73C\uB2C8\uAE4C\uC694.\n\n\uB124. \uC9C0\uAE08\uC740 \uC5B4\uB290
        \uD55C\uCABD \uB9D0\uB85C \uC815\uB9AC\uD558\uAE30 \uC5B4\uB824\uC6B4 \uBD80\uBD84\uC774
        \uC788\uC5B4\uC11C \uC5EC\uB7EC \uBD84\uC744 \uB9CC\uB098\uACE0 \uC788\uC5B4\uC694."
      targetNpcId: npc-investigative-reporter-jung-sua
      memoryType: 8
      interpretation: "\uD68C\uC0AC\uAC00 \uBC84\uD2F0\uAE30 \uC5B4\uB824\uC6B4 \uC774\uC720\uB97C
        \uC54C\uC544\uBCF4\uACE0 \uC788\uB2E4\uACE0 \uB9D0\uD588\uB2E4. \uC790\uAE08
        \uC9C0\uC6D0\xB7\uCDE8\uC7AC \uD611\uC870\uB97C \uD655\uC57D\uD558\uC9C0
        \uC54A\uC558\uB2E4."
      relationDelta:
        trust: 0
        respect: 1
        closeness: 0
    - title: "\uB0A8\uC740 \uC0AC\uB78C\uB4E4\uC758 \uC774\uC57C\uAE30\uB3C4 \uB4E3\uACE0
        \uC2F6\uB2E4\uACE0 \uD55C\uB2E4"
      description: "\uB0A8\uC544 \uC788\uB294 \uC0AC\uB78C\uB4E4\uC758 \uC774\uC57C\uAE30\uB97C \uB354 \uB4E3\uC2B5\uB2C8\uB2E4."
      playerLine: "\uD68C\uC0AC\uB97C \uBCFC \uB54C \uC9C0\uAE08 \uB0A8\uC544 \uC788\uB294
        \uBD84\uB4E4 \uC774\uC57C\uAE30\uB3C4 \uB4E3\uACE0 \uC2F6\uC2B5\uB2C8\uB2E4.
        \uC608\uC804\uC5D0 \uC77C\uC774 \uB04A\uACBC\uC744 \uB54C \uBB34\uC5C7\uC744
        \uAC10\uB2F9\uD588\uB294\uC9C0\uC694."
      response: "\uC9C1\uC811 \uBB3C\uC5B4\uBCF4\uC2E4 \uC790\uB9AC\uAC00 \uC0DD\uAE30\uBA74
        \uC88B\uACA0\uB124\uC694. \uC81C\uAC00 \uCDE8\uC7AC\uD55C \uBD84\uB4E4 \uC5F0\uB77D\uCC98\uB97C
        \uB300\uC2E0 \uB4DC\uB9B4 \uC218\uB294 \uC5C6\uC9C0\uB9CC, \uACF5\uAC1C\uD55C
        \uAE30\uC0AC\uC640 \uC790\uB8CC\uB294 \uBCF4\uB0B4\uB4DC\uB9B4\uAC8C\uC694.\n\n\uB124.
        \uC77D\uC73C\uC2DC\uACE0 \uAD81\uAE08\uD55C \uC810\uC740 \uC5F0\uB77D \uC8FC\uC138\uC694.
        \uC81C \uD574\uC11D\uD558\uACE0 \uB2E4\uB974\uAC8C \uBCF4\uC774\uB294 \uBD80\uBD84\uB3C4
        \uAD1C\uCC2E\uACE0\uC694."
      targetNpcId: npc-investigative-reporter-jung-sua
      memoryType: 8
      interpretation: "\uACFC\uAC70 \uAC70\uB798 \uC911\uB2E8 \uB4A4 \uB0A8\uC740
        \uC0AC\uB78C\uB4E4\uC758 \uC0AC\uC815\uC5D0 \uAD00\uC2EC\uC744 \uBCF4\uC600\uB2E4.
        \uD53C\uD574 \uAD6C\uC81C\xB7\uACE0\uC6A9 \uC57D\uC18D \uC5C6\uC74C."
      relationDelta:
        trust: 0
        respect: 0
        closeness: 0
    - title: "\uC544\uC9C1\uC740 \uD22C\uC790 \uD310\uB2E8\uC5D0 \uC9D1\uC911\uD558\uACA0\uB2E4\uACE0
        \uD55C\uB2E4"
      description: "\uC9C0\uAE08\uC740 \uD22C\uC790 \uD310\uB2E8\uC5D0 \uD544\uC694\uD55C \uC0AC\uC2E4\uB9CC \uD655\uC778\uD569\uB2C8\uB2E4."
      playerLine: "\uC9C0\uAE08\uC740 \uC81C\uAC00 \uD22C\uC790\uD560 \uD68C\uC0AC\uB97C
        \uC54C\uC544\uBCF4\uB294 \uAC83\uB9CC\uC73C\uB85C\uB3C4 \uBC85\uCC39\uB2C8\uB2E4.
        \uADF8 \uC774\uC57C\uAE30\uB294 \uB098\uC911\uC5D0 \uB354 \uB4E3\uACA0\uC2B5\uB2C8\uB2E4."
      response: "\uB124. \uCC98\uC74C \uC624\uC168\uB2E4\uACE0 \uD588\uC8E0. \uC624\uB298
        \uB2F9\uC7A5 \uC804\uBD80 \uC544\uC2E4 \uD544\uC694\uB294 \uC5C6\uC5B4\uC694.
        \uC5F0\uB77D\uCC98\uB9CC \uB4DC\uB9B4\uAC8C\uC694.\n\n\uADF8\uAC74 \uB098\uC911\uC5D0
        \uBB3C\uC5B4\uBCF4\uACE0 \uC815\uD558\uBA74 \uB418\uC8E0. \uC624\uB298\uC740
        \uC778\uC0AC\uD55C \uAC78\uB85C\uC694."
      targetNpcId: npc-investigative-reporter-jung-sua
      memoryType: 8
      interpretation: "\uD22C\uC790 \uAC80\uD1A0\uB97C \uC6B0\uC120\uD558\uACE0 \uB300\uD654\uB97C
        \uB9C8\uCCE4\uB2E4. \uD53C\uD574 \uC678\uBA74\xB7\uC740\uD3D0\xB7\uC801\uB300
        \uD6A8\uACFC\uB97C \uBD80\uC5EC\uD558\uC9C0 \uC54A\uB294\uB2E4."
      relationDelta:
        trust: 0
        respect: 0
        closeness: 0
    skipDefaultChoice: 0
  - id: neutral-intro-T2-tail-0
