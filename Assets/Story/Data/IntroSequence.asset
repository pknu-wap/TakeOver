    speaker: 0
    npcId:
    voiceLabel:
    text: "\uB450 \uC0AC\uB78C\uC740 \uBC29\uBB38\uAC1D\uC774 \uC624\uAC00\uC9C0
      \uC54A\uB294 \uCABD\uC73C\uB85C \uC790\uB9AC\uB97C \uC62E\uACBC\uB2E4. \uB098\uB294
      \uBA85\uD568\uC744 \uC8FC\uBA38\uB2C8\uC5D0 \uB123\uC5C8\uB2E4. \uB0B4\uAC00
      \uD68C\uC0AC\uB97C \uC0AC\uB294 \uC774\uC720\uC640, \uADF8 \uD68C\uC0AC\uC5D0
      \uB0A8\uC740 \uC0AC\uB78C\uB4E4\uC774 \uBC14\uB77C\uB294 \uC77C\uC740 \uB2E4\uB97C
      \uC218 \uC788\uC5C8\uB2E4."
    showPlayer: 0
