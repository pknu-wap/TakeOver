    choices: []
    skipDefaultChoice: 0
  - id: neutral-intro-T1-3
    sceneTitle: "\uC774\uBBFC\uADDC \u2014 \uC8FC\uC8FC\uB2D8\uC774\uB77C\uACE0 \uBD88\uB7EC\uB3C4
      \uB418\uB098\uC694"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-economic-reporter-lee-mingyu
    voiceLabel:
    text: "\uC544, \uADF8\uB7FC \uC81C \uC18C\uAC1C\uBD80\uD130 \uD574\uC57C\uACA0\uB124\uC694.
      \uACBD\uC81C\uC9C0\uC5D0\uC11C \uAE30\uC5C5 \uCABD \uB9E1\uB294 \uC774\uBBFC\uADDC\uC785\uB2C8\uB2E4.
      \uC9C8\uBB38\uBD80\uD130 \uD558\uB294 \uBC84\uB987\uC774 \uC788\uC5B4\uC11C\uC694.
      \uBA85\uD568\uBCF4\uB2E4 \uC9C8\uBB38\uC774 \uBA3C\uC800 \uB098\uAC00\uBA74
      \uB300\uBD80\uBD84 \uACBD\uACC4\uD558\uC2DC\uB354\uB77C\uACE0\uC694."
    showPlayer: 1
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: neutral-intro-T1-4
    sceneTitle: "\uC774\uBBFC\uADDC \u2014 \uC8FC\uC8FC\uB2D8\uC774\uB77C\uACE0 \uBD88\uB7EC\uB3C4
