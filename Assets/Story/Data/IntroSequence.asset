  - id: neutral-intro-T1-0
    sceneTitle: "\uC774\uBBFC\uADDC \u2014 \uC8FC\uC8FC\uB2D8\uC774\uB77C\uACE0 \uBD88\uB7EC\uB3C4
      \uB418\uB098\uC694"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 0
    npcId:
    voiceLabel:
    text: "\uC11C\uB958\uB97C \uB3CC\uB824\uBC1B\uACE0 \uB098\uC624\uC790 \uCD9C\uC785\uAD6C
      \uC606\uC5D0\uC11C \uB204\uAD70\uAC00 \uC218\uCCA9\uC744 \uB36E\uC5C8\uB2E4.
      \uBAA9\uC5D0 \uAC78\uB9B0 \uAE30\uC790\uC99D\uC774 \uBA3C\uC800 \uB208\uC5D0
      \uB4E4\uC5B4\uC654\uB2E4. \uCE74\uBA54\uB77C \uB80C\uC988\uB294 \uBC14\uB2E5\uC744
      \uD5A5\uD558\uACE0 \uC788\uC5C8\uB2E4."
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: neutral-intro-T1-1
    sceneTitle: "\uC774\uBBFC\uADDC \u2014 \uC8FC\uC8FC\uB2D8\uC774\uB77C\uACE0 \uBD88\uB7EC\uB3C4
      \uB418\uB098\uC694"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-economic-reporter-lee-mingyu
    voiceLabel:
    text: "\uC7A0\uAE50\uB9CC\uC694. \uBBF8\uB798\uAC74\uC124 \uCABD \uBD84\uC774\uC138\uC694?
      \uC624\uB298 \uC0AC\uBB34\uC2E4\uC5D0 \uCC98\uC74C \uBCF4\uB294 \uBD84\uC774
      \uC790\uAFB8 \uC624\uB124\uC694."
    showPlayer: 1
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: neutral-intro-T1-2
    sceneTitle: "\uC774\uBBFC\uADDC \u2014 \uC8FC\uC8FC\uB2D8\uC774\uB77C\uACE0 \uBD88\uB7EC\uB3C4
      \uB418\uB098\uC694"
