  - id: neutral-intro-T2-help
    sceneTitle: "\uC815\uC218\uC544 \u2014 \uB05D\uB09C \uC77C\uC774\uB77C\uACE0
      \uBD80\uB974\uB294 \uC0AC\uB78C\uB4E4"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 4
    npcId:
    voiceLabel:
    text: "\uC678\uBD80 \uC778\uBB3C\uB3C4 \uC790\uC2E0\uC758 \uBAA9\uC801\uACFC
      \uAD00\uC2EC\uC5D0 \uB530\uB77C \uC0AC\uAC74\uC744 \uC81C\uC548\uD569\uB2C8\uB2E4.
      \uC815\uC218\uC544\uB294 \uACFC\uAC70 \uC0AC\uAC74\uACFC \uADF8 \uB4A4\uC5D0
      \uB0A8\uC740 \uC601\uD5A5\uC744 \uCDE8\uC7AC\uD569\uB2C8\uB2E4. \uB2F5\uBCC0\uC5D0
      \uB530\uB77C \uAD00\uACC4\uC640 \uAE30\uC5B5, \uD6C4\uC18D \uB300\uD654\uAC00
      \uB2EC\uB77C\uC9C8 \uC218 \uC788\uC9C0\uB9CC \uCCAB \uC18C\uAC1C\uB9CC\uC73C\uB85C
      \uC815\uBCF4 \uC81C\uACF5\uC774\uB098 \uD611\uB825\uC774 \uD655\uC815\uB418\uC9C0\uB294
      \uC54A\uC2B5\uB2C8\uB2E4. \uC778\uBB3C\uC774 \uB4E4\uC740 \uB9D0\uACFC \uD50C\uB808\uC774\uC5B4
      \uC790\uC2E0\uC758 \uBE44\uACF5\uAC1C \uC0DD\uAC01\uC740 \uAD6C\uBD84\uD574
      \uAE30\uB85D\uB429\uB2C8\uB2E4."
    showPlayer: 0
    goal: 0
    companyId:
    tutorialTitle: "\uC678\uBD80 \uC778\uBB3C\uACFC\uC758 \uB9CC\uB0A8"
    tutorialText: "\uC678\uBD80 \uC778\uBB3C\uB3C4 \uC790\uC2E0\uC758 \uBAA9\uC801\uACFC
      \uAD00\uC2EC\uC5D0 \uB530\uB77C \uC0AC\uAC74\uC744 \uC81C\uC548\uD569\uB2C8\uB2E4.
      \uC815\uC218\uC544\uB294 \uACFC\uAC70 \uC0AC\uAC74\uACFC \uADF8 \uB4A4\uC5D0
      \uB0A8\uC740 \uC601\uD5A5\uC744 \uCDE8\uC7AC\uD569\uB2C8\uB2E4. \uB2F5\uBCC0\uC5D0
      \uB530\uB77C \uAD00\uACC4\uC640 \uAE30\uC5B5, \uD6C4\uC18D \uB300\uD654\uAC00
      \uB2EC\uB77C\uC9C8 \uC218 \uC788\uC9C0\uB9CC \uCCAB \uC18C\uAC1C\uB9CC\uC73C\uB85C
      \uC815\uBCF4 \uC81C\uACF5\uC774\uB098 \uD611\uB825\uC774 \uD655\uC815\uB418\uC9C0\uB294
      \uC54A\uC2B5\uB2C8\uB2E4. \uC778\uBB3C\uC774 \uB4E4\uC740 \uB9D0\uACFC \uD50C\uB808\uC774\uC5B4
      \uC790\uC2E0\uC758 \uBE44\uACF5\uAC1C \uC0DD\uAC01\uC740 \uAD6C\uBD84\uD574
      \uAE30\uB85D\uB429\uB2C8\uB2E4."
