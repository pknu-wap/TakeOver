  - id: neutral-intro-T3-20
    sceneTitle: "\uAE40\uD0DC\uC131 \u2014 \uC88B\uC544 \uBCF4\uC774\uB294\uB370
      \uC65C \uC548 \uC0AC\uC2ED\uB2C8\uAE4C"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-institutional-investor-kim-taeseong
    voiceLabel:
    text: "\uC2F8\uAC8C \uC0B0 \uC790\uC0B0 \uB54C\uBB38\uC5D0 \uB2E4\uC74C \uB2EC
      \uD544\uC694\uD55C \uB3C8\uC774 \uBB36\uC774\uBA74 \uACE4\uB780\uD558\uC8E0.
      \uC9C0\uAE08 \uAC00\uC9C4 \uD604\uAE08 \uC911 \uC5BC\uB9C8\uAE4C\uC9C0 \uBB36\uC5B4\uB3C4
      \uB429\uB2C8\uAE4C?"
    showPlayer: 1
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: neutral-intro-T3-choice
    sceneTitle: "\uAE40\uD0DC\uC131 \u2014 \uC88B\uC544 \uBCF4\uC774\uB294\uB370
      \uC65C \uC548 \uC0AC\uC2ED\uB2C8\uAE4C"
    background: {fileID: 21300000, guid: 974e87b52bad3034dbc93184f2f6b396, type: 3}
    backgroundTint: {r: 1, g: 1, b: 1, a: 1}
    speaker: 2
    npcId: npc-institutional-investor-kim-taeseong
    voiceLabel:
    text: "\uC5B4\uB5A4 \uC0DD\uAC01\uC774\uC2E0\uC9C0 \uB4E3\uACE0 \uC2F6\uC2B5\uB2C8\uB2E4."
    showPlayer: 1
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices:
    - title: "\uB0A8\uAE38 \uD604\uAE08\uBD80\uD130 \uC815\uD558\uACA0\uB2E4\uACE0
        \uD55C\uB2E4"
      description: "\uD22C\uC790\uD55C \uB4A4\uC5D0\uB3C4 \uB0A8\uACA8 \uB458 \uD604\uAE08\uC744 \uBA3C\uC800 \uC815\uD569\uB2C8\uB2E4."
      playerLine: "\uB2E4\uC74C \uC77C\uC815\uC5D0 \uC4F8 \uB3C8\uBD80\uD130 \uB0A8\uACA8\uB450\uACA0\uC2B5\uB2C8\uB2E4.
        \uADF8\uB2E4\uC74C\uC5D0 \uD22C\uC790\uD560 \uBC94\uC704\uB97C \uC815\uD558\uC8E0."
      response: "\uADF8\uB807\uAC8C \uC815\uD55C \uAE08\uC561\uC740 \uC88B\uC740
        \uC18C\uC2DD\uC744 \uB4E4\uC5C8\uC744 \uB54C\uB3C4 \uB2E4\uC2DC \uD655\uC778\uD558\uC138\uC694.
        \uC190\uC2E4\uC774 \uB0AC\uC744 \uB54C\uBCF4\uB2E4 \uC624\uB97C \uAC83 \uAC19\uC744
        \uB54C \uC120\uC744 \uB118\uAE30 \uC27D\uC2B5\uB2C8\uB2E4.\n\n\uC190\uC2E4\uC740
        \uB0A0 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uB2E4\uB9CC \uC190\uC2E4 \uD558\uB098
        \uB54C\uBB38\uC5D0 \uB2E4\uB978 \uC120\uD0DD\uAE4C\uC9C0 \uC804\uBD80 \uC783\uC9C0\uB294
        \uC54A\uACA0\uC8E0."
      targetNpcId: npc-institutional-investor-kim-taeseong
      memoryType: 8
      interpretation: "\uD22C\uC790 \uC804 \uC720\uB3D9\uC131 \uC5EC\uC720\uB97C
        \uC815\uD558\uACA0\uB2E4\uACE0 \uB9D0\uD588\uB2E4. \uC2E4\uC81C \uD604\uAE08
        \uD655\uBCF4\uB098 \uC790\uC0B0 \uBC30\uBD84 \uC644\uB8CC\uB294 \uC544\uB2C8\uB2E4."
      relationDelta:
        trust: 0
        respect: 1
        closeness: 0
    - title: "\uC131\uC7A5 \uAE30\uD68C\uB97C \uB193\uCE58\uB294 \uAC83\uB3C4 \uC704\uD5D8\uC774\uB77C\uACE0
        \uB9D0\uD55C\uB2E4"
      description: "\uAE30\uB2E4\uB9AC\uB294 \uB3D9\uC548 \uB193\uCE60 \uC131\uC7A5 \uAE30\uD68C\uB97C \uC9DA\uC2B5\uB2C8\uB2E4."
      playerLine: "\uB108\uBB34 \uB0A8\uACA8\uB450\uBA74 \uAE30\uD68C\uB97C \uB193\uCE60
        \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uC131\uC7A5\uD560 \uB54C \uD568\uAED8 \uB4E4\uC5B4\uAC00\uB294
        \uAC8C \uC911\uC694\uD560 \uC218\uB3C4 \uC788\uACE0\uC694."
      response: "\uB9DE\uC2B5\uB2C8\uB2E4. \uADF8\uB798\uC11C \uAE30\uB2E4\uB9AC\uB294
        \uBE44\uC6A9\uB3C4 \uACC4\uC0B0\uD558\uC8E0. \uB2E4\uB9CC \uAE30\uB300\uD55C
        \uC131\uC7A5\uC774 \uB2A6\uC5B4\uC84C\uC744 \uB54C \uCD94\uAC00\uB85C \uB3C8\uC744
        \uB123\uC744 \uAC74\uC9C0, \uBA48\uCD9C \uAC74\uC9C0\uB294 \uC9C0\uAE08 \uBB3C\uC5B4\uBCFC
        \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uD22C\uC790 \uADDC\uBAA8\uB97C \uC791\uAC8C
        \uC2DC\uC791\uD558\uBA74 \uB429\uB2C8\uB2E4. \uB2F5\uC774 \uC5C6\uB2E4\uB294
        \uC0AC\uC2E4\uAE4C\uC9C0 \uC228\uAE38 \uD544\uC694\uB294 \uC5C6\uC5B4\uC694."
      targetNpcId: npc-institutional-investor-kim-taeseong
      memoryType: 8
      interpretation: "\uC131\uC7A5 \uAE30\uD68C\uC640 \uBCF4\uC720 \uD604\uAE08
        \uC0AC\uC774\uC758 \uBE44\uC6A9\uC744 \uC9C8\uBB38\uD588\uB2E4. \uBB34\uB9AC\uD55C
        \uD22C\uC790 \uC131\uD5A5\uC73C\uB85C \uB2E8\uC815\uD558\uC9C0 \uC54A\uB294\uB2E4."
      relationDelta:
        trust: 0
        respect: 0
        closeness: 0
    - title: "\uD68C\uC0AC\uC758 \uD68C\uC218 \uACC4\uD68D\uBD80\uD130 \uBB3B\uACA0\uB2E4\uACE0
        \uD55C\uB2E4"
      description: "\uC5B8\uC81C \uC5B4\uB5A4 \uBC29\uC2DD\uC73C\uB85C \uC790\uAE08\uC744 \uD68C\uC218\uD560\uC9C0 \uBB3B\uC2B5\uB2C8\uB2E4."
      playerLine: "\uC81C \uC790\uAE08 \uACC4\uD68D\uB3C4 \uD544\uC694\uD558\uC9C0\uB9CC,
        \uD68C\uC0AC\uAC00 \uC5B8\uC81C \uD604\uAE08\uC744 \uD68C\uC218\uD558\uB294\uC9C0\uBD80\uD130
        \uD655\uC778\uD558\uACE0 \uC2F6\uC2B5\uB2C8\uB2E4."
      response: "\uADF8\uB7FC \uC608\uC0C1\uC774 \uC5B4\uAE0B\uB0A0 \uB54C\uC758
        \uC124\uBA85\uB3C4 \uAC19\uC774 \uBC1B\uC73C\uC138\uC694. \uC815\uC0C1 \uC77C\uC815\uB9CC
        \uC788\uB294 \uC790\uB8CC\uB294 \uB300\uBD80\uBD84 \uBCF4\uAE30 \uC88B\uC2B5\uB2C8\uB2E4.\n\n\uB450
        \uBC88\uC9F8 \uACC4\uD68D\uC774 \uC5C6\uB294 \uACBD\uC6B0\uB3C4 \uC788\uC2B5\uB2C8\uB2E4.
        \uADF8 \uACBD\uC6B0\uC5D0\uB294 \uC5C6\uB2E4\uB294 \uB2F5\uC744 \uB4E4\uC5B4\uC57C
        \uD558\uACE0\uC694."
      targetNpcId: npc-institutional-investor-kim-taeseong
      memoryType: 8
      interpretation: "\uD604\uAE08 \uD68C\uC218 \uACC4\uD68D\uACFC \uC9C0\uC5F0
        \uC2DC \uB300\uC751\uC744 \uD655\uC778\uD558\uACA0\uB2E4\uACE0 \uB9D0\uD588\uB2E4.
        \uC790\uAE08 \uC9C0\uC6D0 \uD569\uC758\uB294 \uC544\uB2C8\uB2E4."
      relationDelta:
        trust: 0
        respect: 0
        closeness: 0
    skipDefaultChoice: 0
  - id: neutral-intro-T3-tail-0
