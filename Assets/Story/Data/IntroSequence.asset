    companyId:
    tutorialTitle: "\ub9e4\ub3c4 \ud6c4 \ubcf4\uc720 \ud604\ud669"
    tutorialText: "\ub9e4\ub3c4 \ud6c4 \ubcf4\uc720 \uc8fc\uc2dd\uacfc \uc9c0\ubd84\uc728, \ub0a8\uc740 \uc790\uae08\uc744 \ud655\uc778\ud574 \uc8fc\uc2ed\uc2dc\uc624. \ub2e4\uc74c \uac70\ub798\ub098 \ub9cc\ub0a8\uc5d0 \ud544\uc694\ud55c \uc790\uae08\uc774 \ub0a8\uc544 \uc788\ub294\uc9c0\ub3c4 \ud568\uaed8 \uc0b4\ud3b4\ubcf4\uc2ed\uc2dc\uc624."
