    speaker: 2
    npcId: npc-mirae-construction-cfo-seo-jia
    voiceLabel:
    text: "\uD22C\uC790\uB97C \uC0DD\uAC01\uD558\uACE0 \uACC4\uC2DC\uB2E4\uACE0\uC694.
      \uC7A5\uBD80\uB294 \uAC00\uC838\uC654\uC5B4\uC694. \uB3C8\uC744 \uBC84\uB294
      \uAC83\uD558\uACE0, \uB2F9\uC7A5 \uC4F8 \uB3C8\uC774 \uC788\uB294 \uAC74 \uC880
      \uB2E4\uB974\uB2C8 \uAC19\uC774 \uBCF4\uC2DC\uC8E0."
    showPlayer: 1
    goal: 0
    companyId:
    tutorialTitle:
    tutorialText:
    choices: []
    skipDefaultChoice: 0
  - id: intro-062
    sceneTitle: "\uCCAB \uBC88\uC9F8 \uC8FC\uC8FC  /  \uC11C\uC9C0\uC544\uC758 \uC22B\uC790"
