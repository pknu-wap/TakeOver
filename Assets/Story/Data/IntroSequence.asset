    speaker: 2
    npcId: npc-broker-yoon-hajin
    voiceLabel:
    text: "\uADF8\uAC74 \uAD8C\uD55C\uD558\uACE0 \uC870\uAC74\uBD80\uD130 \uBD10\uC57C\uC8E0.
      \uBC15\uC0C1\uD604 \uC528\uC608\uC694. \uC815\uCC45 \uC790\uBB38\uACFC \uC0AC\uC5C5
      \uC5F0\uACB0\uC744 \uD558\uB294\uB370, \uC790\uB8CC\uB97C \uBC1B\uB294 \uAC83\uACFC
      \uC77C\uC744 \uB9E1\uAE30\uB294 \uAC74 \uB530\uB85C \uC0DD\uAC01\uD558\uC138\uC694."
    showPlayer: 1
