    npcId: npc-blueharbor-retail-ceo-seo-yujin
    companyId: blueharbor-retail
    profile:
      standingIllustration: {fileID: 0}
      dimmedStandingIllustration: {fileID: 0}
      displayName: "\uC11C\uC720\uC9C4"
      role: CEO
      affiliation: "\uBE14\uB8E8\uD558\uBC84\uB9AC\uD14C\uC77C"
      personalitySummary: "\uACE0\uAC1D \uACBD\uD5D8\uC744 \uC77D\uB294 \uD310\uB2E8\uB825\uC774
        \uBE60\uB974\uACE0 \uC0C1\uB300\uC640 \uBD80\uB4DC\uB7FD\uAC8C \uD611\uC0C1\uD55C\uB2E4.
        \uC18C\uBE44\uC790 \uC2E0\uB8B0\uB97C \uC9C0\uD0A8\uB2E4\uACE0 \uBBFF\uC9C0\uB9CC
        \uACC4\uC5F4 \uC0C1\uD488\uC744 \uC6B0\uB300\uD558\uB294 \uC9C8\uC11C\uB97C
        \uACF5\uC815\uD55C \uACBD\uC7C1\uC774\uB77C\uACE0 \uC124\uBA85\uD558\uB824\uB294
        \uBA74\uC774 \uC788\uB2E4.\n\uD589\uB3D9 \uC591\uC2DD: \uAC00\uACA9\xB7\uC9C4\uC5F4\xB7\uC11C\uBE44\uC2A4
        \uC9C0\uD45C\uB97C \uD568\uAED8 \uC870\uC815\uD55C\uB2E4. \uACE0\uAC1D\uC774
        \uC2E4\uC81C\uB85C \uC774\uD0C8\uD560 \uC815\uB3C4\uC758 \uD3B8\uBC95\uC740
        \uAEBC\uB9AC\uC9C0\uB9CC \uD310\uB9E4\uB9DD\uC758 \uC8FC\uB3C4\uAD8C\uC740
        \uC27D\uAC8C \uC591\uBCF4\uD558\uC9C0 \uC54A\uB294\uB2E4."
      gameplayRoleSummary: "\uC5ED\uD560: \uADF8\uB8F9 \uD310\uB9E4\uB9DD\uC744 \uBC29\uC5B4\uD558\uB294
        \uACBD\uC7C1 \uACBD\uC601\uC790. \uC8FC\uC778\uACF5\uC758 \uC88B\uC740 \uC81C\uD488\uC744
        \uAC70\uB798\uD558\uBA74\uC11C\uB3C4 \uC2DC\uC7A5 \uC8FC\uB3C4\uAD8C\uC744
        \uB193\uACE0 \uB300\uB9BD\uD560 \uC218 \uC788\uB2E4.\n\uC120\uD638: \uAC80\uC99D\uB41C
        \uACE0\uAC1D \uB9CC\uC871, \uC548\uC815\uC801 \uB0A9\uD488, \uD569\uB9AC\uC801\uC778
        \uAC00\uACA9\uACFC \uC11C\uBE44\uC2A4 \uAC1C\uC120, \uC7A5\uAE30\uC801\uC778
        \uD310\uB9E4\uB9DD \uC6B4\uC601\n\uAE30\uD53C: \uAC1C\uC778\uC815\uBCF4 \uD310\uB9E4,
        \uACE0\uAC1D \uAE30\uB9CC, \uBB34\uB9AC\uD55C \uB9E4\uC7A5 \uD3D0\uC1C4,
        \uAC1C\uC778 \uBCF4\uC0C1\uC73C\uB85C \uC9C4\uC5F4\uAD8C\uC744 \uB118\uAE30\uB77C\uB294
        \uC81C\uC548"
      anyEventRelationDelta:
        trust: 0
        respect: 0
        fear: 0
        hostility: 0
        dependency: 0
        interest: 0
      eventRelationBiases: []
    actionPreferences: []
  storyDesign:
    stance: 1
    personalGoal: "\uC804\uAD6D \uB9E4\uC7A5\uC758 \uC2E0\uB8B0\uC640 \uD310\uB9E4\uB9DD\uC744
      \uC9C0\uD0A4\uBA70 \uC790\uC2E0\uC774 \uACE0\uAC1D\uC744 \uAC00\uC7A5 \uC798
      \uC774\uD574\uD558\uB294 \uACBD\uC601\uC790\uC784\uC744 \uC785\uC99D\uD55C\uB2E4."
    loyaltyReason: "\uADF8\uB8F9\uC758 \uC790\uBCF8\xB7\uC0C1\uD488 \uACF5\uAE09\uC774
      \uC804\uAD6D \uACE0\uAC1D \uC11C\uBE44\uC2A4\uC640 \uB0A9\uD488 \uC57D\uC18D\uC744
      \uAC00\uB2A5\uD558\uAC8C \uD588\uB2E4\uACE0 \uBBFF\uB294\uB2E4. \uC790\uC2E0\uC774
      \uC720\uC9C0\uD55C \uC9C8\uC11C\uB3C4 \uADF8 \uC548\uC5D0 \uC788\uB2E4."
    innerConflict: "\uACE0\uAC1D \uC120\uD0DD\uC744 \uB9D0\uD558\uBA74\uC11C \uACC4\uC5F4
      \uC0C1\uD488\uC5D0 \uC720\uB9AC\uD55C \uC9C4\uC5F4\uC744 \uC815\uB2F9\uD654\uD55C\uB2E4.
      \uC601\uC5C5 \uC131\uACFC\uC640 \uACF5\uC815\uD55C \uC124\uBA85\uC774 \uB298
      \uC77C\uCE58\uD558\uC9C0 \uC54A\uB294\uB2E4."
    pressureTactics: "\uACC4\uC5F4 \uC9C4\uC5F4\xB7\uD310\uCD09\xB7\uC785\uC810 \uC870\uAC74\uC744
      \uD65C\uC6A9\uD574 \uC8FC\uC778\uACF5\uC758 \uC2DD\uD488\xB7\uC18C\uBE44\uC7AC
      \uAE30\uC5C5\uC774 \uD310\uB9E4\uB9DD\uC5D0 \uC9C4\uC785\uD558\uB294 \uBE44\uC6A9\uC744
      \uB192\uC778\uB2E4."
    cooperationTrigger: "\uACE0\uAC1D\uACFC \uB0A9\uD488\uB9DD\uC758 \uC190\uC2E4\uC744
      \uC904\uC774\uB294 \uAC1C\uBCC4 \uC0C1\uD488 \uACF5\uAE09\xB7\uC11C\uBE44\uC2A4
      \uACC4\uC57D\uC5D0\uC11C\uB9CC \uD611\uC758\uB97C \uAC80\uD1A0\uD55C\uB2E4."
    requestedTerms: "\uD488\uC9C8 \uAC80\uC99D, \uC548\uC815\uC801 \uBB3C\uB7C9,
      \uC18C\uBE44\uC790\uC5D0\uAC8C \uC124\uBA85 \uAC00\uB2A5\uD55C \uAC00\uACA9,
      \uB9E4\uC7A5 \uC6B4\uC601\uC744 \uD574\uCE58\uC9C0 \uC54A\uB294 \uACC4\uC57D."
    cooperationLimit: "\uC88B\uC740 \uC0C1\uD488\uC744 \uAC70\uB798\uD574\uB3C4 \uADF8\uB8F9\uC744
      \uBC30\uC2E0\uD558\uAC70\uB098 \uCD5C\uC885 \uC720\uD1B5\uB9DD \uBC29\uC5B4\uB97C
      \uD3EC\uAE30\uD558\uC9C0 \uC54A\uB294\uB2E4. \uB192\uC740 \uAC1C\uC778 \uBCF4\uC218\uB294
      \uC804\uD5A5 \uC870\uAC74\uC774 \uC544\uB2C8\uB2E4."
    informationScope: "\uD569\uC758\uB41C \uC0C1\uD488\uC758 \uD310\uB9E4\xB7\uD488\uC9C8\xB7\uC11C\uBE44\uC2A4
      \uC9C0\uD45C. \uADF8\uB8F9\uC758 \uC804\uAD6D \uC9C4\uC5F4 \uC804\uB7B5, \uACE0\uAC1D
      \uBA85\uB2E8, \uC785\uCC30 \uC0C1\uD55C\uC740 \uB118\uAE30\uC9C0 \uC54A\uB294\uB2E4."
    refusalConditions: "\uACBD\uC601\uC9C4 \uAC1C\uC778 \uB9E4\uC218, \uACE0\uAC1D
      \uC815\uBCF4\uC640 \uB3C5\uC810 \uC9C4\uC5F4\uC758 \uB9DE\uAD50\uD658, \uC11C\uBE44\uC2A4
      \uC800\uD558\uB97C \uC804\uC81C\uB85C \uD55C \uC774\uC775 \uBCF4\uC7A5."
    renewedConflict: "\uC8FC\uC778\uACF5\uC774 \uACC4\uC5F4 \uC0C1\uD488\uACFC \uAC19\uC740
      \uC2DC\uC7A5\uC758 \uD310\uB9E4\uB9DD\uC744 \uB113\uD788\uBA74 \uAC70\uB798
      \uC5EC\uBD80\uC640 \uBCC4\uAC1C\uB85C \uB2E4\uC2DC \uC801\uADF9 \uACAC\uC81C\uD55C\uB2E4."
    storyArc: "\uCD08\uAE30: \uC785\uC810\uACFC \uD310\uCD09 \uC870\uAC74\uC73C\uB85C
      \uC131\uC7A5\uC744 \uB9C9\uB294\uB2E4.\n\uC911\uBC18: \uACE0\uAC1D \uC911\uC2EC\uC774\uB77C\uB294
      \uC790\uAE30 \uC124\uBA85\uACFC \uACC4\uC5F4 \uC6B0\uB300\uC758 \uBAA8\uC21C\uC744
      \uB9C8\uC8FC\uD55C\uB2E4.\n\uCD5C\uC885: \uC81C\uD55C \uC0C1\uD488 \uAC70\uB798\uB97C
      \uC778\uC815\uD558\uBA74\uC11C\uB3C4 \uADF8\uB8F9\uC758 \uC804\uAD6D \uD310\uB9E4\uB9DD\uC744
      \uB05D\uAE4C\uC9C0 \uBC29\uC5B4\uD55C\uB2E4."
