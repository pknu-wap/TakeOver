      - memoryType: 1
        relationDelta: {trust: -2, respect: 0, fear: 0, hostility: 1, dependency: 0, interest: 0}
    actionPreferences:
    - actionId: GoodFaith
      disposition: 1
      rationale: 약속과 거래 신뢰를 지킨 행동
    - actionId: ContractBreach
