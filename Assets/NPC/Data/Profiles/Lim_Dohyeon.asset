    - memoryType: 4
      disposition: 1
      rationale: "\uAE30\uC5C5 \uC0DD\uC874\uC73C\uB85C \uD22C\uC790 \uD68C\uC218
        \uAC00\uB2A5\uC131\uC774 \uB192\uC544\uC9C4 \uACB0\uACFC\uC5D0 \uC0AC\uC5C5\uC801
        \uAD00\uC2EC\uC744 \uBCF4\uC778\uB2E4."
