    npcId: npc-polaris-finance-ceo-lim-dohyeon
    companyId: polaris-finance
    profile:
      standingIllustration: {fileID: 0}
      dimmedStandingIllustration: {fileID: 0}
      displayName: "\uC784\uB3C4\uD604"
      role: CEO
      affiliation: "\uD3F4\uB77C\uB9AC\uC2A4\uD30C\uC774\uB0B8\uC2A4"
      personalitySummary: "\uB0C9\uC815\uD558\uACE0 \uC774\uC775\uC5D0 \uBBFC\uAC10\uD558\uB2E4.
        \uC790\uC2E0\uC744 \uAC10\uC815 \uC5C6\uB294 \uACC4\uC0B0\uAC00\uB85C \uC5EC\uAE30\uC9C0\uB9CC,
        \uADF8\uB8F9\uC758 \uC790\uAE08 \uCC3D\uAD6C\uB85C\uB9CC \uCDE8\uAE09\uBC1B\uB294
        \uC77C\uC5D0\uB294 \uC720\uB09C\uD788 \uC790\uC874\uC2EC\uC744 \uB4DC\uB7EC\uB0B8\uB2E4.
        \uB3C5\uB9BD \uACBD\uC601\uC744 \uB9D0\uD558\uBA74\uC11C \uB300\uD615 \uACE0\uAC1D\uC5D0
        \uC758\uC874\uD558\uB294 \uBAA8\uC21C\uC774 \uC788\uB2E4.\n\uD589\uB3D9 \uC591\uC2DD:
        \uC790\uAE08\uC774 \uAE09\uD55C \uC0C1\uB300\uC5D0\uAC8C \uB2F4\uBCF4\xB7\uC635\uC158\uC744
        \uC694\uAD6C\uD558\uACE0, \uACC4\uC57D\uC758 \uC218\uC775\uACFC \uD68C\uC218
        \uC21C\uC11C\uB97C \uBE44\uAD50\uD55C\uB2E4. \uCDA9\uBD84\uD55C \uADFC\uAC70\uAC00
        \uC788\uC73C\uBA74 \uACFC\uAC70\uC758 \uAC70\uB798 \uC0C1\uB300\uB97C \uBC14\uAFB8\uB294
        \uB370 \uC8FC\uC800\uD558\uC9C0 \uC54A\uB294\uB2E4."
      gameplayRoleSummary: "\uC5ED\uD560: \uC8FC\uC778\uACF5\uC5D0\uAC8C \uC778\uC218
        \uC790\uAE08\uC744 \uC81C\uACF5\uD560 \uC218\uB3C4, \uACBD\uC7C1\uC790\uC5D0\uAC8C
        \uC790\uAE08\uC744 \uB300\uC5B4 \uAC00\uACA9\uC744 \uB04C\uC5B4\uC62C\uB9B4
        \uC218\uB3C4 \uC788\uB294 \uAE08\uC735 \uD611\uC0C1 \uC0C1\uB300.\n\uC120\uD638:
        \uAC80\uC99D\uB41C \uB2F4\uBCF4, \uC190\uC2E4 \uC0C1\uD55C, \uB3C5\uB9BD\uC801\uC778
        \uC218\uC775\uC6D0, \uC2E4\uC81C \uC9C0\uAE09\uB41C \uC131\uACFC\uBCF4\uC218\n\uAE30\uD53C:
        \uD68C\uC218 \uACC4\uD68D \uC5C6\uB294 \uACE0\uC218\uC775 \uC57D\uC18D, \uAC10\uC815\uC801
        \uD560\uC778 \uC694\uAD6C, \uC790\uC2E0\uC758 \uAD8C\uD55C\uC744 \uAC74\uB108\uB6F4
        \uADF8\uB8F9 \uC9C0\uC2DC"
      anyEventRelationDelta:
        trust: 0
        respect: 0
        fear: 0
        hostility: 0
        dependency: 0
        interest: 0
      eventRelationBiases: []
    actionPreferences: []
  storyDesign:
    stance: 2
    personalGoal: "\uADF8\uB8F9\uC758 \uD558\uCCAD \uC790\uAE08 \uCC3D\uAD6C\uC5D0\uC11C
      \uBC97\uC5B4\uB098 \uC5B4\uB5A4 \uC778\uC218\uC790\uB3C4 \uBB34\uC2DC\uD558\uC9C0
      \uBABB\uD558\uB294 \uB3C5\uB9BD \uAE08\uC735 \uAD8C\uB825\uC744 \uAC16\uB294\uB2E4."
    loyaltyReason: "\uADF8\uB8F9\uC774 \uC81C\uACF5\uD558\uB294 \uB300\uD615 \uAC70\uB798\xB7\uB2F4\uBCF4\xB7\uD68C\uC218
      \uC2E4\uC801\uC774 \uD3F4\uB77C\uB9AC\uC2A4\uC758 \uC131\uC7A5\uACFC \uC790\uC2E0\uC758
      \uC9C0\uC704\uB97C \uC9C0\uD0F1\uD55C\uB2E4."
    innerConflict: "\uB3C5\uB9BD\uC131\uC744 \uC6D0\uD558\uBA74\uC11C \uB2E8\uAE30
      \uC218\uC775 \uB54C\uBB38\uC5D0 \uADF8\uB8F9 \uC9D1\uC911 \uC704\uD5D8\uC744
      \uD0A4\uC6E0\uB2E4. \uC774\uB97C \uC778\uC815\uD558\uBA74 \uC790\uC2E0\uC758
      \uD310\uB2E8 \uC2E4\uD328\uB3C4 \uB4DC\uB7EC\uB09C\uB2E4."
    pressureTactics: "\uACBD\uC7C1 \uC778\uC218\uC790\uC5D0\uAC8C \uAE08\uC735\uC744
      \uC81C\uACF5\uD558\uACE0, \uC8FC\uC778\uACF5\uC758 \uCC28\uD658 \uC2DC\uC810\uC5D0
      \uB2F4\uBCF4\xB7\uC9C0\uBD84 \uC635\uC158\uC744 \uAC15\uD654\uD55C\uB2E4."
    cooperationTrigger: "\uADF8\uB8F9\uC758 \uC190\uC2E4 \uC804\uAC00\uAC00 \uACC4\uC57D\xB7\uD604\uAE08
      \uD750\uB984 \uC790\uB8CC\uB85C \uD655\uC778\uB418\uACE0, \uC8FC\uC778\uACF5\uC758
      \uB300\uC548 \uAC70\uB798\uAC00 \uB9AC\uC2A4\uD06C \uC2EC\uC0AC\uB97C \uD1B5\uACFC\uD574\uC57C
      \uD55C\uB2E4."
    requestedTerms: "\uC2E4\uBB3C \uB2F4\uBCF4, \uD68C\uC218 \uC6B0\uC120\uC21C\uC704,
      \uC2E4\uC81C \uC9D1\uD589\uD560 \uC790\uBCF8, \uBCC4\uB3C4 \uC815\uBCF4 \uB300\uAC00.
      \uB354 \uB192\uC740 \uC218\uC775\uB960 \uD55C \uC904\uB9CC\uC73C\uB85C\uB294
      \uC131\uB9BD\uD558\uC9C0 \uC54A\uB294\uB2E4."
    cooperationLimit: "\uD2B9\uC815 \uAE08\uC735 \uAC70\uB798\uC758 \uC0C1\uB300\uB9CC
      \uBC14\uAFBC\uB2E4. \uC8FC\uC778\uACF5\uC758 \uBCF5\uC218\uC5D0 \uB3D9\uCC38\uD558\uAC70\uB098
      \uC774\uD6C4\uC758 \uBAA8\uB4E0 \uC778\uC218\uC5D0 \uC790\uAE08\uC744 \uBCF4\uC7A5\uD558\uC9C0
      \uC54A\uB294\uB2E4."
    informationScope: "\uADF8\uB8F9\uACFC\uC758 \uD611\uC0C1\uC5D0\uC11C \uD655\uBCF4\uD55C
      \uBE44\uACF5\uAC1C \uCC28\uD658 \uB9C8\uAC10\xB7\uB2F4\uBCF4 \uD68C\uC218 \uC21C\uC11C\uB97C
      \uC120\uBCC4 \uC81C\uACF5\uD560 \uC218 \uC788\uB2E4. \uB2E4\uB978 \uACE0\uAC1D\uC758
      \uACC4\uC88C\xB7\uAC1C\uC778 \uBA85\uB2E8\uC740 \uC81C\uC678\uD55C\uB2E4."
    refusalConditions: "\uC790\uAE30 \uC790\uBCF8\uC758 \uC190\uC2E4\uC744 \uC228\uAE34
      \uC81C\uC548, \uD68C\uC218\uAD8C\uC758 \uBB34\uC870\uAC74 \uD3EC\uAE30, \uB2F4\uBCF4
      \uC5C6\uB294 \uC815\uCE58\uC801 \uBCF4\uD638 \uC57D\uC18D."
    renewedConflict: "\uC8FC\uC778\uACF5\uC774 \uB2F4\uBCF4\xB7\uC218\uC775 \uC57D\uC815\uC744
      \uC5B4\uAE30\uAC70\uB098 \uB354 \uB098\uC740 \uD68C\uC218 \uC870\uAC74\uC758
      \uACBD\uC7C1 \uAC70\uB798\uAC00 \uC0DD\uAE30\uBA74 \uB2E4\uC2DC \uC790\uAE08\uC744
      \uD68C\uC218\uD558\uACE0 \uC778\uC218 \uACBD\uC7C1\uC744 \uC9C0\uC6D0\uD55C\uB2E4."
    storyArc: "\uCD08\uAE30: \uAE09\uD55C \uC790\uAE08\uC758 \uB300\uAC00\uB85C \uC9C0\uBD84
      \uC635\uC158\uC744 \uC694\uAD6C\uD55C\uB2E4.\n\uC911\uBC18: \uADF8\uB8F9\uC758
      \uBD80\uB2F4 \uC804\uAC00 \uC790\uB8CC\uC640 \uB300\uCCB4 \uAE08\uC735 \uACC4\uC57D\uC744
      \uBE44\uAD50\uD55C\uB2E4.\n\uCD5C\uC885: \uADF8\uB8F9 \uC790\uAE08\uC904 \uC77C\uBD80\uB97C
      \uB04A\uC744 \uC218 \uC788\uC73C\uB098 \uC790\uAE30 \uCC44\uAD8C \uD68C\uC218\uB294
      \uB05D\uAE4C\uC9C0 \uC694\uAD6C\uD55C\uB2E4."
