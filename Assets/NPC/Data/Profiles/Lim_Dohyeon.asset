    - memoryType: 1
      disposition: 2
      rationale: "\uD569\uC758\uB41C \uB2F4\uBCF4\xB7\uC218\uC775 \uC870\uAC74 \uC704\uBC18\uC740
        \uAE08\uC735 \uAC70\uB798\uC758 \uC2E0\uB8B0\uB97C \uD6FC\uC190\uD55C\uB2E4."
      effect:
