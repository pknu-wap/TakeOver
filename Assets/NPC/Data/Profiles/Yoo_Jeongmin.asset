    - memoryType: 1
      disposition: 2
      rationale: "\uD655\uC815\uD55C \uC7A5\uAE30 \uACC4\uD68D\uC758 \uC77C\uBC29\uC801
        \uBCC0\uACBD\uC740 \uD611\uC5C5 \uC2E0\uB8B0\uB97C \uD574\uCE5C\uB2E4."
