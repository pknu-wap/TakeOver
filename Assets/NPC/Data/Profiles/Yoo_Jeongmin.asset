    memoryPreferences:
    - memoryType: 0
      disposition: 1
      rationale: "\uB3C4\uC2DC \uACC4\uD68D\uACFC \uC9C0\uC5ED \uD611\uC758\uC758
        \uC774\uD589\uC740 \uC7A5\uAE30 \uAC1C\uBC1C\uC744 \uAC00\uB2A5\uD558\uAC8C
        \uD55C\uB2E4."
