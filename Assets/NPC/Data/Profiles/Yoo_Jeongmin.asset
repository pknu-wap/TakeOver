    npcId: npc-sinseong-development-planning-director-yoo-jeongmin
    companyId: sinseong-development
    profile:
      standingIllustration: {fileID: 0}
      dimmedStandingIllustration: {fileID: 0}
      displayName: "\uC720\uC815\uBBFC"
      role: "\uAC1C\uBC1C\uAE30\uD68D\uCC45\uC784\uC790"
      affiliation: "\uC2E0\uC131\uAC1C\uBC1C"
      personalitySummary: "\uB3C4\uC2DC\uC758 \uC624\uB798\uAC00\uB294 \uACF5\uAC04\uC744
        \uB9CC\uB4DC\uB294 \uB370 \uC790\uBD80\uC2EC\uC774 \uC788\uB2E4. \uC774\uC0C1\uC801\uC778
        \uC124\uACC4\uB97C \uC774\uC57C\uAE30\uD558\uC9C0\uB9CC \uCCAB \uB300\uD615
        \uD504\uB85C\uC81D\uD2B8\uB97C \uC5BB\uAE30 \uC704\uD574 \uBE44\uD604\uC2E4\uC801\uC778
        \uC218\uC775 \uAC00\uC815\uC744 \uBB35\uC778\uD55C \uC801\uC774 \uC788\uB2E4.\n\uD589\uB3D9
        \uC591\uC2DD: \uC720\uB3D9\uC778\uAD6C\uC640 \uC7A5\uAE30 \uC784\uB300\uAC00\uCE58\uB97C
        \uD568\uAED8 \uACC4\uC0B0\uD55C\uB2E4. \uC218\uC775\uC131 \uAC80\uD1A0\uB97C
        \uD68C\uD53C\uD558\uC9C0 \uC54A\uB418 \uC124\uACC4\uB97C \uBC14\uAFB8\uB294
        \uC774\uC720\uC640 \uADF8 \uBE44\uC6A9\uC744 \uBB38\uC11C\uC5D0 \uB0A8\uAE30\uB824
        \uD55C\uB2E4."
      gameplayRoleSummary: "\uC5ED\uD560: \uAC1C\uBC1C \uC774\uC775\uACFC \uB3C4\uC2DC\uC758
        \uC7A5\uAE30 \uAC00\uCE58\uB97C \uD568\uAED8 \uC81C\uC2DC\uD558\uB294 \uAE30\uD68D\uC790.
        \uC22B\uC790\uB85C \uBCF4\uC774\uB294 \uC785\uC9C0 \uACBD\uC7C1 \uB4A4\uC758
        \uACC4\uD68D\uACFC \uCC45\uC784\uC744 \uB4DC\uB7EC\uB0B8\uB2E4.\n\uC120\uD638:
        \uB2E8\uACC4\uBCC4 \uBCF5\uD569\uAC1C\uBC1C, \uBCF4\uD589\xB7\uC0C1\uAD8C
        \uC5F0\uACB0, \uAC80\uC99D\uB41C \uC7A5\uAE30 \uC218\uC694, \uC124\uACC4
        \uBCC0\uACBD\uC758 \uCC45\uC784 \uAE30\uB85D\n\uAE30\uD53C: \uB2E8\uAE30
        \uB9E4\uAC01\uC744 \uC704\uD55C \uACFC\uBC00 \uAC1C\uBC1C, \uC218\uC694 \uC218\uCE58
        \uACFC\uC7A5, \uC124\uACC4\uC790\uC758 \uC774\uB984\uB9CC \uBE4C\uB9AC\uB294
        \uACB0\uC7AC, \uC9C0\uC5ED \uB9E5\uB77D\uC744 \uC9C0\uC6B0\uB294 \uACC4\uD68D"
      anyEventRelationDelta:
        trust: 0
        respect: 0
        fear: 0
        hostility: 0
        dependency: 0
        interest: 0
      eventRelationBiases: []
    actionPreferences: []
  storyDesign:
    stance: 4
    personalGoal: "\uC790\uAE30 \uC774\uB984\uC774 \uBD99\uC740 \uD504\uB85C\uC81D\uD2B8\uAC00
      \uB9E4\uAC01 \uC9C1\uD6C4 \uC1E0\uD1F4\uD558\uB294 \uC790\uC0B0\uC774 \uC544\uB2C8\uB77C
      \uC2E4\uC81C\uB85C \uC4F0\uC774\uB294 \uACF5\uAC04\uC73C\uB85C \uB0A8\uAC8C
      \uD55C\uB2E4."
    loyaltyReason: "\uADF8\uB8F9 \uC790\uAE08\uC774 \uC788\uC5B4\uC57C \uD070 \uC124\uACC4\uB97C
      \uC2E4\uD604\uD560 \uC218 \uC788\uC5C8\uACE0, \uD504\uB85C\uC81D\uD2B8\uC758
      \uC131\uACF5\uC774 \uC790\uC2E0\uC758 \uACBD\uB825\uACFC \uC5F0\uACB0\uB3FC
      \uC788\uB2E4."
    innerConflict: "\uC65C\uACE1\uB41C \uCD08\uAE30 \uC218\uC694 \uAC00\uC815\uC744
      \uBB35\uC778\uD588\uB2E4. \uC790\uB8CC \uACF5\uAC1C\uB294 \uADF8\uB8F9\uBFD0
      \uC544\uB2C8\uB77C \uC790\uC2E0\uC758 \uC124\uACC4 \uD310\uB2E8\uB3C4 \uC2EC\uD310\uB300\uC5D0
      \uC62C\uB9B0\uB2E4."
    pressureTactics: "\uC8FC\uC778\uACF5\uC758 \uAC1C\uBC1C\uC548\uC5D0 \uC0C1\uAD8C\xB7\uB3D9\uC120\xB7\uC7A5\uAE30
      \uC784\uB300 \uC190\uC2E4\uC744 \uC81C\uAE30\uD574 \uB2E8\uC21C\uD55C \uC800\uAC00
      \uB9E4\uC785\uC758 \uC124\uB4DD\uB825\uC744 \uAE4E\uB294\uB2E4."
    cooperationTrigger: "\uADF8\uB8F9\uC758 \uAC15\uC81C \uC124\uACC4 \uBCC0\uACBD\uC774
      \uAC80\uC99D \uC790\uB8CC\uC640 \uCDA9\uB3CC\uD558\uACE0 \uC8FC\uC778\uACF5\uC774
      \uC6D0\uB798 \uACC4\uD68D\uC758 \uC7A5\uAE30 \uAC00\uCE58\uB97C \uC2E4\uC81C
      \uC608\uC0B0\xB7\uC77C\uC815\uC73C\uB85C \uBCF4\uC7A5\uD574\uC57C \uD55C\uB2E4."
    requestedTerms: "\uC124\uACC4 \uBCC0\uACBD\uC758 \uCC45\uC784 \uACF5\uAC1C, \uB2E8\uACC4\uBCC4
      \uC0AC\uC5C5 \uC608\uC0B0, \uC7A5\uAE30 \uC6B4\uC601 \uAC80\uC99D, \uC790\uC2E0\uC758
      \uC624\uB958\uB3C4 \uC218\uC815 \uAE30\uB85D\uC5D0 \uB0A8\uAE30\uB294 \uC870\uAC74."
    cooperationLimit: "\uD504\uB85C\uC81D\uD2B8\uC758 \uB300\uC548 \uC124\uACC4\uC640
      \uC790\uB8CC \uAC80\uC99D\uC5D0 \uD611\uC870\uD55C\uB2E4. \uC815\uB3C4\uD604\uC758
      \uAC1C\uBC1C\uAD8C\uC774\uB098 \uC2E0\uC131 \uC804\uCCB4\uC758 \uC758\uC0AC\uACB0\uC815\uC744
      \uB300\uC2E0 \uB118\uAE30\uC9C0 \uC54A\uB294\uB2E4."
    informationScope: "\uC6D0\uBCF8 \uC218\uC694 \uAC80\uD1A0\xB7\uACC4\uD68D \uBCC0\uACBD
      \uC774\uB825\xB7\uADF8\uB8F9\uC774 \uC694\uAD6C\uD55C \uBC00\uB3C4 \uC870\uC815
      \uADFC\uAC70. \uC790\uC2E0\uC758 \uBB35\uC778 \uAE30\uB85D\uB3C4 \uD3EC\uD568\uD574
      \uC81C\uACF5\uD55C\uB2E4."
    refusalConditions: "\uC790\uC2E0\uC758 \uCC45\uC784\uB9CC \uC9C0\uC6CC \uC8FC\uB294
      \uB300\uAC00\uC131 \uD3ED\uB85C, \uC0C8 \uACC4\uD68D\uB3C4 \uACFC\uC7A5\uB41C
      \uC218\uC775\uB9CC \uB0B4\uC138\uC6B0\uB294 \uC81C\uC548, \uC6D0\uBCF8 \uC790\uB8CC\uC758
      \uC0AD\uC81C."
    renewedConflict: "\uC8FC\uC778\uACF5\uC774 \uC7A5\uAE30 \uC6B4\uC601 \uC57D\uC18D\uC744
      \uBC84\uB9AC\uACE0 \uC870\uAE30 \uB9E4\uAC01\xB7\uACFC\uBC00 \uAC1C\uBC1C\uB85C
      \uC804\uD658\uD558\uBA74 \uC790\uB8CC \uD611\uC870\uB97C \uAC70\uB450\uACE0
      \uACC4\uD68D\uC5D0 \uBC18\uB300\uD55C\uB2E4."
    storyArc: "\uCD08\uAE30: \uC8FC\uC778\uACF5\uC758 \uBD80\uC9C0 \uD65C\uC6A9 \uACC4\uD68D\uC744
      \uBE44\uD310\uD55C\uB2E4.\n\uC911\uBC18: \uC790\uC2E0\uB3C4 \uAD00\uC5EC\uD55C
      \uC218\uC694 \uACFC\uC7A5\uC744 \uC778\uC815\uD560\uC9C0 \uC120\uD0DD\uD55C\uB2E4.\n\uCD5C\uC885:
      \uADF8\uB8F9\uC758 \uACC4\uD68D \uBCC0\uACBD \uADFC\uAC70\uB97C \uACF5\uAC1C\uD560
      \uC218 \uC788\uC9C0\uB9CC \uC8FC\uC778\uACF5\uC5D0\uAC8C\uB3C4 \uAC19\uC740
      \uC124\uACC4 \uAE30\uC900\uC744 \uC801\uC6A9\uD55C\uB2E4."
