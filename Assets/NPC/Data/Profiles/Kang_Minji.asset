          trust: 0
          respect: 0
          closeness: 0
    - memoryType: 1
      disposition: 2
      rationale: "\uC9C0\uC5ED \uD569\uC758\uC640 \uBCF4\uD638 \uC870\uAC74\uC744
        \uAE68\uBA74 \uC2E0\uB8B0\uC640 \uD611\uB825 \uAE30\uBC18\uC774 \uD6FC\uC190\uB41C\uB2E4."
      effect:
