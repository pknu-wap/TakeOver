    npcId: npc-sinseong-development-community-director-kang-minji
    companyId: sinseong-development
    profile:
      standingIllustration: {fileID: 0}
      dimmedStandingIllustration: {fileID: 0}
      displayName: "\uAC15\uBBFC\uC9C0"
      role: "\uC784\uCC28\uC778\xB7\uC9C0\uC5ED\uAD00\uACC4 \uCC45\uC784\uC790"
      affiliation: "\uC2E0\uC131\uAC1C\uBC1C"
      personalitySummary: "\uC8FC\uBBFC\uACFC \uC784\uCC28\uC778\uC758 \uAC10\uC815\uC744
        \uC77D\uB294 \uB370 \uB2A5\uD558\uC9C0\uB9CC \uBAA8\uB450\uC5D0\uAC8C \uC88B\uC740
        \uB2F5\uC774 \uC788\uB2E4\uACE0 \uBBFF\uC9C0\uB294 \uC54A\uB294\uB2E4. \uAC08\uB4F1\uC744
        \uC904\uC774\uB824 \uB9D0\uC744 \uACE8\uB790\uB358 \uC77C\uC774 \uC0AC\uC2E4\uC744
        \uB2A6\uAC8C \uC54C\uB9AC\uB294 \uD551\uACC4\uAC00 \uB418\uAE30\uB3C4 \uD588\uB2E4.\n\uD589\uB3D9
        \uC591\uC2DD: \uD569\uC758\uBB38\uACFC \uC2E4\uC81C \uC774\uC8FC\xB7\uBCF4\uC0C1
        \uC77C\uC815\uC744 \uB300\uC870\uD55C\uB2E4. \uB300\uD654\uC758 \uCC3D\uAD6C\uB97C
        \uC5F4\uB418, \uB300\uD45C\uB098 \uD22C\uC790\uC790\uAC00 \uC8FC\uBBFC\uC744
        \uB300\uC2E0\uD574 \uB3D9\uC758\uD588\uB2E4\uACE0 \uB9D0\uD558\uB294 \uC0C1\uD669\uC744
        \uB9C9\uB294\uB2E4."
      gameplayRoleSummary: "\uC5ED\uD560: \uAC1C\uBC1C \uD611\uC0C1\uC758 \uC9C0\uC5ED
        \uCC3D\uAD6C. \uC8FC\uC778\uACF5\uACFC \uC0C1\uB300 \uD68C\uC0AC \uBAA8\uB450\uC5D0\uAC8C
        \uC57D\uC18D\uC758 \uBB38\uAD6C\uBCF4\uB2E4 \uB2F9\uC0AC\uC790\uC758 \uC120\uD0DD\uAD8C\uACFC
        \uC2E4\uC81C \uC774\uD589\uC744 \uC694\uAD6C\uD55C\uB2E4.\n\uC120\uD638:
        \uC784\uCC28\uC778 \uBCF4\uD638, \uB2F9\uC0AC\uC790 \uCC38\uC5EC, \uC9C0\uAE09
        \uC7AC\uC6D0\uC774 \uC788\uB294 \uBCF4\uC0C1, \uBC14\uB010 \uC870\uAC74\uC758
        \uC2E0\uC18D\uD55C \uC124\uBA85\n\uAE30\uD53C: \uC77C\uAD04 \uD1F4\uAC70,
        \uC124\uBA85 \uC5C6\uB294 \uC77C\uC815 \uBCC0\uACBD, \uC8FC\uBBFC\uC744 \uB3D9\uC6D0\uD558\uB294
        \uC5EC\uB860\uC804, \uC790\uC2E0\uC758 \uC911\uC7AC\uB97C \uB3D9\uC758\uC11C\uCC98\uB7FC
        \uC4F0\uB294 \uD0DC\uB3C4"
      anyEventRelationDelta:
        trust: 0
        respect: 0
        fear: 0
        hostility: 0
        dependency: 0
        interest: 0
      eventRelationBiases: []
    actionPreferences: []
  storyDesign:
    stance: 4
    personalGoal: "\uC8FC\uBBFC\uC744 \uC548\uC2EC\uC2DC\uCF30\uB358 \uC790\uC2E0\uC758
      \uB9D0\uC774 \uB204\uAD70\uAC00\uB97C \uBC00\uC5B4\uB0B4\uB294 \uB3C4\uAD6C\uAC00
      \uB418\uC9C0 \uC54A\uAC8C \uD55C\uB2E4."
    loyaltyReason: "\uADF8\uB8F9 \uC0AC\uC5C5\uC774 \uC57D\uC18D\uD55C \uC0C1\uAD8C\xB7\uC774\uC8FC
      \uC790\uAE08\uC774 \uD604\uC2E4\uC801\uC778 \uB300\uC548\uC774\uB77C\uACE0
      \uBBFF\uC5C8\uACE0, \uADF8 \uC57D\uC18D\uC744 \uC9C0\uC5ED\uC5D0 \uC124\uBA85\uD55C
      \uCC45\uC784\uC774 \uC788\uB2E4."
    innerConflict: "\uC0AC\uC5C5\uC744 \uC9C0\uD0A4\uB824 \uBD88\uB9AC\uD55C \uBCC0\uACBD\uC744
      \uB2A6\uAC8C \uC54C\uB838\uACE0 \uADF8 \uACB0\uACFC \uC8FC\uBBFC\uC758 \uC120\uD0DD
      \uC2DC\uAC04\uC774 \uC904\uC5C8\uB2E4."
    pressureTactics: "\uC8FC\uC778\uACF5\uC758 \uAC1C\uBC1C\uC548\uC5D0 \uBCF4\uC0C1\xB7\uC774\uC8FC\xB7\uC0C1\uAD8C
      \uD53C\uD574 \uC870\uAC74\uC744 \uC694\uAD6C\uD558\uACE0 \uBD88\uCDA9\uBD84\uD55C
      \uC81C\uC548\uC744 \uC9C0\uC5ED \uD611\uC0C1\uC5D0\uC11C \uBC18\uB300\uD55C\uB2E4."
    cooperationTrigger: "\uADF8\uB8F9\uC774 \uBCF4\uD638 \uC57D\uC18D\uC744 \uB4A4\uC9D1\uC740
      \uC790\uB8CC\uAC00 \uD655\uC778\uB418\uACE0, \uC8FC\uC778\uACF5\uC774 \uC8FC\uBBFC
      \uCC38\uC5EC\uC640 \uC9C0\uAE09 \uC7AC\uC6D0\uC744 \uAC16\uCD98 \uB300\uC548\uC744
      \uC81C\uC2DC\uD574\uC57C \uD55C\uB2E4."
    requestedTerms: "\uB2F9\uC0AC\uC790 \uB3D9\uC758, \uBCF4\uC0C1\uAE08 \uD655\uBCF4,
      \uC774\uC8FC \uD6C4 \uC0DD\uACC4 \uB300\uCC45, \uB3C5\uB9BD\uC801\uC778 \uC774\uD589
      \uD655\uC778\uACFC \uC911\uC7AC \uCC3D\uAD6C."
    cooperationLimit: "\uC9C0\uC5ED \uD53C\uD574\uB97C \uC904\uC774\uB294 \uC0AC\uC5C5\uBCC4
      \uD611\uC870\uB2E4. \uC8FC\uBBFC\uC744 \uC8FC\uC778\uACF5\uC758 \uC9C0\uC9C0
      \uC138\uB825\uC73C\uB85C \uB118\uAE30\uAC70\uB098 \uB300\uD45C\uC758 \uAC1C\uBC1C\uAD8C\uC744
      \uCC98\uBD84\uD558\uC9C0 \uC54A\uB294\uB2E4."
    informationScope: "\uC8FC\uBBFC\uC774 \uACF5\uAC1C\uC5D0 \uB3D9\uC758\uD55C \uD569\uC758
      \uC774\uB825\xB7\uADF8\uB8F9\uC758 \uC870\uAC74 \uBCC0\uACBD \uACF5\uBB38\xB7\uBBF8\uC9D1\uD589
      \uBCF4\uC0C1 \uADFC\uAC70. \uBBFC\uC6D0\uC778\uC758 \uC2E0\uC6D0\uACFC \uC0AC\uC801
      \uC57D\uC810\uC740 \uC81C\uC678\uD55C\uB2E4."
    refusalConditions: "\uC8FC\uBBFC \uB3D9\uC758 \uC5C6\uB294 \uD3ED\uB85C, \uBCF4\uBCF5
      \uC704\uD5D8\uC758 \uC804\uAC00, \uD604\uAE08 \uBCF4\uC218\uB85C \uC9C0\uC5ED
      \uD569\uC758\uB97C \uB300\uCCB4\uD558\uB824\uB294 \uC694\uAD6C."
    renewedConflict: "\uC8FC\uC778\uACF5\uC774 \uAC19\uC740 \uC77C\uAD04 \uD1F4\uAC70\uB098
      \uC815\uBCF4 \uC9C0\uC5F0\uC744 \uBC18\uBCF5\uD558\uBA74 \uACF5\uAC1C\uC801\uC73C\uB85C
      \uBC18\uB300\uD558\uBA70 \uD53C\uD574 \uB2F9\uC0AC\uC790\uC758 \uD3B8\uC5D0\uC11C
      \uC7AC\uD611\uC0C1\uD55C\uB2E4."
    storyArc: "\uCD08\uAE30: \uC8FC\uC778\uACF5\uC758 \uC785\uC9C0 \uD655\uBCF4\uB97C
      \uC9C0\uC5ED \uC870\uAC74\uC73C\uB85C \uB9C9\uB294\uB2E4.\n\uC911\uBC18: \uC790\uC2E0\uC758
      \uB2A6\uC740 \uC124\uBA85\uACFC \uADF8\uB8F9\uC758 \uC870\uAC74 \uBCC0\uACBD\uC744
      \uC778\uC815\uD55C\uB2E4.\n\uCD5C\uC885: \uB3D9\uC758\uB41C \uBCC0\uACBD \uC790\uB8CC\uB85C
      \uD611\uC870\uD560 \uC218 \uC788\uC9C0\uB9CC \uC8FC\uC778\uACF5\uC758 \uAC1C\uBC1C\uC5D0\uB3C4
      \uBCF4\uD638 \uC57D\uC18D\uC744 \uB05D\uAE4C\uC9C0 \uC801\uC6A9\uD55C\uB2E4."
