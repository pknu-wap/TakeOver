          interest: 0
    - memoryType: 1
      disposition: 2
      rationale: "\uBD80\uCC44\uC640 \uC9C0\uC6D0 \uC870\uAC74\uC744 \uC228\uAE30\uAC70\uB098
        \uC5B4\uAE30\uBA74 \uC804\uCCB4 \uD604\uAE08 \uACC4\uD68D\uC774 \uBB34\uB108\uC9C4\uB2E4."
