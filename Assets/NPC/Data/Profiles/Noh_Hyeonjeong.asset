    - memoryType: 4
      disposition: 1
      rationale: "\uD604\uAE08 \uC0DD\uC874\uC774 \uD655\uC778\uB41C \uD68C\uC0DD
        \uC131\uACFC\uB97C \uC778\uC815\uD55C\uB2E4."
      effect:
        mode: 1
