    memoryPreferences:
    - memoryType: 0
      disposition: 1
      rationale: "\uACF5\uAC1C\uD55C \uC7AC\uBB34 \uC870\uAC74\uC744 \uC9C0\uD0A8
        \uACB0\uACFC\uB294 \uD1B5\uD569 \uC7AC\uBB34\uC758 \uC2E0\uB8B0\uAC00 \uB41C\uB2E4."
