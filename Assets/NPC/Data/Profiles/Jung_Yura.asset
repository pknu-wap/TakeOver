      rationale: "\uC131\uACFC\uBCF4\uC218\uC640 \uC5ED\uD560\uC744 \uC2E4\uC81C\uB85C
        \uC9C0\uD0A8 \uACB0\uACFC\uB294 \uB2E4\uC74C \uAC70\uB798\uC758 \uC2E0\uB8B0\uAC00
