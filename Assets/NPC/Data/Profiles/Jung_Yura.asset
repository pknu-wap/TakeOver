    npcId: npc-polaris-finance-ma-director-jung-yura
    companyId: polaris-finance
    profile:
      standingIllustration: {fileID: 0}
      dimmedStandingIllustration: {fileID: 0}
      displayName: "\uC815\uC720\uB77C"
      role: "M&A \uBCF8\uBD80\uC7A5"
      affiliation: "\uD3F4\uB77C\uB9AC\uC2A4\uD30C\uC774\uB0B8\uC2A4"
      personalitySummary: "\uC0C1\uB300\uC758 \uC695\uB9DD\uC744 \uC77D\uACE0 \uD611\uC0C1
        \uAD6C\uC870\uB97C \uC9DC\uB294 \uC77C\uC744 \uC990\uAE34\uB2E4. \uB204\uAD6C\uC5D0\uAC8C\uB3C4
        \uB9E4\uC774\uC9C0 \uC54A\uB294\uB2E4\uACE0 \uB9D0\uD558\uC9C0\uB9CC, \uC815\uBCF4\uC640
        \uC131\uACFC\uBCF4\uC218\uAC00 \uBAA8\uB450 \uADF8\uB8F9\uC5D0 \uBB36\uC774\uB294
        \uCC98\uC9C0\uC5D0\uB294 \uC608\uBBFC\uD558\uB2E4.\n\uD589\uB3D9 \uC591\uC2DD:
        \uBCF5\uC218 \uB9E4\uC218\uC790\uB97C \uACBD\uC7C1\uC2DC\uD0A4\uB418 \uC790\uC2E0\uC774
        \uCC45\uC784\uC9C8 \uC815\uBCF4\uC640 \uCD94\uCE21\uC744 \uAD6C\uBD84\uD55C\uB2E4.
        \uC0C1\uB300\uC5D0\uAC8C \uD544\uC694\uD55C \uC815\uBCF4\uB97C \uD55C\uAEBC\uBC88\uC5D0
        \uC8FC\uC9C0 \uC54A\uACE0 \uB2E8\uACC4\uBCC4 \uC774\uD589\uC744 \uD655\uC778\uD55C\uB2E4."
      gameplayRoleSummary: "\uC5ED\uD560: \uC778\uC218 \uACBD\uC7C1\uC758 \uC911\uAC1C\uC790\uC774\uC790
        \uBE44\uACF5\uAC1C \uC815\uBCF4 \uD611\uC0C1\uC758 \uCC3D\uAD6C. \uAC70\uB798\uAC00
        \uB05D\uB09C \uB4A4\uC5D0\uB3C4 \uAC19\uC740 \uD3B8\uC774\uB77C\uACE0 \uB2E8\uC815\uD560
        \uC218 \uC5C6\uB294 \uC0C1\uB300.\n\uC120\uD638: \uAC80\uC99D \uAC00\uB2A5\uD55C
        \uAC70\uB798 \uC885\uACB0 \uC870\uAC74, \uC131\uACF5\uBCF4\uC218\uC758 \uC2E4\uC81C
        \uC9C0\uAE09, \uD55C\uC815\uB41C \uB3C5\uC810\uAD8C, \uC815\uBCF4 \uC81C\uACF5\uC790
        \uBCF4\uD638\n\uAE30\uD53C: \uBB34\uC81C\uD55C \uB3C5\uC810 \uC694\uAD6C,
        \uBCF4\uC218 \uBBF8\uC9C0\uAE09, \uC815\uBCF4\uB97C \uBC1B\uC740 \uB4A4\uC758
        \uACF5\uAC1C \uB9DD\uC2E0, \uCC45\uC784\uC744 \uC815\uBCF4\uC6D0\uC5D0\uAC8C\uB9CC
        \uC804\uAC00\uD558\uB294 \uACC4\uC57D"
      anyEventRelationDelta:
        trust: 0
        respect: 0
        fear: 0
        hostility: 0
        dependency: 0
        interest: 0
      eventRelationBiases: []
    actionPreferences: []
  storyDesign:
    stance: 2
    personalGoal: "\uB204\uAD70\uAC00\uC758 \uC2EC\uBD80\uB984\uAFBC\uC774 \uC544\uB2C8\uB77C
      \uAC70\uB798\uC758 \uC870\uAC74\uACFC \uB300\uAC00\uB97C \uC790\uC2E0\uC774
      \uC815\uD558\uB294 \uD611\uC0C1\uAC00\uB85C \uB0A8\uB294\uB2E4."
    loyaltyReason: "\uADF8\uB8F9\uC774 \uC81C\uACF5\uD558\uB294 \uB300\uD615 \uB9E4\uBB3C\xB7\uBE44\uACF5\uAC1C
      \uB124\uD2B8\uC6CC\uD06C\uC640 \uC131\uACF5\uBCF4\uC218 \uAE30\uD68C \uB54C\uBB38\uC5D0
      \uD611\uB825\uD55C\uB2E4."
    innerConflict: "\uD0C0\uC778\uC758 \uC57D\uC810\uC744 \uAC70\uB798\uD558\uBA74\uC11C
      \uC790\uC2E0\uC758 \uC815\uBCF4 \uB3C5\uC810\uAD8C\uC744 \uC0DD\uC874\uC758
      \uAD8C\uB9AC\uB77C\uACE0 \uC815\uB2F9\uD654\uD55C\uB2E4. \uC644\uC804\uD55C
      \uC911\uB9BD\uB3C4 \uC644\uC804\uD55C \uC790\uC720\uB3C4 \uAC16\uC9C0 \uBABB\uD588\uB2E4."
    pressureTactics: "\uACBD\uC7C1 \uC785\uCC30\uC744 \uBD99\uC774\uACE0 \uD611\uC0C1
      \uAE30\uD55C\uC744 \uC555\uCD95\uD574 \uC8FC\uC778\uACF5\uC758 \uC591\uBCF4\uC640
      \uC218\uC218\uB8CC\uB97C \uB298\uB9B0\uB2E4."
    cooperationTrigger: "\uADF8\uB8F9\uC774 \uC57D\uC18D\uD55C \uBCF4\uC218\uB97C
      \uB5BC\uAC70\uB098 \uCC45\uC784\uC744 \uB5A0\uB118\uAE34 \uC0AC\uC2E4\uC774
      \uD655\uC778\uB418\uACE0, \uC8FC\uC778\uACF5\uC774 \uC131\uC0AC \uAC00\uB2A5\uD55C
      \uB300\uCCB4 \uAC70\uB798\uB97C \uC81C\uC2DC\uD574\uC57C \uD55C\uB2E4."
    requestedTerms: "\uB2E8\uACC4\uBCC4 \uC131\uACF5\uBCF4\uC218, \uD55C\uC815\uB41C
      \uC815\uBCF4 \uB3C5\uC810 \uAE30\uAC04, \uC81C\uACF5\uC790 \uC2E0\uC6D0 \uBCF4\uD638,
      \uC815\uBCF4\uAC00 \uD2C0\uB838\uC744 \uB54C\uC758 \uCC45\uC784 \uBD84\uB2F4."
    cooperationLimit: "\uD2B9\uC815 \uAC70\uB798\uC5D0\uC11C\uB294 \uADF8\uB8F9\uC758
      \uC2E0\uB8B0\uB97C \uAE68\uACE0 \uD611\uC870\uD560 \uC218 \uC788\uC73C\uB098
      \uB2E4\uC74C \uB9E4\uBB3C\uAE4C\uC9C0 \uC8FC\uC778\uACF5\uC5D0\uAC8C \uC885\uC18D\uB418\uC9C0\uB294
      \uC54A\uB294\uB2E4."
    informationScope: "\uADF8\uB8F9\uC758 \uBE44\uACF5\uAC1C \uB9E4\uAC01 \uC6B0\uC120\uC21C\uC704\xB7\uC785\uCC30
      \uC0C1\uD55C\uC120\xB7\uD611\uC0C1 \uC2DC\uD55C\uC744 \uC120\uBCC4 \uC81C\uACF5\uD55C\uB2E4.
      \uC790\uC2E0\uC5D0\uAC8C \uBD88\uB9AC\uD55C \uC804\uB2EC \uC774\uB825\uB3C4
      \uB530\uB85C \uC228\uAE38 \uC218 \uC788\uC5B4 \uAD50\uCC28 \uAC80\uC99D\uC774
      \uD544\uC694\uD558\uB2E4."
    refusalConditions: "\uC815\uBCF4 \uC804\uCCB4\uB97C \uC120\uC9C0\uAE09\uD558\uB77C\uB294
      \uC694\uAD6C, \uC81C3\uC790\uC5D0\uAC8C \uC7AC\uD310\uB9E4\uD560 \uAD8C\uD55C,
      \uBCF4\uBCF5\uC744 \uC815\uBCF4\uC6D0 \uD63C\uC790 \uAC10\uB2F9\uD558\uAC8C
      \uD558\uB294 \uC57D\uC18D."
    renewedConflict: "\uC8FC\uC778\uACF5\uC774 \uBCF4\uC218\uB97C \uBBF8\uB8E8\uAC70\uB098
      \uC2E0\uC6D0\uC744 \uB4DC\uB7EC\uB0B4\uBA74 \uACBD\uC7C1\uC790\uC5D0\uAC8C
      \uB2E4\uC74C \uAC70\uB798\uB97C \uC5F0\uACB0\uD55C\uB2E4. \uC790\uAE30 \uACC4\uC57D\uC758
      \uC774\uD589\uACFC \uADF8\uB8F9\uC5D0 \uB300\uD55C \uCDA9\uC131\uC740 \uAD6C\uBD84\uD55C\uB2E4."
    storyArc: "\uCD08\uAE30: \uC8FC\uC778\uACF5\uC758 \uACBD\uC7C1 \uC778\uC218\uB97C
      \uC911\uAC1C\uD55C\uB2E4.\n\uC911\uBC18: \uBBF8\uC9C0\uAE09 \uBCF4\uC218\uC640
      \uCC45\uC784 \uC804\uAC00\uB97C \uACC4\uAE30\uB85C \uC815\uBCF4 \uACC4\uC57D\uC744
      \uD0C0\uC9C4\uD55C\uB2E4.\n\uCD5C\uC885: \uD575\uC2EC \uC785\uCC30 \uC815\uBCF4\uB97C
      \uB118\uAE38 \uC218 \uC788\uC9C0\uB9CC \uBC30\uC2E0\uC758 \uBE44\uC6A9\uACFC
      \uC815\uBCF4\uC758 \uC9C4\uC704\uB97C \uC8FC\uC778\uACF5\uB3C4 \uAC10\uB2F9\uD574\uC57C
      \uD55C\uB2E4."
