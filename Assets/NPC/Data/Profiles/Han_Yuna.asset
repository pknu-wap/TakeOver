    npcId: npc-aurora-foodtech-business-development-director-han-yuna
    companyId: aurora-foodtech
    profile:
      standingIllustration: {fileID: 0}
      dimmedStandingIllustration: {fileID: 0}
      displayName: "\uD55C\uC720\uB098"
      role: "\uC0AC\uC5C5\uAC1C\uBC1C\uCC45\uC784\uC790"
      affiliation: "\uC624\uB85C\uB77C\uD478\uB4DC\uD14C\uD06C"
      personalitySummary: "\uC2DC\uC7A5\uACFC \uD22C\uC790\uC790\uC758 \uAD00\uC2EC\uC744
        \uC77D\uB294 \uC2E4\uC6A9\uC801\uC778 \uD611\uC0C1\uAC00\uB2E4. \uC5F0\uAD6C\uB97C
        \uD314\uC544\uB118\uAE30\uB294 \uC0AC\uB78C\uC774 \uC544\uB2C8\uB77C \uC138\uC0C1\uC5D0
        \uC4F0\uC774\uAC8C \uD558\uB294 \uC0AC\uB78C\uC774\uB77C\uACE0 \uBBFF\uC9C0\uB9CC,
        \uC131\uACFC\uB97C \uC704\uD574 \uBD88\uB9AC\uD55C \uB3C5\uC810 \uC870\uAC74\uC744
        \uBC1B\uC544\uB4E4\uC778 \uCC45\uC784\uB3C4 \uC548\uB2E4.\n\uD589\uB3D9 \uC591\uC2DD:
        \uB77C\uC774\uC120\uC2A4\xB7\uACF5\uB3D9\uBE0C\uB79C\uB4DC\xB7\uC120\uAD6C\uB9E4\uB97C
        \uBB36\uC5B4 \uD604\uAE08\uD654\uD55C\uB2E4. \uAC70\uB798 \uC18D\uB3C4\uBFD0
        \uC544\uB2C8\uB77C \uB204\uAC00 \uC5B4\uB5A4 \uAD8C\uB9AC\uB97C \uC2E4\uC81C\uB85C
        \uC904 \uC218 \uC788\uB294\uC9C0\uC640 \uCD5C\uC18C \uB9E4\uCD9C\uC744 \uD655\uC778\uD55C\uB2E4."
      gameplayRoleSummary: "\uC5ED\uD560: \uAE30\uC220\uACFC \uD310\uB9E4\uB9DD\uC744
        \uC5F0\uACB0\uD558\uB294 \uC0AC\uC5C5 \uD611\uC0C1 \uCC3D\uAD6C. \uCC3D\uC5C5\uC790\uC758
        \uC9C4\uC601 \uC120\uD0DD\uACFC \uBCC4\uAC1C\uB85C \uAC1C\uBCC4 \uC0AC\uC5C5
        \uACC4\uC57D\uC758 \uAD6C\uC870\uB97C \uC7AC\uC124\uACC4\uD560 \uC218 \uC788\uB2E4.\n\uC120\uD638:
        \uC2E4\uD589\uB418\uB294 \uD310\uB85C, \uCD5C\uC18C \uB9E4\uCD9C \uBCF4\uC7A5,
        \uBC94\uC704\uAC00 \uBA85\uD655\uD55C \uB77C\uC774\uC120\uC2A4, \uAC80\uC99D\uC744
        \uAC70\uCE5C \uACF5\uB3D9 \uBE0C\uB79C\uB4DC\n\uAE30\uD53C: \uC0C1\uC6A9\uD654
        \uC5C6\uB294 \uAE30\uC220 \uB3C5\uC810, \uD22C\uC790 \uC758\uD5A5\uB9CC \uBC18\uBCF5\uD558\uB294
        \uC81C\uC548, \uAD8C\uD55C \uC5C6\uB294 \uD2B9\uD5C8 \uC774\uC804, \uAC80\uC99D
        \uACB0\uACFC\uB97C \uC228\uAE30\uB294 \uD310\uCD09"
      anyEventRelationDelta:
        trust: 0
        respect: 0
        fear: 0
        hostility: 0
        dependency: 0
        interest: 0
      eventRelationBiases: []
    actionPreferences: []
  storyDesign:
    stance: 2
    personalGoal: "\uC790\uC0AC \uAE30\uC220\uC774 \uD55C \uADF8\uB8F9\uC758 \uC9C4\uC5F4
      \uC2AC\uB86F\uC5D0\uB9CC \uBB36\uC774\uC9C0 \uC54A\uACE0 \uC5EC\uB7EC \uC2DC\uC7A5\uC5D0\uC11C
      \uC218\uC775\uC744 \uB0B4\uB294 \uAD6C\uC870\uB97C \uB9CC\uB4E0\uB2E4."
    loyaltyReason: "\uADF8\uB8F9\uC758 \uD310\uB9E4\uB9DD\uACFC \uD22C\uC790\uC790\uAC00
      \uCD08\uAE30 \uB9E4\uCD9C\uC744 \uB9CC\uB4E4\uC5B4 \uC790\uC2E0\uC758 \uC131\uACFC\uB3C4
      \uAC00\uB2A5\uD558\uAC8C \uD588\uB2E4."
    innerConflict: "\uAE30\uC220\uC758 \uD655\uC0B0\uC744 \uB9D0\uD558\uC9C0\uB9CC
      \uCCAB \uC2E4\uC801\uC744 \uC704\uD574 \uAC15\uD55C \uB3C5\uC810 \uC870\uAC74\uC744
      \uBC1B\uC544\uB4E4\uC5EC \uD6C4\uC18D \uC0AC\uC5C5\uC758 \uC120\uD0DD\uC9C0\uB97C
      \uC881\uD614\uB2E4."
    pressureTactics: "\uD2B9\uD5C8 \uB77C\uC774\uC120\uC2A4\uC640 \uC120\uAD6C\uB9E4\uACC4\uC57D\uC744
      \uBA3C\uC800 \uBB36\uC5B4 \uC8FC\uC778\uACF5\uC758 \uC2DD\uD488 \uAE30\uC5C5\uC774
      \uC0AC\uC6A9\uD560 \uAE30\uC220\xB7\uD310\uB85C\uB97C \uC904\uC778\uB2E4."
    cooperationTrigger: "\uADF8\uB8F9\uC774 \uC57D\uC18D\uD55C \uD310\uB9E4 \uBB3C\uB7C9\uC744
      \uC774\uD589\uD558\uC9C0 \uC54A\uC544 \uB3C5\uC810 \uACC4\uC57D\uC758 \uC7AC\uD611\uC0C1\xB7\uD574\uC9C0
      \uADFC\uAC70\uAC00 \uC0DD\uAE30\uACE0, \uC8FC\uC778\uACF5\uC774 \uAC80\uC99D\uB41C
      \uB300\uCCB4 \uD310\uB85C\uB97C \uC81C\uC2DC\uD574\uC57C \uD55C\uB2E4."
    requestedTerms: "\uCD5C\uC18C \uAD6C\uB9E4\uC758 \uC2E4\uC81C \uC9D1\uD589, \uAD8C\uD55C\uC774
      \uD655\uBCF4\uB41C \uBE44\uB3C5\uC810 \uB77C\uC774\uC120\uC2A4, \uAC80\uC99D
      \uCC45\uC784, \uC131\uACFC\uBCF4\uC218\uC640 \uAE30\uC874 \uC758\uBB34\uC758
      \uC815\uC0B0."
    cooperationLimit: "\uADF8\uB8F9\uACFC\uC758 \uD2B9\uC815 \uB3C5\uC810 \uAC70\uB798\uB97C
      \uAE68\uAC70\uB098 \uBC14\uAFC0 \uC218 \uC788\uC9C0\uB9CC \uAE40\uC11C\uD6C4\uC758
      \uC9C0\uBD84\xB7\uD2B9\uD5C8\uB97C \uB300\uC2E0 \uCC98\uBD84\uD558\uC9C0 \uC54A\uB294\uB2E4.
      \uACC4\uC57D \uC885\uB8CC \uB4A4 \uB2E4\uB978 \uD30C\uD2B8\uB108\uB97C \uC120\uD0DD\uD560
      \uC218 \uC788\uB2E4."
    informationScope: "\uC790\uC2E0\uC774 \uB2F4\uB2F9\uD55C \uBE44\uACF5\uAC1C \uC120\uAD6C\uB9E4
      \uBBF8\uC774\uD589\xB7\uB77C\uC774\uC120\uC2A4 \uC870\uAC74\xB7\uC720\uD1B5
      \uC815\uC0B0 \uB0B4\uC5ED. \uD575\uC2EC \uC5F0\uAD6C \uC6D0\uBCF8\uACFC \uB2E4\uB978
      \uACC4\uC57D\uC790\uC758 \uBE44\uBC00 \uC790\uB8CC\uB294 \uC81C\uC678\uD55C\uB2E4."
    refusalConditions: "\uAD8C\uD55C \uC5C6\uB294 \uAE30\uC220 \uC774\uC804 \uC694\uAD6C,
      \uC120\uAD6C\uB9E4 \uC2E4\uCCB4 \uC5C6\uB294 \uACE0\uC561 \uBCF4\uC218, \uAC80\uC99D
      \uC2E4\uD328\uB97C \uAC10\uCD98 \uACF5\uB3D9 \uB9C8\uCF00\uD305."
    renewedConflict: "\uC8FC\uC778\uACF5\uC774 \uC0C8 \uB3C5\uC810\uC73C\uB85C \uAE30\uC220\uC744
      \uBB36\uAC70\uB098 \uCD5C\uC18C \uAD6C\uB9E4\uB97C \uC5B4\uAE30\uBA74 \uB2E4\uB978
      \uD310\uB9E4\uB9DD\uC73C\uB85C \uC62E\uAE30\uACE0 \uACC4\uC57D\uC0C1 \uAD8C\uB9AC\uB97C
      \uD589\uC0AC\uD55C\uB2E4."
    storyArc: "\uCD08\uAE30: \uC120\uAD6C\uB9E4\uC640 \uB77C\uC774\uC120\uC2A4\uB85C
      \uC2DC\uC7A5\uC744 \uC120\uC810\uD55C\uB2E4.\n\uC911\uBC18: \uC790\uC2E0\uC774
      \uCCB4\uACB0\uD55C \uB3C5\uC810 \uACC4\uC57D\uC758 \uBBF8\uC774\uD589\uC744
      \uAC80\uC99D\uD55C\uB2E4.\n\uCD5C\uC885: \uC0C8 \uC720\uD1B5\xB7\uC0C1\uC6A9\uD654
      \uACC4\uC57D\uACFC \uAD00\uB828 \uC815\uBCF4\uB97C \uC81C\uACF5\uD560 \uC218
      \uC788\uC9C0\uB9CC \uACFC\uD559\uC801 \uC2B9\uC778\uACFC \uB300\uD45C\uC758
      \uC9C0\uBD84\uC740 \uBCC4\uB3C4 \uBB38\uC81C\uB85C \uB0A8\uB294\uB2E4."
