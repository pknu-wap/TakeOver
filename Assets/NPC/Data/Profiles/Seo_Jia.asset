  m_Script: {fileID: 11500000, guid: da74c4ef110445c0b10cdd6f4eb3fdfa, type: 3}
  m_Name: Seo_Jia
  m_EditorClassIdentifier: Assembly-CSharp::TakeOver.NPC.NpcDefinition
  seed:
    position: 0
    preferenceResponse:
      enabled: 1
      likedMultiplier: 1.5
      dislikedMultiplier: 1.5
    memoryPreferences:
    - memoryType: 0
      disposition: 1
      rationale: "\uD14C\uC2A4\uD2B8\uC6A9 - \uC57D\uC18D \uC774\uD589 \uACB0\uACFC\uB97C
        \uC2E0\uB8B0\uD55C\uB2E4."
    - memoryType: 4
      disposition: 1
      rationale: "\uD14C\uC2A4\uD2B8\uC6A9 - \uAE30\uC5C5 \uC0DD\uC874\uC5D0 \uAE30\uC5EC\uD55C
        \uACB0\uACFC\uB97C \uAE0D\uC815\uC801\uC73C\uB85C \uBCF8\uB2E4."
    - memoryType: 1
      disposition: 2
      rationale: "\uD14C\uC2A4\uD2B8\uC6A9 - \uC790\uAE08 \uBC0F \uBD80\uCC44 \uD569\uC758
        \uC704\uBC18\uC5D0 \uBC18\uBC1C\uD55C\uB2E4."
    npcId: npc-mirae-construction-cfo-seo-jia
    companyId: mirae-construction
    profile:
      standingIllustration: {fileID: 0}
      displayName: "\uC11C\uC9C0\uC544"
      role: CFO
      affiliation: "\uBBF8\uB798\uAC74\uC124"
      personalitySummary: "\uB0C9\uC815\uD558\uACE0 \uC22B\uC790 \uC911\uC2EC\uC774\uB2E4.
        \uAC10\uC815\uBCF4\uB2E4 \uC0DD\uC874 \uAC00\uB2A5\uC131\uC744 \uD310\uB2E8\uD558\uBA70
        \uBD80\uCC44 \uB9CC\uAE30, \uD604\uAE08\uD750\uB984, \uD504\uB85C\uC81D\uD2B8\uBCC4
        \uC218\uC775\uC131\uC744 \uBE44\uAD50\uD574 \uC190\uC2E4\uC774 \uAC00\uC7A5
        \uC801\uC740 \uC120\uD0DD\uC744 \uCC3E\uB294\uB2E4. \uAC70\uC9D3 \uC22B\uC790\uC640
        \uC228\uAE34 \uC7AC\uBB34 \uC870\uAC74\uC5D0\uB294 \uBC29\uC5B4\uC801\uC73C\uB85C
        \uBC18\uC751\uD55C\uB2E4."
      gameplayRoleSummary: "\uC704\uAE30\uC77C\uC218\uB85D \uB9E4\uAC01\uC744 \uC801\uADF9
        \uAC80\uD1A0\uD558\uBA70 \uD50C\uB808\uC774\uC5B4\uC758 \uC7AC\uBB34 \uB2A5\uB825\uACFC
        \uAC1D\uAD00\uC801 \uAC70\uB798 \uC870\uAC74\uC744 \uD3C9\uAC00\uD55C\uB2E4.
        \uC228\uACA8\uC9C4 \uBD80\uCC44\uC640 \uC218\uC775\uC131\uC774 \uB0AE\uC740
        \uC0AC\uC5C5\uBD80\uB97C \uC54C\uB824\uC8FC\uB294 \uB0B4\uBD80 \uC815\uBCF4
        \uCC3D\uAD6C\uB2E4."
      anyEventRelationDelta:
        trust: 0
        respect: 0
        fear: 0
        hostility: 0
        dependency: 0
        interest: 0
      eventRelationBiases: []
    actionPreferences:
    - actionId: GoodFaith
      disposition: 1
      rationale: "\uBA85\uD655\uD55C \uC7AC\uBB34 \uC870\uAC74\uACFC \uACC4\uC57D\uC744
        \uC2E4\uC81C\uB85C \uC9C0\uD0A8 \uD589\uB3D9\uC73C\uB85C \uD574\uC11D\uD560
        \uB54C \uC120\uD638\uD55C\uB2E4."
    - actionId: SavedCompany
      disposition: 1
      rationale: "\uD604\uAE08\uD750\uB984\uACFC \uC0DD\uC874 \uAC00\uB2A5\uC131\uC744
        \uAC1C\uC120\uD55C \uAE30\uC5C5 \uAD6C\uC81C\uB85C \uD574\uC11D\uD560 \uB54C
        \uC120\uD638\uD55C\uB2E4."
    - actionId: ContractBreach
      disposition: 2
      rationale: "\uBA85\uC2DC\uB41C \uC790\uAE08\uC774\uB098 \uBD80\uCC44 \uC778\uC218
        \uD569\uC758\uB97C \uC5B4\uAE34 \uC0AC\uAC74\uC73C\uB85C \uD574\uC11D\uD560
        \uB54C \uAE30\uD53C\uD55C\uB2E4."
    - actionId: ClearFundingPlan
      disposition: 1
      rationale: "\uBA85\uD655\uD55C \uC790\uAE08 \uACC4\uD68D\uC744 \uC81C\uC2DC\uD558\uB294
        \uAC70\uB798\uB97C \uC120\uD638\uD55C\uB2E4."
    - actionId: ExplicitDebtAssumption
      disposition: 1
      rationale: "\uBD80\uCC44 \uC778\uC218 \uC5EC\uBD80\uAC00 \uBA85\uC2DC\uB41C
        \uAC70\uB798\uB97C \uC120\uD638\uD55C\uB2E4."
    - actionId: PerformanceBasedCompensation
      disposition: 1
      rationale: "\uC131\uACFC\uBCF4\uC218 \uB4F1 \uAC1D\uAD00\uC801\uC778 \uC870\uAC74\uC744
        \uC120\uD638\uD55C\uB2E4."
    - actionId: VaguePromises
      disposition: 2
      rationale: "\uBAA8\uD638\uD55C \uC7A5\uBC0B\uBE5B \uC57D\uC18D\uC744 \uAE30\uD53C\uD55C\uB2E4."
    - actionId: UnverifiedGrowth
      disposition: 2
      rationale: "\uAC80\uC99D\uB418\uC9C0 \uC54A\uC740 \uC131\uC7A5\uB960\uC744
        \uAE30\uD53C\uD55C\uB2E4."
    - actionId: VanityInvestment
      disposition: 2
      rationale: "\uD604\uAE08\uD750\uB984\uC744 \uBB34\uC2DC\uD55C \uACFC\uC2DC\uC131
        \uD22C\uC790\uB97C \uAE30\uD53C\uD55C\uB2E4."
    - actionId: FinancialMisrepresentation
      disposition: 2
      rationale: "\uAC70\uC9D3 \uC22B\uC790\uB97C \uC81C\uC2DC\uD558\uBA74 \uC989\uC2DC
        \uBC29\uC5B4\uC801\uC778 \uD0DC\uB3C4\uB85C \uB3CC\uC544\uC120\uB2E4."
    - actionId: HiddenFinancialTerms
      disposition: 2
      rationale: "\uBD88\uB9AC\uD55C \uC7AC\uBB34 \uC870\uAC74\uC744 \uC228\uAE30\uB294
        \uAC70\uB798\uC5D0 \uBC29\uC5B4\uC801\uC73C\uB85C \uBC18\uC751\uD55C\uB2E4."
