      rationale: "\uB370\uC774\uD130 \uC774\uC6A9 \uD569\uC758\uB97C \uC5B4\uAE30\uBA74
        \uADDC\uC81C\uC640 \uD611\uC5C5 \uC704\uD5D8\uC774 \uCEE4\uC9C4\uB2E4."
