    npcId: npc-blueharbor-retail-data-director-han-dogyeong
    companyId: blueharbor-retail
    profile:
      standingIllustration: {fileID: 0}
      dimmedStandingIllustration: {fileID: 0}
      displayName: "\uD55C\uB3C4\uACBD"
      role: "\uB370\uC774\uD130\uCD1D\uAD04"
      affiliation: "\uBE14\uB8E8\uD558\uBC84\uB9AC\uD14C\uC77C"
      personalitySummary: "\uC815\uAD50\uD55C \uBD84\uC11D\uC774 \uC790\uC758\uC801\uC778
        \uAD8C\uB825\uC744 \uC904\uC778\uB2E4\uACE0 \uBBFF\uB294\uB2E4. \uADF8\uB7EC\uB098
        \uC790\uC2E0\uC774 \uC124\uACC4\uD55C \uC9C0\uD45C\uAC00 \uC57D\uD55C \uB0A9\uD488\uC5C5\uCCB4\uC758
        \uC190\uC2E4\uC744 \uAC00\uB9B0\uB2E4\uB294 \uC0AC\uC2E4\uC744 \uC778\uC815\uD558\uB294
        \uB370\uB294 \uBC29\uC5B4\uC801\uC774\uB2E4.\n\uD589\uB3D9 \uC591\uC2DD:
        \uB370\uC774\uD130 \uCD9C\uCC98\uC640 \uD45C\uBCF8\uC758 \uD3B8\uD5A5\uC744
        \uD655\uC778\uD55C\uB2E4. \uC0AC\uC5C5 \uC131\uACFC\uB97C \uD3EC\uAE30\uD558\uC9C0
        \uC54A\uB418 \uBD84\uC11D \uACB0\uACFC\uAC00 \uC815\uCE58\uC801 \uACB0\uB860\uC5D0
        \uB9DE\uCDB0 \uBC14\uB00C\uBA74 \uC6D0\uBCF8\uACFC \uC218\uC815 \uC774\uB825\uC744
        \uB300\uC870\uD55C\uB2E4."
      gameplayRoleSummary: "\uC5ED\uD560: \uD310\uB9E4 \uC815\uCC45\uC758 \uADFC\uAC70\uC640
        \uD6A8\uACFC\uB97C \uAC80\uC99D\uD558\uB294 \uB370\uC774\uD130 \uC2E4\uBB34\uC790.
        \uC22B\uC790\uB85C \uAC00\uB824\uC9C4 \uBE44\uC6A9\uACFC \uC9C0\uD45C \uC124\uACC4\uC790\uC758
        \uCC45\uC784\uC744 \uD568\uAED8 \uBCF4\uC5EC\uC900\uB2E4.\n\uC120\uD638:
        \uC7AC\uD604 \uAC00\uB2A5\uD55C \uBD84\uC11D, \uD569\uBC95\uC801 \uAC1C\uC778\uD654,
        \uC9D1\uACC4 \uAE30\uC900\uC758 \uC77C\uAD00\uC131, \uB370\uC774\uD130 \uC0AC\uC6A9
        \uBC94\uC704 \uD569\uC758\n\uAE30\uD53C: \uACE0\uAC1D \uAC1C\uC778\uC815\uBCF4
        \uAC70\uB798, \uCD9C\uCC98 \uBD88\uBA85 \uB370\uC774\uD130, \uACB0\uB860\uC5D0
        \uB9DE\uCD98 \uD45C\uBCF8 \uC0AD\uC81C, \uBD84\uC11D\uAC00\uC5D0\uAC8C \uCC45\uC784\uB9CC
        \uB118\uAE30\uB294 \uC9C0\uC2DC"
      anyEventRelationDelta:
        trust: 0
        respect: 0
        fear: 0
        hostility: 0
        dependency: 0
        interest: 0
      eventRelationBiases: []
    actionPreferences: []
  storyDesign:
    stance: 4
    personalGoal: "\uC790\uC2E0\uC758 \uBD84\uC11D\uC774 \uD2B9\uC815 \uC9C4\uC601\uC758
      \uACB0\uB860\uC744 \uAFB8\uBBF8\uB294 \uB3C4\uAD6C\uAC00 \uC544\uB2C8\uB77C
      \uAC80\uC99D \uAC00\uB2A5\uD55C \uD310\uB2E8 \uADFC\uAC70\uB85C \uB0A8\uAC8C
      \uD55C\uB2E4."
    loyaltyReason: "\uBE14\uB8E8\uD558\uBC84\uC758 \uC804\uAD6D \uB370\uC774\uD130\uC640
      \uADF8\uB8F9\uC758 \uD22C\uC790 \uB355\uBD84\uC5D0 \uBD84\uC11D\uC744 \uC0AC\uC5C5\uC5D0
      \uC801\uC6A9\uD560 \uC218 \uC788\uC5C8\uACE0 \uC131\uACFC\uB3C4 \uC778\uC815\uBC1B\uC558\uB2E4."
    innerConflict: "\uD3B8\uD5A5\uB41C \uC131\uACFC \uC9C0\uD45C\uB97C \uCC98\uC74C
      \uC124\uACC4\uD55C \uC0AC\uB78C\uC774 \uC790\uC2E0\uC774\uB2E4. \uBB38\uC81C\uB97C
      \uB4DC\uB7EC\uB0B4\uBA74 \uB3D9\uB8CC\uC640 \uC790\uAE30 \uD3C9\uAC00\uB3C4
      \uC190\uC0C1\uB41C\uB2E4."
    pressureTactics: "\uC8FC\uC778\uACF5 \uC81C\uD488\uC758 \uD310\uB9E4\xB7\uC7AC\uACE0\xB7\uBC18\uD488
      \uC704\uD5D8\uC744 \uC218\uCE58\uB85C \uC81C\uC2DC\uD574 \uC785\uC810 \uC870\uAC74\uC744
      \uAC15\uD654\uD55C\uB2E4."
    cooperationTrigger: "\uADF8\uB8F9\uC758 \uC9C0\uD45C \uC870\uC791 \uC694\uAD6C\uAC00
      \uC6D0\uBCF8 \uAE30\uB85D\uACFC \uCDA9\uB3CC\uD558\uACE0, \uC8FC\uC778\uACF5\uC774
      \uB3C5\uB9BD \uC7AC\uAC80\uC99D\uACFC \uBE44\uC2DD\uBCC4 \uCC98\uB9AC\uB97C
      \uBC1B\uC544\uB4E4\uC5EC\uC57C \uD55C\uB2E4."
    requestedTerms: "\uC6D0\uBCF8\xB7\uC218\uC815 \uC774\uB825 \uB3D9\uC2DC \uBCF4\uC874,
      \uBE44\uC2DD\uBCC4 \uC9D1\uACC4, \uAC80\uC99D \uBC94\uC704\uC640 \uACF5\uAC1C
      \uCC45\uC784\uC758 \uBB38\uC11C\uD654."
    cooperationLimit: "\uC65C\uACE1\uB41C \uC815\uCC45\uC758 \uAC80\uC99D\uC5D0 \uD611\uC870\uD55C\uB2E4.
      \uACE0\uAC1D \uB370\uC774\uD130\uB97C \uD310\uB9E4\uD558\uAC70\uB098 \uC804\uAD6D
      \uCD94\uCC9C\xB7\uAC00\uACA9 \uC2DC\uC2A4\uD15C\uC744 \uC8FC\uC778\uACF5\uC5D0\uAC8C
      \uB118\uAE30\uC9C0 \uC54A\uB294\uB2E4."
    informationScope: "\uBE44\uC2DD\uBCC4 \uC785\uC810\xB7\uD310\uCD09 \uC815\uCC45\uC758
      \uBCC0\uACBD \uC774\uB825, \uC9D1\uACC4 \uD1B5\uACC4\uC640 \uC9C0\uD45C \uC124\uACC4
      \uADFC\uAC70. \uC790\uC2E0\uC758 \uD3B8\uD5A5\uB41C \uC124\uACC4 \uAE30\uB85D\uB3C4
      \uD3EC\uD568\uD55C\uB2E4."
    refusalConditions: "\uAC1C\uC778 \uC2DD\uBCC4 \uB370\uC774\uD130 \uC694\uAD6C,
      \uAC80\uC99D \uC804 \uB2E8\uC815\uC801\uC778 \uD3ED\uB85C, \uC8FC\uC778\uACF5\uC5D0\uAC8C
      \uBD88\uB9AC\uD55C \uD45C\uBCF8\uB3C4 \uC0AD\uC81C\uD558\uB77C\uB294 \uC9C0\uC2DC."
    renewedConflict: "\uC8FC\uC778\uACF5\uC774 \uAC19\uC740 \uB370\uC774\uD130 \uC65C\uACE1\uC774\uB098
      \uAC1C\uC778\uC815\uBCF4 \uCE68\uD574\uB97C \uC2DC\uB3C4\uD558\uBA74 \uC790\uB8CC
      \uC81C\uACF5\uC744 \uC911\uB2E8\uD558\uACE0 \uBC18\uB300 \uADFC\uAC70\uB97C
      \uB0A8\uAE34\uB2E4."
    storyArc: "\uCD08\uAE30: \uBD84\uC11D\uC73C\uB85C \uC8FC\uC778\uACF5\uC758 \uD310\uB85C
      \uD655\uB300\uB97C \uACAC\uC81C\uD55C\uB2E4.\n\uC911\uBC18: \uC790\uC2E0\uC758
      \uC9C0\uD45C\uC640 \uADF8\uB8F9 \uC9C0\uC2DC \uC0AC\uC774\uC758 \uCC45\uC784\uC744
      \uC778\uC815\uD55C\uB2E4.\n\uCD5C\uC885: \uC815\uCC45 \uC65C\uACE1\uC758 \uC6D0\uBCF8
      \uADFC\uAC70\uB97C \uC81C\uACF5\uD560 \uC218 \uC788\uC9C0\uB9CC \uC8FC\uC778\uACF5\uC758
      \uC8FC\uC7A5\uB3C4 \uAC19\uC740 \uBC29\uC2DD\uC73C\uB85C \uAC80\uC99D\uD55C\uB2E4."
