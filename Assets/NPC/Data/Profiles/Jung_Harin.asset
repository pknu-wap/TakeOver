    npcId: npc-aurora-foodtech-chief-scientist-jung-harin
    companyId: aurora-foodtech
    profile:
      standingIllustration: {fileID: 0}
      dimmedStandingIllustration: {fileID: 0}
      displayName: "\uC815\uD558\uB9B0"
      role: "\uC218\uC11D\uACFC\uD559\uC790"
      affiliation: "\uC624\uB85C\uB77C\uD478\uB4DC\uD14C\uD06C"
      personalitySummary: "\uC815\uD655\uB3C4\uC640 \uC7AC\uD604\uC131\uC744 \uC911\uC2DC\uD558\uB294
        \uC5F0\uAD6C\uC790\uB2E4. \uC5F0\uAD6C\uAC00 \uC2E4\uC81C \uC81C\uD488\uC774
        \uB418\uAE30\uB97C \uBC14\uB77C\uBA74\uC11C\uB3C4, \uC790\uC2E0\uC758 \uC11C\uBA85\uC774
        \uBE60\uB978 \uCD9C\uC2DC\uB97C \uC815\uB2F9\uD654\uD558\uB294 \uB370 \uC4F0\uC774\uB294
        \uC0C1\uD669\uC744 \uB450\uB824\uC6CC\uD55C\uB2E4. \uACFC\uAC70\uC758 \uCE68\uBB35\uC5D0\uB3C4
        \uCC45\uC784\uC744 \uB290\uB080\uB2E4.\n\uD589\uB3D9 \uC591\uC2DD: \uC6D0\uBCF8
        \uC2E4\uD5D8\uACFC \uBC18\uBCF5 \uAC80\uC99D\uC744 \uC694\uAD6C\uD55C\uB2E4.
        \uCD9C\uC2DC\uB97C \uB2A6\uCD94\uB294 \uBE44\uC6A9\uB3C4 \uC778\uC815\uD558\uC9C0\uB9CC,
        \uB370\uC774\uD130\uB97C \uBC14\uAFB8\uAC70\uB098 \uD55C\uACC4\uB97C \uC228\uACA8
        \uADF8 \uBE44\uC6A9\uC744 \uC904\uC774\uC9C0\uB294 \uC54A\uC73C\uB824 \uD55C\uB2E4."
      gameplayRoleSummary: "\uC5ED\uD560: \uC18D\uB3C4\uC640 \uACFC\uD559\uC801 \uC2E0\uB8B0\uC758
        \uAC08\uB4F1\uC744 \uB4DC\uB7EC\uB0B4\uB294 \uC5F0\uAD6C \uCC45\uC784\uC790.
        \uAE30\uC220\uC758 \uC0AC\uC5C5 \uAC00\uCE58\uC640 \uC5F0\uAD6C\uC790\uAC00
        \uCC45\uC784\uC9C8 \uC99D\uAC70\uB97C \uD568\uAED8 \uB530\uC9C4\uB2E4.\n\uC120\uD638:
        \uC7AC\uD604\uC131 \uAC80\uC99D, \uC2E4\uD328 \uACB0\uACFC\uC758 \uBCF4\uC874,
        \uD2B9\uD5C8 \uBC29\uC5B4, \uC5F0\uAD6C\uC790 \uCC45\uC784\uACFC \uBC1C\uD45C
        \uAD8C\uD55C\uC758 \uBA85\uD655\uD654\n\uAE30\uD53C: \uD6A8\uACFC \uACFC\uC7A5,
        \uBBF8\uC644\uC131 \uAE30\uC220\uC758 \uBB34\uB9AC\uD55C \uC0C1\uC6A9\uD654,
        \uACB0\uACFC\uC5D0 \uB9DE\uCD98 \uC2E4\uD5D8 \uC0AD\uC81C, \uBCF4\uC218\uC640
        \uB9DE\uBC14\uAFB8\uB294 \uC5F0\uAD6C \uC6D0\uBCF8 \uC720\uCD9C"
      anyEventRelationDelta:
        trust: 0
        respect: 0
        fear: 0
        hostility: 0
        dependency: 0
        interest: 0
      eventRelationBiases: []
    actionPreferences: []
  storyDesign:
    stance: 4
    personalGoal: "\uC790\uC2E0\uC758 \uC774\uB984\uC774 \uBD99\uC740 \uC5F0\uAD6C
      \uACB0\uACFC\uAC00 \uAC80\uC99D\uB41C \uBC94\uC704 \uC548\uC5D0\uC11C \uC0AC\uC6A9\uB418\uB3C4\uB85D
      \uD55C\uB2E4."
    loyaltyReason: "\uADF8\uB8F9 \uD22C\uC790\uB85C \uC7A5\uBE44\uC640 \uC5F0\uAD6C\uD300\uC744
      \uC720\uC9C0\uD588\uACE0, \uC5F0\uAD6C\uB97C \uD604\uC2E4\uC758 \uC81C\uD488\uC73C\uB85C
      \uB9CC\uB4E4 \uAE30\uD68C\uB97C \uC5BB\uC5C8\uB2E4."
    innerConflict: "\uC774\uC804 \uAC80\uC99D\uC758 \uD55C\uACC4\uB97C \uC791\uC740
      \uC8FC\uC11D\uC73C\uB85C\uB9CC \uB0A8\uAE30\uACE0 \uCD9C\uC2DC\uC5D0 \uB3D9\uC758\uD588\uB2E4.
      \uC0C8 \uD3ED\uB85C\uB294 \uC790\uAE30 \uCE68\uBB35\uC758 \uCC45\uC784\uB3C4
      \uB4DC\uB7EC\uB0B8\uB2E4."
    pressureTactics: "\uC8FC\uC778\uACF5 \uC81C\uD488\uACFC \uAE30\uC220 \uC81C\uC548\uC5D0\uB3C4
      \uC7AC\uD604 \uC2E4\uD5D8\xB7\uADDC\uACA9\xB7\uADFC\uAC70\uB97C \uC694\uAD6C\uD574
      \uBE60\uB978 \uC2DC\uC7A5 \uACF5\uB7B5\uC5D0 \uC81C\uB3D9\uC744 \uAC74\uB2E4."
    cooperationTrigger: "\uADF8\uB8F9\uC774 \uC6D0\uBCF8 \uACB0\uACFC\uB97C \uC65C\uACE1\uD558\uAC70\uB098
      \uACBD\uACE0\uB97C \uC0AD\uC81C\uD558\uB824\uB294 \uADFC\uAC70\uAC00 \uC788\uACE0,
      \uC8FC\uC778\uACF5\uC774 \uB3C5\uB9BD \uAC80\uC99D\uACFC \uC5F0\uAD6C\uD300
      \uBCF4\uD638\uB97C \uBC1B\uC544\uB4E4\uC5EC\uC57C \uD55C\uB2E4."
    requestedTerms: "\uAC80\uC99D \uBE44\uC6A9\uC758 \uC2E4\uC81C \uD655\uBCF4, \uC6D0\uBCF8\xB7\uC2E4\uD328
      \uACB0\uACFC \uBCF4\uC874, \uC5F0\uAD6C\uC790\uC758 \uCC45\uC784 \uACF5\uAC1C,
      \uBC1C\uD45C \uBC94\uC704\uC640 \uD300\uC758 \uC548\uC804."
    cooperationLimit: "\uC99D\uAC70\uC758 \uAC80\uC99D\uACFC \uC5F0\uAD6C \uBCF4\uD638\uC5D0
      \uD611\uC870\uD55C\uB2E4. \uC8FC\uC778\uACF5\uC758 \uAE30\uC220\uC774 \uAC80\uC99D\uC744
      \uBABB \uD1B5\uACFC\uD574\uB3C4 \uC9C0\uC9C0\uD558\uAC70\uB098 \uD2B9\uD5C8
      \uC18C\uC720\uAD8C\uC744 \uB300\uC2E0 \uB118\uAE30\uC9C0 \uC54A\uB294\uB2E4."
    informationScope: "\uCD9C\uC2DC \uD310\uB2E8\uC5D0 \uC0AC\uC6A9\uB41C \uC6D0\uBCF8
      \uBC18\uBCF5 \uC2E4\uD5D8\xB7\uC2E4\uD328 \uAE30\uB85D\xB7\uADF8\uB8F9\uC758
      \uC218\uC815 \uC694\uAD6C. \uBB34\uAD00\uD55C \uD2B9\uD5C8 \uC870\uC131\xB7\uC2E4\uD5D8
      \uB300\uC0C1 \uC2E0\uC6D0\uC740 \uC81C\uC678\uD55C\uB2E4."
    refusalConditions: "\uC815\uD574\uC9C4 \uACB0\uB860\uC5D0 \uB9DE\uCD98 \uAC80\uC99D,
      \uC2E4\uD328 \uACB0\uACFC \uC0AD\uC81C, \uB2E8\uC21C \uBCF4\uC218\uB9CC \uB300\uAC00\uB85C
      \uD55C \uC5F0\uAD6C \uC790\uC0B0 \uC804\uCCB4 \uC694\uAD6C."
    renewedConflict: "\uC8FC\uC778\uACF5\uC774 \uACFC\uC7A5 \uB9C8\uCF00\uD305\uC774\uB098
      \uAC80\uC99D \uC0DD\uB7B5\uC744 \uC694\uAD6C\uD558\uBA74 \uAC19\uC740 \uAE30\uC900\uC73C\uB85C
      \uACF5\uAC1C \uBC18\uB300\uD558\uACE0 \uD611\uC870\uB97C \uC911\uB2E8\uD55C\uB2E4."
    storyArc: "\uCD08\uAE30: \uC8FC\uC778\uACF5\uC758 \uC2E0\uAE30\uC220 \uC8FC\uC7A5\uB3C4
      \uC5C4\uACA9\uD558\uAC8C \uAC80\uC99D\uD55C\uB2E4.\n\uC911\uBC18: \uACFC\uAC70\uC5D0
      \uC790\uC2E0\uC774 \uB0A8\uAE34 \uC8FC\uC11D\uACFC \uADF8\uB8F9\uC758 \uC0AD\uC81C
      \uC694\uAD6C\uB97C \uB300\uBA74\uD55C\uB2E4.\n\uCD5C\uC885: \uBD88\uB9AC\uD55C
      \uC6D0\uBCF8 \uAE30\uB85D\uC73C\uB85C \uADF8\uB8F9\uC758 \uC2E0\uB8B0\uB97C
      \uAE68\uB728\uB9B4 \uC218 \uC788\uC9C0\uB9CC \uC8FC\uC778\uACF5\uC758 \uC81C\uD488\uC5D0\uB3C4
      \uB3D9\uC77C\uD55C \uAC80\uC99D\uC744 \uC694\uAD6C\uD55C\uB2E4."
