    memoryPreferences:
    - memoryType: 0
      disposition: 1
      rationale: "\uC784\uB300\uC640 \uAC1C\uBC1C \uC870\uAC74\uC758 \uC2E4\uC81C
        \uC774\uD589\uC740 \uC77C\uC815 \uC608\uCE21\uC744 \uAC00\uB2A5\uD558\uAC8C
        \uD55C\uB2E4."
      effect:
        mode: 1
        multiplier: 1.2
        affectedAxes: 3
        relationBonus:
          trust: 0
          respect: 0
          closeness: 0
    - memoryType: 1
      disposition: 2
      rationale: "\uAC1C\uBC1C\xB7\uC784\uB300 \uD569\uC758 \uC704\uBC18\uC740 \uC9C0\uC5F0\uACFC
        \uC790\uC0B0 \uC190\uC2E4\uC744 \uB9CC\uB4E0\uB2E4."
      effect:
        mode: 1
        multiplier: 1.3
        affectedAxes: 1
        relationBonus:
          trust: 0
          respect: 0
          closeness: 0
    - memoryType: 4
      disposition: 1
      rationale: "\uC0AC\uC5C5\uC758 \uC7A5\uAE30 \uAC00\uCE58\uB97C \uBCF4\uC874\uD55C
        \uD68C\uC0DD\uC5D0 \uAD00\uC2EC\uC744 \uBCF4\uC778\uB2E4."
      effect:
        mode: 1
        multiplier: 1.2
        affectedAxes: 4
        relationBonus:
          trust: 0
