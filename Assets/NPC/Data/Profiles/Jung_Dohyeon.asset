    npcId: npc-sinseong-development-ceo-jung-dohyeon
    companyId: sinseong-development
    profile:
      standingIllustration: {fileID: 0}
      dimmedStandingIllustration: {fileID: 0}
      displayName: "\uC815\uB3C4\uD604"
      role: CEO
      affiliation: "\uC2E0\uC131\uAC1C\uBC1C"
      personalitySummary: "\uD1A0\uC9C0\uC640 \uAC1C\uBC1C\uAD8C\uC758 \uD76C\uC18C\uC131\uC744
        \uC77D\uB294 \uD611\uC0C1\uAC00\uB2E4. \uB3C8\uC744 \uC22B\uC790\uB85C \uB9D0\uD558\uC9C0\uB9CC
        \uC790\uC2E0\uC774 \uC120\uD0DD\uD55C \uC785\uC9C0\uAC00 \uC2E4\uD328\uD588\uB2E4\uB294
        \uD3C9\uAC00\uC5D0\uB294 \uC9D1\uCC29\uD55C\uB2E4. \uC7A5\uAE30 \uAC00\uCE58\uC640
        \uB2E8\uAE30 \uD68C\uC218 \uC0AC\uC774\uC5D0\uC11C \uB298 \uC720\uB9AC\uD55C
        \uC124\uBA85\uC744 \uCC3E\uB294\uB2E4.\n\uD589\uB3D9 \uC591\uC2DD: \uD575\uC2EC
        \uBD80\uC9C0\uC640 \uC77C\uC815\uC744 \uC120\uC810\uD558\uACE0, \uBC18\uBC1C\uC774
        \uCEE4\uC9C0\uBA74 \uC9C0\uC5F0 \uBE44\uC6A9\uC744 \uACC4\uC0B0\uD574 \uC870\uAC74\uC744
        \uBC14\uAFBC\uB2E4. \uC2E0\uB8B0\uBCF4\uB2E4 \uBA3C\uC800 \uAD8C\uB9AC\uC640
        \uC815\uC0B0\uC758 \uC2E4\uD589 \uAC00\uB2A5\uC131\uC744 \uBB3B\uB294\uB2E4."
      gameplayRoleSummary: "\uC5ED\uD560: \uBBF8\uB798\uAC74\uC124\uC758 \uC785\uC9C0\xB7\uC785\uCC30\uC744
        \uC555\uBC15\uD558\uB294 \uC9C0\uC5ED \uACBD\uC7C1\uC790. \uC0AC\uC5C5\uBCC4
        \uACC4\uC57D\uC758 \uC0C1\uB300\uAC00 \uB2EC\uB77C\uC838\uB3C4 \uB3C5\uC790\uC801\uC778
        \uC774\uD574\uAD00\uACC4\uB294 \uC720\uC9C0\uD55C\uB2E4.\n\uC120\uD638: \uD655\uC2E4\uD55C
        \uC0AC\uC5C5\uAD8C, \uC7A5\uAE30 \uC784\uB300\uC218\uC775, \uCC45\uC784\uC774
        \uB098\uB25C \uACF5\uB3D9 \uAC1C\uBC1C, \uC774\uD589 \uAC00\uB2A5\uD55C \uC815\uC0B0
        \uC77C\uC815\n\uAE30\uD53C: \uCD9C\uAD6C \uC5C6\uB294 \uAC1C\uBC1C \uAC15\uD589,
        \uBB34\uB9AC\uD55C \uBD84\uC591, \uAD8C\uB9AC \uD655\uC778 \uC5C6\uB294 \uAD6C\uB450
        \uC57D\uC18D, \uC790\uC2E0\uC758 \uC790\uC0B0\uC744 \uBCF5\uC218\uC758 \uC18C\uBAA8\uD488\uC73C\uB85C
        \uC4F0\uB294 \uAC70\uB798"
      anyEventRelationDelta:
        trust: 0
        respect: 0
        fear: 0
        hostility: 0
        dependency: 0
        interest: 0
      eventRelationBiases: []
    actionPreferences: []
  storyDesign:
    stance: 2
    personalGoal: "\uADF8\uB8F9 \uC790\uBCF8\uC744 \uC774\uC6A9\uD558\uB418 \uB3C4\uC2DC\uC758
      \uD575\uC2EC \uC785\uC9C0\uC640 \uAC1C\uBC1C \uC8FC\uB3C4\uAD8C\uC740 \uC790\uAE30
      \uD68C\uC0AC\uC5D0 \uB0A8\uAE34\uB2E4."
    loyaltyReason: "\uB300\uD615 \uC790\uAE08\uACFC \uC0AC\uC5C5 \uC2B9\uC778 \uACBD\uB85C\uB97C
      \uC81C\uACF5\uD558\uB294 \uB3D9\uC548 \uADF8\uB8F9\uACFC \uD611\uB825\uD558\uB294
      \uD3B8\uC774 \uC218\uC775\uACFC \uC77C\uC815\uC5D0 \uC720\uB9AC\uD558\uB2E4."
    innerConflict: "\uC7A5\uAE30 \uAC00\uCE58\uB97C \uB9D0\uD558\uBA74\uC11C \uB2E8\uAE30
      \uD68C\uC218\uB97C \uC704\uD574 \uC784\uCC28\uC778\uACFC \uC124\uACC4 \uC870\uAC74\uC744
      \uC555\uBC15\uD55C \uCC45\uC784\uC774 \uC788\uB2E4."
    pressureTactics: "\uC8FC\uC778\uACF5\uC758 \uD6C4\uBCF4 \uBD80\uC9C0\xB7\uC785\uCC30\uC5D0
      \uC120\uC81C \uAC1C\uC785\uD558\uACE0 \uC778\uC811 \uAC1C\uBC1C\uAD8C\uC744
      \uBB36\uC5B4 \uC120\uD0DD\uC9C0\uB97C \uC904\uC778\uB2E4."
    cooperationTrigger: "\uADF8\uB8F9\uC774 \uC190\uC2E4\xB7\uC0AC\uC5C5 \uC9C0\uC5F0\uC744
      \uC77C\uBC29 \uC804\uAC00\uD558\uAC70\uB098 \uC57D\uC815 \uAD8C\uB9AC\uB97C
      \uCE68\uD574\uD558\uACE0, \uC8FC\uC778\uACF5\uC758 \uB300\uC548\uC774 \uAD8C\uB9AC\xB7\uD604\uAE08
      \uC591\uCABD\uC5D0\uC11C \uC2E4\uD589 \uAC00\uB2A5\uD574\uC57C \uD55C\uB2E4."
    requestedTerms: "\uC0AC\uC5C5\uAD8C \uBCF4\uC804, \uC120\uC9C0\uAE09 \uB610\uB294
      \uB2F4\uBCF4, \uAE30\uC874 \uC758\uBB34\uC758 \uC815\uC0B0, \uC0C8 \uAC1C\uBC1C
      \uC774\uC775\uC758 \uBAAB\uACFC \uC9C0\uC5ED \uD569\uC758 \uBE44\uC6A9."
    cooperationLimit: "\uD55C \uD504\uB85C\uC81D\uD2B8\uC5D0\uC11C \uADF8\uB8F9\uC744
      \uBC30\uC2E0\uD560 \uC218 \uC788\uC73C\uB098 \uC2E0\uC131\uC758 \uC785\uC9C0\uC640
      \uAD8C\uB9AC\uB97C \uBB34\uC0C1\uC73C\uB85C \uC8FC\uAC70\uB098 \uC8FC\uC778\uACF5\uC758
      \uBAA8\uB4E0 \uAC1C\uBC1C\uC5D0 \uC591\uBCF4\uD558\uC9C0 \uC54A\uB294\uB2E4."
    informationScope: "\uACF5\uB3D9\uC0AC\uC5C5\uC5D0\uC11C \uC5BB\uC740 \uADF8\uB8F9\uC758
      \uBE44\uACF5\uAC1C \uC785\uCC30 \uAE30\uC900\xB7\uC6B0\uC120 \uBD80\uC9C0\xB7\uC77C\uC815
      \uBCC0\uACBD \uC790\uB8CC. \uC81C\uACF5 \uC2DC \uC790\uC2E0\uC758 \uACC4\uC57D
      \uC704\uBC18 \uCC45\uC784\uB3C4 \uAC70\uB798 \uBE44\uC6A9\uC774 \uB41C\uB2E4."
    refusalConditions: "\uAC1C\uBC1C\uAD8C \uC77C\uAD04 \uD3EC\uAE30, \uC9C0\uC5ED
      \uBC18\uBC1C\uC744 \uC804\uBD80 \uC2E0\uC131 \uD0D3\uC73C\uB85C \uB3CC\uB9AC\uB294
      \uACC4\uC57D, \uC815\uC0B0 \uC7AC\uC6D0 \uC5C6\uB294 \uD638\uC758."
    renewedConflict: "\uC8FC\uC778\uACF5\uC774 \uAC19\uC740 \uD575\uC2EC \uBD80\uC9C0\uB97C
      \uB178\uB9AC\uAC70\uB098 \uD569\uC758 \uC774\uC775\uC744 \uC904\uC774\uBA74
      \uB2E4\uC2DC \uC785\uCC30 \uACBD\uC7C1\uACFC \uC0AC\uC5C5\uAD8C \uBC29\uC5B4\uC5D0
      \uB098\uC120\uB2E4."
    storyArc: "\uCD08\uAE30: \uBBF8\uB798\uAC74\uC124\uC758 \uD655\uC7A5 \uD6C4\uBCF4\uC9C0\uB97C
      \uC120\uC810\uD55C\uB2E4.\n\uC911\uBC18: \uADF8\uB8F9\uACFC \uACF5\uB3D9\uC0AC\uC5C5\uC758
      \uCC45\uC784\xB7\uC774\uC775 \uBC30\uBD84\uC774 \uAC08\uB77C\uC9C4\uB2E4.\n\uCD5C\uC885:
      \uBE44\uACF5\uAC1C \uAC1C\uBC1C \uC815\uBCF4\uB97C \uC81C\uACF5\uD560 \uC218
      \uC788\uC9C0\uB9CC \uD575\uC2EC \uC785\uC9C0\uB97C \uB458\uB7EC\uC2FC \uB2E4\uC74C
      \uACBD\uC7C1\uC744 \uB0A8\uAE34\uB2E4."
