      disposition: 2
      rationale: "\uBB34\uCC28\uBCC4 \uAC10\uCD95\uC73C\uB85C \uC0DD\uC0B0 \uC870\uC9C1\uC758
        \uADDC\uBAA8\uC640 \uC5ED\uB7C9\uC774 \uD6FC\uC190\uB418\uB294 \uAC83\uC744
