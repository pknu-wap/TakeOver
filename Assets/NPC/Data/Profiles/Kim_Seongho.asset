    npcId: npc-daeseong-industry-ceo-kim-seongho
    companyId: daeseong-industry
    profile:
      standingIllustration: {fileID: 0}
      dimmedStandingIllustration: {fileID: 0}
      displayName: "\uAE40\uC131\uD638"
      role: CEO
      affiliation: "\uB300\uC131\uC0B0\uC5C5"
      personalitySummary: "\uB300\uAE30\uC5C5 \uC870\uC9C1\uC758 \uADDC\uBAA8\uC640
        \uC0DD\uC0B0 \uB2A5\uB825\uC744 \uC2E0\uB150\uC73C\uB85C \uC0BC\uB294\uB2E4.
        \uC9C1\uC6D0\uACFC \uACF5\uAE09\uB9DD\uC744 \uC9C0\uD0A8\uB2E4\uB294 \uCC45\uC784\uAC10\uC774
        \uAC15\uD558\uC9C0\uB9CC, \uADF8 \uCC45\uC784\uC744 \uC774\uC720\uB85C \uC790\uAE30
        \uBC29\uC2DD\uACFC \uADF8\uB8F9\uC758 \uC601\uD5A5\uB825\uC744 \uBD84\uB9AC\uD558\uC9C0
        \uBABB\uD55C\uB2E4.\n\uD589\uB3D9 \uC591\uC2DD: \uC7A5\uAE30 \uC218\uC8FC\xB7\uACC4\uC5F4\uC0AC
        \uC5F0\uB300\xB7\uD1B5\uD569 \uC0DD\uC0B0\uC73C\uB85C \uB9DE\uC120\uB2E4.
        \uC0C1\uB300\uC758 \uC6B4\uC601 \uB2A5\uB825\uC740 \uC778\uC815\uD574\uB3C4
        \uC870\uC9C1\uC744 \uCABC\uAC1C\uB294 \uC81C\uC548\uC5D0\uB294 \uD611\uC0C1
        \uC5EC\uC9C0\uB97C \uC881\uD78C\uB2E4."
      gameplayRoleSummary: "\uC5ED\uD560: \uADF8\uB8F9 \uC81C\uC870 \uAE30\uBC18\uC744
        \uBC29\uC5B4\uD558\uB294 \uB300\uD615 \uC778\uC218\uC804 \uC0C1\uB300. \uC8FC\uC778\uACF5\uC5D0\uAC8C
        \uD68C\uC0AC\uB97C \uC0B0 \uB4A4 \uC6B4\uC601\uD560 \uCC45\uC784\uC744 \uBB3B\uB294\uB2E4.\n\uC120\uD638:
        \uC7A5\uAE30 \uACF5\uAE09 \uACC4\uC57D, \uC0DD\uC0B0\uC2DC\uC124\uC758 \uC5F0\uC18D\uC131,
        \uCC45\uC784 \uC788\uB294 \uD1B5\uD569 \uC6B4\uC601, \uACBD\uC7C1\uC790\uC758
        \uC2E4\uB825 \uC788\uB294 \uC815\uBA74 \uC81C\uC548\n\uAE30\uD53C: \uC0AC\uC5C5\uBD80
        \uBD84\uD574, \uD575\uC2EC \uC2DC\uC124 \uB2F4\uBCF4 \uCC98\uBD84, \uC870\uC9C1\uC744
        \uBCF4\uC218\uC640 \uBC14\uAFB8\uB77C\uB294 \uC81C\uC548, \uD68C\uC0AC\uC758
        \uC5ED\uC0AC\uB97C \uC870\uB871\uD558\uB294 \uD0DC\uB3C4"
      anyEventRelationDelta:
        trust: 0
        respect: 0
        fear: 0
        hostility: 0
        dependency: 0
        interest: 0
      eventRelationBiases: []
    actionPreferences: []
  storyDesign:
    stance: 1
    personalGoal: "\uC790\uC2E0\uC774 \uC9C0\uCF1C \uC628 \uC0DD\uC0B0 \uC870\uC9C1\uACFC
      \uACF5\uAE09\uB9DD\uC744 \uB2E4\uC74C \uC138\uB300\uC5D0\uB3C4 \uD55C \uB369\uC5B4\uB9AC\uB85C
      \uB0A8\uAE34\uB2E4."
    loyaltyReason: "\uADF8\uB8F9 \uC790\uBCF8\uACFC \uC218\uC8FC\uB9DD\uC774 \uACF5\uC7A5\uC744
      \uC9C0\uCF30\uB2E4\uACE0 \uBBFF\uACE0, \uADF8 \uC5F0\uB300\uB97C \uB04A\uB294
      \uC77C\uC774 \uC790\uAE30 \uACBD\uC601\uC758 \uBD80\uC815\uC774\uB77C\uACE0
      \uC5EC\uAE34\uB2E4."
    innerConflict: "\uC9C1\uC6D0 \uBCF4\uD638\uB97C \uB9D0\uD558\uBA74\uC11C\uB3C4
      \uACFC\uB3C4\uD55C \uD1B5\uD569\uACFC \uC5F0\uB300 \uBCF4\uC99D\uC744 \uBC1B\uC544\uB4E4\uC600\uB2E4.
      \uBCF4\uD638\uD574\uC57C \uD560 \uC0AC\uB78C\uACFC \uC9C0\uD0A4\uB824\uB294
      \uAD8C\uB825\uC774 \uCDA9\uB3CC\uD55C\uB2E4."
    pressureTactics: "\uACC4\uC5F4 \uC9C0\uBD84 \uC5F0\uB300\xB7\uC7A5\uAE30 \uACF5\uAE09\uACC4\uC57D\xB7\uC2DC\uC124
      \uD22C\uC790\uB85C \uC8FC\uC778\uACF5\uC758 \uC778\uC218\uC640 \uC6B4\uC601
      \uAE30\uBC18\uC744 \uB3D9\uC2DC\uC5D0 \uC555\uBC15\uD55C\uB2E4."
    cooperationTrigger: "\uB0A9\uD488\xB7\uC548\uC804\xB7\uACE0\uC6A9 \uD53C\uD574\uB97C
      \uC904\uC774\uB294 \uC81C\uD55C \uD611\uC758\uC640 \uC11C\uB85C\uC5D0\uAC8C
      \uD544\uC694\uD55C \uACF5\uB3D9 \uC218\uC8FC\uB9CC \uAC80\uD1A0\uD55C\uB2E4."
    requestedTerms: "\uACC4\uC57D \uC774\uD589, \uC0DD\uC0B0 \uC5F0\uC18D\uC131,
      \uC778\uB825 \uC2B9\uACC4, \uD611\uC758 \uBC94\uC704\uB97C \uB118\uB294 \uC815\uBCF4
      \uC694\uAD6C \uAE08\uC9C0."
    cooperationLimit: "\uADF8\uB8F9\uC744 \uBC30\uC2E0\uD558\uAC70\uB098 \uC8FC\uC778\uACF5\uC758
      \uCD5C\uC885 \uC778\uC218\uC5D0 \uD45C\uB97C \uBCF4\uD0DC\uC9C0 \uC54A\uB294\uB2E4.
      \uC81C\uD55C \uD734\uC804 \uD6C4\uC5D0\uB3C4 \uCD5C\uC885\uAE4C\uC9C0 \uC801\uB300
      \uC9C4\uC601\uC758 \uB300\uD45C\uB85C \uB0A8\uB294\uB2E4."
    informationScope: "\uD611\uC758 \uB300\uC0C1 \uC2DC\uC124\uC758 \uC6B4\uC601\xB7\uB0A9\uD488
      \uAC80\uC99D \uC790\uB8CC\uB9CC \uC81C\uACF5\uD55C\uB2E4. \uADF8\uB8F9\uC758
      \uC9C0\uBD84 \uBC29\uC5B4 \uACC4\uD68D\uACFC \uBE44\uACF5\uAC1C \uC778\uC218
      \uAC00\uACA9\uC740 \uB118\uAE30\uC9C0 \uC54A\uB294\uB2E4."
    refusalConditions: "\uAC1C\uC778 \uC9C0\uBD84\xB7\uBCF4\uC218\uB85C \uC9C4\uC601\uC744
      \uBC14\uAFB8\uB77C\uB294 \uC81C\uC548, \uB300\uC131\uC758 \uBD84\uD560\uC744
      \uC804\uC81C\uB85C \uD55C \uAD6C\uC81C, \uC9C1\uC6D0 \uBCF4\uD638\uB97C \uBA85\uBD84\uC73C\uB85C
      \uD55C \uC2DC\uC124 \uCC98\uBD84."
    renewedConflict: "\uD734\uC804 \uC0C1\uB300\uAC00 \uACF5\uAE09\uB9DD\uC744 \uBD84\uB9AC\uD558\uAC70\uB098
      \uC778\uB825\uC744 \uB2F4\uBCF4\uB85C \uD611\uBC15\uD558\uBA74 \uC989\uC2DC
      \uC5F0\uB300\uB97C \uBCF5\uAD6C\uD574 \uAC15\uD558\uAC8C \uB9DE\uC120\uB2E4."
    storyArc: "\uCD08\uAE30: \uACF5\uAE09\uACC4\uC57D \uC120\uC810\uC73C\uB85C \uC8FC\uC778\uACF5\uC758
      \uD655\uC7A5\uC744 \uB9C9\uB294\uB2E4.\n\uC911\uBC18: \uC790\uAE30 \uD1B5\uD569
      \uC815\uCC45\uC758 \uBE44\uC6A9\uC744 \uC778\uC815\uD558\uBA74\uC11C\uB3C4
      \uC870\uC9C1 \uD574\uCCB4\uC5D0\uB294 \uBC18\uB300\uD55C\uB2E4.\n\uCD5C\uC885:
      \uC8FC\uC778\uACF5\uC758 \uC2E4\uB825\uC744 \uC778\uC815\uD558\uB294 \uB300\uC0AC\uC640
      \uBCC4\uAC1C\uB85C \uB05D\uAE4C\uC9C0 \uADF8\uB8F9 \uC9C0\uBD84 \uBC29\uC5B4\uB97C
      \uC774\uB048\uB2E4."
