    - memoryType: 4
      disposition: 1
      rationale: "\uC0DD\uC0B0 \uAE30\uBC18\uC744 \uBCF4\uC874\uD55C \uAE30\uC5C5
        \uD68C\uC0DD\uC740 \uADDC\uBAA8 \uC720\uC9C0\uC5D0 \uAE30\uC5EC\uD55C\uB2E4."
