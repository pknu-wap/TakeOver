    - memoryType: 1
      disposition: 2
      rationale: "\uC228\uACA8\uC9C4 \uBD80\uCC44\uC640 \uACC4\uC57D \uC704\uBC18\uC740
        \uC704\uD5D8 \uD1B5\uC81C\uC758 \uC804\uC81C\uB97C \uBB34\uB108\uB728\uB9B0\uB2E4."
