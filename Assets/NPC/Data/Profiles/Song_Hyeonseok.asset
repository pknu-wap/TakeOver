    npcId: npc-polaris-finance-risk-director-song-hyeonseok
    companyId: polaris-finance
    profile:
      standingIllustration: {fileID: 0}
      dimmedStandingIllustration: {fileID: 0}
      displayName: "\uC1A1\uD604\uC11D"
      role: "\uB9AC\uC2A4\uD06C\uAD00\uB9AC\uCC45\uC784\uC790"
      affiliation: "\uD3F4\uB77C\uB9AC\uC2A4\uD30C\uC774\uB0B8\uC2A4"
      personalitySummary: "\uC870\uC6A9\uD558\uACE0 \uBCF4\uC218\uC801\uC774\uBA70
        \uCD5C\uC545\uC758 \uC190\uC2E4\uBD80\uD130 \uACC4\uC0B0\uD55C\uB2E4. \uC22B\uC790\uB85C
        \uCC45\uC784\uC744 \uB2E4\uD55C\uB2E4\uACE0 \uBBFF\uC9C0\uB9CC, \uC704\uD5D8\uC744
        \uC54C\uBA74\uC11C\uB3C4 \uBCF4\uACE0\uC11C\uC758 \uD45C\uD604\uC744 \uC644\uD654\uD588\uB358
        \uC790\uC2E0\uC744 \uC27D\uAC8C \uC6A9\uC11C\uD558\uC9C0 \uBABB\uD55C\uB2E4.\n\uD589\uB3D9
        \uC591\uC2DD: \uACC4\uC57D\uC758 \uC2E4\uD328 \uC0C1\uD669\uC744 \uBA3C\uC800
        \uBB3B\uACE0 \uC790\uB8CC\uB97C \uAD50\uCC28 \uAC80\uC99D\uD55C\uB2E4. CEO\uAC00
        \uC2B9\uC778\uD55C \uAC70\uB798\uB77C\uB3C4 \uBD80\uCC44\xB7\uB2F4\uBCF4
        \uC124\uBA85\uC774 \uB9DE\uC9C0 \uC54A\uC73C\uBA74 \uC9D1\uD589\uC744 \uB9C9\uB294\uB2E4."
      gameplayRoleSummary: "\uC5ED\uD560: \uC778\uC218 \uAE08\uC735\uC758 \uC9D1\uD589
        \uC5EC\uBD80\uC640 \uC190\uC2E4 \uAC80\uC99D\uC744 \uB2F4\uB2F9\uD55C\uB2E4.
        \uC124\uB4DD\uC758 \uAE30\uC900\uC740 \uCE5C\uBD84\uBCF4\uB2E4 \uC790\uB8CC\uC758
        \uC7AC\uD604\uC131\uACFC \uC608\uCE21 \uAC00\uB2A5\uC131\uC774\uB2E4.\n\uC120\uD638:
        \uCD94\uC801 \uAC00\uB2A5\uD55C \uD604\uAE08 \uD750\uB984, \uB2F4\uBCF4 \uAC00\uCE58
        \uAC80\uC99D, \uC190\uC2E4 \uD55C\uB3C4, \uBD88\uB9AC\uD55C \uC815\uBCF4\uC758
        \uC790\uBC1C\uC801 \uACF5\uAC1C\n\uAE30\uD53C: \uC228\uACA8\uC9C4 \uBD80\uCC44,
        \uCD9C\uCC98 \uBD88\uBA85 \uC815\uBCF4, \uD2B9\uC815 \uACE0\uAC1D \uC9D1\uC911,
        \uAC80\uD1A0\uC790\uB97C \uC555\uBC15\uD558\uB294 \uAD6C\uB450 \uC9C0\uC2DC"
      anyEventRelationDelta:
        trust: 0
        respect: 0
        fear: 0
        hostility: 0
        dependency: 0
        interest: 0
      eventRelationBiases: []
    actionPreferences: []
  storyDesign:
    stance: 3
    personalGoal: "\uD3F4\uB77C\uB9AC\uC2A4\uAC00 \uC790\uC2E0\uC774 \uACBD\uACE0\uD588\uB358
      \uC704\uD5D8 \uB54C\uBB38\uC5D0 \uBB34\uB108\uC9C0\uB294 \uC77C\uC744 \uB9C9\uACE0,
      \uC704\uD5D8 \uBCF4\uACE0\uC11C\uAC00 \uD615\uC2DD\uC774 \uB418\uB294 \uAD00\uD589\uC744
      \uB05D\uB0B8\uB2E4."
    loyaltyReason: "\uADF8\uB8F9 \uAC70\uB798\uAC00 \uC81C\uACF5\uD558\uB294 \uC548\uC815\uC131\uC744
      \uC778\uC815\uD558\uACE0, \uD3F4\uB77C\uB9AC\uC2A4\uC758 \uC608\uAE08\xB7\uD22C\uC790
      \uC790\uBCF8\uC744 \uC9C0\uD0A4\uB294 \uCC45\uC784\uC744 \uC18C\uC18D\uC758
      \uC774\uC720\uB85C \uC0BC\uB294\uB2E4."
    innerConflict: "\uAC70\uB798\uB97C \uB9C9\uC744 \uAD8C\uD55C\uC740 \uC788\uC9C0\uB9CC
      \uC2B9\uC9C4\uACFC \uC870\uC9C1 \uC548\uC815\uC744 \uC704\uD574 \uACBD\uACE0\uB97C
      \uC644\uD654\uD55C \uC801\uC774 \uC788\uB2E4. \uC678\uBD80\uC758 \uC815\uC758\uB85C\uC6B4
      \uC2EC\uD310\uC790\uCC98\uB7FC \uD589\uB3D9\uD560 \uC218 \uC5C6\uB2E4."
    pressureTactics: "\uC8FC\uC778\uACF5\uC758 \uC790\uAE08 \uACC4\uD68D\uC5D0 \uC2A4\uD2B8\uB808\uC2A4
      \uC870\uAC74\uC744 \uC694\uAD6C\uD558\uACE0 \uBD88\uD655\uC2E4\uD55C \uCC28\uC785\uC758
      \uC2B9\uC778\uC744 \uC9C0\uC5F0\uD55C\uB2E4."
    cooperationTrigger: "\uADF8\uB8F9 \uC704\uD5D8\uC774 \uC790\uC2E0\uC758 \uAC80\uC99D
      \uC790\uB8CC\uC640 \uC77C\uCE58\uD558\uACE0, \uC8FC\uC778\uACF5\uC774 \uBD88\uB9AC\uD55C
      \uBD80\uCC44\uAE4C\uC9C0 \uACF5\uAC1C\uD574 \uC190\uC2E4 \uCD95\uC18C\uC548\uC744
      \uC81C\uC2DC\uD574\uC57C \uD55C\uB2E4."
    requestedTerms: "\uB3C5\uB9BD \uAC80\uC99D, \uC790\uB8CC \uC0AC\uC6A9 \uBC94\uC704,
      \uACE0\uAC1D \uBE44\uC2DD\uBCC4\uD654, \uC2E4\uC81C \uC704\uD5D8 \uCD95\uC18C
      \uC808\uCC28\uC640 \uAC80\uD1A0 \uAE30\uB85D\uC758 \uBCF4\uC874."
    cooperationLimit: "\uC9C1\uBB34\uC0C1 \uAC80\uC99D\uACFC \uC704\uD5D8 \uCD95\uC18C\uC5D0\uB9CC
      \uD611\uC870\uD55C\uB2E4. \uADF8\uB8F9 \uB9E4\uAC01 \uC791\uC804\uC758 \uB0B4\uBD80\uC790\uAC00
      \uB418\uAC70\uB098 \uB300\uD45C\uC758 \uC9C0\uC2DC\uB97C \uB300\uC2E0 \uACB0\uC815\uD558\uC9C0
      \uC54A\uB294\uB2E4."
    informationScope: "\uD5C8\uAC00\uB41C \uB370\uC774\uD130\uB8F8\uC758 \uAC80\uC99D
      \uACB0\uACFC\xB7\uB2F4\uBCF4 \uBD80\uC871 \uADFC\uAC70\xB7\uC704\uD5D8 \uD3C9\uAC00
      \uAE30\uB85D. \uACE0\uAC1D \uC2DD\uBCC4 \uC815\uBCF4\uC640 \uBE44\uBC00 \uC785\uCC30\uAC00\uB294
      \uC81C\uACF5\uD558\uC9C0 \uC54A\uB294\uB2E4."
    refusalConditions: "\uBD88\uB9AC\uD55C \uC790\uB8CC \uC0AD\uC81C, \uACE0\uAC1D
      \uC2E0\uC6D0 \uD310\uB9E4, \uACB0\uB860\uC744 \uBA3C\uC800 \uC815\uD574 \uB454
      \uC2E4\uC0AC, \uD615\uC2DD\uC801\uC778 \uBA74\uCC45\uB9CC \uB0B4\uC138\uC6B0\uB294
      \uAC70\uB798."
    renewedConflict: "\uC8FC\uC778\uACF5\uC774 \uC790\uB8CC\uB97C \uC120\uB3D9\uC5D0
      \uC774\uC6A9\uD558\uAC70\uB098 \uC704\uD5D8\uC744 \uC228\uACA8 \uAC70\uB798\uB97C
      \uD655\uB300\uD558\uBA74 \uC989\uC2DC \uC2EC\uC0AC \uAC70\uC808\uB85C \uB3CC\uC544\uC120\uB2E4."
    storyArc: "\uCD08\uAE30: \uC8FC\uC778\uACF5\uC758 \uCC28\uC785 \uACC4\uD68D\uC744
      \uBC18\uB824\uD55C\uB2E4.\n\uC911\uBC18: \uC790\uC2E0\uC758 \uC644\uD654 \uBCF4\uACE0\uC11C\uC640
      \uADF8\uB8F9\uC758 \uC2E4\uC81C \uC704\uD5D8\uC774 \uCDA9\uB3CC\uD55C\uB2E4.\n\uCD5C\uC885:
      \uC704\uD5D8 \uC790\uB8CC\uB97C \uAC80\uC99D\uD560 \uC218 \uC788\uC9C0\uB9CC
      \uAC70\uB798 \uC870\uAC74\uC744 \uCDA9\uC871\uD558\uC9C0 \uBABB\uD558\uBA74
      \uB05D\uAE4C\uC9C0 \uC9D1\uD589\uC744 \uB9C9\uB294\uB2E4."
