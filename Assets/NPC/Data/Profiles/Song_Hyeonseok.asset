      rationale: "\uCD9C\uCC98 \uBD88\uBA85\uC758 \uAE08\uC735 \uC815\uBCF4\uB294
        \uBC95\uC801 \uC704\uD5D8\uACFC \uC608\uCE21 \uBD88\uAC00\uB2A5\uC131\uC744
        \uB192\uC778\uB2E4."
      effect:
        mode: 1
        multiplier: 1.35
        affectedAxes: 1
        relationBonus:
