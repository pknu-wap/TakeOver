    memoryPreferences:
    - memoryType: 0
      disposition: 1
      rationale: "\uC77C\uC815\uACFC \uC870\uAC74\uC744 \uC9C0\uD0A4\uB294 \uAC70\uB798
        \uC0C1\uB300\uB294 \uC704\uD5D8\uC744 \uC608\uCE21\uD558\uAE30 \uC27D\uB2E4."
      effect:
        mode: 1
        multiplier: 1.2
        affectedAxes: 3
        relationBonus:
          trust: 0
          respect: 0
          closeness: 0
    - memoryType: 1
      disposition: 2
      rationale: "\uC228\uACA8\uC9C4 \uBD80\uCC44\uC640 \uACC4\uC57D \uC704\uBC18\uC740
        \uC704\uD5D8 \uD1B5\uC81C\uC758 \uC804\uC81C\uB97C \uBB34\uB108\uB728\uB9B0\uB2E4."
      effect:
        mode: 1
        multiplier: 1.4
        affectedAxes: 1
        relationBonus:
          trust: 0
