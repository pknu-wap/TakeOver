      eventRelationBiases:
      - memoryType: 0
        relationDelta: {trust: 2, respect: 1, fear: 0, hostility: 0, dependency: 0, interest: 0}
      - memoryType: 1
        relationDelta: {trust: -2, respect: 0, fear: 0, hostility: 2, dependency: 0, interest: 0}
      - memoryType: 2
