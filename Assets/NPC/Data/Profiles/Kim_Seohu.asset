    npcId: npc-aurora-foodtech-ceo-kim-seohu
    companyId: aurora-foodtech
    profile:
      standingIllustration: {fileID: 0}
      dimmedStandingIllustration: {fileID: 0}
      displayName: "\uAE40\uC11C\uD6C4"
      role: CEO
      affiliation: "\uC624\uB85C\uB77C\uD478\uB4DC\uD14C\uD06C"
      personalitySummary: "\uB099\uAD00\uC801\uC774\uACE0 \uC0AC\uB78C\uC744 \uC6C0\uC9C1\uC774\uB294
        \uD798\uC774 \uC788\uB2E4. \uD68C\uC0AC\uB97C \uC0B4\uB9AC\uB294 \uAC83\uC740
        \uC18D\uB3C4\uB77C\uACE0 \uBBFF\uC9C0\uB9CC, \uBA48\uCD94\uB294 \uC21C\uAC04
        \uC790\uC2E0\uC774 \uD2C0\uB838\uB2E4\uB294 \uD3C9\uAC00\uB97C \uBC1B\uC744\uAE4C
        \uB450\uB824\uC6CC\uD55C\uB2E4. \uADF8\uB8F9\uC758 \uC9C0\uC6D0\uC744 \uC0DD\uC874\uC758
        \uC740\uD61C\uC774\uC790 \uC790\uC2E0\uC758 \uD1B5\uC81C\uAD8C\uC73C\uB85C
        \uC5EC\uAE34\uB2E4.\n\uD589\uB3D9 \uC591\uC2DD: \uCD9C\uC2DC\xB7\uD2B9\uD5C8\xB7\uC120\uAD6C\uB9E4\uACC4\uC57D\uC744
        \uB3D9\uC2DC\uC5D0 \uBC00\uC5B4\uBD99\uC778\uB2E4. \uAE30\uC220 \uC9C0\uC801\uC744
        \uBB34\uC2DC\uD558\uB294 \uCC99\uD558\uB2E4\uAC00\uB3C4 \uAC80\uC99D\uB41C
        \uC2E4\uD328\uB294 \uC228\uAE30\uAE30\uBCF4\uB2E4 \uB2E4\uC74C \uC77C\uC815\uC73C\uB85C
        \uD761\uC218\uD558\uB824 \uD55C\uB2E4."
      gameplayRoleSummary: "\uC5ED\uD560: \uADF8\uB8F9\uC758 \uAE30\uC220\xB7\uC2E0\uC81C\uD488
        \uC804\uC120\uC744 \uC774\uB044\uB294 \uACBD\uC7C1 \uCC3D\uC5C5\uC790. \uBE60\uB978
        \uC2DC\uC7A5 \uC9C4\uC785\uC758 \uD604\uC2E4\uC801 \uC774\uC775\uACFC \uAC80\uC99D\uC744
        \uBBF8\uB8E8\uB294 \uBE44\uC6A9\uC744 \uB3D9\uC2DC\uC5D0 \uBCF4\uC5EC\uC900\uB2E4.\n\uC120\uD638:
        \uC9D1\uD589\uB418\uB294 \uC131\uC7A5 \uC790\uAE08, \uD655\uC2E4\uD55C \uC720\uD1B5
        \uCC3D\uAD6C, \uBE60\uB978 \uAC80\uC99D\uACFC \uCD9C\uC2DC\uC758 \uC5F0\uACB0,
        \uCC3D\uC5C5\uC790\uC758 \uC0AC\uC5C5 \uC8FC\uB3C4\uAD8C\n\uAE30\uD53C: \uBB34\uAE30\uD55C
        \uC2B9\uC778 \uC9C0\uC5F0, \uAE30\uC220\uC744 \uD1B5\uC9F8\uB85C \uB118\uAE30\uB294
        \uD22C\uC790, \uAC1C\uC778 \uBCF4\uC218\uB85C \uD68C\uC0AC\uC758 \uC9C4\uC601\uC744
        \uBC14\uAFB8\uB77C\uB294 \uC81C\uC548"
      anyEventRelationDelta:
        trust: 0
        respect: 0
        fear: 0
        hostility: 0
        dependency: 0
        interest: 0
      eventRelationBiases: []
    actionPreferences: []
  storyDesign:
    stance: 1
    personalGoal: "\uC790\uC2E0\uC758 \uAE30\uC220\uC744 \uD2C8\uC0C8 \uC2E4\uD5D8\uC774
      \uC544\uB2C8\uB77C \uC2E4\uC81C \uC2DC\uC7A5\uC744 \uBC14\uAFB8\uB294 \uC81C\uD488\uC73C\uB85C
      \uB9CC\uB4E0\uB2E4."
    loyaltyReason: "\uADF8\uB8F9\uC774 \uC2E4\uD328 \uAC00\uB2A5\uC131\uC774 \uD070
      \uC2DC\uAE30\uC5D0 \uC790\uAE08\uACFC \uD310\uB85C\uB97C \uC81C\uACF5\uD588\uB2E4\uACE0
      \uBBFF\uC73C\uBA70, \uADF8 \uC548\uC5D0\uC11C \uCC3D\uC5C5\uC790 \uC8FC\uB3C4\uAD8C\uC744
      \uC9C0\uD0AC \uC218 \uC788\uB2E4\uACE0 \uC0DD\uAC01\uD55C\uB2E4."
    innerConflict: "\uB3C5\uC790\uC801\uC778 \uD601\uC2E0\uC744 \uB9D0\uD558\uBA74\uC11C
      \uADF8\uB8F9 \uC758\uC874\uC744 \uD0A4\uC6E0\uACE0, \uC2E4\uD328 \uC778\uC815\uC774
      \uD1B5\uC81C\uAD8C \uC0C1\uC2E4\uB85C \uC774\uC5B4\uC9C8\uAE4C \uB450\uB824\uC6CC\uD55C\uB2E4."
    pressureTactics: "\uADF8\uB8F9\uC758 \uC790\uAE08\xB7\uD310\uB9E4\uB9DD\uC73C\uB85C
      \uD2B9\uD5C8\xB7\uC120\uAD6C\uB9E4\xB7\uCD9C\uC2DC\uB97C \uC120\uC810\uD574
      \uD558\uB298\uC2DD\uD488\uC758 \uC2E0\uC2DC\uC7A5 \uC9C4\uC785\uC744 \uB9C9\uB294\uB2E4."
    cooperationTrigger: "\uAE30\uC220 \uAC80\uC99D\xB7\uADDC\uACA9\xB7\uAC1C\uBCC4
      \uB77C\uC774\uC120\uC2A4\uCC98\uB7FC \uD68C\uC0AC\uC758 \uC7A5\uAE30 \uAC00\uCE58\uB97C
      \uB192\uC774\uB294 \uD55C\uC815 \uD611\uC758\uB9CC \uAC80\uD1A0\uD55C\uB2E4."
    requestedTerms: "\uAE30\uC220 \uC18C\uC720\uAD8C\uACFC \uCC3D\uC5C5\uC790 \uC5ED\uD560
      \uBCF4\uC804, \uD604\uC2E4\uC801\uC778 \uAC80\uC99D \uAE30\uD55C, \uACC4\uC57D
      \uBC94\uC704\uAC00 \uBD84\uBA85\uD55C \uC0C1\uC6A9\uD654 \uB300\uAC00."
    cooperationLimit: "\uC5F0\uAD6C \uC9C0\uC801\uC744 \uBC1B\uC544\uB4E4\uC774\uAC70\uB098
      \uCD9C\uC2DC\uB97C \uACE0\uCCD0\uB3C4 \uCD5C\uC885\uAE4C\uC9C0 \uADF8\uB8F9
      \uCE21\uC5D0 \uB0A8\uB294\uB2E4. \uB354 \uB192\uC740 \uAC1C\uC778 \uBCF4\uC218\uB85C
      \uC8FC\uC778\uACF5 \uD3B8\uC774 \uB418\uC9C0 \uC54A\uB294\uB2E4."
    informationScope: "\uD569\uC758\uB41C \uAC80\uC99D\xB7\uADDC\uACA9\xB7\uC0C1\uC6A9\uD654
      \uC77C\uC815. \uADF8\uB8F9\uC758 \uD22C\uC790 \uC791\uC804, \uD575\uC2EC \uD2B9\uD5C8
      \uC6D0\uBCF8\uACFC \uC5F0\uAD6C \uC778\uB825\uC758 \uC0AC\uC801 \uC790\uB8CC\uB294
      \uC81C\uACF5\uD558\uC9C0 \uC54A\uB294\uB2E4."
    refusalConditions: "\uC9C0\uBD84\xB7\uD2B9\uD5C8\uB97C \uBAA8\uB450 \uB118\uAE34\uB2E4\uB294
      \uC804\uC81C\uC758 \uAD6C\uC81C, \uC790\uC2E0\uC744 \uC81C\uC678\uD55C \uC5F0\uAD6C\uD300
      \uC77C\uAD04 \uC778\uC218, \uC2DC\uAC04 \uC81C\uC57D \uC5C6\uB294 \uAC80\uD1A0."
    renewedConflict: "\uAC80\uC99D \uD611\uC758\uAC00 \uB05D\uB098\uBA74 \uCD9C\uC2DC\xB7\uD2B9\uD5C8
      \uACBD\uC7C1\uC73C\uB85C \uBCF5\uADC0\uD55C\uB2E4. \uC8FC\uC778\uACF5\uC774
      \uC5F0\uAD6C\uB97C \uC9C0\uC5F0 \uC218\uB2E8\uC73C\uB85C \uC4F0\uBA74 \uB354
      \uAC15\uACBD\uD574\uC9C4\uB2E4."
    storyArc: "\uCD08\uAE30: \uC120\uCD9C\uC2DC\uB85C \uC8FC\uC778\uACF5\uC758 \uC2DC\uC7A5\uC744
      \uC881\uD78C\uB2E4.\n\uC911\uBC18: \uAC80\uC99D\uC758 \uBD80\uC871\uACFC \uC790\uC2E0\uC758
      \uADF8\uB8F9 \uC758\uC874\uC744 \uB9C8\uC8FC\uD55C\uB2E4.\n\uCD5C\uC885: \uD544\uC694\uD55C
      \uAE30\uC220 \uC218\uC815\uC744 \uC778\uC815\uD558\uBA74\uC11C\uB3C4 \uADF8\uB8F9\uC758
      \uC2E0\uC0AC\uC5C5 \uC804\uC120\uC744 \uB9C8\uC9C0\uB9C9\uAE4C\uC9C0 \uBC29\uC5B4\uD55C\uB2E4."
