    - memoryType: 1
      disposition: 2
      rationale: "\uD22C\uC790\xB7\uCD9C\uC2DC \uD569\uC758\uB97C \uAE68\uBA74 \uC2DC\uC7A5
        \uC120\uC810 \uAE30\uD68C\uB97C \uC783\uB294\uB2E4."
