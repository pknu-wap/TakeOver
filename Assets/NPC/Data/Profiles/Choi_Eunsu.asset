      rationale: "\uC778\uB825 \uC2B9\uACC4\uC640 \uD1B5\uD569 \uC57D\uC18D\uC758
        \uC2E4\uC81C \uC774\uD589\uC744 \uC2E0\uB8B0\uD55C\uB2E4."
      effect:
        mode: 1
        multiplier: 1.2
        affectedAxes: 3
        relationBonus:
          trust: 0
          respect: 0
          closeness: 0
    - memoryType: 1
      disposition: 2
      rationale: "\uD569\uC758\uD55C \uC2B9\uACC4 \uC870\uAC74\uC744 \uC5B4\uAE30\uBA74
        \uD1B5\uD569 \uAE30\uBC18\uC744 \uD6FC\uC190\uD55C\uB2E4."
      effect:
        mode: 1
        multiplier: 1.3
        affectedAxes: 1
        relationBonus:
          trust: 0
          respect: 0
          closeness: 0
    - memoryType: 2
      disposition: 2
      rationale: "\uC77C\uAD04 \uD574\uACE0\uB294 \uC870\uC9C1 \uC548\uC815\uACFC
        \uD575\uC2EC \uC778\uB825\uC758 \uC2E0\uB8B0\uB97C \uD06C\uAC8C \uD574\uCE5C\uB2E4."
      effect:
