    npcId: npc-daeseong-industry-hr-director-choi-eunsu
    companyId: daeseong-industry
    profile:
      standingIllustration: {fileID: 0}
      dimmedStandingIllustration: {fileID: 0}
      displayName: "\uCD5C\uC740\uC218"
      role: "\uC870\uC9C1\xB7\uC778\uC0AC\uCC45\uC784\uC790"
      affiliation: "\uB300\uC131\uC0B0\uC5C5"
      personalitySummary: "\uC870\uC9C1 \uD63C\uB780\uC744 \uC904\uC774\uB294 \uB370
        \uB2A5\uD558\uACE0 \uC0AC\uB78C\uC744 \uC27D\uAC8C \uBC84\uB9AC\uC9C0 \uC54A\uB294\uB2E4.
        \uBAA8\uB450\uB97C \uC9C0\uD0AC \uC218 \uC5C6\uB2E4\uB294 \uD604\uC2E4\uB3C4
        \uC54C\uAE30\uC5D0, \uC870\uC6A9\uD788 \uC774\uB904\uC9C0\uB294 \uBD88\uB9AC\uD55C
        \uD569\uC758\uC5D0 \uC790\uC2E0\uC774 \uC775\uC219\uD574\uC9C4 \uAC83\uC740
        \uC544\uB2CC\uC9C0 \uACBD\uACC4\uD55C\uB2E4.\n\uD589\uB3D9 \uC591\uC2DD:
        \uD1B5\uD569 \uC804\uC5D0 \uC2E4\uC81C \uC778\uC6D0\xB7\uAE30\uC220\xB7\uAD50\uC721
        \uC2DC\uAC04\uC744 \uD655\uC778\uD558\uACE0 \uB300\uD45C\uC640 \uC9C1\uC6D0
        \uC0AC\uC774\uC758 \uC870\uAC74\uC744 \uBB38\uC11C\uD654\uD55C\uB2E4. \uD654\uB824\uD55C
        \uACE0\uC6A9 \uC57D\uC18D\uBCF4\uB2E4 \uC9C0\uAE09\uACFC \uBC30\uCE58\uC758
        \uC2E4\uD589\uC744 \uBCF8\uB2E4."
      gameplayRoleSummary: "\uC5ED\uD560: \uB300\uD615 \uC778\uC218\uC758 \uC778\uB825
        \uC2B9\uACC4\uC640 \uC870\uC9C1 \uC804\uD658\uC744 \uD611\uC0C1\uD558\uB294
        \uC2E4\uBB34\uC790. \uACBD\uC601\uC9C4\uACFC \uC758\uACAC\uC774 \uB2EC\uB77C\uB3C4
        \uC9C1\uC6D0\uC758 \uC18C\uC18D\uC744 \uB300\uC2E0 \uD314\uC9C0\uB294 \uC54A\uB294\uB2E4.\n\uC120\uD638:
        \uC810\uC9C4\uC801 \uD1B5\uD569, \uD575\uC2EC \uC778\uB825 \uC2B9\uACC4,
        \uAD50\uC721 \uC608\uC0B0\uC758 \uC2E4\uC81C \uC9D1\uD589, \uC9C1\uC6D0 \uB2F9\uC0AC\uC790\uC758
        \uC120\uD0DD\uAD8C\n\uAE30\uD53C: \uC778\uC218 \uC9C1\uD6C4 \uC77C\uAD04
        \uD574\uACE0, \uAC15\uC81C \uC870\uC9C1\uBB38\uD654 \uD1B5\uD569, \uC9C1\uC6D0
        \uBA85\uBD80\uC758 \uAC70\uB798, \uCC45\uC784 \uC5C6\uB294 \uACE0\uC6A9 \uBCF4\uC7A5
        \uBC1C\uC5B8"
      anyEventRelationDelta:
        trust: 0
        respect: 0
        fear: 0
        hostility: 0
        dependency: 0
        interest: 0
      eventRelationBiases: []
    actionPreferences: []
  storyDesign:
    stance: 3
    personalGoal: "\uC778\uC218 \uB4A4\uC5D0\uB3C4 \uD604\uC7A5\uC774 \uB3CC\uC544\uAC00\uACE0
      \uC9C1\uC6D0\uC774 \uB2E4\uC74C \uC9C1\uBB34\uB97C \uC120\uD0DD\uD560 \uC218
      \uC788\uB294 \uC804\uD658 \uCCB4\uACC4\uB97C \uB9CC\uB4E0\uB2E4."
    loyaltyReason: "\uB300\uC131\uC758 \uC0AC\uB78C\uACFC \uC870\uC9C1\uC5D0 \uCC45\uC784\uC744
      \uB290\uB080\uB2E4. \uADF8\uB8F9 \uC18C\uC18D\uC744 \uAC1C\uC778\uC801 \uCDA9\uC131\uBCF4\uB2E4
      \uC0DD\uACC4\uC640 \uACBD\uB825\uC758 \uC5F0\uC18D\uC131\uC73C\uB85C \uBC1B\uC544\uB4E4\uC778\uB2E4."
    innerConflict: "\uCDA9\uB3CC\uC744 \uC904\uC774\uAE30 \uC704\uD574 \uBD88\uB9AC\uD55C
      \uC804\uD658 \uC870\uAC74\uC744 \uC870\uC6A9\uD788 \uBC1B\uC544\uB4E4\uC778
      \uC801\uC774 \uC788\uACE0, \uADF8 \uD0C0\uD611\uC758 \uD53C\uD574\uB97C \uAE30\uC5B5\uD55C\uB2E4."
    pressureTactics: "\uC778\uB825 \uC2B9\uACC4 \uBE44\uC6A9\uACFC \uAD50\uC721 \uAE30\uAC04\uC744
      \uC0B0\uCD9C\uD574 \uC8FC\uC778\uACF5\uC758 \uC2FC \uC778\uC218\xB7\uBE60\uB978
      \uD1B5\uD569 \uACC4\uD68D\uC744 \uC5B4\uB835\uAC8C \uB9CC\uB4E0\uB2E4."
    cooperationTrigger: "\uC9C1\uC6D0\uC774 \uC2E4\uC81C\uB85C \uC120\uD0DD\uD560
      \uC218 \uC788\uB294 \uC2B9\uACC4\xB7\uAD50\uC721\xB7\uBCF4\uC0C1 \uC808\uCC28\uAC00
      \uC81C\uC2DC\uB418\uACE0 \uC608\uC0B0\uC774 \uD655\uBCF4\uB3FC\uC57C \uD55C\uB2E4."
    requestedTerms: "\uB2F9\uC0AC\uC790 \uB3D9\uC758, \uAD50\uC721\xB7\uC815\uC0B0
      \uC608\uC0B0, \uB2E8\uACC4\uBCC4 \uC804\uD658 \uC77C\uC815, \uC57D\uC18D \uC774\uD589
      \uD655\uC778 \uCC3D\uAD6C."
    cooperationLimit: "\uC9C1\uC6D0 \uD53C\uD574\uB97C \uC904\uC774\uB294 \uD611\uC870\uB2E4.
      \uB300\uC131\uC758 \uC9C0\uBD84 \uC804\uB7B5\uC744 \uD314\uAC70\uB098 \uC9C1\uC6D0\uC744
      \uC8FC\uC778\uACF5 \uD68C\uC0AC\uB85C \uC77C\uAD04 \uC774\uB3D9\uC2DC\uD0A4\uC9C0
      \uC54A\uB294\uB2E4."
    informationScope: "\uBE44\uC2DD\uBCC4 \uC778\uB825\xB7\uAE30\uC220 \uACF5\uBC31,
      \uC804\uD658 \uBE44\uC6A9, \uB2F9\uC0AC\uC790\uAC00 \uB3D9\uC758\uD55C \uACE0\uC6A9
      \uC870\uAC74. \uAC1C\uC778 \uBA85\uBD80\uC640 \uBBFC\uAC10\uD55C \uC778\uC0AC
      \uAE30\uB85D\uC740 \uC81C\uC678\uD55C\uB2E4."
    refusalConditions: "\uB178\uB3D9\uC790\uB97C \uD611\uBC15 \uC218\uB2E8\uC73C\uB85C
      \uC4F0\uB294 \uC81C\uC548, \uC2E4\uC81C \uC7AC\uC6D0 \uC5C6\uB294 \uACE0\uC6A9
      \uC57D\uC18D, \uC9C1\uC6D0 \uB3D9\uC758 \uC5C6\uB294 \uAC1C\uC778 \uC790\uB8CC
      \uC694\uAD6C."
    renewedConflict: "\uC8FC\uC778\uACF5\uC774 \uAD50\uC721\xB7\uC2B9\uACC4 \uC870\uAC74\uC744
      \uC5B4\uAE30\uBA74 \uC9C1\uC6D0 \uCE21 \uD611\uC0C1\uACFC \uACF5\uAC1C\uC801\uC778
      \uBB38\uC81C \uC81C\uAE30\uB85C \uB9DE\uC120\uB2E4."
    storyArc: "\uCD08\uAE30: \uD1B5\uD569 \uACC4\uD68D\uC5D0 \uC778\uB825 \uBE44\uC6A9\uC744
      \uBC18\uC601\uD558\uB77C\uACE0 \uC694\uAD6C\uD55C\uB2E4.\n\uC911\uBC18: \uC790\uC2E0\uC758
      \uACFC\uAC70 \uD0C0\uD611\uC744 \uC778\uC815\uD558\uACE0 \uB2F9\uC0AC\uC790
      \uD611\uC758 \uC808\uCC28\uB97C \uC5F0\uB2E4.\n\uCD5C\uC885: \uC2B9\uACC4 \uC870\uAC74\uC740
      \uD611\uC870\uD558\uB418 \uB300\uC131\uC758 \uD328\uBC30\uB97C \uC704\uD574
      \uC9C1\uC6D0 \uC815\uBCF4\uB97C \uB118\uAE30\uC9C0 \uC54A\uB294\uB2E4."
