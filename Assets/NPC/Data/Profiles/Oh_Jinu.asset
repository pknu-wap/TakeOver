    memoryPreferences:
    - memoryType: 0
      disposition: 1
      rationale: "\uD568\uAED8 \uD655\uC815\uD55C \uAC70\uB798\uC758 \uC2E4\uD589\uC740
        \uB2E4\uC74C \uC778\uC218 \uD611\uB825\uC758 \uC2E0\uB8B0\uAC00 \uB41C\uB2E4."
      effect:
        mode: 1
        multiplier: 1.15
        affectedAxes: 1
        relationBonus:
          trust: 0
          respect: 0
          fear: 0
          hostility: 0
          dependency: 0
          interest: 0
    - memoryType: 1
      disposition: 2
      rationale: "\uACF5\uB3D9 \uC778\uC218\uC640 \uACF5\uAE09 \uD569\uC758\uB97C
        \uAE68\uBA74 \uACBD\uC7C1\uC801 \uC801\uB300\uAC10\uC774 \uB192\uC544\uC9C4\uB2E4."
      effect:
        mode: 1
        multiplier: 1.3
        affectedAxes: 9
        relationBonus:
          trust: 0
          respect: 0
          fear: 0
          hostility: 0
          dependency: 0
          interest: 0
    - memoryType: 3
      disposition: 1
      rationale: "\uB300\uB2F4\uD55C \uC778\uC218\uC758 \uC2E4\uD589 \uB2A5\uB825\uC5D0
        \uC874\uC911\uC774 \uC0DD\uAE30\uB294 \uACBD\uC6B0\uB9CC \uAC15\uD654\uD55C\uB2E4.
        \uACBD\uC7C1\uC73C\uB85C \uC0DD\uAE34 \uC801\uB300\uAC10\uC740 \uAE30\uBCF8
        \uD6A8\uACFC\uB97C \uC720\uC9C0\uD55C\uB2E4."
      effect:
        mode: 1
        multiplier: 1.2
        affectedAxes: 2
        relationBonus:
          trust: 0
          respect: 0
          fear: 0
          hostility: 0
          dependency: 0
          interest: 0
    npcId: npc-daeseong-industry-business-development-director-oh-jinu
    companyId: daeseong-industry
    profile:
      standingIllustration: {fileID: 0}
      dimmedStandingIllustration: {fileID: 0}
      displayName: "\uC624\uC9C4\uC6B0"
      role: "\uC0AC\uC5C5\uAC1C\uBC1C\uCD1D\uAD04"
      affiliation: "\uB300\uC131\uC0B0\uC5C5"
      personalitySummary: "\uC778\uC218\uC640 \uC2E0\uADDC \uC2DC\uC7A5\uC744 \uD1B5\uD574
        \uC790\uAE30 \uC2E4\uB825\uC744 \uC99D\uBA85\uD558\uB824 \uD55C\uB2E4. \uC8FC\uC778\uACF5\uC744
        \uC595\uBCF4\uC9C0 \uC54A\uC73C\uBA70 \uC720\uB2A5\uD55C \uACBD\uC7C1\uC790\uC5D0\uAC8C
        \uB04C\uB9AC\uC9C0\uB9CC, \uC778\uC815\uBC1B\uACE0 \uC2F6\uB2E4\uB294 \uC695\uB9DD
        \uB54C\uBB38\uC5D0 \uB354 \uC9D1\uC694\uD558\uAC8C \uB9DE\uC120\uB2E4.\n\uD589\uB3D9
        \uC591\uC2DD: \uACBD\uC7C1\uC0AC\uC758 \uC2DC\uC124\xB7\uAE30\uC220\xB7\uC778\uB825\uC744
        \uBA3C\uC800 \uD655\uBCF4\uD558\uACE0 \uC778\uC218 \uC18D\uB3C4\uB97C \uB192\uC778\uB2E4.
        \uC774\uAE30\uB294 \uAC83\uBFD0 \uC544\uB2C8\uB77C \uC778\uC218\uD55C \uC870\uC9C1\uC774
        \uC2E4\uC81C \uC131\uACFC\uB97C \uB0B4\uB294\uC9C0\uB3C4 \uC790\uC2E0\uC758
        \uD3C9\uAC00\uB85C \uBC1B\uC544\uB4E4\uC778\uB2E4."
      gameplayRoleSummary: "\uC5ED\uD560: \uC8FC\uC778\uACF5\uC758 \uD655\uC7A5 \uBC29\uC2DD\uC744
        \uBE44\uCD94\uB294 \uC9C0\uC18D \uACBD\uC7C1\uC790. \uC874\uC911\uACFC \uC801\uB300\uAC10\uC774
        \uB3D9\uC2DC\uC5D0 \uCEE4\uC9C8 \uC218 \uC788\uC73C\uBA70 \uCE5C\uBC00\uAC10\uC774
        \uC9C4\uC601 \uC804\uD658\uC744 \uBCF4\uC7A5\uD558\uC9C0 \uC54A\uB294\uB2E4.\n\uC120\uD638:
        \uC2E4\uD589\uB825 \uC788\uB294 \uC778\uC218, \uC2E0\uADDC \uC2DC\uC7A5\uC758
        \uD655\uC2E4\uD55C \uD310\uB85C, \uC7A5\uAE30 \uACF5\uAE09\uC758 \uB3C5\uC810\uAD8C,
        \uC2E4\uB825\uC744 \uAC74 \uC815\uBA74 \uC2B9\uBD80\n\uAE30\uD53C: \uBCF4\uC218\uC801\uC778
        \uAE30\uD68C \uD3EC\uAE30, \uC4F8\uBAA8\uC5C6\uB294 \uC790\uC0B0\uB9CC \uB0A8\uAE30\uB294
        \uC778\uC218, \uAC1C\uC778 \uC601\uC785\uC73C\uB85C \uACBD\uC7C1\uC744 \uB05D\uB0B4\uB824\uB294
        \uC81C\uC548"
      anyEventRelationDelta:
        trust: 0
        respect: 0
        fear: 0
        hostility: 0
        dependency: 0
        interest: 0
      eventRelationBiases: []
    actionPreferences: []
  storyDesign:
    stance: 1
    personalGoal: "\uADF8\uB8F9\uC758 \uB2E4\uC74C \uC131\uC7A5 \uCD95\uC744 \uC9C1\uC811
      \uB9CC\uB4E4\uC5B4 \uAE40\uC131\uD638\uC758 \uD6C4\uACC4 \uC2E4\uD589\uC790\uB85C
      \uC778\uC815\uBC1B\uB294\uB2E4."
    loyaltyReason: "\uADF8\uB8F9\uC758 \uC790\uBCF8\xB7\uACF5\uAE09\uB9DD\uC774 \uC790\uC2E0\uC758
      \uB300\uD615 \uC778\uC218 \uAD6C\uC0C1\uC744 \uC2E4\uD604\uD560 \uBB34\uB300\uC774\uBA70,
      \uADF8 \uC548\uC5D0\uC11C \uC131\uACFC\uB97C \uC99D\uBA85\uD558\uB824 \uD55C\uB2E4."
    innerConflict: "\uC2E4\uB825\uC73C\uB85C \uD3C9\uAC00\uBC1B\uACE0 \uC2F6\uB2E4\uBA74\uC11C
      \uC0C1\uB300\uBCF4\uB2E4 \uD070 \uC790\uBCF8\uACFC \uC870\uC9C1\uC744 \uC2B9\uB9AC\uC758
      \uADFC\uAC70\uB85C \uC0AC\uC6A9\uD55C\uB2E4."
    pressureTactics: "\uC8FC\uC778\uACF5\uC758 \uD6C4\uBCF4 \uAE30\uC5C5\uC5D0 \uC120\uC81C
      \uC785\uCC30\uD558\uACE0 \uD575\uC2EC \uC778\uB825\xB7\uC2DC\uC124\xB7\uB3C5\uC810
      \uACF5\uAE09\uACC4\uC57D\uC744 \uBB36\uB294\uB2E4."
    cooperationTrigger: "\uC591\uCE21 \uBAA8\uB450 \uC190\uD574 \uBCF4\uB294 \uC81C3\uC758
      \uACF5\uAE09 \uCC28\uC9C8\uC774\uB098 \uD55C\uC815\uB41C \uACF5\uB3D9 \uC218\uC8FC\uC5D0\uC11C\uB9CC
      \uC77C\uC2DC\uC801 \uD611\uC758\uB97C \uAC80\uD1A0\uD55C\uB2E4."
    requestedTerms: "\uC5ED\uD560\xB7\uC131\uACFC \uADC0\uC18D\xB7\uAE30\uD55C\uC774
      \uBA85\uD655\uD55C \uACC4\uC57D. \uC0C1\uB300\uC5D0\uAC8C \uC885\uC18D\uB418\uB294
      \uAC1C\uC778 \uC601\uC785 \uC870\uAC74\uC740 \uBC1B\uC9C0 \uC54A\uB294\uB2E4."
    cooperationLimit: "\uC8FC\uC778\uACF5\uC758 \uC2E4\uB825\uC744 \uC778\uC815\uD574\uB3C4
      \uADF8\uB8F9\uC744 \uBC30\uC2E0\uD558\uC9C0 \uC54A\uB294\uB2E4. \uACF5\uB3D9
      \uC0AC\uC5C5\uC758 \uC885\uB8CC\uC640 \uB3D9\uC2DC\uC5D0 \uCD5C\uC885 \uC778\uC218
      \uACBD\uC7C1\uC73C\uB85C \uBCF5\uADC0\uD55C\uB2E4."
    informationScope: "\uACF5\uB3D9 \uC0AC\uC5C5\uC5D0 \uD544\uC694\uD55C \uC77C\uC815\xB7\uADDC\uACA9\xB7\uBB3C\uB7C9.
      \uADF8\uB8F9\uC758 \uC785\uCC30 \uC0C1\uD55C\uACFC \uC778\uC218 \uB300\uC0C1
      \uC6B0\uC120\uC21C\uC704\uB294 \uC81C\uACF5\uD558\uC9C0 \uC54A\uB294\uB2E4."
    refusalConditions: "\uAC1C\uC778 \uBCF4\uC0C1\uC73C\uB85C \uB300\uC131\uC758
      \uAE30\uD68C\uB97C \uB118\uAE30\uB77C\uB294 \uC694\uAD6C, \uC2DC\uC124\uACFC
      \uC778\uB825\uC744 \uAECD\uB370\uAE30\uCC98\uB7FC \uCDE8\uAE09\uD558\uB294
      \uC0AC\uC5C5 \uACC4\uD68D."
    renewedConflict: "\uC8FC\uC778\uACF5\uC774 \uAC19\uC740 \uC2DC\uC7A5\uC758 \uD655\uC7A5\uC744
      \uC7AC\uAC1C\uD558\uBA74 \uACE7\uBC14\uB85C \uB9DE\uB300\uC751\uD55C\uB2E4.
      \uC874\uC911\uC774 \uC313\uC77C\uC218\uB85D \uB354 \uCE58\uBC00\uD55C \uACBD\uC7C1\uC790\uAC00
      \uB41C\uB2E4."
    storyArc: "\uCD08\uAE30: \uCCAB \uACBD\uC7C1 \uC778\uC218\uB85C \uC8FC\uC778\uACF5\uC744
      \uC2DC\uD5D8\uD55C\uB2E4.\n\uC911\uBC18: \uC131\uAE09\uD55C \uD655\uC7A5\uC758
      \uBE44\uC6A9\uC744 \uACAA\uACE0 \uC6B4\uC601 \uB2A5\uB825\uC744 \uBC30\uC6B0\uC9C0\uB9CC
      \uC9C4\uC601\uC740 \uBC14\uAFB8\uC9C0 \uC54A\uB294\uB2E4.\n\uCD5C\uC885: \uC8FC\uC778\uACF5\uC744
      \uB3D9\uAE09 \uACBD\uC7C1\uC790\uB85C \uBD80\uB974\uBA70 \uB9C8\uC9C0\uB9C9
      \uC785\uCC30\uC744 \uBC8C\uC778\uB2E4."
