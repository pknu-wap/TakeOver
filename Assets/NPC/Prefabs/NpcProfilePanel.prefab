  m_text: "\uAC70\uB798 \uC218\uC218\uB8CC\uC640 \uD611\uC0C1 \uC2E0\uB8B0\uB97C
    \uC911\uC2DC\uD55C\uB2E4. \uAC70\uB798\uB97C \uB298\uB9AC\uB294 \uC0C1\uB300\uB97C
