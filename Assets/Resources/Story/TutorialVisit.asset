  - choiceText: "\ubd80\ucc44 \ub0b4\uc5ed\uc744 \ubb3b\ub294\ub2e4"
    choiceDescription: "\uacf5\uac1c \uc790\ub8cc\ub97c \uc0b4\ud3b4\ubd05\ub2c8\ub2e4. \uacc4\uc57d\uc774\ub098 \ucd94\uac00 \uac70\ub798\ub294 \ubc1c\uc0dd\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
    playerLine: "\uac1a\uc544\uc57c \ud560 \ub3c8\uc740 \uc5b4\ub290 \uc815\ub3c4\uc778\uc9c0 \uba3c\uc800 \uc54c\uace0 \uc2f6\uc2b5\ub2c8\ub2e4."
    resultDialogue: "\uacf5\uc2dc\ub41c \ubd80\ucc44 \ub0b4\uc5ed\ubd80\ud130 \ubcf4\uc5ec\ub4dc\ub9b4\uac8c\uc694. \uaddc\ubaa8\ubfd0 \uc544\ub2c8\ub77c \uc5b8\uc81c \uac1a\uc544\uc57c \ud558\ub294\uc9c0\ub3c4 \uc0b4\ud3b4\ubcf4\uc138\uc694."
