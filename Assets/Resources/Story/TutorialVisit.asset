        dependency: 0
        interest: 0
  - choiceText: "\ub9e4\ucd9c\uacfc \uc774\uc775\uc744 \ubb3b\ub294\ub2e4"
    choiceDescription: "\uacf5\uac1c \uc790\ub8cc\ub97c \uc0b4\ud3b4\ubd05\ub2c8\ub2e4. \uacc4\uc57d\uc774\ub098 \ucd94\uac00 \uac70\ub798\ub294 \ubc1c\uc0dd\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
    playerLine: "\ub9e4\ucd9c\uc774 \ub298\uc5b4\ub09c \ub9cc\ud07c \ud68c\uc0ac\uc5d0\ub3c4 \ub3c8\uc774 \ub0a8\uace0 \uc788\uc2b5\ub2c8\uae4c?"
    resultDialogue: "\ube44\uc6a9\uc744 \ube7c\uace0 \ub0a8\uc740 \uc774\uc775\uc744 \uac19\uc774 \ubcf4\uc154\uc57c \ud574\uc694. \ub9e4\ucd9c\ub9cc \ubcf4\uace0 \ud310\ub2e8\ud558\uc2dc\uba74 \ub193\uce58\ub294 \uac8c \uc788\uc2b5\ub2c8\ub2e4."
