  eventId: tutorial_materials_01
  tutorialOnly: 1
  title: "\uc7ac\ubb34 \uc790\ub8cc \ud655\uc778"
  description: "\uc5b4\uc81c \uc778\uc0ac\ub97c \ub098\ub208 \ubbf8\ub798\uac74\uc124 CFO \uc11c\uc9c0\uc544\uac00 \uae30\ubcf8 \uc7ac\ubb34 \uc790\ub8cc\ub97c \uc815\ub9ac\ud574 \ub450\uc5c8\ub2e4. \uacf5\uac1c\ub41c \uc22b\uc790 \uc911 \uad81\uae08\ud55c \ubd80\ubd84\uc744 \ubb3c\uc5b4\ubcf4\uc790. \ud22c\uc790\ub098 \ubcf4\uc218 \uacc4\uc57d\uc744 \uacb0\uc815\ud558\ub294 \uc790\ub9ac\ub294 \uc544\ub2c8\ub2e4."
  speakerNpcId: "npc-mirae-construction-cfo-seo-jia"
  speakerName: "\uc11c\uc9c0\uc544"
  speakerRole: "\ubbf8\ub798\uac74\uc124 CFO"
  startButtonText: "\uc790\ub8cc\ub97c \ud655\uc778\ud55c\ub2e4"
  dialogue: "\uc5b4\uc81c \ubb3c\uc5b4\ubcf4\uc2e0 \uc22b\uc790\ub97c \uc815\ub9ac\ud574 \ub480\uc5b4\uc694. \uacf5\uac1c \uc790\ub8cc\uc5d0\uc11c \ud655\uc778\ud560 \uc218 \uc788\ub294 \ub0b4\uc6a9\uc785\ub2c8\ub2e4. \uc5b4\ub290 \ubd80\ubd84\ubd80\ud130 \uc124\uba85\ud574 \ub4dc\ub9b4\uae4c\uc694?"
  companyQuestion: ""
  companyPlayerLine: ""
  image: {fileID: 21300000, guid: e4f06f328acf53c4385995fb1f2c1e65, type: 3}
  cardImage: {fileID: 21300000, guid: d04aa39026668454991718ef00702904, type: 3}
  negotiationBackground: {fileID: 0}
  highlightImage: {fileID: 0}
  apCost: 1
  companyIds:
  - mirae-construction
  choices:
  - choiceText: "\ud604\uae08 \uc0c1\ud669\uc744 \ubb3b\ub294\ub2e4"
    choiceDescription: "\uacf5\uac1c \uc790\ub8cc\ub97c \uc0b4\ud3b4\ubd05\ub2c8\ub2e4. \uacc4\uc57d\uc774\ub098 \ucd94\uac00 \uac70\ub798\ub294 \ubc1c\uc0dd\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
    playerLine: "\ub2f9\uc7a5 \uc4f8 \uc218 \uc788\ub294 \ud68c\uc0ac \uc790\uae08\uc774 \uc5bc\ub9c8\ub098 \uc788\ub294\uc9c0 \uad81\uae08\ud569\ub2c8\ub2e4."
    resultDialogue: "\uadf8\ub7fc \ud604\uae08\ubd80\ud130 \ubcfc\uac8c\uc694. \ub9e4\ucd9c\ub85c \uc7a1\ud78c \ub3c8\uacfc \uc9c0\uae08 \ud1b5\uc7a5\uc5d0 \uc788\ub294 \ub3c8\uc740 \ub530\ub85c \ubcf4\uc154\uc57c \ud574\uc694."
    resultValue: business
    cashDelta: 0
    npcResult:
      targetNpcIds:
      - npc-mirae-construction-cfo-seo-jia
      targetReactions: []
      memoryType: 8
      strength: 1
      publicity: 0
      durationTurns: 3
      permanent: 0
      reliability: 1
      interpretation: "\uacf5\uac1c \uc7ac\ubb34 \uc790\ub8cc\ub97c \ud655\uc778\ud558\uba70 \ud68c\uc0ac\uc758 \ud604\uae08 \uc0c1\ud669\uc744 \ubb3c\uc5c8\ub2e4. \uacc4\uc57d\uc774\ub098 \ubcf4\uc218 \uc9c0\uae09\uc744 \uc57d\uc18d\ud558\uc9c0 \uc54a\uc558\ub2e4."
      tags:
