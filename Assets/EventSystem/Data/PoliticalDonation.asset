  title: "\uBC15\uC0C1\uD604 \u2014 \uD6C4\uC6D0 \uC81C\uC548"
  image: {fileID: 21300000, guid: 1c5908734a77d9f4488050a3b459f7d0, type: 3}
  cardImage: {fileID: 21300000, guid: 1b70266e1c827944cb88275fc484e6eb, type: 3}
  npcArts:
  - npcId: npc-political-lobbyist-park-sanghyeon
    cardImage: {fileID: 21300000, guid: 1b70266e1c827944cb88275fc484e6eb, type: 3}
    popupImage: {fileID: 21300000, guid: 1c5908734a77d9f4488050a3b459f7d0, type: 3}
  highlightImage: {fileID: 0}
  negotiationBackground: {fileID: 0}
  description: "\uBC15\uC0C1\uD604\uC774 \uC9C0\uBD84 \uBCF4\uC720\uB97C \uB450\uACE0
    \uB4E4\uC5B4\uC624\uB294 \uBB38\uC758\uB97C \uB35C\uC5B4\uC8FC\uACA0\uB2E4\uBA70
    \uD6C4\uC6D0\uC744 \uAEBC\uB0C8\uB2E4. \uADF8 \uB3C8\uC774 \uB204\uAD6C\uC5D0\uAC8C
    \uAC00\uACE0 \uB0B4 \uC774\uB984\uC73C\uB85C \uC5B4\uB5A4 \uC57D\uC18D\uC774
    \uB0A8\uB294\uC9C0 \uBB3B\uACA0\uB2E4."
  apCost: 1
  startButtonText: "\uB9CC\uB098\uAE30"
  companyIds: []
  speakerNpcId: npc-political-lobbyist-park-sanghyeon
  speakerName: "\uBC15\uC0C1\uD604"
  speakerRole:
  dialogue: "\uC694\uC998 \uC9C0\uBD84 \uBCF4\uC720\uB97C \uB450\uACE0 \uC124\uBA85\uD574\uB2EC\uB77C\uB294
    \uC5F0\uB77D\uB3C4 \uBC1B\uC73C\uC2DC\uC8E0. \uC81C\uAC00 \uADF8\uB7F0 \uBD80\uB2F4\uC744
    \uC870\uAE08 \uB35C\uC5B4\uB4DC\uB9B4 \uAE38\uC740 \uC788\uC2B5\uB2C8\uB2E4.
    \uB2E4\uB9CC \uADF8\uCABD\uC5D0\uB3C4 \uC131\uC758\uB97C \uBCF4\uC5EC\uC57C \uD574\uC694."
  companyQuestion:
  companyPlayerLine:
  choices:
  - choiceText: "\uD6C4\uC6D0\uC744 \uBC1B\uC544\uB4E4\uC778\uB2E4"
    choiceDescription: "\uC790\uAE08 100 \uC9C0\uCD9C."
    playerLine: "\uC774\uBC88 \uD6C4\uC6D0 \uC81C\uC548\uC740 \uBC1B\uACA0\uC2B5\uB2C8\uB2E4.
      \uB2E4\uB9CC \uB3C8\uC744 \uB0C8\uB2E4\uB294 \uC774\uC720\uB85C \uBAA8\uB4E0
      \uC77C\uC774 \uD574\uACB0\uB410\uB2E4\uACE0 \uC774\uD574\uD558\uC9C0\uB294
      \uC54A\uACA0\uC2B5\uB2C8\uB2E4."
    resultDialogue: "\uC54C\uACA0\uC2B5\uB2C8\uB2E4. \uC774\uBC88 \uAC74\uC73C\uB85C
      \uBC1B\uC8E0. \uC624\uB298 \uC5B4\uB5A4 \uCDE8\uC9C0\uB85C \uC624\uAC04 \uB3C8\uC778\uC9C0\uB294
      \uC11C\uB85C \uAE30\uC5B5\uD558\uACE0 \uC788\uC5B4\uC57C\uACA0\uB124\uC694."
    resultValue: sponsor
    npcResult:
