  - choiceText: "\uD6C4\uC6D0\uD55C\uB2E4"
    resultDialogue: "\uD604\uBA85\uD55C \uD310\uB2E8\uC785\uB2C8\uB2E4. \uACE7 \uC88B\uC740
      \uC18C\uC2DD \uB4E4\uC73C\uC2E4 \uAC81\uB2C8\uB2E4."
