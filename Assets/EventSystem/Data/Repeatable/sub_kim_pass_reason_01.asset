    player: 1
    narration: 0
    scene: 0
  - npcId: npc-institutional-investor-kim-taeseong
    text: "\uC624\uB298\uC740 \uADF8\uCABD \uC774\uC57C\uAE30\uAC00 \uAD81\uAE08\uD569\uB2C8\uB2E4.
