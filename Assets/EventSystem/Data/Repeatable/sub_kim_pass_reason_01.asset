  - choiceText: "\uB2E4\uB978 \uC120\uD0DD\uC744 \uD560 \uC790\uAE08\uC744 \uB0A8\uAE30\uACA0\uB2E4\uACE0
      \uD55C\uB2E4"
    choiceDescription:
    playerLine: "\uC9C0\uAE08 \uD22C\uC790\uD558\uBA74 \uB2E4\uB978 \uAE30\uD68C\uAC00
      \uC640\uB3C4 \uC6C0\uC9C1\uC77C \uC5EC\uC720\uAC00 \uC904\uC5B4\uB4ED\uB2C8\uB2E4.
      \uC774\uBC88\uC5D0\uB294 \uADF8 \uC5EC\uC720\uB97C \uB0A8\uAE30\uACA0\uC2B5\uB2C8\uB2E4."
    resultDialogue: "\uADF8\uB7EC\uBA74 \uAE30\uB2E4\uB9AC\uB294 \uC120\uD0DD\uC744
      \uD558\uC2E0 \uAC70\uAD70\uC694. \uB098\uC911\uC5D0 \uC624\uB978 \uAC00\uACA9\uC744
      \uBD10\uB3C4 \uB2F9\uC2DC \uB0A8\uAE30\uB824\uB358 \uC5EC\uC720\uAC00 \uBB34\uC5C7\uC774\uC5C8\uB294\uC9C0
      \uD568\uAED8 \uBCF4\uC138\uC694."
    resultValue: answer_2
