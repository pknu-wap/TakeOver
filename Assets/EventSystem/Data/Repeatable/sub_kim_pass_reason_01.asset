  title: "\uAE40\uD0DC\uC131 \u2014 \uB9E4\uC218\uB97C \uBBF8\uB8EC \uC774\uC720"
  image: {fileID: 21300000, guid: e4f06f328acf53c4385995fb1f2c1e65, type: 3}
  cardImage: {fileID: 21300000, guid: d04aa39026668454991718ef00702904, type: 3}
  npcArts: []
  highlightImage: {fileID: 0}
  negotiationBackground: {fileID: 0}
  description: "\uAE40\uD0DC\uC131\uC740 \uB0B4\uAC00 \uACE0\uB978 \uC885\uBAA9\uBCF4\uB2E4
    \uC544\uC9C1 \uC0AC\uC9C0 \uC54A\uC740 \uC885\uBAA9\uC774 \uAD81\uAE08\uD558\uB2E4\uACE0
    \uD55C\uB2E4. \uC8FC\uAC00\uAC00 \uC2F8 \uBCF4\uC5EC\uB3C4 \uC190\uC744 \uBA48\uCD98
    \uC774\uC720\uB97C \uC124\uBA85\uD560 \uC790\uB9AC\uB2E4."
  apCost: 1
  startButtonText: "\uB9CC\uB098\uAE30"
  companyIds: []
  speakerNpcId: npc-institutional-investor-kim-taeseong
  speakerName: "\uAE40\uD0DC\uC131"
  speakerRole:
  dialogue: "\uC88B\uC544 \uBCF4\uC774\uB294 \uD68C\uC0AC\uB97C \uCC3E\uC73C\uC168\uC2B5\uB2C8\uAE4C?"
  companyQuestion:
  companyPlayerLine:
  choices:
  - choiceText: "\uC774\uD574\uD558\uC9C0 \uBABB\uD55C \uBD80\uBD84\uC774 \uB0A8\uC558\uB2E4\uACE0
      \uD55C\uB2E4"
    choiceDescription:
    playerLine: "\uC774\uC775\uC774 \uB098\uB294 \uC774\uC720\uB97C \uC544\uC9C1
      \uCDA9\uBD84\uD788 \uC774\uD574\uD558\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4.
      \uC124\uBA85\uC744 \uB354 \uB4E4\uC5B4\uBCF4\uACE0 \uD310\uB2E8\uD560 \uC0DD\uAC01\uC785\uB2C8\uB2E4."
    resultDialogue: "\uC54C\uACA0\uC2B5\uB2C8\uB2E4. \uADF8\uB7FC \uBB34\uC5C7\uC744
      \uB4E4\uC73C\uBA74 \uC774\uD574\uD588\uB2E4\uACE0 \uD560 \uC218 \uC788\uB294\uC9C0
      \uC801\uC5B4\uBCF4\uC138\uC694. \uB9C9\uC5F0\uD788 \uB354 \uC54C\uC544\uBCF4\uACA0\uB2E4\uACE0\uB9CC
      \uD558\uBA74 \uACB0\uC815\uC740 \uACC4\uC18D \uB4A4\uB85C \uAC11\uB2C8\uB2E4."
    resultValue: answer_0
    npcResult:
      eventId:
