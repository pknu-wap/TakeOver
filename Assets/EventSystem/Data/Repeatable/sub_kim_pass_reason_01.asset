    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uD22C\uC790\uD558\uC9C0 \uC54A\uC740 \uAC83\uAE4C\uC9C0 \uC124\uBA85\uD574\uC57C
      \uD569\uB2C8\uAE4C?"
    player: 1
    narration: 0
    scene: 0
  - npcId: npc-institutional-investor-kim-taeseong
    text: "\uB0A8\uC5D0\uAC8C\uB294 \uC548 \uD558\uC154\uB3C4 \uB429\uB2C8\uB2E4.
      \uBCF8\uC778\uC5D0\uAC8C\uB3C4 \uC774\uC720\uAC00 \uC5C6\uC73C\uBA74 \uB098\uC911\uC5D0
      \uAC00\uACA9\uC774 \uC6C0\uC9C1\uC778 \uB4A4 \uC774\uC720\uB97C \uC0C8\uB85C
      \uB9CC\uB4E4\uAE30 \uC27D\uC8E0."
