  - choiceText: "\uD604\uC7AC \uAC00\uACA9\uC774 \uAE30\uB300\uB97C \uB108\uBB34
      \uBC18\uC601\uD588\uB2E4\uACE0 \uD55C\uB2E4"
    choiceDescription:
    playerLine: "\uD68C\uC0AC\uAC00 \uB098\uC058\uB2E4\uAE30\uBCF4\uB2E4 \uC9C0\uAE08
      \uAC00\uACA9\uC5D0\uC11C\uB294 \uC81C\uAC00 \uAE30\uB300\uD560 \uC5EC\uC9C0\uAC00
      \uC791\uB2E4\uACE0 \uBD05\uB2C8\uB2E4."
    resultDialogue: "\uADF8\uB7F4 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uB2E4\uB9CC \uAC00\uACA9\uC774
      \uB0B4\uB824\uC624\uBA74 \uC790\uB3D9\uC73C\uB85C \uC88B\uC740 \uD22C\uC790\uAC00
      \uB418\uB294\uC9C0\uB294 \uB2E4\uC2DC \uD655\uC778\uD558\uC138\uC694. \uAC00\uACA9\uACFC
      \uD568\uAED8 \uD68C\uC0AC \uC0AC\uC815\uB3C4 \uB2EC\uB77C\uC9C8 \uC218 \uC788\uC73C\uB2C8\uAE4C\uC694."
