  - choiceText: "\uAD8C\uD55C\uC744 \uD655\uC778\uD560 \uB54C\uAE4C\uC9C0 \uBD80\uD0C1\uC744
      \uBCF4\uB958\uD55C\uB2E4"
    choiceDescription:
    playerLine: "\uC81C\uAC00 \uB300\uC2E0 \uBB3C\uC5B4\uBCFC \uC218 \uC788\uB294
      \uC77C\uC778\uC9C0\uBD80\uD130 \uD655\uC778\uD558\uACA0\uC2B5\uB2C8\uB2E4.
