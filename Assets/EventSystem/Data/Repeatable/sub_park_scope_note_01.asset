  - choiceText: "\uBE44\uC6A9\uACFC \uC911\uB2E8 \uAE30\uC900\uC744 \uBA3C\uC800
      \uC801\uB294\uB2E4"
    choiceDescription:
    playerLine: "\uC5BC\uB9C8\uB098 \uC9C4\uD589\uD588\uC744 \uB54C \uBE44\uC6A9\uC774
      \uC0DD\uAE30\uB294\uC9C0, \uC911\uAC04\uC5D0 \uBA48\uCD94\uBA74 \uBB34\uC5C7\uC774
      \uB0A8\uB294\uC9C0\uBD80\uD130 \uC801\uC8E0."
    resultDialogue: "\uB124. \uACB0\uACFC\uAC00 \uC548 \uB098\uC624\uBA74 \uB3C8\uB3C4
      \uC548 \uB4E0\uB2E4\uACE0 \uC0DD\uAC01\uD558\uACE0 \uC624\uC2DC\uB294 \uBD84\uB3C4
      \uC788\uC73C\uB2C8 \uADF8 \uBD80\uBD84\uC740 \uBA3C\uC800 \uB9DE\uCD94\uB294
      \uAC8C \uC88B\uACA0\uC2B5\uB2C8\uB2E4. \uC2E4\uC81C \uAC74\uC774 \uC788\uC73C\uBA74
      \uACAC\uC801\uBD80\uD130 \uB4DC\uB9AC\uC8E0."
