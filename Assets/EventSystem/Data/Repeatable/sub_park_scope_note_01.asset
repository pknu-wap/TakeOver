  tutorialOnly: 0
  title: "\uBC15\uC0C1\uD604 \u2014 \uB300\uC678 \uBB38\uC758 \uBC94\uC704"
  image: {fileID: 21300000, guid: 1c5908734a77d9f4488050a3b459f7d0, type: 3}
  cardImage: {fileID: 21300000, guid: 1b70266e1c827944cb88275fc484e6eb, type: 3}
  npcArts: []
  highlightImage: {fileID: 0}
  negotiationBackground: {fileID: 0}
  description: "\uBC15\uC0C1\uD604\uC774 \uB204\uAD6C \uC774\uB984\uC73C\uB85C \uC5B4\uB514\uAE4C\uC9C0
    \uC54C\uC544\uBCFC\uC9C0 \uC801\uC5B4\uB2EC\uB77C\uACE0 \uD588\uB2E4. \uAC00\uBCBC\uC6B4
    \uBB38\uC758\uAC00 \uC0C1\uB300\uC5D0\uAC8C \uD22C\uC790 \uC758\uD5A5\uC73C\uB85C
    \uC804\uB2EC\uB418\uBA74 \uACE4\uB780\uD558\uB2E4."
  apCost: 1
  startButtonText: "\uB9CC\uB098\uAE30"
  companyIds: []
  speakerNpcId: npc-political-lobbyist-park-sanghyeon
  speakerName: "\uBC15\uC0C1\uD604"
  speakerRole:
  dialogue: "\uBD80\uD0C1\uC744 \uB9D0\uB85C \uB4E4\uC73C\uBA74 \uAC04\uB2E8\uD55C\uB370
    \uC801\uC5B4\uBCF4\uBA74 \uAE38\uC5B4\uC9C8 \uB54C\uAC00 \uC788\uC2B5\uB2C8\uB2E4.
    \u2018\uD55C\uBC88 \uC54C\uC544\uBD10 \uB2EC\uB77C\u2019\uB294 \uB9D0\uC774 \uC81C\uC77C
    \uADF8\uB798\uC694."
  companyQuestion:
  companyPlayerLine:
  choices:
  - choiceText: "\uACF5\uAC1C \uC815\uBCF4 \uD655\uC778\uC73C\uB85C \uBC94\uC704\uB97C
      \uC81C\uD55C\uD55C\uB2E4"
    choiceDescription:
    playerLine: "\uACF5\uAC1C\uB41C \uB0B4\uC6A9\uC744 \uD655\uC778\uD558\uB294 \uBC94\uC704\uB85C
      \uC801\uACA0\uC2B5\uB2C8\uB2E4. \uC81C \uC774\uB984\uC73C\uB85C \uC870\uAC74\uC744
      \uC81C\uC548\uD558\uAC70\uB098 \uD611\uC0C1\uD558\uC9C0\uB294 \uC54A\uB294
      \uAC83\uC73C\uB85C\uC694."
    resultDialogue: "\uBA85\uD655\uD558\uB124\uC694. \uADF8 \uBC94\uC704\uB97C \uB118\uB294
      \uC9C8\uBB38\uC774 \uC0DD\uAE30\uBA74 \uC81C\uAC00 \uBA3C\uC800 \uB2E4\uC2DC
      \uC5EC\uCB59\uB294 \uAC83\uC73C\uB85C \uC801\uC8E0. \uC624\uB298 \uCC29\uC218\uD558\uACA0\uB2E4\uB294
      \uB73B\uC740 \uC544\uB2C8\uACE0\uC694."
    resultValue: answer_0
    npcResult:
      eventId:
