  title: "\uD558\uB298\uC2DD\uD488 \u2014 \uD3EC\uC7A5\uC9C0\uC758 \uD55C \uC904"
  image: {fileID: 21300000, guid: 78c838ba73b33d84589843d32505324c, type: 3}
  cardImage: {fileID: 21300000, guid: 78c838ba73b33d84589843d32505324c, type: 3}
  npcArts: []
  highlightImage: {fileID: 0}
  negotiationBackground: {fileID: 0}
  description: "\uD558\uB298\uC2DD\uD488 \u2014 \uD3EC\uC7A5\uC9C0\uC758 \uD55C \uC904\uC5D0
    \uAD00\uD55C \uBA74\uB2F4 \uC694\uCCAD\uC785\uB2C8\uB2E4. \uB0B4\uC6A9\uACFC
    \uBE44\uC6A9\uC744 \uD655\uC778\uD55C \uB4A4 \uB9CC\uB098\uC2ED\uC2DC\uC624."
  apCost: 1
  startButtonText: "\uB9CC\uB098\uAE30"
  companyIds:
  - haneul-food
  speakerNpcId: npc-haneul-food-ceo-kim-harin
  speakerName: "\uAE40\uD558\uB9B0"
  speakerRole:
  dialogue: "\uC624\uB298\uC740 \uD3EC\uC7A5\uC9C0 \uC774\uC57C\uAE30\uC608\uC694.
    \uB2E4\uB4E4 \uC791\uC740 \uAE00\uC528\uB77C\uACE0 \uC9C0\uB098\uAC00\uB294\uB370,
    \uADF8\uAC78 \uAF3C\uAF3C\uD788 \uC77D\uB294 \uC190\uB2D8\uB3C4 \uACC4\uC2DC\uAC70\uB4E0\uC694."
  companyQuestion:
  companyPlayerLine:
  choices:
  - choiceText: "\uAE30\uB300\uB97C \uD06C\uAC8C \uB9CC\uB4E0 \uD45C\uD604\uBD80\uD130
      \uACE0\uCE58\uC790\uACE0 \uD55C\uB2E4"
    choiceDescription: "\uC774\uBC88 \uB2F5\uBCC0\uC744 \uAD00\uACC4\uC640 \uAE30\uC5B5\uC5D0
      \uBC18\uC601\uD569\uB2C8\uB2E4. \uD604\uAE08\xB7\uC9C0\uBD84 \uBCC0\uD654 \uC5C6\uC74C."
    playerLine: "\uC0AC\uC2E4\uC774 \uB9DE\uC544\uB3C4 \uB2E4\uB978 \uB73B\uC73C\uB85C
      \uC77D\uD78C\uB2E4\uBA74 \uD45C\uD604\uC744 \uC881\uD788\uB294 \uAC8C \uC88B\uACA0\uC2B5\uB2C8\uB2E4.
      \uC190\uB2D8\uC774 \uBB58 \uAE30\uB300\uD588\uB294\uC9C0\uBD80\uD130 \uBCF4\uC8E0."
    resultDialogue: "\uC800\uB3C4 \uADF8\uCABD\uC774 \uB9C8\uC74C\uC5D0 \uAC78\uB824\uC694.
      \uBC14\uAFB8\uBA74 \uB208\uC5D0 \uB35C \uB74C \uC218\uB294 \uC788\uACA0\uC9C0\uB9CC,
      \uC5F4\uC5B4\uBCF4\uACE0 \uC2E4\uB9DD\uD558\uB294 \uAC83\uBCF4\uB2E4\uB294
      \uB0AB\uACA0\uC8E0. \uBC14\uB85C \uC778\uC1C4\uB97C \uBC14\uAFB8\uAE30 \uC804\uC5D0
      \uBB38\uC758\uB97C \uB354 \uBAA8\uC544\uBCFC\uAC8C\uC694."
    resultValue: answer_0
    npcResult:
      eventId:
      companyId:
      actorId:
      actionId:
      targetNpcIds:
      - npc-haneul-food-ceo-kim-harin
      targetReactions: []
