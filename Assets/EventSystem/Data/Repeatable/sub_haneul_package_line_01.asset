  - choiceText: "\uC7A5\uC810\uC744 \uAD6C\uCCB4\uC801\uC778 \uC124\uBA85\uC73C\uB85C
      \uBCF4\uC5EC\uC8FC\uC790\uACE0 \uD55C\uB2E4"
