  - choiceText: "\uC774\uC775\uACFC \uD568\uAED8 \uD604\uAE08\uC774 \uB298\uC5C8\uB294\uC9C0
      \uBB3B\uB294\uB2E4"
    choiceDescription:
    playerLine: "\uB450 \uD68C\uC0AC \uBAA8\uB450 \uD68C\uC218 \uC2DC\uC810\uBD80\uD130
      \uBCF4\uACE0 \uC2F6\uC2B5\uB2C8\uB2E4. \uC774\uC775\uC774 \uB298\uC5C8\uC5B4\uB3C4
      \uB3C8\uC774 \uB2A6\uAC8C \uB4E4\uC5B4\uC624\uBA74 \uC81C\uAC00 \uAE30\uB2E4\uB9B4
      \uC2DC\uAC04\uC774 \uB2EC\uB77C\uC9D1\uB2C8\uB2E4."
    resultDialogue: "\uB124. \uADF8\uB2E4\uC74C\uC5D0\uB294 \uADF8 \uCC28\uC774\uAC00
      \uC77C\uC2DC\uC801\uC778\uC9C0 \uAD6C\uC870\uC801\uC778\uC9C0 \uBCF4\uC154\uC57C\uACA0\uC8E0.
