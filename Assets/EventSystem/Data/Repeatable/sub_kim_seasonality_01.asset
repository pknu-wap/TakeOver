  title: "\uAE40\uD0DC\uC131 \u2014 \uC774\uC775\uC774 \uB298\uC5B4\uB09C \uB450
    \uAC00\uC9C0 \uC774\uC720"
  image: {fileID: 21300000, guid: e4f06f328acf53c4385995fb1f2c1e65, type: 3}
  cardImage: {fileID: 21300000, guid: d04aa39026668454991718ef00702904, type: 3}
  npcArts: []
  highlightImage: {fileID: 0}
  negotiationBackground: {fileID: 0}
  description: "\uC131\uC218\uAE30\uB97C \uB9DE\uC740 \uD68C\uC0AC\uC640 \uBE44\uC6A9\uC744
    \uC904\uC778 \uD68C\uC0AC\uC758 \uC774\uC775\uC774 \uB611\uAC19\uC774 \uB298\uC5C8\uB2E4\uBA74
    \uC5B4\uB290 \uCABD\uC744 \uB354 \uBBFF\uC744 \uC218 \uC788\uC744\uAE4C. \uAE40\uD0DC\uC131\uACFC
    \uB2E4\uC74C \uBD84\uAE30\uC5D0\uB3C4 \uAC19\uC740 \uD750\uB984\uC774 \uC774\uC5B4\uC9C8\uC9C0
    \uB530\uC838\uBCF8\uB2E4."
  apCost: 1
  startButtonText: "\uB9CC\uB098\uAE30"
  companyIds: []
  speakerNpcId: npc-institutional-investor-kim-taeseong
  speakerName: "\uAE40\uD0DC\uC131"
  speakerRole:
  dialogue: "\uB450 \uD68C\uC0AC\uC758 \uC774\uC775\uC774 \uAC19\uC740 \uD3ED\uC73C\uB85C
    \uB298\uC5C8\uB2E4\uACE0 \uAC00\uC815\uD574\uBCF4\uC8E0. \uD55C\uCABD\uC740 \uC131\uC218\uAE30\uC600\uACE0
    \uB2E4\uB978 \uCABD\uC740 \uBE44\uC6A9\uC744 \uC904\uC600\uC2B5\uB2C8\uB2E4.
    \uC5B4\uB290 \uCABD\uC744 \uB354 \uC88B\uAC8C \uBCF4\uC2ED\uB2C8\uAE4C?"
  companyQuestion:
  companyPlayerLine:
  choices:
  - choiceText: "\uAC19\uC740 \uACC4\uC808\uC758 \uC774\uC804 \uC2E4\uC801\uC744
      \uBE44\uAD50\uD55C\uB2E4"
    choiceDescription:
    playerLine: "\uC131\uC218\uAE30\uB77C\uBA74 \uC774\uC804 \uAC19\uC740 \uC2DC\uAE30\uC640
      \uBA3C\uC800 \uBE44\uAD50\uD558\uACA0\uC2B5\uB2C8\uB2E4. \uB9E4\uBC88 \uC788\uB358
      \uC99D\uAC00\uC778\uC9C0\uBD80\uD130 \uBD10\uC57C\uACA0\uC8E0."
    resultDialogue: "\uADF8\uB7EC\uBA74 \uC77C\uC2DC\uC801\uC778 \uBCC0\uD654\uC640
      \uBC18\uBCF5\uB418\uB294 \uD750\uB984\uC744 \uB098\uB204\uAE30 \uC27D\uACA0\uB124\uC694.
      \uD68C\uC0AC \uADDC\uBAA8\uAC00 \uBC14\uB00C\uC5C8\uB2E4\uBA74 \uADF8 \uC810\uB3C4
      \uAC19\uC774 \uBCF4\uC2DC\uACE0\uC694."
    resultValue: answer_0
    npcResult:
      eventId:
