  - choiceText: "\uC904\uC5B4\uB4E0 \uBE44\uC6A9\uC758 \uB0B4\uC6A9\uC744 \uBB3B\uB294\uB2E4"
    choiceDescription:
    playerLine: "\uBE44\uC6A9\uC744 \uC904\uC778 \uCABD\uC740 \uBB34\uC5C7\uC744
      \uC904\uC600\uB294\uC9C0 \uBCF4\uACA0\uC2B5\uB2C8\uB2E4. \uD544\uC694\uD55C
      \uC810\uAC80\uC774\uB098 \uAD50\uC721\uC744 \uB4A4\uB85C \uBBF8\uB904 \uB9CC\uB4E0
      \uC774\uC775\uC77C \uC218\uB3C4 \uC788\uC73C\uB2C8\uAE4C\uC694."
    resultDialogue: "\uADF8 \uAC00\uB2A5\uC131\uAE4C\uC9C0 \uBCF4\uC2DC\uBA74 \uC88B\uC2B5\uB2C8\uB2E4.
      \uBC18\uB300\uB85C \uBD88\uD544\uC694\uD55C \uC808\uCC28\uB97C \uC904\uC5EC
      \uACC4\uC18D \uB098\uC544\uC9C4 \uACBD\uC6B0\uB3C4 \uC788\uACA0\uC8E0. \uBE44\uC6A9\uC774
      \uC904\uC5C8\uB2E4\uB294 \uC774\uC720\uB9CC\uC73C\uB85C \uD55C\uCABD \uACB0\uB860\uC744
      \uB0B4\uB9AC\uC9C0 \uB9C8\uC138\uC694."
