  - choiceText: "\uC9C0\uAE08 \uACF5\uAC1C\uD560 \uC218 \uC5C6\uB294 \uBD80\uBD84\uC740
      \uAD6C\uBD84\uD574\uB2EC\uB77C\uACE0 \uD55C\uB2E4"
    choiceDescription:
    playerLine: "\uACF5\uAC1C\uD560 \uC218 \uC5C6\uB294 \uB0B4\uC6A9\uC774 \uC788\uB2E4\uBA74
      \uBA3C\uC800 \uB098\uB220\uC8FC\uC138\uC694. \uC81C\uAC00 \uBABB \uBCF8 \uBD80\uBD84\uAE4C\uC9C0
