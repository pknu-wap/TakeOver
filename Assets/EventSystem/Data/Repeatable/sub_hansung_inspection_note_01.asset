    resultDialogue: "\uADF8\uB807\uAC8C \uD574\uC8FC\uC2DC\uBA74 \uC124\uBA85\uD558\uAE30
      \uB0AB\uC2B5\uB2C8\uB2E4. \uC228\uAE38 \uC218 \uC788\uB294 \uAC74 \uC804\uBD80
      \uC228\uAE30\uACA0\uB2E4\uB294 \uB73B\uC740 \uC544\uB2D9\uB2C8\uB2E4. \uD22C\uC790
      \uD310\uB2E8\uC5D0 \uBD80\uC871\uD55C \uBD80\uBD84\uC774 \uC788\uC73C\uBA74
