  - choiceText: "\uBC18\uBCF5\uD574\uC11C \uAC19\uC740 \uACB0\uACFC\uAC00 \uB098\uC624\uB294\uC9C0
      \uBB3B\uB294\uB2E4"
    choiceDescription:
    playerLine: "\uD55C \uBC88 \uD569\uACA9\uD55C \uAC83\uBCF4\uB2E4 \uAC19\uC740
      \uC870\uAC74\uC5D0\uC11C \uACC4\uC18D \uB9CC\uB4E4 \uC218 \uC788\uB294\uC9C0\uAC00
      \uAD81\uAE08\uD569\uB2C8\uB2E4. \uADF8 \uD655\uC778 \uACFC\uC815\uBD80\uD130
      \uB4E3\uACE0 \uC2F6\uC2B5\uB2C8\uB2E4."
    resultDialogue: "\uC88B\uC2B5\uB2C8\uB2E4. \uADF8 \uC9C8\uBB38\uC774\uBA74 \uC0DD\uC0B0
      \uC774\uC57C\uAE30\uB85C \uC774\uC5B4\uAC08 \uC218 \uC788\uACA0\uB124\uC694.
