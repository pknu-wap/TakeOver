  eventId: sub_hansung_inspection_note_01
  category: 0
  linearDialogue: 0
  tutorialOnly: 0
  title: "\uD55C\uC131\uACF5\uC5C5 \u2014 \uD569\uACA9\uD45C\uC5D0 \uBD99\uC740 \uC791\uC5C5
    \uBA54\uBAA8"
  image: {fileID: 21300000, guid: e4f06f328acf53c4385995fb1f2c1e65, type: 3}
  cardImage: {fileID: 21300000, guid: d04aa39026668454991718ef00702904, type: 3}
  npcArts: []
  highlightImage: {fileID: 0}
  negotiationBackground: {fileID: 0}
  description: "\uAC80\uC0AC \uACB0\uACFC\uB294 \uBAA8\uB450 \uD569\uACA9\uC774\uC5C8\uB2E4.
    \uCD5C\uBBF8\uC815\uC740 \uC791\uC5C5 \uC870\uAC74\uC774 \uBC14\uB00C\uBA74 \uB2E4\uC2DC
    \uD655\uC778\uD574\uC57C \uD560 \uD56D\uBAA9\uC744 \uD22C\uC790 \uC124\uBA85\uC5D0\uB3C4
    \uB123\uACE0 \uC2F6\uC5B4 \uD55C\uB2E4."
  apCost: 1
  startButtonText: "\uB9CC\uB098\uAE30"
  companyIds:
  - hansung-industry
  speakerNpcId: npc-hansung-industry-ceo-jo-minseok
  speakerName: "\uC870\uBBFC\uC11D"
  speakerRole:
  dialogue: "\uD45C\uC5D0\uB294 \uC804\uBD80 \uD569\uACA9\uC73C\uB85C \uC801\uD600
    \uC788\uC2B5\uB2C8\uB2E4. \uADF8\uB7F0\uB370 \uC774 \uBA54\uBAA8\uB294 \uC124\uBA85\uC5D0\uC11C
    \uBE60\uC84C\uB354\uAD70\uC694."
  companyQuestion:
  companyPlayerLine:
  choices:
  - choiceText: "\uACB0\uACFC\uC640 \uC801\uC6A9 \uC870\uAC74\uC744 \uD568\uAED8
      \uC124\uBA85\uD574\uB2EC\uB77C\uACE0 \uD55C\uB2E4"
    choiceDescription:
    playerLine: "\uAE30\uC220\uC744 \uACF5\uAC1C\uD558\uC9C0 \uC54A\uC544\uB3C4 \uACB0\uACFC\uAC00
      \uC5B4\uB5A4 \uC870\uAC74\uC758 \uAC83\uC778\uC9C0\uB294 \uC124\uBA85\uD574\uC8FC\uC138\uC694.
      \uADF8 \uC870\uAC74\uC774 \uBC14\uB00C\uBA74 \uBB34\uC5C7\uC744 \uB2E4\uC2DC
      \uD655\uC778\uD560\uC9C0\uB3C4\uC694."
    resultDialogue: "\uADF8 \uC815\uB3C4\uB294 \uC815\uB9AC\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
      \uC88B\uC740 \uACB0\uACFC\uB97C \uAE4E\uC544\uB0B4\uB9AC\uC790\uB294 \uC9C8\uBB38\uC740
      \uC544\uB2CC \uAC83\uC73C\uB85C \uB4E3\uACA0\uC2B5\uB2C8\uB2E4. \uAC00\uB2A5\uD55C
      \uBC94\uC704\uB97C \uBD84\uBA85\uD788 \uD558\uC790\uB294 \uAC70\uACA0\uC8E0."
    resultValue: answer_0
    npcResult:
      eventId:
