  title: "\uC774\uBBFC\uADDC \u2014 \uAE30\uC0AC \uC81C\uBAA9\uC758 \u2018\uAC80\uD1A0
    \uC911\u2019"
  image: {fileID: 21300000, guid: 5e4f9d2677ff7d14485fc7b35103459b, type: 3}
  cardImage: {fileID: 21300000, guid: 50c03d92d4dbc3141a37c95c1ddcd7c6, type: 3}
  npcArts: []
  highlightImage: {fileID: 0}
  negotiationBackground: {fileID: 0}
  description: "\uC774\uBBFC\uADDC\uAC00 \uC608\uC2DC \uAE30\uC0AC\uC5D0\uC11C \u2018\uAC80\uD1A0
    \uC911\u2019\uC744 \uBE80 \uC81C\uBAA9\uC744 \uBCF4\uC5EC\uC92C\uB2E4. \uB0B4
    \uD68C\uC0AC \uAE30\uC0AC\uC600\uB2E4\uBA74 \uC5B4\uB514\uBD80\uD130 \uACE0\uCCD0\uB2EC\uB77C\uACE0
    \uD560\uC9C0 \uC0DD\uAC01\uD574\uBCF4\uC790."
  apCost: 1
  startButtonText: "\uB9CC\uB098\uAE30"
  companyIds: []
  speakerNpcId: npc-economic-reporter-lee-mingyu
  speakerName: "\uC774\uBBFC\uADDC"
  speakerRole:
  dialogue: "\u2018\uAC80\uD1A0 \uC911\u2019 \uC138 \uAE00\uC790\uAC00 \uC5BC\uB9C8\uB098
    \uC790\uB9AC\uB97C \uCC28\uC9C0\uD558\uB294\uC9C0 \uC544\uC138\uC694? \uC81C\uBAA9\uC5D0\uC11C\uB294
    \uC5C4\uCCAD\uB0A9\uB2C8\uB2E4. \uBE7C\uBA74 \uC548 \uB418\uB294\uB370 \uBE7C\uACE0
    \uC2F6\uC740 \uC790\uB9AC\uC5D0 \uAF2D \uB4E4\uC5B4\uAC00\uC694."
  companyQuestion:
  companyPlayerLine:
  choices:
  - choiceText: "\uACB0\uC815 \uC0C1\uD0DC\uB97C \uB098\uD0C0\uB0B4\uB294 \uB9D0\uC740
      \uB0A8\uAE30\uC790\uACE0 \uD55C\uB2E4"
    choiceDescription:
    playerLine: "\uBB34\uC5C7\uC774 \uD655\uC815\uC778\uC9C0 \uB098\uD0C0\uB0B4\uB294
      \uB9D0\uC740 \uB0A8\uAE30\uB294 \uAC8C \uC88B\uACA0\uC2B5\uB2C8\uB2E4. \uD68C\uC0AC
      \uC774\uB984\uC744 \uC904\uC774\uB354\uB77C\uB3C4\uC694."
    resultDialogue: "\uADF8\uCABD\uBD80\uD130 \uC9C0\uD0A4\uC8E0. \uBA4B\uC788\uAC8C
      \uC9E7\uC544\uC84C\uB294\uB370 \uB2E4\uB978 \uC0AC\uC2E4\uC774 \uB418\uBA74
      \uC81C \uC77C\uC774 \uB298\uC5B4\uB098\uB2C8\uAE4C\uC694. \uB3C5\uC790\uBD84
      \uC77C\uB3C4 \uB298\uC5B4\uB098\uACE0\uC694."
    resultValue: answer_0
    npcResult:
      eventId:
