  - choiceText: "\uC81C\uBAA9\uACFC \uCCAB \uBB38\uC7A5\uC5D0\uC11C \uC5ED\uD560\uC744
      \uB098\uB204\uC790\uACE0 \uD55C\uB2E4"
    choiceDescription:
    playerLine: "\uC81C\uBAA9\uC5D0\uC11C \uB2E4 \uC124\uBA85\uD560 \uC218 \uC5C6\uB2E4\uBA74
      \uCCAB \uBB38\uC7A5\uC73C\uB85C \uC774\uC5B4\uC9C0\uAC8C \uD558\uC8E0. \uB2E4\uB9CC
      \uC81C\uBAA9\uB9CC \uBCF4\uACE0\uB3C4 \uBC18\uB300 \uB73B\uC73C\uB85C \uC77D\uD788\uBA74
      \uC548 \uB418\uACA0\uC2B5\uB2C8\uB2E4."
    resultDialogue: "\uB124. \uC9E7\uAC8C \uC4F0\uB77C\uB294 \uB9D0\uC744 \uB300\uCDA9
      \uC4F0\uB77C\uB294 \uD5C8\uAC00\uB85C \uBC1B\uC73C\uBA74 \uC548 \uB418\uC8E0.
      \uC81C\uAC00 \uC624\uB298\uB3C4 \uADF8 \uD5C8\uAC00\uB97C \uCC3E\uACE0 \uC788\uC5C8\uB098
      \uBD05\uB2C8\uB2E4."
