    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uBB34\uC5C7\uBD80\uD130 \uBB3C\uC5B4\uBCF4\uBA74 \uC88B\uACA0\uC2B5\uB2C8\uAE4C?"
