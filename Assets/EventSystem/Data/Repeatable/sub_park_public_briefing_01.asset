  - choiceText: "\uC900\uBE44\uD560 \uC5C5\uBB34\uC640 \uC2DC\uAC04\uC744 \uBA3C\uC800
      \uBCF8\uB2E4"
    choiceDescription:
    playerLine: "\uC870\uAC74\uC774 \uB9DE\uC544\uB3C4 \uC900\uBE44\uD560 \uC778\uB825\uACFC
      \uC2DC\uAC04\uC774 \uC5C6\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uD544\uC694\uD55C
      \uC5C5\uBB34\uBD80\uD130 \uBCF4\uACA0\uC2B5\uB2C8\uB2E4."
    resultDialogue: "\uADF8 \uC9C8\uBB38\uC744 \uB2A6\uAC8C \uD558\uC2DC\uB294 \uBD84\uB4E4\uC774
      \uB9CE\uC8E0. \uBC1B\uC744 \uC218 \uC788\uB294 \uAE08\uC561\uB9CC \uBCF4\uACE0
      \uC2DC\uC791\uD588\uB2E4\uAC00 \uC11C\uB958 \uC900\uBE44\uC5D0 \uC2DC\uAC04\uC744
      \uB2E4 \uC4F0\uAE30\uB3C4 \uD569\uB2C8\uB2E4. \uD544\uC694\uD55C \uBC94\uC704\uB97C
      \uB098\uB220\uBCF4\uACA0\uC2B5\uB2C8\uB2E4."
    resultValue: answer_1
