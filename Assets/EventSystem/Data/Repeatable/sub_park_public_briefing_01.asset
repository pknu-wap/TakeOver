  title: "\uBC15\uC0C1\uD604 \u2014 \uACF5\uAC1C \uC124\uBA85\uD68C \uC9C8\uBB38
    \uC900\uBE44"
  image: {fileID: 21300000, guid: 1c5908734a77d9f4488050a3b459f7d0, type: 3}
  cardImage: {fileID: 21300000, guid: 1b70266e1c827944cb88275fc484e6eb, type: 3}
  npcArts: []
  highlightImage: {fileID: 0}
  negotiationBackground: {fileID: 0}
  description: "\uBC15\uC0C1\uD604\uC774 \uACF5\uAC1C \uC124\uBA85\uD68C\uC758 \uC9C8\uBB38
    \uC2DC\uAC04\uC5D0 \uBB3C\uC5B4\uBCFC \uC77C\uC744 \uAC00\uC838\uC654\uB2E4.
    \uD68C\uC0AC\uAC00 \uB530\uB85C \uB2F5\uD574\uC918\uC57C \uD560 \uC0AC\uD56D\uC744
    \uBBF8\uB9AC \uACE8\uB77C\uBCF4\uC790."
  apCost: 1
  startButtonText: "\uB9CC\uB098\uAE30"
  companyIds: []
  speakerNpcId: npc-political-lobbyist-park-sanghyeon
  speakerName: "\uBC15\uC0C1\uD604"
  speakerRole: "\ub85c\ube44\uc2a4\ud2b8"
  dialogue: "\uC124\uBA85\uD68C\uB294 \uC55E\uC790\uB9AC\uBCF4\uB2E4 \uC9C8\uBB38
    \uC2DC\uAC04\uC5D0 \uB4E4\uC744 \uAC8C \uB9CE\uC2B5\uB2C8\uB2E4. \uC790\uB8CC\uC5D0\uB294
    \uB2E4 \uC88B\uC544 \uBCF4\uC774\uB294 \uB9D0\uB9CC \uC801\uD600 \uC788\uC73C\uB2C8\uAE4C\uC694."
  companyQuestion:
  companyPlayerLine:
  choices:
  - choiceText: "\uC2E0\uCCAD \uC790\uACA9\uACFC \uC81C\uC678 \uC870\uAC74\uC744
      \uBA3C\uC800 \uBCF8\uB2E4"
    choiceDescription:
    playerLine: "\uB300\uC0C1\uC5D0 \uB4E4\uC5B4\uAC00\uB294\uC9C0\uBD80\uD130 \uBCF4\uACA0\uC2B5\uB2C8\uB2E4.
      \uC81C\uC678\uB418\uB294 \uC870\uAC74\uC774 \uC788\uB2E4\uBA74 \uAE30\uB300\uD558\uAE30
      \uC804\uC5D0 \uC54C\uC544\uC57C\uACA0\uC8E0."
    resultDialogue: "\uC88B\uC2B5\uB2C8\uB2E4. \uB2F4\uB2F9\uC790\uAC00 \uB2F5\uD560
      \uC218 \uC788\uB294 \uC9C8\uBB38\uC73C\uB85C \uC815\uB9AC\uD558\uC8E0. \u2018\uC6B0\uB9AC\uB3C4
      \uB418\uB098\uC694\u2019 \uD55C \uC904\uBCF4\uB2E4 \uC5B4\uB290 \uC870\uAC74\uC744
      \uD655\uC778\uD588\uB294\uC9C0 \uC801\uC73C\uBA74 \uBE60\uB985\uB2C8\uB2E4."
    resultValue: answer_0
    npcResult:
