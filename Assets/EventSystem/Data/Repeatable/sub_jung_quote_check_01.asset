  - choiceText: "\uBC30\uACBD \uC758\uACAC\uB9CC \uB9D0\uD55C\uB2E4"
    choiceDescription:
    playerLine: "\uC81C \uC774\uB984\uC73C\uB85C \uC778\uC6A9\uD558\uC9C0 \uC54A\uB294
      \uC120\uC5D0\uC11C \uC758\uACAC\uC740 \uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4.
      \uD68C\uC0AC\uB9C8\uB2E4 \uD544\uC694\uD55C \uC124\uBA85\uC774 \uB2E4\uB974\uB2C8
      \uD55C \uBB38\uC7A5\uC73C\uB85C \uBB36\uAE30\uB294 \uC5B4\uB835\uC2B5\uB2C8\uB2E4."
    resultDialogue: "\uC54C\uACA0\uC2B5\uB2C8\uB2E4. \uADF8 \uB9D0\uC744 \uC775\uBA85
      \uC778\uC6A9\uC73C\uB85C \uBC14\uAFD4 \uC4F0\uC9C0\uB3C4 \uC54A\uACA0\uC2B5\uB2C8\uB2E4.
      \uCDE8\uC7AC \uBC29\uD5A5\uC744 \uC0DD\uAC01\uD560 \uB54C \uCC38\uACE0\uD558\uB294
      \uBC94\uC704\uB85C \uB4E4\uC744\uAC8C\uC694."
    resultValue: answer_1
