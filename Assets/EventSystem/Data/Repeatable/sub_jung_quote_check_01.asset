  tutorialOnly: 0
  title: "\uC815\uC218\uC544 \u2014 \uC778\uD130\uBDF0 \uC778\uC6A9 \uBC94\uC704"
  image: {fileID: 21300000, guid: b0c2d642c28a21742b1c9e2acbb476d8, type: 3}
  cardImage: {fileID: 21300000, guid: 408461e7a731f4842b6f83c82be8a2da, type: 3}
  npcArts: []
  highlightImage: {fileID: 0}
  negotiationBackground: {fileID: 0}
  description: "\uC815\uC218\uC544\uAC00 \uD22C\uC790\uC790\uAC00 \uD68C\uC0AC\uC5D0
    \uC5B4\uB514\uAE4C\uC9C0 \uC124\uBA85\uC744 \uC694\uAD6C\uD558\uB294\uC9C0 \uB0B4
    \uC758\uACAC\uC744 \uB4E3\uACE0 \uC2F6\uB2E4\uACE0 \uD588\uB2E4. \uB2F5\uBCC0
    \uC911 \uC5B4\uB290 \uBD80\uBD84\uC774 \uB0B4 \uC774\uB984\uC73C\uB85C \uAE30\uC0AC\uC5D0
    \uC2E4\uB9B4 \uC218 \uC788\uB294\uC9C0\uBD80\uD130 \uBB3B\uACA0\uB2E4."
  apCost: 1
  startButtonText: "\uB9CC\uB098\uAE30"
  companyIds: []
  speakerNpcId: npc-investigative-reporter-jung-sua
  speakerName: "\uC815\uC218\uC544"
  speakerRole:
  dialogue: "\uC624\uB298\uC740 \uC9E7\uAC8C \uC758\uACAC \uD558\uB098\uB9CC \uC5EC\uCB64\uBCFC\uAC8C\uC694.
    \uD22C\uC790\uC790\uAC00 \uD68C\uC0AC\uC5D0 \uC124\uBA85\uC744 \uC694\uAD6C\uD560
    \uB54C \uC5B4\uB514\uAE4C\uC9C0 \uC54C\uC544\uC57C \uD55C\uB2E4\uACE0 \uBCF4\uC138\uC694?"
  companyQuestion:
  companyPlayerLine:
  choices:
  - choiceText: "\uC774\uB984\uC744 \uBC1D\uD788\uACE0 \uC758\uACAC\uC744 \uB9D0\uD55C\uB2E4"
    choiceDescription:
    playerLine: "\uACB0\uC815\uC5D0 \uC601\uD5A5\uC744 \uC900 \uC124\uBA85\uC774
      \uBB34\uC5C7\uC778\uC9C0 \uC54C\uC544\uC57C \uD55C\uB2E4\uACE0 \uC0DD\uAC01\uD569\uB2C8\uB2E4.
      \uC81C \uC758\uACAC\uC73C\uB85C \uC778\uC6A9\uD574\uB3C4 \uC88B\uC2B5\uB2C8\uB2E4.
      \uD2B9\uC815 \uD68C\uC0AC\uC5D0 \uC798\uBABB\uC774 \uC788\uB2E4\uB294 \uB73B\uC740
      \uC544\uB2C8\uACE0\uC694."
    resultDialogue: "\uB124. \uADF8 \uBC94\uC704\uB85C \uC801\uACA0\uC2B5\uB2C8\uB2E4.
      \uD2B9\uC815 \uC0AC\uAC74\uC5D0 \uB300\uD55C \uD310\uB2E8\uC73C\uB85C \uBD99\uC774\uC9C0
      \uC54A\uACA0\uC2B5\uB2C8\uB2E4. \uBB38\uB9E5\uC774 \uB2EC\uB77C\uC9C0\uBA74
      \uB2E4\uC2DC \uD655\uC778\uD560\uAC8C\uC694."
    resultValue: answer_0
    npcResult:
      eventId:
      companyId:
      actorId:
