  - choiceText: "\uC815\uC2DD \uC778\uD130\uBDF0\uB97C \uC0AC\uC591\uD55C\uB2E4"
    choiceDescription:
    playerLine: "\uC544\uC9C1\uC740 \uC778\uC6A9\uB418\uB294 \uB2F5\uBCC0\uC744 \uB4DC\uB9AC\uC9C0
      \uC54A\uACA0\uC2B5\uB2C8\uB2E4. \uB354 \uD655\uC778\uD55C \uB4A4\uC5D0 \uC774\uC57C\uAE30\uD558\uC8E0."
    resultDialogue: "\uB124. \uC624\uB298 \uB300\uD654\uB294 \uC778\uD130\uBDF0\uB85C
      \uC4F0\uC9C0 \uC54A\uACA0\uC2B5\uB2C8\uB2E4. \uB300\uC2E0 \uACF5\uAC1C\uB41C
      \uAC70\uB798\uB098 \uACF5\uC2DC\uAC00 \uC788\uC73C\uBA74 \uADF8\uAC74 \uBCC4\uB3C4\uB85C
