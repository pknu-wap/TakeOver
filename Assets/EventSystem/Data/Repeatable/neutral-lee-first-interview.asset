    - npcId:
      text: "\uB9DE\uC2B5\uB2C8\uB2E4. \uC9C1\uC6D0 \uACE0\uC6A9\uC744 \uBCF4\uC7A5\uD55C\uB2E4\uB294
        \uB73B\uB3C4 \uC544\uB2D9\uB2C8\uB2E4. \uC81C\uAC00 \uC9C0\uAE08 \uACB0\uC815\uD560
