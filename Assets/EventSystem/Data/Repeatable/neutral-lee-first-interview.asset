  m_Name: neutral-lee-first-interview
  m_EditorClassIdentifier: Assembly-CSharp::TakeOver.Events.EventDefinition
  eventId: neutral-lee-first-interview
  category: 0
  linearDialogue: 0
  tutorialOnly: 0
  title: "\uC774\uBBFC\uADDC \u2014 \uC0C8 \uC8FC\uC8FC\uC640\uC758 \uCCAB \uC778\uD130\uBDF0"
  image: {fileID: 21300000, guid: 5e4f9d2677ff7d14485fc7b35103459b, type: 3}
  cardImage: {fileID: 21300000, guid: 50c03d92d4dbc3141a37c95c1ddcd7c6, type: 3}
  npcArts: []
  highlightImage: {fileID: 0}
  negotiationBackground: {fileID: 0}
  description: "\uC0C8 \uD22C\uC790\uC790\uAC00 \uB4E4\uC5B4\uC624\uBA74 \uD68C\uC0AC\uB97C
    \uBC14\uAFB8\uB824 \uD55C\uB2E4\uB294 \uC18C\uBB38\uBD80\uD130 \uB3C8\uB2E4.
    \uC774\uBBFC\uADDC\uAC00 \uB0B4\uAC8C \uC9C1\uC811 \uBB3C\uC5B4\uBCF4\uACA0\uB2E4\uACE0
    \uD588\uB2E4. \uC778\uC6A9 \uBC94\uC704\uBD80\uD130 \uB9DE\uCD94\uACE0 \uC774\uC57C\uAE30\uD558\uC790."
  apCost: 1
  startButtonText: "\uB9CC\uB098\uAE30"
  companyIds: []
  speakerNpcId: npc-economic-reporter-lee-mingyu
  speakerName: "\uC774\uBBFC\uADDC"
  speakerRole:
  dialogue: "\uC624\uB298\uC740 \uBA3C\uC800 \uD655\uC778\uD560\uAC8C\uC694. \uC774\uB984\uACFC
    \uD22C\uC790\uC790\uB77C\uB294 \uC2E0\uBD84\uC744 \uB123\uACE0, \uB2F5\uBCC0\uD55C
    \uBD80\uBD84\uB9CC \uC778\uC6A9\uD574\uB3C4 \uB420\uAE4C\uC694? \uC2EB\uC73C\uC2DC\uBA74
    \uC778\uD130\uBDF0\uB294 \uC5EC\uAE30\uC11C \uBA48\uCDB0\uB3C4 \uB429\uB2C8\uB2E4."
  companyQuestion:
  companyPlayerLine:
  choices:
  - choiceText: "\uD604\uC7AC \uD655\uC778\uD558\uB294 \uBC94\uC704\uB97C \uAD6C\uCCB4\uC801\uC73C\uB85C
      \uB9D0\uD55C\uB2E4"
    choiceDescription:
    playerLine: "\uC9C0\uAE08\uC740 \uD68C\uC0AC\uBCC4 \uD604\uAE08 \uD68C\uC218\uC640
      \uD604\uC7A5 \uC6B4\uC601\uC744 \uBCF4\uACE0 \uC788\uC2B5\uB2C8\uB2E4. \uD22C\uC790
      \uD310\uB2E8 \uB2E8\uACC4\uC774\uACE0 \uACBD\uC601 \uBCC0\uD654\uB098 \uC790\uAE08
      \uC9C0\uC6D0\uC740 \uC815\uD558\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4. \uADF8
      \uBC94\uC704\uB85C \uC778\uC6A9\uD574 \uC8FC\uC138\uC694."
    resultDialogue: "\uB124. \u2018\uC7AC\uBB34\uC640 \uC6B4\uC601\uC744 \uD655\uC778
      \uC911\uC774\uBA70 \uCD94\uAC00 \uC9C0\uC6D0\uC740 \uBBF8\uC815\u2019 \uC815\uB3C4\uB85C
      \uC815\uB9AC\uD558\uBA74 \uB9DE\uC2B5\uB2C8\uAE4C?\n\n\uC54C\uACA0\uC2B5\uB2C8\uB2E4.
      \uADF8 \uC81C\uD55C\uB3C4 \uAC19\uC774 \uC801\uC744\uAC8C\uC694. \uC9E7\uC740
      \uAE30\uC0AC\uB77C\uB3C4 \uBE60\uC9C0\uBA74 \uB2E4\uB978 \uB73B\uC774 \uB418\uB2C8\uAE4C."
    resultValue: answer_0
    npcResult:
      eventId:
      companyId:
      actorId:
      actionId:
      targetNpcIds:
      - npc-economic-reporter-lee-mingyu
      targetReactions: []
      memoryType: 8
