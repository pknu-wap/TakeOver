  - npcId: npc-economic-reporter-lee-mingyu
    text: "\uC88B\uC2B5\uB2C8\uB2E4. \uC0C8\uB85C\uC6B4 \uD22C\uC790\uC790\uAC00
      \uB4E4\uC5B4\uC624\uBA74 \uD68C\uC0AC\uAC00 \uBC14\uB014 \uAC70\uB77C\uB294
      \uB9D0\uC774 \uB530\uB77C\uBD99\uC5B4\uC694. \uBCF8\uC778\uC740 \uBB34\uC5C7\uC744
      \uBC14\uAFB8\uB824\uACE0 \uC624\uC168\uC2B5\uB2C8\uAE4C?"
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uC544\uC9C1 \uBC14\uAFC0 \uAD8C\uD55C\uC740 \uC5C6\uC2B5\uB2C8\uB2E4.
      \uAC00\uC9C4 \uC8FC\uC2DD\uD558\uACE0 \uD68C\uC0AC\uB97C \uC6B4\uC601\uD558\uB294
      \uAD8C\uD55C\uC740 \uB2E4\uB974\uC8E0."
    player: 1
    narration: 0
    scene: 0
  - npcId: npc-economic-reporter-lee-mingyu
    text: "\uADF8 \uBB38\uC7A5\uBD80\uD130 \uC801\uC5B4\uB3C4 \uB418\uACA0\uB124\uC694.
      \uB2E4\uB4E4 \uB4A4\uB85C \uBBF8\uB8E8\uB294 \uC598\uAE30\uC778\uB370."
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uC65C \uADF8 \uC9C8\uBB38\uC744 \uD558\uC2ED\uB2C8\uAE4C?"
    player: 1
    narration: 0
    scene: 0
  - npcId: npc-economic-reporter-lee-mingyu
    text: "\uC0AC\uB78C\uB9C8\uB2E4 \uAE30\uB300\uAC00 \uB2EC\uB77C\uC11C\uC694.
      \uC5B4\uB5A4 \uC9C1\uC6D0\uC740 \uB3C8\uC774 \uB354 \uB4E4\uC5B4\uC628\uB2E4\uACE0
      \uC0DD\uAC01\uD558\uACE0, \uB204\uAD70\uAC00\uB294 \uC790\uAE30 \uC77C\uC790\uB9AC\uAC00
      \uC5C6\uC5B4\uC9C8\uAE4C \uAC71\uC815\uD574\uC694. \uADF8\uB7F0\uB370 \uD22C\uC790\uC790\uB294
      \uADF8\uB0E5 \uC8FC\uC2DD\uC744 \uC0C0\uC744 \uC218\uB3C4 \uC788\uC8E0. \uADF8
      \uCC28\uC774\uB97C \uC4F0\uACE0 \uC2F6\uC2B5\uB2C8\uB2E4."
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uC81C \uB9D0\uC774 \uC9C1\uC6D0\uB4E4\uC5D0\uAC8C \uC57D\uC18D\uCC98\uB7FC
      \uC77D\uD790 \uC218\uB3C4 \uC788\uACA0\uAD70\uC694."
    player: 1
    narration: 0
    scene: 0
  - npcId: npc-economic-reporter-lee-mingyu
    text: "\uADF8\uB798\uC11C \u2018\uC0B4\uB9AC\uACA0\uB2E4\u2019, \u2018\uCC45\uC784\uC9C0\uACA0\uB2E4\u2019
      \uAC19\uC740 \uB9D0\uC740 \uD55C \uBC88 \uB354 \uC5EC\uCB64\uBD05\uB2C8\uB2E4.
      \uB204\uAD6C\uC758 \uC5B4\uB5A4 \uC77C\uAE4C\uC9C0 \uCC45\uC784\uC9C4\uB2E4\uB294
      \uB73B\uC778\uC9C0\uC694."
    player: 0
    narration: 0
    scene: 0
  companyVariants: []
