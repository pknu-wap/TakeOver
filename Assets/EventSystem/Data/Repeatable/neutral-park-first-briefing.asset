      player: 0
      narration: 0
      scene: 0
    - npcId:
      text: "\uC800\uB3C4 \uD68C\uC0AC\uB97C \uB300\uC2E0\uD574 \uC815\uD55C \uC77C\uCC98\uB7FC
        \uB9D0\uD558\uC9C0 \uC54A\uACA0\uC2B5\uB2C8\uB2E4."
      player: 1
      narration: 0
      scene: 0
