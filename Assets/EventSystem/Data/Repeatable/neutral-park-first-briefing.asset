  eventId: neutral-park-first-briefing
  category: 0
  linearDialogue: 0
  tutorialOnly: 0
  title: "\uBC15\uC0C1\uD604 \u2014 \uACF5\uAC1C \uC124\uBA85\uD68C \uCD08\uB300"
  image: {fileID: 21300000, guid: 1c5908734a77d9f4488050a3b459f7d0, type: 3}
  cardImage: {fileID: 21300000, guid: 1b70266e1c827944cb88275fc484e6eb, type: 3}
  npcArts: []
  highlightImage: {fileID: 0}
  negotiationBackground: {fileID: 0}
  description: "\uBC15\uC0C1\uD604\uC774 \uACF5\uAC1C \uC124\uBA85\uD68C \uC548\uB0B4\uBB38\uC744
    \uBCF4\uB0C8\uB2E4. \uD68C\uC0AC \uC774\uB984\uC73C\uB85C \uC2E0\uCCAD\uD558\uAE30
    \uC804\uC5D0 \uCC38\uC11D \uC790\uACA9\uACFC \uB0B4\uAC00 \uB4E4\uC744 \uC218
    \uC788\uB294 \uB0B4\uC6A9\uC744 \uC54C\uC544\uB450\uC790."
  apCost: 1
  startButtonText: "\uB9CC\uB098\uAE30"
  companyIds: []
  speakerNpcId: npc-political-lobbyist-park-sanghyeon
  speakerName: "\uBC15\uC0C1\uD604"
  speakerRole:
  dialogue: "\uC774\uCABD\uC785\uB2C8\uB2E4. \uC548\uB0B4\uBB38 \uBCF4\uC168\uC5B4\uC694?
    \uC81C\uC77C \uD070 \uAE00\uC528\uBCF4\uB2E4 \uC2E0\uCCAD \uC790\uACA9\uBD80\uD130
    \uBCF4\uC168\uC73C\uBA74 \uC624\uB298\uC740 \uC808\uBC18 \uB05D\uB0AC\uC2B5\uB2C8\uB2E4."
  companyQuestion:
  companyPlayerLine:
  choices:
  - choiceText: "\uACF5\uAC1C \uC808\uCC28 \uC790\uB8CC\uB9CC \uD68C\uC0AC\uC5D0
      \uC804\uB2EC\uD560 \uC0DD\uAC01\uC774\uB77C\uACE0 \uD55C\uB2E4"
    choiceDescription:
    playerLine: "\uC624\uB298 \uC790\uB8CC\uB9CC \uBC1B\uC544\uC11C \uD68C\uC0AC
      \uB2F4\uB2F9\uC790\uC5D0\uAC8C \uD655\uC778\uC744 \uAD8C\uD558\uACA0\uC2B5\uB2C8\uB2E4.
      \uC2E0\uCCAD\uD560\uC9C0\uB294 \uADF8\uCABD \uD310\uB2E8\uC774\uACE0\uC694."
    resultDialogue: "\uC88B\uC2B5\uB2C8\uB2E4. \uC804\uB2EC\uD558\uC2E4 \uB54C \uC81C\uAC00
      \uC2E0\uCCAD\uC744 \uBCF4\uC7A5\uD588\uB2E4\uACE0 \uBD99\uC774\uC9C0\uB294
      \uB9C8\uC138\uC694. \uC548\uB0B4\uD55C \uBC94\uC704\uB294 \uC5EC\uAE30\uAE4C\uC9C0\uC785\uB2C8\uB2E4.\n\n\uADF8\uB7EC\uBA74
      \uAC04\uB2E8\uD558\uC8E0. \uD544\uC694\uD558\uBA74 \uB2E4\uC74C\uC5D0 \uC815\uC2DD\uC73C\uB85C
      \uC774\uC57C\uAE30\uD569\uC2DC\uB2E4."
    resultValue: answer_0
    npcResult:
      eventId:
      companyId:
      actorId:
      actionId:
      targetNpcIds:
      - npc-political-lobbyist-park-sanghyeon
      targetReactions: []
      memoryType: 8
      strength: 1
      publicity: 0
      permanent: 0
      durationTurns: 3
      reliability: 1
      interpretation: "\uACF5\uAC1C \uC815\uBCF4 \uD655\uC778. \uC2E4\uC81C \uC804\uB2EC\xB7\uC2E0\uCCAD\xB7\uC9C0\uC6D0\uAE08
        \uC218\uB839\uC740 \uC544\uC9C1 \uC544\uB2C8\uB2E4."
      tags: []
