    text: "\uADF8\uB7FC \uB4A4\uC5D0\uC11C \uC124\uBA85\uB9CC \uB4E4\uC73C\uC2DC\uBA74
      \uB418\uC8E0. \uD68C\uC0AC\uB97C \uB300\uD45C\uD574 \uB2F5\uBCC0\uD560 \uC77C\uB3C4
      \uC5C6\uACE0\uC694."
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uADF8\uB7F0\uB370 \uC65C \uC800\uD55C\uD14C \uC5F0\uB77D\uD558\uC168\uC2B5\uB2C8\uAE4C?"
    player: 1
    narration: 0
    scene: 0
  - npcId: npc-political-lobbyist-park-sanghyeon
    text: "\uD68C\uC0AC \uC0AC\uC815\uC744 \uC54C\uC544\uBCF4\uB294 \uBD84\uB4E4\uC740
      \uACB0\uAD6D \uC808\uCC28\uB3C4 \uC54C\uC544\uC57C \uD558\uB2C8\uAE4C\uC694.
      \uB098\uC911\uC5D0 \uC77C\uC774 \uC0DD\uAE30\uBA74 \uC81C \uC790\uBB38\uC744
      \uC4F0\uC2E4 \uC218\uB3C4 \uC788\uACE0. \uC18C\uAC1C\uD55C \uC0AC\uB78C\uC774
      \uB3C4\uC6C0\uC774 \uB410\uB2E4\uB294 \uAE30\uC5B5\uC740 \uC800\uD55C\uD14C\uB3C4
      \uC774\uC775\uC785\uB2C8\uB2E4."
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uAF64 \uC194\uC9C1\uD558\uC2DC\uB124\uC694."
    player: 1
    narration: 0
    scene: 0
  - npcId: npc-political-lobbyist-park-sanghyeon
    text: "\uACF5\uC9DC \uC548\uB0B4\uC5D0 \uC544\uBB34 \uBAA9\uC801\uB3C4 \uC5C6\uB2E4\uACE0
      \uD558\uBA74 \uB354 \uC758\uC2EC\uD558\uC2DC\uC9C0 \uC54A\uACA0\uC2B5\uB2C8\uAE4C."
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uC124\uBA85\uD68C\uAC00 \uB05D\uB09C \uB4A4, \uBC15\uC0C1\uD604\uC774
      \uC9C8\uBB38\uC744 \uC815\uB9AC\uD574 \uB454 \uBA54\uBAA8\uB97C \uBC00\uC5B4\uC8FC\uC5C8\uB2E4.
      \uACF5\uAC1C \uC77C\uC815\uACFC \uBB38\uC758 \uCC3D\uAD6C\uAC00 \uC801\uD600
      \uC788\uC5C8\uB2E4."
    player: 0
    narration: 1
    scene: 0
  - npcId: npc-political-lobbyist-park-sanghyeon
    text: "\uC774 \uB450 \uD56D\uBAA9\uC740 \uD68C\uC0AC \uB2F4\uB2F9\uC790\uAC00
      \uC9C1\uC811 \uBB3C\uC5B4\uBCF4\uB294 \uAC8C \uC88B\uACA0\uC5B4\uC694. \uC11C\uB958
      \uD558\uB098 \uBE60\uC9C0\uBA74 \uAC80\uD1A0 \uC790\uCCB4\uAC00 \uBC00\uB9B4
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uB2F4\uB2F9\uC790\uC5D0\uAC8C \uACF5\uAC1C \uBB38\uC758\uB85C \uD655\uC778\uD558\uBA74
      \uB429\uB2C8\uAE4C?"
    player: 1
    narration: 0
    scene: 0
  - npcId: npc-political-lobbyist-park-sanghyeon
    text: "\uB124. \uC6D0\uD558\uC2DC\uBA74 \uC81C\uAC00 \uACF5\uAC1C \uC808\uCC28
      \uC548\uC5D0\uC11C \uC9C8\uC758 \uBAA9\uB85D\uC744 \uC900\uBE44\uD574\uB4DC\uB9B4
      \uC218 \uC788\uACE0\uC694. \uC720\uB8CC \uC5C5\uBB34\uB97C \uB9E1\uAE30\uC2E4
      \uAC70\uBA74 \uBC94\uC704\uB97C \uB530\uB85C \uC801\uACA0\uC2B5\uB2C8\uB2E4."
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uC0AC\uB78C\uC744 \uC18C\uAC1C\uD574\uC8FC\uB294 \uC77C\uB3C4 \uD558\uC2DC\uACA0\uC8E0?"
    player: 1
    narration: 0
    scene: 0
  - npcId: npc-political-lobbyist-park-sanghyeon
    text: "\uC18C\uAC1C\uB294 \uD558\uC8E0. \uADF8\uB7F0\uB370 \uB204\uAD74 \uC54C\uBA74
      \uACB0\uACFC\uAE4C\uC9C0 \uC815\uD574\uC9C4\uB2E4\uB294 \uB9D0\uC740 \uB4E3\uC9C0
      \uB9C8\uC138\uC694. \uC800\uB3C4 \uADF8\uB807\uAC8C \uB9D0\uD558\uB294 \uC0AC\uB78C\uD55C\uD14C
      \uB3C8 \uB9E1\uAE30\uC9C0\uB294 \uC54A\uC2B5\uB2C8\uB2E4."
    player: 0
    narration: 0
    scene: 0
  companyVariants: []
