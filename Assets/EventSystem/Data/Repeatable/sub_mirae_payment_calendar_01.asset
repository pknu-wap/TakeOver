    playerLine: "\uB098\uAC00\uB294 \uB3C8\uC5D0\uB3C4 \uD655\uC815\uB41C \uAC83\uACFC
      \uC870\uC815 \uAC00\uB2A5\uD55C \uAC8C \uC788\uC744 \uAC81\uB2C8\uB2E4. \uADF8\uAC78
      \uB098\uB220\uC8FC\uC2DC\uBA74 \uD310\uB2E8\uD558\uAE30 \uC27D\uACA0\uC2B5\uB2C8\uB2E4."
    resultDialogue: "\uB124. \uB2E4\uB9CC \uC870\uC815 \uAC00\uB2A5\uD558\uB2E4\uB294
      \uAC8C \uB2A6\uAC8C \uC918\uB3C4 \uB41C\uB2E4\uB294 \uB73B\uC740 \uC544\uB2C8\uC5D0\uC694.
      \uC0C1\uB300\uC640 \uB2E4\uC2DC \uC774\uC57C\uAE30\uD560 \uBE44\uC6A9\uB3C4
      \uAC19\uC774 \uC801\uACA0\uC2B5\uB2C8\uB2E4."
