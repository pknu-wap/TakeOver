  eventId: sub_mirae_payment_calendar_01
  category: 0
  linearDialogue: 0
  tutorialOnly: 0
  title: "\uBBF8\uB798\uAC74\uC124 \u2014 \uC9C0\uAE09\uC77C\uACFC \uC785\uAE08\uC77C"
  image: {fileID: 21300000, guid: e4f06f328acf53c4385995fb1f2c1e65, type: 3}
  cardImage: {fileID: 21300000, guid: d04aa39026668454991718ef00702904, type: 3}
  npcArts: []
  highlightImage: {fileID: 0}
  negotiationBackground: {fileID: 0}
  description: "\uC11C\uC9C0\uC544\uAC00 \uAC19\uC740 \uB0A0\uC5D0 \uC7A1\uD78C \uC785\uAE08\uACFC
    \uC9C0\uAE09\uC5D0 \uC11C\uB85C \uB2E4\uB978 \uD45C\uC2DC\uB97C \uD574\uB480\uB2E4.
    \uC608\uC815\uB300\uB85C \uB3C8\uC774 \uB4E4\uC5B4\uC624\uC9C0 \uC54A\uC73C\uBA74
    \uC5B4\uB290 \uD604\uC7A5\uC774 \uBA3C\uC800 \uB9C9\uD788\uB294\uC9C0 \uBCF4\uC790."
  apCost: 1
  startButtonText: "\uB9CC\uB098\uAE30"
  companyIds:
  - mirae-construction
  speakerNpcId: npc-mirae-construction-cfo-seo-jia
  speakerName: "\uC11C\uC9C0\uC544"
  speakerRole:
  dialogue: "\uC624\uB298 \uC790\uB8CC\uB294 \uC22B\uC790\uBCF4\uB2E4 \uB2EC\uB825\uBD80\uD130
    \uBD10\uC8FC\uC138\uC694. \uB4E4\uC5B4\uC62C \uB3C8\uD558\uACE0 \uB098\uAC08
    \uB3C8\uC744 \uAC19\uC740 \uB0A0\uC9DC\uC5D0 \uC801\uC5B4\uB450\uB2C8\uAE4C \uAD1C\uCC2E\uC544
    \uBCF4\uC774\uB354\uB77C\uACE0\uC694."
  companyQuestion:
  companyPlayerLine:
  choices:
  - choiceText: "\uB2A6\uC5B4\uC9C8 \uC218 \uC788\uB294 \uD68C\uC218\uBD80\uD130
      \uBB3B\uB294\uB2E4"
    choiceDescription:
    playerLine: "\uD655\uC815\uB418\uC9C0 \uC54A\uC740 \uD68C\uC218\uAC00 \uB2A6\uC5B4\uC9C0\uBA74
      \uBB34\uC5C7\uC744 \uBA3C\uC800 \uC870\uC815\uD574\uC57C \uD558\uB294\uC9C0
      \uBCF4\uC5EC\uC8FC\uC138\uC694. \uB0A0\uC9DC\uB9CC \uACB9\uCE58\uB294\uC9C0\uBCF4\uB2E4
      \uADF8 \uCC28\uC774\uAC00 \uAD81\uAE08\uD569\uB2C8\uB2E4."
    resultDialogue: "\uADF8\uB7FC \uC815\uC0C1 \uC77C\uC815\uACFC \uB2A6\uC5B4\uC9C4
      \uC77C\uC815\uC744 \uB098\uB780\uD788 \uB193\uC744\uAC8C\uC694. \uAC00\uC7A5
      \uB098\uC05C \uACBD\uC6B0\uB97C \uD655\uC815\uB41C \uC77C\uCC98\uB7FC \uC4F0\uC9C0\uB294
      \uC54A\uACA0\uC9C0\uB9CC, \uC5C6\uB358 \uC77C\uCC98\uB7FC \uBE7C\uC9C0\uB3C4
      \uC54A\uACA0\uC2B5\uB2C8\uB2E4."
    resultValue: answer_0
    npcResult:
