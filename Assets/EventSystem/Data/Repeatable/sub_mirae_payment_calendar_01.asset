  - choiceText: "\uD655\uC815 \uC9C0\uAE09\uACFC \uC608\uC0C1 \uC9C0\uAE09\uC744
      \uAD6C\uBD84\uD574\uB2EC\uB77C\uACE0 \uD55C\uB2E4"
