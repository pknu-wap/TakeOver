  title: "\uAE40\uD0DC\uC131 \u2014 \uBBF8\uB798\uAC74\uC124 \uD22C\uC790 \uAC80\uD1A0"
  image: {fileID: 21300000, guid: e4f06f328acf53c4385995fb1f2c1e65, type: 3}
  cardImage: {fileID: 21300000, guid: d04aa39026668454991718ef00702904, type: 3}
  npcArts: []
  highlightImage: {fileID: 0}
  negotiationBackground: {fileID: 0}
  description: "\uAE40\uD0DC\uC131\uC774 \uBBF8\uB798\uAC74\uC124\uC5D0 \uC790\uAE08\uC774
    \uB354 \uB4E4\uC5B4\uAC00\uBA74 \uBB34\uC5C7\uC774 \uD574\uACB0\uB418\uB294\uC9C0
    \uBB3C\uC5C8\uB2E4. \uC5B4\uB514\uC11C \uB3C8\uC774 \uB9C9\uD788\uB294\uC9C0\uBD80\uD130
    \uC124\uBA85\uD560 \uC218 \uC788\uC5B4\uC57C \uD55C\uB2E4."
  apCost: 1
  startButtonText: "\uB9CC\uB098\uAE30"
  companyIds: []
  speakerNpcId: npc-institutional-investor-kim-taeseong
  speakerName: "\uAE40\uD0DC\uC131"
  speakerRole:
  dialogue: "\uC624\uB298\uC740 \uC5B4\uB290 \uD68C\uC0AC\uB97C \uBCF4\uC168\uC2B5\uB2C8\uAE4C?"
  companyQuestion:
  companyPlayerLine:
  choices:
  - choiceText: "\uD655\uC778\uD560 \uC870\uAC74\uC744 \uC815\uD558\uACE0 \uAE30\uB2E4\uB9B0\uB2E4"
    choiceDescription:
    playerLine: "\uD68C\uC218 \uC77C\uC815\uC774 \uD55C \uBC88 \uB2A6\uC5B4\uC838\uB3C4
      \uBC84\uD2F8 \uC218 \uC788\uB294\uC9C0 \uBCF4\uACA0\uC2B5\uB2C8\uB2E4. \uADF8
      \uC124\uBA85\uC744 \uB4E3\uAE30 \uC804\uC5D0\uB294 \uCD94\uAC00 \uADDC\uBAA8\uB97C
      \uB298\uB9AC\uC9C0 \uC54A\uACA0\uC2B5\uB2C8\uB2E4."
    resultDialogue: "\uD655\uC778\uD560 \uC870\uAC74\uC774 \uC0DD\uACBC\uB124\uC694.
      \uB2E4\uB9CC \uC870\uAC74\uC744 \uB108\uBB34 \uC624\uB798 \uBBF8\uB8F0 \uC218\uB3C4
      \uC788\uC5B4\uC694. \uBB34\uC5C7\uC744 \uBC1B\uC73C\uBA74 \uD310\uB2E8\uD560
      \uC218 \uC788\uB294\uC9C0 \uC0C1\uB300\uAC00 \uB2F5\uD560 \uC218 \uC788\uAC8C
      \uBB3C\uC73C\uC138\uC694.\n\n\uB124. \uAE30\uB2E4\uB9AC\uB294 \uB3D9\uC548
      \uAC00\uACA9\uC774 \uC6C0\uC9C1\uC77C \uC218 \uC788\uB2E4\uB294 \uAC83\uB3C4
      \uAC10\uC218\uD574\uC57C \uD558\uACE0\uC694."
    resultValue: answer_0
    npcResult:
      eventId:
      companyId:
      actorId:
      actionId:
      targetNpcIds:
      - npc-institutional-investor-kim-taeseong
      targetReactions: []
