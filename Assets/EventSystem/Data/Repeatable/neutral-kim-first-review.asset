  - choiceText: "\uC190\uC2E4 \uD55C\uB3C4\uB97C \uC0DD\uAC01\uD574 \uC791\uC740
      \uADDC\uBAA8\uBD80\uD130 \uAC80\uD1A0\uD55C\uB2E4"
    choiceDescription:
    playerLine: "\uD655\uC778\uB418\uC9C0 \uC54A\uC740 \uBD80\uBD84\uC744 \uAC10\uC548\uD574\uC11C
      \uC783\uC5B4\uB3C4 \uB2E4\uC74C \uC120\uD0DD\uC744 \uD560 \uC218 \uC788\uB294
      \uADDC\uBAA8\uB9CC \uAC80\uD1A0\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    resultDialogue: "\uC791\uC740 \uD22C\uC790\uB85C \uC2DC\uC791\uD560 \uC218\uB294
      \uC788\uC8E0. \uADF8\uB807\uB2E4\uACE0 \uD68C\uC0AC \uCABD \uC704\uD5D8\uC774
      \uC791\uC544\uC9C0\uB294 \uAC74 \uC544\uB2D9\uB2C8\uB2E4. \uD310\uB2E8\uC774
      \uD2C0\uB838\uC744 \uB54C \uAE08\uC561\uC744 \uB354 \uB123\uC5B4\uC11C \uCC98\uC74C
      \uD310\uB2E8\uC744 \uC9C0\uD0A4\uB824 \uD558\uC9C0\uB294 \uB9C8\uC138\uC694.\n\n\uB124.
      \uC218\uC775\uC774 \uB098\uB3C4\uC694. \uCCAB \uACB0\uACFC\uAC00 \uC88B\uC558\uB2E4\uB294
      \uC774\uC720\uB85C \uB2E4\uC74C \uC704\uD5D8\uAE4C\uC9C0 \uC124\uBA85\uB418\uC9C0\uB294
      \uC54A\uC2B5\uB2C8\uB2E4."
    resultValue: answer_1
    npcResult:
      eventId:
