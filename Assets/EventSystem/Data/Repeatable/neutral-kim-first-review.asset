      \uC5EC\uAE30\uC11C\uB294 \uC2E4\uC81C \uC790\uAE08 \uC9C0\uC6D0\uC744 \uAC80\uD1A0\uD55C\uB2E4\uB294
      \uAC00\uC815\uC73C\uB85C \uB2F5\uD558\uBA74 \uB429\uB2C8\uAE4C?"
    player: 1
    narration: 0
    scene: 0
  - npcId: npc-institutional-investor-kim-taeseong
    text: "\uB124. \uC2DC\uC7A5\uC5D0\uC11C \uC8FC\uC2DD\uC744 \uC0AC\uB294 \uB300\uAE08\uC774
      \uD68C\uC0AC \uD1B5\uC7A5\uC73C\uB85C \uBC14\uB85C \uB4E4\uC5B4\uAC00\uB294
      \uAC74 \uC544\uB2C8\uB2C8\uAE4C\uC694. \uC2E4\uC81C \uC9C0\uC6D0\uC744 \uD558\uB824\uBA74
      \uC5B4\uB5A4 \uAC70\uB798\uC778\uC9C0, \uBB34\uC5C7\uC744 \uB9E1\uB294\uC9C0\uBD80\uD130
      \uB530\uB85C \uC815\uD574\uC57C \uD569\uB2C8\uB2E4."
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uAE09\uD55C \uC9C0\uAE09 \uC77C\uC815\uC740 \uB118\uAE38 \uC218 \uC788\uACA0\uC8E0."
    player: 1
    narration: 0
    scene: 0
  - npcId: npc-institutional-investor-kim-taeseong
    text: "\uADF8\uB2E4\uC74C\uC5D0\uB294\uC694?"
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uAC19\uC740 \uBC29\uC2DD\uC73C\uB85C \uC218\uC8FC\uD558\uBA74 \uB610
      \uBB36\uC77C \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uADF8\uB798\uC11C \uC0C8 \uACF5\uC0AC\uAE4C\uC9C0
      \uAC19\uC774 \uBD10\uC57C\uACA0\uC2B5\uB2C8\uB2E4."
    player: 1
    narration: 0
    scene: 0
  - npcId: npc-institutional-investor-kim-taeseong
    text: "\uADF8\uB807\uB2E4\uBA74 \uC9C0\uAE08 \uD310\uB2E8\uC740 \uC790\uAE08
      \uBD80\uC871\uB9CC\uC758 \uBB38\uC81C\uB294 \uC544\uB2C8\uAD70\uC694. \uBC1B\uB294
      \uC77C\uC815\uACFC \uC4F0\uB294 \uBC29\uC2DD\uC744 \uAC19\uC774 \uBD10\uC57C
      \uD55C\uB2E4\uB294 \uCABD\uC774\uACE0\uC694."
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uB124. \uC88B\uC740 \uACC4\uC57D\uACFC \uB2F9\uC7A5 \uBC84\uD2F8 \uC218
      \uC788\uB294 \uACC4\uC57D\uC774 \uB2E4\uB97C \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4."
    player: 1
    narration: 0
    scene: 0
  - npcId: npc-institutional-investor-kim-taeseong
    text: "\uADF8 \uCC28\uC774\uAC00 \uCDA9\uBD84\uD788 \uD655\uC778\uB418\uC9C0
      \uC54A\uC558\uB2E4\uACE0 \uD569\uC2DC\uB2E4. \uADF8\uB798\uB3C4 \uC9C0\uAE08
      \uC0AC\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
    player: 0
    narration: 0
    scene: 0
