  - choiceText: "\uAC19\uC740 \uC22B\uC790\uB97C \uC124\uBA85\uD558\uB294 \uC0AC\uB78C\uC744
      \uC5EC\uB7EC \uBA85 \uB9CC\uB09C\uB2E4"
    choiceDescription: "\uC774\uBC88 \uB2F5\uBCC0\uC744 \uAD00\uACC4\uC640 \uAE30\uC5B5\uC5D0
      \uBC18\uC601\uD569\uB2C8\uB2E4. \uD604\uAE08\xB7\uC9C0\uBD84 \uBCC0\uD654 \uC5C6\uC74C."
    playerLine: "\uB2F4\uB2F9\uC790\uAC00 \uB2E4\uB978 \uC0AC\uB78C\uB4E4\uC740 \uAC19\uC740
      \uACB0\uACFC\uB97C \uC5B4\uB5BB\uAC8C \uC124\uBA85\uD558\uB294\uC9C0 \uB4E3\uACE0
      \uC2F6\uC2B5\uB2C8\uB2E4. \uC22B\uC790\uB294 \uAC19\uC544\uB3C4 \uADF8\uB3D9\uC548
      \uD55C \uC77C\uC740 \uB2E4\uB97C \uD14C\uB2C8\uAE4C\uC694."
    resultDialogue: "\uB124. \uB300\uD45C\uB2D8 \uC124\uBA85\uC744 \uB4E3\uACE0 \uB098\uC654\uB2E4\uACE0
      \uD68C\uC0AC \uC804\uBD80\uB97C \uB9CC\uB09C \uAC74 \uC544\uB2C8\uC8E0. \uB3D9\uC758\uBC1B\uC740
      \uBC94\uC704\uC5D0\uC11C \uC2E4\uC81C \uC5C5\uBB34 \uB9E1\uB294 \uBD84\uB4E4\uB3C4
      \uBD50 \uC218 \uC788\uB294\uC9C0 \uD655\uC778\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    resultValue: answer_1
