  category: 0
  tutorialOnly: 0
  title: "\uC774\uBBFC\uADDC \u2014 \uD604\uC7A5\uC73C\uB85C \uAC00\uB294 \uC9C8\uBB38"
  image: {fileID: 21300000, guid: 5e4f9d2677ff7d14485fc7b35103459b, type: 3}
  cardImage: {fileID: 21300000, guid: 50c03d92d4dbc3141a37c95c1ddcd7c6, type: 3}
  npcArts: []
  highlightImage: {fileID: 0}
  negotiationBackground: {fileID: 0}
  description: "\uC774\uBBFC\uADDC \u2014 \uD604\uC7A5\uC73C\uB85C \uAC00\uB294 \uC9C8\uBB38\uC5D0
    \uAD00\uD55C \uBA74\uB2F4 \uC694\uCCAD\uC785\uB2C8\uB2E4. \uB0B4\uC6A9\uACFC
    \uBE44\uC6A9\uC744 \uD655\uC778\uD55C \uB4A4 \uB9CC\uB098\uC2ED\uC2DC\uC624."
  apCost: 1
  startButtonText: "\uB9CC\uB098\uAE30"
  companyIds: []
  speakerNpcId: npc-economic-reporter-lee-mingyu
  speakerName: "\uC774\uBBFC\uADDC"
  speakerRole:
  dialogue: "\uB0B4\uC77C \uD604\uC7A5 \uCDE8\uC7AC\uAC00 \uC788\uB294\uB370 \uC790\uB8CC\uB9CC
    \uC77D\uC5C8\uB354\uB2C8 \uC9C8\uBB38\uC774 \uC804\uBD80 \u2018\uC65C \uB298\uC5C8\uC2B5\uB2C8\uAE4C\u2019\uB354\uB77C\uACE0\uC694.
    \uC774\uB7EC\uBA74 \uC804\uD654\uB85C \uD574\uB3C4 \uB418\uB294 \uC598\uAE30\uB77C\uC11C\uC694."
  companyQuestion:
  companyPlayerLine:
  choices:
  - choiceText: "\uD3C9\uC18C\uC640 \uBC14\uC05C \uC2DC\uAC04\uC758 \uCC28\uC774\uB97C
      \uBB3B\uB294\uB2E4"
    choiceDescription: "\uC774\uBC88 \uB2F5\uBCC0\uC744 \uAD00\uACC4\uC640 \uAE30\uC5B5\uC5D0
      \uBC18\uC601\uD569\uB2C8\uB2E4. \uD604\uAE08\xB7\uC9C0\uBD84 \uBCC0\uD654 \uC5C6\uC74C."
    playerLine: "\uC790\uB8CC\uB97C \uB9CC\uB4E0 \uB0A0\uACFC \uD3C9\uC18C \uC6B4\uC601\uC774
      \uAC19\uC740\uC9C0 \uAD81\uAE08\uD569\uB2C8\uB2E4. \uC77C\uC774 \uBAB0\uB9B4
      \uB54C \uBB34\uC5C7\uC774 \uBA3C\uC800 \uB2EC\uB77C\uC9C0\uB294\uC9C0 \uBB3C\uC5B4\uBCF4\uBA74
      \uC5B4\uB5A8\uAE4C\uC694?"
    resultDialogue: "\uC88B\uB124\uC694. \uC548\uB0B4\uBC1B\uC740 \uD55C \uC2DC\uAC04\uC73C\uB85C
      \uD558\uB8E8 \uC804\uCCB4\uB97C \uBD24\uB2E4\uACE0 \uC4F8 \uC218\uB294 \uC5C6\uC8E0.
      \uB2E4\uB978 \uC2DC\uAC04\uB300 \uC790\uB8CC\uAC00 \uC788\uB294\uC9C0\uB3C4
      \uBB3C\uC5B4\uBCF4\uACA0\uC2B5\uB2C8\uB2E4."
    resultValue: answer_0
    npcResult:
      eventId:
      companyId:
      actorId:
      actionId:
      targetNpcIds:
      - npc-economic-reporter-lee-mingyu
