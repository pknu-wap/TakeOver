    resultDialogue: "\uB9DE\uC544\uC694. \uCC98\uB9AC \uC2DC\uAC04\uC774 \uC904\uC5C8\uB2E4\uACE0
      \uC801\uC5C8\uB294\uB370 \uD655\uC778 \uC804\uD654\uAC00 \uB298\uC5C8\uB2E4\uBA74
      \uAC19\uC774 \uC368\uC57C\uACA0\uB124\uC694. \uD604\uC7A5 \uAC00\uAE30 \uC804\uC5D0
