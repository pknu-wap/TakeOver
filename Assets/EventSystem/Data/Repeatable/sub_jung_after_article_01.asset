  - choiceText: "\uBC18\uBCF5 \uC5F0\uB77D\uC774 \uBD80\uB2F4\uC2A4\uB7FD\uC9C0 \uC54A\uC740\uC9C0
      \uBB3B\uB294\uB2E4"
    choiceDescription: "\uC774\uBC88 \uB2F5\uBCC0\uC744 \uAD00\uACC4\uC640 \uAE30\uC5B5\uC5D0
      \uBC18\uC601\uD569\uB2C8\uB2E4. \uD604\uAE08\xB7\uC9C0\uBD84 \uBCC0\uD654 \uC5C6\uC74C."
    playerLine: "\uC790\uAFB8 \uACFC\uAC70\uB97C \uC774\uC57C\uAE30\uD574\uC57C \uD558\uBA74
      \uD798\uB4E4 \uC218\uB3C4 \uC788\uACA0\uC2B5\uB2C8\uB2E4. \uADF8\uBD84\uC774
      \uC5B4\uB5A4 \uC774\uC57C\uAE30\uB97C \uD558\uACE0 \uC2F6\uC740\uC9C0 \uBA3C\uC800
      \uBD10\uC57C\uACA0\uB124\uC694."
    resultDialogue: "\uB9DE\uC544\uC694. \uADF8\uB798\uC11C \uC774\uBC88\uC5D0\uB294
      \uC81C\uAC00 \uC900\uBE44\uD55C \uC9C8\uBB38\uC744 \uB35C \uD588\uC5B4\uC694.
      \uC548\uBD80\uB97C \uBB3C\uC73C\uB7EC \uAC14\uB2E4\uAC00 \uCDE8\uC7AC \uBAA9\uB85D\uB9CC
      \uCC44\uC6B0\uACE0 \uC624\uBA74 \uC548 \uB418\uB2C8\uAE4C\uC694."
    resultValue: answer_1
