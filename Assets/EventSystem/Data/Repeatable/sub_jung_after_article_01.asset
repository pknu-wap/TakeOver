  title: "\uC815\uC218\uC544 \u2014 \uAE30\uC0AC \uB4A4\uC5D0 \uB0A8\uC740 \uD558\uB8E8"
  image: {fileID: 21300000, guid: d8d3f113a14a1de47b97d1e11657d5d6, type: 3}
  cardImage: {fileID: 21300000, guid: d8d3f113a14a1de47b97d1e11657d5d6, type: 3}
  npcArts: []
  highlightImage: {fileID: 0}
  negotiationBackground: {fileID: 0}
  description: "\uC815\uC218\uC544 \u2014 \uAE30\uC0AC \uB4A4\uC5D0 \uB0A8\uC740
    \uD558\uB8E8\uC5D0 \uAD00\uD55C \uBA74\uB2F4 \uC694\uCCAD\uC785\uB2C8\uB2E4.
    \uB0B4\uC6A9\uACFC \uBE44\uC6A9\uC744 \uD655\uC778\uD55C \uB4A4 \uB9CC\uB098\uC2ED\uC2DC\uC624."
  apCost: 1
  startButtonText: "\uB9CC\uB098\uAE30"
  companyIds: []
  speakerNpcId: npc-investigative-reporter-jung-sua
  speakerName: "\uC815\uC218\uC544"
  speakerRole:
  dialogue: "\uC624\uB298 \uC608\uC804\uC5D0 \uBD40\uB358 \uBD84\uC744 \uB2E4\uC2DC
    \uB9CC\uB0AC\uC5B4\uC694. \uC81C\uAC00 \uCD5C\uADFC \uC548\uBD80\uB97C \uC5EC\uCB64\uBD24\uB354\uB2C8,
    \uC0C8 \uC77C\uC5D0 \uC801\uC751\uD558\uB290\uB77C \uAE30\uC0AC \uBCFC \uC2DC\uAC04\uB3C4
    \uC5C6\uC5C8\uB2E4\uACE0 \uD558\uC2DC\uB354\uB77C\uACE0\uC694."
  companyQuestion:
  companyPlayerLine:
  choices:
  - choiceText: "\uBB34\uC5C7\uC774 \uB098\uC544\uC84C\uB294\uC9C0 \uBB3C\uC5B4\uBCF8\uB2E4"
    choiceDescription: "\uC774\uBC88 \uB2F5\uBCC0\uC744 \uAD00\uACC4\uC640 \uAE30\uC5B5\uC5D0
      \uBC18\uC601\uD569\uB2C8\uB2E4. \uD604\uAE08\xB7\uC9C0\uBD84 \uBCC0\uD654 \uC5C6\uC74C."
    playerLine: "\uACF5\uC720\uD560 \uC218 \uC788\uB294 \uBC94\uC704\uC5D0\uC11C,
      \uC5B4\uB5A4 \uBD80\uBD84\uC774 \uB098\uC544\uC84C\uB294\uC9C0 \uAD81\uAE08\uD569\uB2C8\uB2E4.
      \uBB38\uC81C\uAC00 \uC788\uC5C8\uB358 \uC77C\uB9CC\uC73C\uB85C \uADF8\uBD84\uC744
      \uAE30\uC5B5\uD558\uACE0 \uC2F6\uC9C0\uB294 \uC54A\uAD70\uC694."
    resultDialogue: "\uC800\uB3C4 \uADF8\uB798\uC694. \uC138\uBD80 \uC0AC\uC815\uC740
      \uB9D0\uC500\uB4DC\uB9AC\uAE30 \uC5B4\uB835\uC9C0\uB9CC \uC0C8 \uC77C\uC5D0\uC11C
      \uC775\uC219\uD574\uC9C4 \uAC8C \uC0DD\uACBC\uB2E4\uACE0 \uD558\uC168\uC5B4\uC694.
      \uC81C\uAC00 \uAC71\uC815\uD558\uB294 \uC774\uC57C\uAE30\uB9CC \uBB3C\uC5C8\uC73C\uBA74
      \uBABB \uB4E4\uC5C8\uACA0\uC8E0."
    resultValue: answer_0
    npcResult:
      eventId:
      companyId:
      actorId:
      actionId:
      targetNpcIds:
      - npc-investigative-reporter-jung-sua
