  eventId: neutral-jung-first-record
  category: 0
  linearDialogue: 0
  tutorialOnly: 0
  title: "\uC815\uC218\uC544 \u2014 \uAC70\uB798 \uC774\uD6C4\uC5D0 \uB0A8\uC740
    \uAE30\uB85D"
  image: {fileID: 21300000, guid: e4f06f328acf53c4385995fb1f2c1e65, type: 3}
  cardImage: {fileID: 21300000, guid: d04aa39026668454991718ef00702904, type: 3}
  npcArts: []
  highlightImage: {fileID: 0}
  negotiationBackground: {fileID: 0}
  description: "\uC815\uC218\uC544\uAC00 \uC774\uBBF8 \uBCF4\uB3C4\uD55C \uAE30\uC0AC\uC640
    \uCDE8\uC7AC \uACBD\uACFC\uB97C \uAC00\uC838\uC654\uB2E4. \uAC70\uB798\uAC00
    \uB05D\uB0AC\uB2E4\uACE0 \uC801\uD78C \uB0A0 \uC774\uD6C4 \uD68C\uC0AC\uC640
    \uC9C1\uC6D0\uC5D0\uAC8C \uC5B4\uB5A4 \uC77C\uC774 \uB0A8\uC558\uB294\uC9C0 \uB4E4\uC5B4\uBCF4\uACE0
    \uC2F6\uB2E4."
  apCost: 1
  startButtonText: "\uB9CC\uB098\uAE30"
  companyIds: []
  speakerNpcId: npc-investigative-reporter-jung-sua
  speakerName: "\uC815\uC218\uC544"
  speakerRole:
  dialogue: "\uC640\uC8FC\uC154\uC11C \uACE0\uB9C8\uC6CC\uC694. \uC9C0\uB09C\uBC88\uC5D0
    \uC5F0\uB77D\uCC98\uB9CC \uB4DC\uB9AC\uACE0 \uC81C\uB300\uB85C \uB9D0\uC500\uC744
    \uBABB \uB098\uB234\uC8E0. \uD68C\uC0AC\uB294 \uC880 \uB354 \uBCF4\uC168\uC5B4\uC694?"
  companyQuestion:
  companyPlayerLine:
  choices:
  - choiceText: "\uACC4\uD68D\uC774 \uBC14\uB014 \uB54C\uC758 \uC124\uBA85\uC744
      \uB4E3\uACE0 \uC2F6\uB2E4\uACE0 \uD55C\uB2E4"
    choiceDescription:
    playerLine: "\uC9C0\uAE08 \uACC4\uD68D\uC774 \uC88B\uC544 \uBCF4\uC774\uB294\uC9C0\uB3C4
      \uC911\uC694\uD558\uC9C0\uB9CC, \uB2EC\uB77C\uC84C\uC744 \uB54C \uB204\uAD6C\uC5D0\uAC8C
      \uBB34\uC5C7\uC744 \uC124\uBA85\uD560\uC9C0\uB3C4 \uAD81\uAE08\uD569\uB2C8\uB2E4.
      \uD22C\uC790\uC790\uD55C\uD14C\uB9CC \uC124\uBA85\uD558\uACE0 \uD604\uC7A5\uC5D0\uB294
      \uB2A6\uAC8C \uC54C\uB824\uC904 \uC218\uB3C4 \uC788\uACA0\uC8E0."
    resultDialogue: "\uADF8 \uC9C8\uBB38\uC740 \uD68C\uC0AC\uC5D0 \uC9C1\uC811 \uD574\uBCF4\uC154\uB3C4
      \uC88B\uACA0\uB124\uC694. \uB2F9\uC2DC \uC790\uB8CC\uB97C \uBCF4\uBA74 \uBC1C\uD45C\uB41C
      \uB0A0\uC9DC\uD558\uACE0 \uD604\uC7A5\uC5D0\uC11C \uC54C\uAC8C \uB41C \uB0A0\uC9DC\uAC00
      \uB2E4\uB978 \uACBD\uC6B0\uAC00 \uC788\uAC70\uB4E0\uC694.\n\n\uB124. \uADF8\uB54C
      \uC0C1\uD669\uC744 \uBCF4\uACE0 \uB2E4\uC2DC \uC774\uC57C\uAE30\uD574\uC694.
      \uC9C0\uAE08 \uC790\uB8CC\uB97C \uC8FC\uC2DC\uACA0\uB2E4\uACE0 \uC57D\uC18D\uD558\uC2E4
      \uD544\uC694\uB294 \uC5C6\uC2B5\uB2C8\uB2E4."
    resultValue: answer_0
    npcResult:
      eventId:
      companyId:
      actorId:
      actionId:
      targetNpcIds:
      - npc-investigative-reporter-jung-sua
      targetReactions: []
