  - choiceText: "\uD22C\uC790 \uD310\uB2E8\uACFC \uCDE8\uC7AC \uCC38\uC5EC\uB97C
      \uAD6C\uBD84\uD55C\uB2E4"
    choiceDescription:
    playerLine: "\uC790\uB8CC\uB294 \uC77D\uC5B4\uBCF4\uACA0\uC2B5\uB2C8\uB2E4. \uB2E4\uB9CC
      \uC81C\uAC00 \uB4E4\uC740 \uD68C\uC0AC \uC774\uC57C\uAE30\uB97C \uBC14\uB85C
