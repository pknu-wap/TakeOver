  - choiceText: "\uB0A8\uC740 \uC0AC\uC5C5\uACFC \uC0AC\uB78C\uC758 \uAC00\uCE58\uB97C
      \uD568\uAED8 \uBCF4\uACE0 \uC2F6\uB2E4\uACE0 \uD55C\uB2E4"
    choiceDescription:
    playerLine: "\uC774\uBBF8 \uB09C \uC190\uC2E4\uB9CC \uBCF4\uBA74 \uD68C\uC0AC\uAC00
      \uB108\uBB34 \uB2E8\uC21C\uD574\uC9D1\uB2C8\uB2E4. \uADF8 \uB4A4\uC5D0\uB3C4
      \uC77C\uC744 \uC774\uC5B4\uC628 \uC0AC\uB78C\uB4E4\uC774 \uC788\uB2E4\uBA74,
      \uC55E\uC73C\uB85C \uBB58 \uD560 \uC218 \uC788\uB294\uC9C0\uB3C4 \uB4E3\uACE0
      \uC2F6\uC2B5\uB2C8\uB2E4."
    resultDialogue: "\uC800\uB3C4 \uADF8\uBD84\uB4E4\uC744 \uD53C\uD574 \uBCF8 \uC0AC\uB78C\uC73C\uB85C\uB9CC
      \uC4F0\uACE0 \uC2F6\uC9C0\uB294 \uC54A\uC544\uC694. \uB2E4\uC2DC \uC77C\uC744
      \uC2DC\uC791\uD558\uC2E0 \uBD84\uB3C4 \uC788\uACE0, \uB0A8\uC544\uC11C \uBC29\uBC95\uC744
      \uCC3E\uC740 \uBD84\uB3C4 \uACC4\uC2DC\uB2C8\uAE4C\uC694.\n\n\uB124. \uADF8\uB798\uC11C
      \uC2DC\uAC04\uC774 \uB354 \uAC78\uB824\uB3C4 \uB2E4\uC2DC \uB9CC\uB0A9\uB2C8\uB2E4.
      \uB2E4\uB9CC \uC798 \uBC84\uD17C\uB2E4\uB294 \uC774\uC57C\uAE30 \uB54C\uBB38\uC5D0
      \uB204\uAC00 \uC5B4\uB5A4 \uBD80\uB2F4\uC744 \uC92C\uB294\uC9C0\uAE4C\uC9C0
      \uD750\uB824\uC9C0\uC9C0\uB294 \uC54A\uC558\uC73C\uBA74 \uD574\uC694."
