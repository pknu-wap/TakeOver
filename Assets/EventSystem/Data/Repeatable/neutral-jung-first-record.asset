      scene: 0
    - npcId:
      text: "\uADF8\uB7F0 \uCC28\uC774\uAC00 \uC788\uC73C\uBA74 \uAE30\uC790\uB2D8\uAED8\uB3C4
        \uC54C\uB824\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4. \uACF5\uC720\uD560 \uC218
        \uC788\uB294 \uB0B4\uC6A9\uC774\uB77C\uBA74\uC694."
      player: 1
