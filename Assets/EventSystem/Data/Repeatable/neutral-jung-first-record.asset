  openingLines:
  - npcId:
    text: "\uC815\uC218\uC544\uB294 \uD14C\uC774\uBE14 \uC704\uC758 \uB450\uAEBC\uC6B4
      \uC11C\uB958\uB97C \uC790\uAE30 \uCABD\uC73C\uB85C \uC815\uB9AC\uD588\uB2E4.
      \uB0B4\uAC8C \uAC74\uB128 \uAC83\uC740 \uC774\uBBF8 \uACF5\uAC1C\uD55C \uAE30\uC0AC\uC640
      \uC9E7\uC740 \uCDE8\uC7AC \uACBD\uACFC\uBFD0\uC774\uC5C8\uB2E4."
    player: 0
    narration: 1
    scene: 0
  - npcId: npc-investigative-reporter-jung-sua
    text: "\uC640\uC8FC\uC154\uC11C \uACE0\uB9C8\uC6CC\uC694. \uC9C0\uB09C\uBC88\uC5D0
      \uC5F0\uB77D\uCC98\uB9CC \uB4DC\uB9AC\uACE0 \uC81C\uB300\uB85C \uB9D0\uC500\uC744
      \uBABB \uB098\uB234\uC8E0. \uD68C\uC0AC\uB294 \uC880 \uB354 \uBCF4\uC168\uC5B4\uC694?"
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uC870\uAE08\uC529\uC694. \uAC19\uC740 \uD68C\uC0AC\uC778\uB370 \uB204\uAD6C\uD55C\uD14C
      \uBB3B\uB290\uB0D0\uC5D0 \uB530\uB77C \uAE09\uD55C \uC77C\uC774 \uB2E4\uB974\uB354\uAD70\uC694."
    player: 1
    narration: 0
    scene: 0
  - npcId: npc-investigative-reporter-jung-sua
    text: "\uADF8\uB7F4 \uAC70\uC608\uC694. \uB300\uD45C\uB2D8\uC740 \uB2E4\uC74C
      \uACC4\uC57D\uC774 \uAE09\uD558\uACE0, \uD604\uC7A5\uC740 \uC774\uBC88 \uC9C0\uAE09\uC77C\uC774
      \uAE09\uD560 \uC218 \uC788\uC73C\uB2C8\uAE4C\uC694."
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uCDE8\uC7AC\uD558\uC2DC\uB294 \uBD84\uB4E4\uB3C4 \uADF8\uB807\uC2B5\uB2C8\uAE4C?"
    player: 1
    narration: 0
    scene: 0
  - npcId: npc-investigative-reporter-jung-sua
    text: "\uB124. \uC5B4\uB5A4 \uBD84\uC740 \uADF8 \uAC70\uB798\uB97C \uD070 \uC2E4\uC218\uB77C\uACE0
      \uD574\uC694. \uB2E4\uB978 \uBD84\uC740 \uADF8\uB54C\uB294 \uB2E4\uB978 \uC120\uD0DD\uC774
      \uC5C6\uC5C8\uB2E4\uACE0 \uD558\uACE0\uC694. \uAC19\uC740 \uC790\uB9AC\uC5D0
      \uACC4\uC168\uB294\uB370 \uAE30\uC5B5\uD558\uB294 \uC21C\uC11C\uB3C4 \uC870\uAE08\uC529
      \uB2E4\uB974\uACE0\uC694."
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uADF8\uC911\uC5D0 \uB9DE\uB294 \uB9D0\uC744 \uCC3E\uC544\uC57C\uACA0\uAD70\uC694."
    player: 1
    narration: 0
    scene: 0
  - npcId: npc-investigative-reporter-jung-sua
    text: "\uB9DE\uB294 \uBD80\uBD84\uC774 \uC11C\uB85C \uB2E4\uB97C \uC218\uB3C4
      \uC788\uC5B4\uC694. \uD68C\uC0AC\uAC00 \uC190\uC2E4\uC744 \uC904\uC600\uB2E4\uB294
      \uC124\uBA85\uB3C4 \uB9DE\uACE0, \uADF8 \uACFC\uC815\uC5D0\uC11C \uB204\uAD70\uAC00\uB294
      \uC77C\uC744 \uC783\uC5C8\uB2E4\uB294 \uB9D0\uB3C4 \uB9DE\uC744 \uC218 \uC788\uC8E0."
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uC815\uC218\uC544\uB294 \uAE30\uC0AC \uD55C\uCABD\uC744 \uAC00\uB9AC\uCF30\uB2E4.
      \uC0AC\uC5C5 \uC911\uB2E8\uC744 \uC54C\uB9AC\uB294 \uC9E7\uC740 \uBB38\uC7A5
      \uC544\uB798\uC5D0, \uADF8 \uC774\uD6C4\uB97C \uBB3B\uB294 \uC9C8\uBB38\uC774
      \uC801\uD600 \uC788\uC5C8\uB2E4."
    player: 0
    narration: 1
    scene: 0
  - npcId:
    text: "\uC774\uB7F0 \uCDE8\uC7AC\uB97C \uC2DC\uC791\uD55C \uACC4\uAE30\uAC00
      \uC788\uC2B5\uB2C8\uAE4C?"
    player: 1
    narration: 0
    scene: 0
  - npcId: npc-investigative-reporter-jung-sua
    text: "\uC608\uC804\uC5D0 \uC0AC\uC5C5 \uC815\uB9AC \uC18C\uC2DD\uC744 \uC4F0\uACE0
      \uBA87 \uB2EC \uB4A4\uC5D0 \uB2E4\uC2DC \uAC04 \uC801\uC774 \uC788\uC5B4\uC694.
      \uC800\uB294 \uC77C\uC774 \uB05D\uB0AC\uB2E4\uACE0 \uC0DD\uAC01\uD588\uB294\uB370,
      \uADF8\uBD84\uB4E4\uC740 \uC544\uC9C1 \uB3C8\uC744 \uBC1B\uC73C\uB7EC \uB2E4\uB2C8\uACE0
      \uACC4\uC2DC\uB354\uB77C\uACE0\uC694."
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uC815\uB9AC\uAC00 \uB05D\uB0AC\uB2E4\uB294 \uAE30\uC0AC \uB4A4\uC5D0
      \uB0A8\uC740 \uC77C\uC774 \uC788\uC5C8\uAD70\uC694."
    player: 1
    narration: 0
    scene: 0
  - npcId: npc-investigative-reporter-jung-sua
    text: "\uB124. \uC81C\uAC00 \uC798\uBABB \uC4F4 \uBD80\uBD84\uB3C4 \uC788\uC5C8\uC5B4\uC694.
      \uD68C\uC0AC\uAC00 \uBC1C\uD45C\uD55C \uC815\uB9AC\uC640 \uADF8\uBD84\uB4E4
      \uC0DD\uD65C\uC758 \uC815\uB9AC\uB97C \uAC19\uC740 \uB9D0\uB85C \uC368\uBC84\uB9B0
      \uAC70\uC8E0. \uADF8 \uB4A4\uB85C\uB294 \uD55C \uBC88 \uB354 \uAC00\uBCF4\uB824\uACE0
      \uD569\uB2C8\uB2E4."
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uC774\uBC88 \uBBF8\uB798\uAC74\uC124 \uCDE8\uC7AC\uB3C4 \uADF8 \uC77C\uC758
      \uC5F0\uC7A5\uC785\uB2C8\uAE4C?"
    player: 1
    narration: 0
    scene: 0
  - npcId: npc-investigative-reporter-jung-sua
    text: "\uBE44\uC2B7\uD55C \uC9C8\uBB38\uC5D0\uC11C \uC2DC\uC791\uD588\uC5B4\uC694.
      \uADF8\uB807\uB2E4\uACE0 \uC0AC\uC815\uAE4C\uC9C0 \uAC19\uC744 \uAC70\uB77C\uACE0
      \uBCF4\uC9C0\uB294 \uC54A\uC2B5\uB2C8\uB2E4. \uC624\uB298\uB3C4 \uB204\uAC00
      \uCC45\uC784\uC774 \uC788\uB294\uC9C0 \uACB0\uB860\uC744 \uB9D0\uC500\uB4DC\uB9AC\uB824\uACE0
      \uBD80\uB978 \uAC74 \uC544\uB2C8\uACE0\uC694."
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uC81C\uAC8C\uB294 \uC5B4\uB5A4 \uC598\uAE30\uB97C \uB4E3\uACE0 \uC2F6\uC73C\uC168\uC2B5\uB2C8\uAE4C?"
    player: 1
    narration: 0
    scene: 0
  - npcId: npc-investigative-reporter-jung-sua
    text: "\uD68C\uC0AC\uB97C \uC0B4\uD3B4\uBCF4\uB294 \uC0AC\uB78C\uC774 \uBB34\uC5C7\uC744
      \uC54C\uBA74 \uD310\uB2E8\uC744 \uBC14\uAFB8\uB294\uC9C0\uC694. \uC800\uB294
      \uC77C\uC774 \uC9C0\uB098\uAC04 \uB4A4\uC5D0 \uB4E3\uB294 \uB9D0\uC774 \uB9CE\uC544\uC694.
      \uADF8\uC804\uC5D0 \uC5B4\uB5A4 \uC124\uBA85\uC744 \uB4E4\uC5C8\uB294\uC9C0\uB3C4
      \uC54C\uACE0 \uC2F6\uC2B5\uB2C8\uB2E4."
    player: 0
    narration: 0
    scene: 0
  companyVariants: []
