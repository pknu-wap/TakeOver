  category: 0
  tutorialOnly: 0
  title: "\uC815\uC218\uC544 \u2014 \uC9E7\uC544\uC9C4 \uD574\uBA85\uBB38"
  image: {fileID: 21300000, guid: d8d3f113a14a1de47b97d1e11657d5d6, type: 3}
  cardImage: {fileID: 21300000, guid: d8d3f113a14a1de47b97d1e11657d5d6, type: 3}
  npcArts: []
  highlightImage: {fileID: 0}
  negotiationBackground: {fileID: 0}
  description: "\uC815\uC218\uC544 \u2014 \uC9E7\uC544\uC9C4 \uD574\uBA85\uBB38\uC5D0
    \uAD00\uD55C \uBA74\uB2F4 \uC694\uCCAD\uC785\uB2C8\uB2E4. \uB0B4\uC6A9\uACFC
    \uBE44\uC6A9\uC744 \uD655\uC778\uD55C \uB4A4 \uB9CC\uB098\uC2ED\uC2DC\uC624."
  apCost: 1
  startButtonText: "\uB9CC\uB098\uAE30"
  companyIds: []
  speakerNpcId: npc-investigative-reporter-jung-sua
  speakerName: "\uC815\uC218\uC544"
  speakerRole:
  dialogue: "\uD68C\uC0AC \uC124\uBA85\uC774 \uAE38\uBA74 \uC548 \uC77D\uD78C\uB2E4\uB294
    \uB9D0\uC744 \uC790\uC8FC \uB4E3\uC2B5\uB2C8\uB2E4. \uADF8\uB798\uC11C \uC9E7\uAC8C
    \uC815\uB9AC\uD558\uBA74, \uC774\uBC88\uC5D0\uB294 \uC911\uC694\uD55C \uAC78
    \uBE90\uB2E4\uACE0 \uD558\uC2DC\uACE0\uC694."
  companyQuestion:
  companyPlayerLine:
  choices:
  - choiceText: "\uBB34\uC5C7\uC744 \uC870\uCE58\uD588\uACE0 \uBB34\uC5C7\uC774 \uB0A8\uC558\uB294\uC9C0
      \uBB3B\uB294\uB2E4"
    choiceDescription: "\uC774\uBC88 \uB2F5\uBCC0\uC744 \uAD00\uACC4\uC640 \uAE30\uC5B5\uC5D0
      \uBC18\uC601\uD569\uB2C8\uB2E4. \uD604\uAE08\xB7\uC9C0\uBD84 \uBCC0\uD654 \uC5C6\uC74C."
    playerLine: "\uB05D\uB09C \uC77C\uACFC \uB0A8\uC740 \uC77C\uC744 \uAD6C\uBD84\uD574\uC92C\uC73C\uBA74
      \uD569\uB2C8\uB2E4. \uC870\uCE58\uD588\uB2E4\uB294 \uB9D0\uB9CC\uC73C\uB85C
      \uC190\uC2E4\uC774\uB098 \uBD88\uD3B8\uAE4C\uC9C0 \uC0AC\uB77C\uC9C4 \uAC83\uCC98\uB7FC
      \uC77D\uD788\uB2C8\uAE4C\uC694."
    resultDialogue: "\uADF8 \uAD6C\uBD84\uC740 \uB123\uC5B4\uC57C\uACA0\uB124\uC694.
      \uC870\uCE58\uB97C \uC2DC\uC791\uD588\uB2E4\uB294 \uB9D0\uB3C4 \uC644\uB8CC\uB85C
      \uBC14\uB00C\uC9C0 \uC54A\uAC8C \uBCF4\uACE0\uC694. \uC81C \uBB38\uC7A5\uC5D0\uC11C\uB3C4
      \uC790\uC8FC \uD655\uC778\uD574\uC57C \uD558\uB294 \uBD80\uBD84\uC785\uB2C8\uB2E4."
    resultValue: answer_0
    npcResult:
      eventId:
