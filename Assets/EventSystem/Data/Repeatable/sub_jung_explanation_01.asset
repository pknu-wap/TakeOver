  - choiceText: "\uD310\uB2E8\uC758 \uADFC\uAC70\uC640 \uD655\uC778\uD560 \uBC29\uBC95\uC744
      \uBB3B\uB294\uB2E4"
    choiceDescription: "\uC774\uBC88 \uB2F5\uBCC0\uC744 \uAD00\uACC4\uC640 \uAE30\uC5B5\uC5D0
      \uBC18\uC601\uD569\uB2C8\uB2E4. \uD604\uAE08\xB7\uC9C0\uBD84 \uBCC0\uD654 \uC5C6\uC74C."
    playerLine: "\uD574\uACB0\uB410\uB2E4\uACE0 \uBCF4\uB294 \uADFC\uAC70\uAC00 \uAD81\uAE08\uD569\uB2C8\uB2E4.
      \uC22B\uC790\uC778\uC9C0, \uB2F9\uC0AC\uC790 \uC124\uBA85\uC778\uC9C0, \uBB34\uC5C7\uC744
      \uBCF4\uACE0 \uD310\uB2E8\uD588\uB294\uC9C0\uC694."
    resultDialogue: "\uB124. \uD55C\uCABD\uC758 \uC124\uBA85\uC774\uBA74 \uADF8\uB807\uAC8C
      \uBC1D\uD600\uC57C\uACA0\uC8E0. \uC81C\uAC00 \uD655\uC778\uD55C \uBC94\uC704\uD558\uACE0
      \uC544\uC9C1 \uB4E3\uAE30\uB9CC \uD55C \uBD80\uBD84\uB3C4 \uB098\uB204\uACA0\uC2B5\uB2C8\uB2E4."
    resultValue: answer_1
