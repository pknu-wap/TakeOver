  - choiceText: "\uC26C\uC6B4 \uC694\uC57D\uACFC \uC0C1\uC138 \uC124\uBA85\uC744
      \uD568\uAED8 \uB450\uC790\uACE0 \uD55C\uB2E4"
    choiceDescription: "\uC774\uBC88 \uB2F5\uBCC0\uC744 \uAD00\uACC4\uC640 \uAE30\uC5B5\uC5D0
      \uBC18\uC601\uD569\uB2C8\uB2E4. \uD604\uAE08\xB7\uC9C0\uBD84 \uBCC0\uD654 \uC5C6\uC74C."
    playerLine: "\uCC98\uC74C\uC5D0\uB294 \uC9E7\uAC8C \uC77D\uC744 \uC218 \uC788\uAC8C
      \uD558\uB418 \uC790\uC138\uD55C \uC124\uBA85\uB3C4 \uC774\uC5B4\uC11C \uBCFC
      \uC218 \uC788\uC73C\uBA74 \uC88B\uACA0\uC2B5\uB2C8\uB2E4. \uC774\uD574\uD558\uAE30
      \uC5B4\uB824\uC6CC\uC11C \uC544\uC608 \uC548 \uC77D\uB294 \uACBD\uC6B0\uB3C4
      \uC788\uC744 \uD14C\uB2C8\uAE4C\uC694."
    resultDialogue: "\uB9DE\uC544\uC694. \uC911\uC694\uD55C \uB0B4\uC6A9\uC744 \uC9C0\uD0A4\uACA0\uB2E4\uACE0
      \uB204\uAD6C\uB3C4 \uB05D\uAE4C\uC9C0 \uBABB \uC77D\uAC8C \uC4F0\uBA74 \uACE4\uB780\uD558\uC8E0.
      \uC694\uC57D\uC5D0\uC11C \uC0DD\uB7B5\uD55C \uBC94\uC704\uB3C4 \uBCF4\uC774\uAC8C
      \uD574\uBCF4\uACA0\uC2B5\uB2C8\uB2E4."
    resultValue: answer_2
