  - choiceText: "\uC131\uC0AC\uB418\uC9C0 \uC54A\uC558\uC744 \uB54C\uC758 \uBE44\uC6A9\uC744
      \uBB3B\uB294\uB2E4"
    choiceDescription: "\uC774\uBC88 \uB2F5\uBCC0\uC744 \uAD00\uACC4\uC640 \uAE30\uC5B5\uC5D0
      \uBC18\uC601\uD569\uB2C8\uB2E4. \uD604\uAE08\xB7\uC9C0\uBD84 \uBCC0\uD654 \uC5C6\uC74C."
    playerLine: "\uAC70\uB798\uAC00 \uC548 \uB410\uC744 \uB54C \uC5B4\uB5A4 \uBE44\uC6A9\uC774
      \uB0A8\uB294\uC9C0\uBD80\uD130 \uC54C\uACE0 \uC2F6\uC2B5\uB2C8\uB2E4. \uC911\uAC04\uC5D0
      \uC81C\uAC00 \uCCA0\uD68C\uD558\uB294 \uACBD\uC6B0\uB3C4\uC694."
    resultDialogue: "\uADF8 \uC9C8\uBB38 \uC88B\uB124\uC694. \uC131\uACF5\uD588\uC744
      \uB54C\uC758 \uBE44\uC6A9\uB9CC \uC774\uC57C\uAE30\uD558\uBA74 \uC2E4\uD328\uD55C
      \uB4A4\uC5D0 \uC11C\uB85C \uAE30\uC5B5\uC774 \uB2EC\uB77C\uC9D1\uB2C8\uB2E4.
      \uC2E4\uC81C \uC77C\uC744 \uB9E1\uAE30\uC2E4 \uB54C \uADF8 \uC870\uAC74\uBD80\uD130
      \uC801\uC8E0."
    resultValue: answer_1
