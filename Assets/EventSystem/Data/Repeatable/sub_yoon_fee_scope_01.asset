  title: "\uC724\uD558\uC9C4 \u2014 \uC218\uC218\uB8CC\uBD80\uD130 \uB9D0\uD574\uB450\uC8E0"
  image: {fileID: 21300000, guid: e4ad3f1b63392de47bb9cbfeb6be2bd0, type: 3}
  cardImage: {fileID: 21300000, guid: e317d1d530e3577478c641da73f9c3d8, type: 3}
  npcArts: []
  highlightImage: {fileID: 0}
  negotiationBackground: {fileID: 0}
  description: "\uC724\uD558\uC9C4 \u2014 \uC218\uC218\uB8CC\uBD80\uD130 \uB9D0\uD574\uB450\uC8E0\uC5D0
    \uAD00\uD55C \uBA74\uB2F4 \uC694\uCCAD\uC785\uB2C8\uB2E4. \uB0B4\uC6A9\uACFC
    \uBE44\uC6A9\uC744 \uD655\uC778\uD55C \uB4A4 \uB9CC\uB098\uC2ED\uC2DC\uC624."
  apCost: 1
  startButtonText: "\uB9CC\uB098\uAE30"
  companyIds: []
  speakerNpcId: npc-broker-yoon-hajin
  speakerName: "\uC724\uD558\uC9C4"
  speakerRole:
  dialogue: "\uAC70\uB798 \uC774\uC57C\uAE30\uB97C \uAEBC\uB0B4\uAE30 \uC804\uC5D0
    \uADC0\uCC2E\uC740 \uAC83\uBD80\uD130 \uC815\uD574\uB450\uC8E0. \uC81C\uAC00
    \uC5B4\uB514\uAE4C\uC9C0 \uD558\uBA74 \uC218\uC218\uB8CC\uB97C \uBC1B\uB294\uC9C0\uC694."
  companyQuestion:
  companyPlayerLine:
  choices:
  - choiceText: "\uC5C5\uBB34 \uBC94\uC704\uB97C \uBA3C\uC800 \uC801\uC5B4\uB2EC\uB77C\uACE0
      \uD55C\uB2E4"
    choiceDescription: "\uC774\uBC88 \uB2F5\uBCC0\uC744 \uAD00\uACC4\uC640 \uAE30\uC5B5\uC5D0
      \uBC18\uC601\uD569\uB2C8\uB2E4. \uD604\uAE08\xB7\uC9C0\uBD84 \uBCC0\uD654 \uC5C6\uC74C."
    playerLine: "\uC18C\uAC1C, \uC790\uB8CC \uD655\uC778, \uD611\uC0C1 \uC9C0\uC6D0\uC744
      \uB098\uB220\uC11C \uC801\uC5B4\uC8FC\uC138\uC694. \uC81C\uAC00 \uC5B4\uB290
      \uC77C\uAE4C\uC9C0 \uBD80\uD0C1\uD558\uB294\uC9C0\uBD80\uD130 \uC815\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    resultDialogue: "\uC88B\uC544\uC694. \uC18C\uAC1C\uBC1B\uC558\uB2E4\uACE0 \uC81C
      \uAC80\uC99D\uAE4C\uC9C0 \uC0C0\uB2E4\uACE0 \uC0DD\uAC01\uD558\uC2DC\uBA74
      \uACE4\uB780\uD558\uB2C8\uAE4C\uC694. \uD655\uC778\uD558\uC9C0 \uC54A\uC740
      \uBD80\uBD84\uB3C4 \uD45C\uC2DC\uD574\uB458\uAC8C\uC694."
    resultValue: answer_0
    npcResult:
      eventId:
