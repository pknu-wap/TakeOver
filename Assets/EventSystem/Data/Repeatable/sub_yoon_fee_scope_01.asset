    choiceDescription: "\uC774\uBC88 \uB2F5\uBCC0\uC744 \uAD00\uACC4\uC640 \uAE30\uC5B5\uC5D0
      \uBC18\uC601\uD569\uB2C8\uB2E4. \uD604\uAE08\xB7\uC9C0\uBD84 \uBCC0\uD654 \uC5C6\uC74C."
    playerLine: "\uC6D0\uCE59\uC740 \uC54C\uACA0\uC2B5\uB2C8\uB2E4. \uB2E4\uB9CC
      \uC9C0\uAE08\uC740 \uC870\uAC74\uC744 \uC815\uD558\uC9C0 \uC54A\uACE0, \uC2E4\uC81C
      \uAC70\uB798\uAC00 \uC0DD\uACBC\uC744 \uB54C \uC5C5\uBB34 \uBC94\uC704\uC640
      \uD568\uAED8 \uBCF4\uACA0\uC2B5\uB2C8\uB2E4."
    resultDialogue: "\uB124. \uADF8\uB7FC \uC624\uB298 \uB2F5\uC744 \uACC4\uC57D\uCC98\uB7FC
      \uBC1B\uC544\uB450\uC9C0\uB294 \uC54A\uC744\uAC8C\uC694. \uB098\uC911\uC5D0
