  title: "\uC724\uD558\uC9C4 \u2014 \uAC70\uB798\uCC98\uC5D0 \uBCF4\uB0BC \uC18C\uAC1C"
  image: {fileID: 21300000, guid: e4ad3f1b63392de47bb9cbfeb6be2bd0, type: 3}
  cardImage: {fileID: 21300000, guid: e317d1d530e3577478c641da73f9c3d8, type: 3}
  npcArts: []
  highlightImage: {fileID: 0}
  negotiationBackground: {fileID: 0}
  description: "\uC724\uD558\uC9C4\uC774 \uAC70\uB798\uCC98\uC5D0 \uB0B4 \uC774\uB984\uC744
    \uC804\uD558\uACA0\uB2E4\uACE0 \uD55C\uB2E4. \uB9CC\uB098\uAE30\uB3C4 \uC804\uC5D0
    \uC0C1\uB300\uAC00 \uC790\uAE08 \uC57D\uC18D\uC744 \uBC1B\uC740 \uC904 \uC54C\uBA74
    \uACE4\uB780\uD558\uB2E4. \uC5B4\uB514\uAE4C\uC9C0 \uC804\uD560\uC9C0 \uBA3C\uC800
    \uB9DE\uCDB0\uC57C\uACA0\uB2E4."
  apCost: 1
  startButtonText: "\uB9CC\uB098\uAE30"
  companyIds: []
  speakerNpcId: npc-broker-yoon-hajin
  speakerName: "\uC724\uD558\uC9C4"
  speakerRole:
  dialogue: "\uC18C\uAC1C\uB97C \uD558\uB098 \uD560 \uC218\uB3C4 \uC788\uB294\uB370,
    \uBA3C\uC800 \uD655\uC778\uD560 \uAC8C \uC788\uC5B4\uC694. \uC0C1\uB300\uC5D0\uAC8C
    \uC5B4\uB5A4 \uBD84\uC774\uB77C\uACE0 \uB9D0\uC500\uB4DC\uB9AC\uBA74 \uB420\uAE4C\uC694?"
  companyQuestion:
  companyPlayerLine:
  choices:
  - choiceText: "\uD22C\uC790 \uAC00\uB2A5\uC131\uC744 \uAC80\uD1A0\uD558\uB294 \uC790\uB9AC\uB77C\uACE0
      \uC18C\uAC1C\uD55C\uB2E4"
    choiceDescription:
    playerLine: "\uD22C\uC790 \uAC00\uB2A5\uC131\uC744 \uC54C\uC544\uBCF4\uB294 \uC790\uB9AC\uB77C\uACE0
      \uD574\uC8FC\uC138\uC694. \uAE08\uC561\uC774\uB098 \uCC38\uC5EC \uC5EC\uBD80\uB294
      \uC790\uB8CC\uB97C \uBCF8 \uB4A4\uC5D0 \uC815\uD55C\uB2E4\uACE0\uC694."
    resultDialogue: "\uADF8\uB807\uAC8C \uC804\uD558\uC8E0. \uC0C1\uB300\uAC00 \uD655\uB2F5\uC744
      \uC6D0\uD558\uBA74 \uC18C\uAC1C \uC804\uC5D0 \uB2E4\uC2DC \uD655\uC778\uD558\uACA0\uC2B5\uB2C8\uB2E4.
      \uAE30\uB300\uB9CC \uD0A4\uC6CC\uC11C \uC790\uB9AC\uB97C \uB9CC\uB4DC\uB294
      \uAC74 \uC800\uD55C\uD14C\uB3C4 \uC190\uD574\uC608\uC694."
    resultValue: answer_0
    npcResult:
      eventId:
