  eventId: sub_kim_cash_room_01
  category: 0
  tutorialOnly: 0
  title: "\uAE40\uD0DC\uC131 \u2014 \uB2E4\uC74C \uC77C\uC815\uC5D0 \uC4F8 \uB3C8"
  image: {fileID: 21300000, guid: 19c4990f7686f4d49b8c0ca95d675ea4, type: 3}
  cardImage: {fileID: 21300000, guid: 19c4990f7686f4d49b8c0ca95d675ea4, type: 3}
  npcArts: []
  highlightImage: {fileID: 0}
  negotiationBackground: {fileID: 0}
  description: "\uAE40\uD0DC\uC131 \u2014 \uB2E4\uC74C \uC77C\uC815\uC5D0 \uC4F8
    \uB3C8\uC5D0 \uAD00\uD55C \uBA74\uB2F4 \uC694\uCCAD\uC785\uB2C8\uB2E4. \uB0B4\uC6A9\uACFC
    \uBE44\uC6A9\uC744 \uD655\uC778\uD55C \uB4A4 \uB9CC\uB098\uC2ED\uC2DC\uC624."
  apCost: 1
  startButtonText: "\uB9CC\uB098\uAE30"
  companyIds: []
  speakerNpcId: npc-institutional-investor-kim-taeseong
  speakerName: "\uAE40\uD0DC\uC131"
  speakerRole:
  dialogue: "\uC790\uC0B0\uC774 \uB298\uBA74 \uB9C8\uC74C\uC774 \uC870\uAE08 \uD3B8\uD574\uC9C8
    \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uADF8\uB7F0\uB370 \uB2E4\uC74C \uC9C0\uCD9C\uC744
    \uBB34\uC5C7\uC73C\uB85C \uD560\uC9C0\uB3C4 \uAC19\uC774 \uBCF4\uC154\uC57C \uD569\uB2C8\uB2E4."
  companyQuestion:
  companyPlayerLine:
  choices:
  - choiceText: "\uC608\uC815\uB41C \uC9C0\uCD9C\uBD80\uD130 \uB098\uB208\uB2E4"
    choiceDescription: "\uC774\uBC88 \uB2F5\uBCC0\uC744 \uAD00\uACC4\uC640 \uAE30\uC5B5\uC5D0
      \uBC18\uC601\uD569\uB2C8\uB2E4. \uD604\uAE08\xB7\uC9C0\uBD84 \uBCC0\uD654 \uC5C6\uC74C."
    playerLine: "\uC774\uBBF8 \uC815\uD574\uC9C4 \uC9C0\uCD9C\uACFC \uC544\uC9C1
      \uC120\uD0DD\uD560 \uC218 \uC788\uB294 \uC9C0\uCD9C\uBD80\uD130 \uB098\uB204\uACA0\uC2B5\uB2C8\uB2E4.
      \uD544\uC694\uD55C \uB3C8\uC744 \uD22C\uC790 \uC5EC\uC720\uB85C \uC138\uBA74
      \uC548 \uB418\uACA0\uC8E0."
    resultDialogue: "\uADF8\uB807\uAC8C \uB098\uB204\uBA74 \uD3EC\uAE30\uD560 \uC218
      \uC5C6\uB294 \uC77C\uACFC \uC870\uC815 \uAC00\uB2A5\uD55C \uC77C\uC774 \uBCF4\uC77C
      \uAC81\uB2C8\uB2E4. \uC22B\uC790\uB97C \uC801\uC744 \uB54C\uB294 \uAC19\uC740
      \uB3C8\uC744 \uB450 \uBC88 \uC4F0\uC9C0 \uC54A\uB3C4\uB85D \uBCF4\uC138\uC694."
    resultValue: answer_0
    npcResult:
      eventId:
