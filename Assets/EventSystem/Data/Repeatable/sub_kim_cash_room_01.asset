  - choiceText: "\uB9E4\uB3C4\uD574\uC57C \uD560 \uB54C\uC758 \uC21C\uC11C\uB97C
      \uC0DD\uAC01\uD55C\uB2E4"
    choiceDescription: "\uC774\uBC88 \uB2F5\uBCC0\uC744 \uAD00\uACC4\uC640 \uAE30\uC5B5\uC5D0
      \uBC18\uC601\uD569\uB2C8\uB2E4. \uD604\uAE08\xB7\uC9C0\uBD84 \uBCC0\uD654 \uC5C6\uC74C."
    playerLine: "\uAE09\uD788 \uD604\uAE08\uC774 \uD544\uC694\uD574\uC9C0\uBA74 \uBB34\uC5C7\uBD80\uD130
      \uAC80\uD1A0\uD560\uC9C0 \uC0DD\uAC01\uD574\uB450\uACA0\uC2B5\uB2C8\uB2E4.
      \uAC00\uACA9\uC774 \uC624\uB978 \uC21C\uC11C\uB9CC\uC73C\uB85C \uC815\uD558\uC9C0\uB294
      \uC54A\uACE0\uC694."
    resultDialogue: "\uC88B\uC2B5\uB2C8\uB2E4. \uB2E4\uB9CC \uC9C0\uAE08 \uC815\uD55C
      \uC21C\uC11C\uAC00 \uB098\uC911\uC5D0\uB3C4 \uB9DE\uB294\uC9C0\uB294 \uB2E4\uC2DC
      \uBCF4\uC138\uC694. \uACC4\uD68D\uC774 \uD310\uB2E8\uC744 \uB300\uC2E0\uD558\uAC8C
      \uB450\uC9C0\uB294 \uB9C8\uC2ED\uC2DC\uC624."
