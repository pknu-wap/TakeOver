  - npcId:
    text: "\uD544\uC694\uD558\uBA74 \uC8FC\uC2DD\uC744 \uD314 \uC218 \uC788\uACA0\uC8E0."
    player: 1
    narration: 0
  - npcId: npc-institutional-investor-kim-taeseong
    text: "\uD314 \uC218 \uC788\uC744 \uAC81\uB2C8\uB2E4. \uB2E4\uB9CC \uC6D0\uD558\uB294
      \uB0A0 \uC6D0\uD558\uB294 \uAC00\uACA9\uC778\uC9C0\uB294 \uBCC4\uAC1C\uC8E0.
      \uC2E4\uC81C\uB85C \uD314\uB77C\uB294 \uB9D0\uC740 \uC544\uB2D9\uB2C8\uB2E4.
      \uBA3C\uC800 \uC0DD\uAC01\uD574\uBCF4\uC790\uB294 \uAC70\uACE0\uC694."
    player: 0
    narration: 0
  - npcId:
    text: "\uD604\uAE08\uC744 \uC5BC\uB9C8\uB098 \uB0A8\uAE38\uC9C0 \uC815\uD558\uB294
      \uBB38\uC81C\uAD70\uC694."
    player: 1
    narration: 0
  - npcId: npc-institutional-investor-kim-taeseong
    text: "\uB124. \uAC19\uC740 \uAE08\uC561\uB3C4 \uB2E4\uC74C \uC77C\uC815\uACFC
