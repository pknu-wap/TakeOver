  m_Name: sub_dongbang_address_check_01
  m_EditorClassIdentifier: Assembly-CSharp::TakeOver.Events.EventDefinition
  eventId: sub_dongbang_address_check_01
  category: 0
  linearDialogue: 0
  tutorialOnly: 0
  title: "\uB3D9\uBC29\uBB3C\uC0B0 \u2014 \uCD9C\uACE0 \uC8FC\uC18C \uD655\uC778"
  image: {fileID: 21300000, guid: e4f06f328acf53c4385995fb1f2c1e65, type: 3}
  cardImage: {fileID: 21300000, guid: d04aa39026668454991718ef00702904, type: 3}
  npcArts: []
  highlightImage: {fileID: 0}
  negotiationBackground: {fileID: 0}
  description: "\uC8FC\uC18C \uD55C \uAE00\uC790\uAC00 \uB2EC\uB77C \uC791\uC5C5\uC790\uAC00
    \uB2E4\uB978 \uC8FC\uBB38\uAE4C\uC9C0 \uC138\uC6CC\uB480\uB2E4\uACE0 \uD55C\uB2E4.
    \uBC15\uBBFC\uC6B0\uC640 \uD568\uAED8 \uCC98\uB9AC\uB7C9 \uD45C\uC5D0 \uC7A1\uD788\uC9C0
    \uC54A\uC740 \uD655\uC778 \uC2DC\uAC04\uC744 \uB530\uC838\uBCF4\uC790."
  apCost: 1
  startButtonText: "\uB9CC\uB098\uAE30"
  companyIds:
  - dongbang-trading
  speakerNpcId: npc-dongbang-trading-hr-director-park-minu
  speakerName: "\uBC15\uBBFC\uC6B0"
  speakerRole:
  dialogue: "\uC624\uB298\uC740 \uC0C1\uC790 \uD558\uB098\uC5D0\uC11C \uC2DC\uC791\uD55C
    \uC598\uAE30\uC785\uB2C8\uB2E4. \uC8FC\uC18C \uB05D \uD55C \uAE00\uC790\uAC00
    \uC548 \uB9DE\uC544\uC11C \uD655\uC778\uD588\uB354\uB2C8, \uBCF4\uB0B4\uB294
    \uCABD\uD558\uACE0 \uBC1B\uB294 \uCABD\uC774 \uC11C\uB85C \uB9DE\uB2E4\uACE0
    \uD558\uB354\uB77C\uACE0\uC694."
  companyQuestion:
  companyPlayerLine:
  choices:
  - choiceText: "\uC758\uC2EC\uB418\uB294 \uC8FC\uC18C\uB294 \uCD9C\uACE0 \uC804\uC5D0
      \uD655\uC778\uD558\uC790\uACE0 \uD55C\uB2E4"
    choiceDescription:
    playerLine: "\uC798\uBABB \uBCF4\uB0B4\uACE0 \uD68C\uC218\uD558\uB294 \uBE44\uC6A9\uAE4C\uC9C0
      \uBCF4\uBA74 \uBA3C\uC800 \uD655\uC778\uD560 \uC774\uC720\uAC00 \uC788\uACA0\uC2B5\uB2C8\uB2E4.
      \uD655\uC778\uD560 \uAE30\uC900\uC744 \uC881\uD600\uC11C \uC815\uD574\uBCF4\uC8E0."
    resultDialogue: "\uB124. \uC804\uBD80 \uC804\uD654\uD558\uC790\uB294 \uC548\uC73C\uB85C
      \uCEE4\uC9C0\uC9C0 \uC54A\uAC8C \uD558\uACA0\uC2B5\uB2C8\uB2E4. \uC5B4\uB5A4
      \uC624\uB958\uAC00 \uC790\uC8FC \uB098\uB294\uC9C0 \uBCF4\uACE0 \uAE30\uC900\uC744
      \uB9CC\uB4E4\uC8E0."
    resultValue: answer_0
    npcResult:
      eventId:
      companyId:
      actorId:
      actionId:
      targetNpcIds:
