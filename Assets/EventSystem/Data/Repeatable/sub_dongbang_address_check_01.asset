  - npcId:
    text: "\uC5B4\uB514\uAC00 \uD2C0\uB838\uC2B5\uB2C8\uAE4C?"
    player: 1
    narration: 0
    scene: 0
  - npcId: npc-dongbang-trading-hr-director-park-minu
    text: "\uACB0\uAD6D \uD655\uC778\uD574\uC11C \uBCF4\uB0C8\uC2B5\uB2C8\uB2E4.
      \uBB38\uC81C\uB294 \uADF8\uB3D9\uC548 \uC791\uC5C5\uC790\uAC00 \uB2E4\uB978
      \uC8FC\uBB38\uB3C4 \uBD99\uC7A1\uACE0 \uC788\uC5C8\uB2E4\uB294 \uAC70\uC8E0.
      \uCC98\uB9AC\uB7C9 \uD45C\uC5D0\uB294 \uD655\uC778 \uC804\uD654 \uC2DC\uAC04\uC774
      \uB530\uB85C \uC548 \uBCF4\uC600\uACE0\uC694."
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uC808\uCC28\uB97C \uB354 \uB9CC\uB4E4\uBA74 \uB290\uB824\uC9C4\uB2E4\uB294
      \uC758\uACAC\uB3C4 \uC788\uACA0\uAD70\uC694."
    player: 1
    narration: 0
    scene: 0
  - npcId: npc-dongbang-trading-hr-director-park-minu
    text: "\uB9DE\uC544\uC694. \uC804\uD654\uBC88\uD638 \uC606\uC5D0 \u2018\uB9C8\uC74C
      \uAE09\uD55C \uACE0\uAC1D\u2019\uC774\uB77C\uACE0 \uC368\uB458 \uC218\uB294
      \uC5C6\uC73C\uB2C8 \uC808\uCC28\uB85C \uC815\uD574\uC57C \uD569\uB2C8\uB2E4.
      \uC5B4\uB514\uAE4C\uC9C0 \uBA3C\uC800 \uD655\uC778\uD558\uACE0 \uC5B4\uB514\uC11C
      \uBA48\uCD9C\uC9C0\uC694."
