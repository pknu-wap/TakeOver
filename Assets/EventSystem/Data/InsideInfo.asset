  - choiceText: "\uc6b0\uc120 \uad6c\ub450\ub85c \ub0b4\uc6a9\uc744 \ub4e3\ub294\ub2e4"
    choiceDescription: "\uacc4\uc57d \uc758\uc0ac\ub294 \ubc1d\ud788\uc9c0 \uc54a\uace0 \uc124\uba85\ub9cc \uc694\uccad\ud569\ub2c8\ub2e4. \uc0c1\ub300\ub294 \uc790\ub8cc \uc81c\uacf5\uc5d0 \uc18c\uadf9\uc801\uc785\ub2c8\ub2e4."
    playerLine: "\uc624\ub298\uc740 \ub9d0\uc500\ubd80\ud130 \ub4e3\uaca0\uc2b5\ub2c8\ub2e4. \ubcf4\uc218\ub098 \uacc4\uc57d\uc740 \uc9c0\uae08 \uacb0\uc815\ud558\uae30 \uc5b4\ub835\uc2b5\ub2c8\ub2e4."
    resultDialogue: "\uadf8\ub807\ub2e4\uba74 \uc790\uc138\ud55c \uc790\ub8cc\ub97c \ub4dc\ub9ac\uae30\ub294 \uc5b4\ub835\uaca0\uad70\uc694. \uc870\uac74\uc744 \uac80\ud1a0\ud558\uc2e4 \uc0dd\uac01\uc774 \ub4e4\uba74 \ub2e4\uc2dc \uc5f0\ub77d \uc8fc\uc2ed\uc2dc\uc624."
    resultValue: "hear_outline"
