  eventId: inside_info_01
  title: "\uB0B4\uBD80 \uC815\uBCF4 \uC81C\uBCF4"
  image: {fileID: 21300000, guid: e4f06f328acf53c4385995fb1f2c1e65, type: 3}
  cardImage: {fileID: 21300000, guid: d04aa39026668454991718ef00702904, type: 3}
  highlightImage: {fileID: 0}
  description: "\uBBF8\uB798\uAC74\uC124 CFO \uC11C\uC9C0\uC544\uAC00 \uC740\uBC00\uD788
    \uC5F0\uB77D\uD574 \uC654\uB2E4. \uC7A5\uBD80\uC5D0 \uB4DC\uB7EC\uB098\uC9C0
    \uC54A\uC740 \uBD80\uCC44 \uC815\uBCF4\uB97C \uB118\uAE30\uACA0\uB2E4\uACE0 \uD55C\uB2E4."
  apCost: 1
  startButtonText: "\uB9CC\uB098 \uBCF8\uB2E4"
  companyIds:
  - mirae-construction
  speakerNpcId: npc-mirae-construction-cfo-seo-jia
  speakerName: "\uC11C\uC9C0\uC544"
  speakerRole: "\uBBF8\uB798\uAC74\uC124 CFO"
  dialogue: "\uC7A5\uBD80\uC5D0 \uC548 \uC7A1\uD78C \uBD80\uCC44\uAC00 \uC788\uC2B5\uB2C8\uB2E4.
    \uC22B\uC790\uB294 \uC81C\uAC00 \uB4DC\uB9AC\uC8E0. \uB300\uC2E0 \uC778\uC218
    \uD6C4 \uC81C \uC131\uACFC\uBCF4\uC218\uB97C \uD655\uC2E4\uD788 \uBCF4\uC7A5\uD574
    \uC8FC\uC154\uC57C \uD569\uB2C8\uB2E4."
  companyQuestion: 
  companyPlayerLine: 
  choices:
  - choiceText: "\uc790\ub8cc\uc640 \uc694\uad6c \uc870\uac74\uc744 \uc11c\uba74\uc73c\ub85c \uc694\uccad\ud55c\ub2e4"
    choiceDescription: "\uac80\ud1a0\uc6a9 \uc790\ub8cc\ub97c \ubc1b\uc2b5\ub2c8\ub2e4. \ubcf4\uc218 \uc9c0\uae09\uc774\ub098 \uacc4\uc57d \uccb4\uacb0\uc740 \uc544\uc9c1 \ud655\uc815\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
    playerLine: "\uc790\ub8cc\uc640 \uc694\uad6c \uc870\uac74\uc744 \uc11c\uba74\uc73c\ub85c \ubcf4\ub0b4\uc8fc\uc2ed\uc2dc\uc624. \ub0b4\uc6a9\uc744 \ud655\uc778\ud55c \ub4a4 \ub2f5\ub4dc\ub9ac\uaca0\uc2b5\ub2c8\ub2e4."
    resultDialogue: "\uc54c\uaca0\uc2b5\ub2c8\ub2e4. \uc81c\uac00 \uc6d0\ud558\ub294 \uc870\uac74\ub3c4 \ud568\uaed8 \uc801\uaca0\uc2b5\ub2c8\ub2e4. \uac80\ud1a0\ud558\uc2dc\uace0 \ub2e4\uc2dc \ub9d0\uc500\ud574 \uc8fc\uc2ed\uc2dc\uc624."
    resultValue: "request_terms"
    npcResult:
