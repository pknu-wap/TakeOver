        player: 0
        narration: 0
        scene: 0
      - npcId:
        text: "\uC124\uBA85\uC744 \uB4E4\uC5C8\uB2E4\uACE0 \uC804\uBD80 \uB3D9\uC758\uD558\uB294
          \uAC74 \uC544\uB2D9\uB2C8\uB2E4."
        player: 1
        narration: 0
        scene: 0
      - npcId: npc-hansung-industry-ceo-jo-minseok
        text: "\uADF8\uB7F4 \uD544\uC694 \uC5C6\uC2B5\uB2C8\uB2E4. \uBB34\uC5C7\uC744
          \uB2E4\uB974\uAC8C \uBCF4\uB294\uC9C0\uBD80\uD130 \uB4E3\uC8E0."
        player: 0
        narration: 0
        scene: 0
