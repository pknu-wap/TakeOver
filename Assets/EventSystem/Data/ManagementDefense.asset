      choiceDescription:
      playerLine: "\uC9C1\uC811 \uACBD\uC601\uC5D0 \uCC38\uC5EC\uD560 \uAC00\uB2A5\uC131\uB3C4
        \uBCF4\uACE0 \uC788\uC2B5\uB2C8\uB2E4. \uADF8 \uACBD\uC6B0 \uC81C\uD488\uACFC
        \uBE0C\uB79C\uB4DC\uB97C \uC5B4\uB5A4 \uC870\uAC74\uC73C\uB85C \uC774\uC5B4\uAC08\uC9C0
        \uB17C\uC758\uD574\uC57C\uACA0\uC8E0."
      resultDialogue: "\uADF8\uB7EC\uBA74 \uB354 \uAD6C\uCCB4\uC801\uC73C\uB85C \uC774\uC57C\uAE30\uD574\uC57C\uACA0\uB124\uC694.
        \uC81C\uAC00 \uB3D9\uC758\uD560 \uC870\uAC74\uB3C4 \uC788\uACE0 \uC5B4\uB824\uC6B4
        \uC870\uAC74\uB3C4 \uC788\uC744 \uAC70\uC608\uC694.\n\n\uB204\uAD6C\uC778\uC9C0
        \uBCF4\uAE30\uB3C4 \uC804\uC5D0 \uB2F5\uC744 \uC815\uD558\uC9C0\uB294 \uC54A\uC744\uAC8C\uC694.
        \uB2E4\uB9CC \uC190\uB2D8\uC774 \uBBFF\uB358 \uAC78 \uBC14\uAFB8\uBA74\uC11C
