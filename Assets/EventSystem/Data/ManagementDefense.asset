    - choiceText: "\uC7A5\uCC28 \uC778\uC218\uB97C \uAC80\uD1A0\uD55C\uB2E4\uACE0
        \uB9D0\uD55C\uB2E4"
      choiceDescription:
      playerLine: "\uC9C1\uC811 \uC6B4\uC601\uD558\uB294 \uAC00\uB2A5\uC131\uB3C4
        \uBCF4\uACE0 \uC788\uC2B5\uB2C8\uB2E4. \uC0DD\uC0B0 \uAE30\uBC18\uC744 \uC720\uC9C0\uD558\uB824\uBA74
        \uBB34\uC5C7\uC774 \uD544\uC694\uD55C\uC9C0\uB3C4 \uAC80\uD1A0\uD560 \uAC81\uB2C8\uB2E4."
      resultDialogue: "\uADF8\uB7EC\uBA74 \uC2DC\uC124\uC744 \uB0A8\uAE34\uB2E4\uB294
        \uB9D0\uB9CC\uC73C\uB85C\uB294 \uBD80\uC871\uD569\uB2C8\uB2E4. \uC8FC\uBB38\uC744
        \uC774\uC5B4\uAC08 \uACC4\uD68D\uACFC \uC0AC\uB78C \uBB38\uC81C\uAE4C\uC9C0
        \uBCF4\uC154\uC57C \uD569\uB2C8\uB2E4.\n\n\uBC14\uAFC0 \uC774\uC720\uC640
        \uC774\uD6C4 \uACC4\uD68D\uC744 \uAC00\uC838\uC624\uC2ED\uC2DC\uC624. \uC81C\uAC00
        \uACE0\uC9D1\uC744 \uBD80\uB9AC\uB294\uC9C0, \uADF8 \uACC4\uD68D\uC774 \uC595\uC740\uC9C0
        \uADF8\uB54C \uBCF4\uC8E0."
      resultValue: takeover
