  - companyId: haneul-food
    title: "\uD558\uB298\uC2DD\uD488 \u2014 \uAE40\uD558\uB9B0\uC758 \uC8FC\uC8FC
      \uBA74\uB2F4"
    description: "\uAE40\uD558\uB9B0\uC740 \uB0B4\uAC00 \uB2E8\uACE8\uC774 \uB2E4\uC2DC
      \uCC3E\uB294 \uC81C\uD488\uC744 \uC5B4\uB5BB\uAC8C \uBCF4\uB294\uC9C0 \uAD81\uAE08\uD558\uB2E4\uACE0
      \uD588\uB2E4. \uC8FC\uAC00\uAC00 \uC6C0\uC9C1\uC77C \uACC4\uAE30 \uC678\uC5D0
      \uC5B4\uB5A4 \uAC00\uCE58\uB97C \uBCF4\uB294\uC9C0 \uB9D0\uD574\uBCFC \uC790\uB9AC\uB2E4."
    openingLines:
    - npcId: npc-haneul-food-ceo-kim-harin
      text: "\uC624\uB298\uC740 \uC81C\uAC00 \uC9C8\uBB38 \uC880 \uD560\uAC8C\uC694.
        \uC790\uB8CC\uB294 \uB298 \uC800\uD76C\uAC00 \uB4DC\uB9AC\uB294\uB370, \uC815\uC791
        \uC5B4\uB5A4 \uC0DD\uAC01\uC73C\uB85C \uBCF4\uACE0 \uACC4\uC2E0\uC9C0\uB294
        \uC9E7\uAC8C\uB9CC \uB4E3\uAC8C \uB418\uB354\uB77C\uACE0\uC694."
      player: 0
      narration: 0
      scene: 0
    - npcId:
      text: "\uAD81\uAE08\uD55C \uAC8C \uC788\uC73C\uC2ED\uB2C8\uAE4C?"
      player: 1
      narration: 0
      scene: 0
    - npcId: npc-haneul-food-ceo-kim-harin
      text: "\uC190\uB2D8\uC774 \uB2E4\uC2DC \uC0AC\uB294 \uC81C\uD488\uC744 \uBCFC
        \uB54C, \uC624\uB798 \uB0A8\uC744 \uC774\uC720\uB97C \uBCF4\uC138\uC694?
        \uC544\uB2C8\uBA74 \uAC00\uACA9\uC774 \uC6C0\uC9C1\uC77C \uACC4\uAE30\uB97C
        \uBA3C\uC800 \uBCF4\uC138\uC694?"
      player: 0
      narration: 0
      scene: 0
    - npcId:
      text: "\uB458 \uB2E4 \uBCFC \uC218\uB294 \uC5C6\uC2B5\uB2C8\uAE4C?"
      player: 1
      narration: 0
      scene: 0
    - npcId: npc-haneul-food-ceo-kim-harin
      text: "\uADF8\uB7F4 \uC218 \uC788\uC8E0. \uB2E4\uB9CC \uB458\uC774 \uBD80\uB52A\uD790
        \uB54C \uC5B4\uB290 \uCABD\uC744 \uBA3C\uC800 \uBCFC\uC9C0 \uC54C\uACE0 \uC2F6\uC5B4\uC694.
        \uC81C\uD488 \uBC14\uAFC0 \uB54C\uB3C4 \uB298 \uADF8\uB7F0 \uC9C8\uBB38\uC744
        \uD558\uAC70\uB4E0\uC694."
      player: 0
      narration: 0
      scene: 0
    choices:
    - choiceText: "\uD604\uC7AC\uB294 \uD22C\uC790 \uAC80\uD1A0 \uBAA9\uC801\uC774\uB77C\uACE0
        \uB2F5\uD55C\uB2E4"
      choiceDescription:
      playerLine: "\uC9C0\uAE08\uC740 \uC81C\uD488\uC774 \uD314\uB9AC\uB294 \uC774\uC720\uC640
        \uC2E4\uC81C \uB0A8\uB294 \uC774\uC775\uC744 \uAC19\uC774 \uBCF4\uACE0 \uC788\uC2B5\uB2C8\uB2E4.
        \uD68C\uC0AC \uC6B4\uC601 \uBC29\uD5A5\uC744 \uC81C\uAC00 \uC815\uD558\uACA0\uB2E4\uACE0
        \uC628 \uAC83\uC740 \uC544\uB2D9\uB2C8\uB2E4."
      resultDialogue: "\uB124. \uADF8\uB7EC\uBA74 \uC800\uB3C4 \uB300\uD45C\uB85C\uC11C
