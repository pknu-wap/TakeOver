  - companyId: hansung-industry
    title: "\uD55C\uC131\uACF5\uC5C5 \u2014 \uC124\uBE44 \uD3C9\uAC00\uC640 \uC0DD\uC0B0
      \uACC4\uD68D"
    description: "\uC870\uBBFC\uC11D\uC740 \uB0B4\uAC00 \uC7A5\uBD80\uC758 \uAE30\uACC4
      \uAC12\uB9CC \uBCF4\uACE0 \uC788\uB294\uC9C0 \uAD81\uAE08\uD55C \uBAA8\uC591\uC774\uB2E4.
      \uC124\uBE44\uB85C \uBB34\uC5C7\uC744 \uB9CC\uB4E4\uACE0 \uADF8 \uC77C\uC744
      \uB204\uAC00 \uB9E1\uC744 \uC218 \uC788\uB294\uC9C0\uAE4C\uC9C0 \uB4E3\uACE0
      \uC2F6\uB2E4."
    openingLines:
    - npcId: npc-hansung-industry-ceo-jo-minseok
      text: "\uC124\uBE44 \uC790\uB8CC\uB97C \uBCF4\uC168\uACA0\uC8E0. \uADF8\uB2E4\uC74C\uC5D0\uB294
        \uBB34\uC5C7\uC744 \uBCF4\uC2E4 \uC0DD\uAC01\uC785\uB2C8\uAE4C?"
      player: 0
      narration: 0
      scene: 0
    - npcId:
      text: "\uC8FC\uBB38\uACFC \uC0DD\uC0B0 \uB2A5\uB825, \uC0AC\uB78C\uB3C4 \uBD10\uC57C\uACA0\uC2B5\uB2C8\uB2E4."
      player: 1
      narration: 0
      scene: 0
    - npcId: npc-hansung-industry-ceo-jo-minseok
      text: "\uADF8 \uB2F5\uC744 \uB4E4\uC73C\uB824\uACE0 \uC790\uB9AC\uB97C \uBD80\uD0C1\uD588\uC2B5\uB2C8\uB2E4.
        \uAE30\uACC4 \uCC98\uBD84 \uAC00\uACA9\uBD80\uD130 \uACC4\uC0B0\uD558\uB294
        \uBD84\uB3C4 \uACC4\uC154\uC11C\uC694."
      player: 0
      narration: 0
      scene: 0
    - npcId:
      text: "\uC790\uC0B0 \uAC00\uACA9\uC744 \uD655\uC778\uD558\uB294 \uAC83 \uC790\uCCB4\uAC00
        \uC798\uBABB\uC740 \uC544\uB2D9\uB2C8\uB2E4."
      player: 1
      narration: 0
      scene: 0
    - npcId: npc-hansung-industry-ceo-jo-minseok
      text: "\uC555\uB2C8\uB2E4. \uB2E4\uB9CC \uADF8\uAC78\uB85C \uC774 \uD68C\uC0AC\uC5D0
        \uB300\uD55C \uC9C8\uBB38\uC774 \uB05D\uB0AC\uB2E4\uBA74 \uC800\uC640 \uD560
        \uC774\uC57C\uAE30\uB294 \uC9E7\uC2B5\uB2C8\uB2E4. \uD22C\uC790\uC790\uB85C
        \uB0A8\uC744 \uC0DD\uAC01\uC778\uC9C0 \uC9C1\uC811 \uC6B4\uC601\uD560 \uC0DD\uAC01\uC778\uC9C0\uB3C4
        \uB4E3\uACE0 \uC2F6\uACE0\uC694."
      player: 0
      narration: 0
      scene: 0
    choices:
    - choiceText: "\uD604\uC7AC\uB294 \uD22C\uC790 \uAC80\uD1A0 \uBAA9\uC801\uC774\uB77C\uACE0
        \uB2F5\uD55C\uB2E4"
      choiceDescription:
      playerLine: "\uC9C0\uAE08\uC740 \uD68C\uC0AC \uAC00\uCE58\uB97C \uAC80\uD1A0\uD558\uACE0
        \uC788\uC2B5\uB2C8\uB2E4. \uD604\uC7AC \uACBD\uC601\uC744 \uB300\uC2E0\uD558\uACA0\uB2E4\uB294
        \uACB0\uC815\uC740 \uD558\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
      resultDialogue: "\uC88B\uC2B5\uB2C8\uB2E4. \uADF8\uB7EC\uBA74 \uC0DD\uC0B0
        \uACC4\uD68D\uACFC \uB0A9\uD488 \uB2A5\uB825\uBD80\uD130 \uC124\uBA85\uD558\uC8E0.
        \uAE30\uC220\uC744 \uB2E4 \uACF5\uAC1C\uD560 \uC218\uB294 \uC5C6\uC9C0\uB9CC
        \uD22C\uC790 \uD310\uB2E8\uC5D0 \uD544\uC694\uD55C \uBC94\uC704\uB294 \uB17C\uC758\uD558\uACA0\uC2B5\uB2C8\uB2E4.\n\n\uADF8\uB7F4
        \uD544\uC694 \uC5C6\uC2B5\uB2C8\uB2E4. \uBB34\uC5C7\uC744 \uB2E4\uB974\uAC8C
        \uBCF4\uB294\uC9C0\uBD80\uD130 \uB4E3\uC8E0."
      resultValue: investment_review
      npcResult:
        eventId:
        companyId:
