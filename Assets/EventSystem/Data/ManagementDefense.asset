  - companyId: mirae-construction
    title: "\uBBF8\uB798\uAC74\uC124 \u2014 \uAC15\uC900\uD601\uC758 \uC8FC\uC8FC
      \uBA74\uB2F4"
    description: "\uC9C0\uBD84\uC774 \uB298\uC790 \uAC15\uC900\uD601\uC774 \uD604\uC7A5
      \uC6B4\uC601\uC5D0 \uB300\uD574 \uB0B4 \uC0DD\uAC01\uC744 \uC9C1\uC811 \uB4E3\uACE0
      \uC2F6\uB2E4\uACE0 \uD588\uB2E4. \uACBD\uC601\uC9C4\uC744 \uBC14\uAFB8\uB824
      \uD55C\uB2E4\uB294 \uC18C\uBB38\uAE4C\uC9C0 \uB4E4\uC740 \uBAA8\uC591\uC774\uB2E4."
    openingLines:
    - npcId: npc-mirae-construction-ceo-kang-junhyeok
      text: "\uC7A0\uAE50 \uC2DC\uAC04\uC744 \uB0B4\uC8FC\uC168\uC73C\uBA74 \uD569\uB2C8\uB2E4.
        \uC8FC\uC8FC\uBD84\uC774 \uC5B4\uB5A4 \uC0DD\uAC01\uC73C\uB85C \uD68C\uC0AC\uB97C
        \uBCF4\uB294\uC9C0\uB294 \uB0B4\uAC00 \uC9C1\uC811 \uB4E3\uB294 \uD3B8\uC774
        \uB0AB\uACA0\uC18C."
      player: 0
      narration: 0
      scene: 0
    - npcId:
      text: "\uB204\uAC00 \uC81C \uC0DD\uAC01\uC744 \uB300\uC2E0 \uC804\uD558\uB358\uAC00\uC694?"
      player: 1
      narration: 0
      scene: 0
    - npcId: npc-mirae-construction-ceo-kang-junhyeok
      text: "\uADF8\uB7F0 \uB9D0\uC740 \uB298 \uC788\uC2B5\uB2C8\uB2E4. \uC9C0\uBD84\uC774
        \uB298\uBA74 \uB204\uAD6C\uB97C \uBC14\uAFB8\uB824\uB294\uC9C0\uBD80\uD130
        \uBB3B\uB354\uAD70\uC694. \uADF8\uB798\uC11C \uB0A8\uC758 \uD574\uC11D \uB9D0\uACE0
        \uBCF8\uC778 \uC0DD\uAC01\uC744 \uB4E4\uC73C\uB824\uB294 \uAC81\uB2C8\uB2E4."
      player: 0
      narration: 0
      scene: 0
    - npcId:
      text: "\uB300\uD45C\uB2D8\uC740 \uBB34\uC5C7\uC774 \uAC00\uC7A5 \uAC71\uC815\uB418\uC2ED\uB2C8\uAE4C?"
      player: 1
      narration: 0
      scene: 0
    - npcId: npc-mirae-construction-ceo-kang-junhyeok
      text: "\uAE30\uC874 \uACC4\uC57D\uC774 \uC911\uAC04\uC5D0 \uD754\uB4E4\uB9AC\uB294
        \uAC70\uC694. \uC0C1\uB300\uAC00 \uBC14\uB00C\uC5B4\uB3C4 \uD604\uC7A5\uC740
        \uB05D\uAE4C\uC9C0 \uAC00\uC57C \uD569\uB2C8\uB2E4. \uD68C\uC0AC \uC774\uB984\uC744
        \uAC78\uACE0 \uD55C \uC77C\uC778\uB370, \uC0C8 \uC8FC\uC8FC\uAC00 \uC654\uB2E4\uACE0
        \uC124\uBA85\uC774 \uB9E4\uBC88 \uB2EC\uB77C\uC9C0\uBA74 \uACE4\uB780\uD558\uC8E0."
      player: 0
      narration: 0
      scene: 0
    - npcId:
      text: "\uBC14\uAFC0 \uD544\uC694\uAC00 \uC788\uB294 \uBD80\uBD84\uB3C4 \uC788\uC744
        \uC218 \uC788\uACA0\uC8E0."
      player: 1
      narration: 0
      scene: 0
    - npcId: npc-mirae-construction-ceo-kang-junhyeok
      text: "\uC788\uACA0\uC8E0. \uB0B4\uAC00 \uD55C \uD310\uB2E8\uC774 \uB2E4 \uB9DE\uC558\uB2E4\uB294
        \uB9D0\uC740 \uC544\uB2D9\uB2C8\uB2E4. \uB2E4\uB9CC \uBB34\uC5C7\uC744 \uB0A8\uAE30\uACE0
        \uBB34\uC5C7\uC744 \uBC14\uAFB8\uB824\uB294\uC9C0 \uC774\uC57C\uAE30\uD558\uACE0
        \uC6C0\uC9C1\uC5EC\uC57C \uD55C\uB2E4\uB294 \uAC81\uB2C8\uB2E4."
      player: 0
      narration: 0
      scene: 0
    choices:
    - choiceText: "\uD604\uC7AC\uB294 \uD22C\uC790 \uAC80\uD1A0\uAC00 \uBAA9\uC801\uC774\uB77C\uACE0
        \uB2F5\uD55C\uB2E4"
      choiceDescription:
      playerLine: "\uC9C0\uAE08\uC740 \uACC4\uC57D\uACFC \uC790\uAE08 \uC77C\uC815\uC744
        \uBCF4\uBA74\uC11C \uD22C\uC790 \uD310\uB2E8\uC744 \uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4.
        \uACBD\uC601\uC9C4\uC744 \uBC14\uAFB8\uAC70\uB098 \uD68C\uC0AC\uB97C \uC7AC\uD3B8\uD558\uACA0\uB2E4\uACE0
        \uC815\uD55C \uB2E8\uACC4\uB294 \uC544\uB2D9\uB2C8\uB2E4."
      resultDialogue: "\uC54C\uACA0\uC2B5\uB2C8\uB2E4. \uADF8\uB7FC \uC624\uB298\uC740
        \uADF8 \uBC94\uC704\uB85C \uB4E3\uACA0\uC18C. \uAD81\uAE08\uD55C \uACC4\uC57D\uC740
        \uACF5\uAC1C\uD560 \uC218 \uC788\uB294 \uB0B4\uC6A9\uBD80\uD130 \uC124\uBA85\uD558\uACA0\uC2B5\uB2C8\uB2E4.\n\n\uBB3C\uC5B4\uBCF4\uC2ED\uC2DC\uC624.
        \uBB3B\uB294 \uAC83\uD558\uACE0 \uC774\uBBF8 \uB2F5\uC744 \uC815\uD574\uB193\uB294
        \uAC74 \uB2E4\uB974\uB2C8\uAE4C."
      resultValue: investment_review
