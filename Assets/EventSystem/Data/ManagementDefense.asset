  m_Name: ManagementDefense
  m_EditorClassIdentifier: Assembly-CSharp::TakeOver.Events.EventDefinition
  eventId: management_defense_01
  category: 0
  linearDialogue: 0
  tutorialOnly: 0
  title: "\uACBD\uC601\uC9C4\uACFC\uC758 \uC8FC\uC8FC \uBA74\uB2F4"
  image: {fileID: 21300000, guid: b2020d12458451d4c92855da7260657a, type: 3}
  cardImage: {fileID: 21300000, guid: 176d2ca1796791e43b3058ce38a3b370, type: 3}
  npcArts:
  - npcId: npc-mirae-construction-ceo-kang-junhyeok
    cardImage: {fileID: 21300000, guid: 92502223829c12044a7e948ad4c7a44a, type: 3}
    popupImage: {fileID: 21300000, guid: e4c7fba1a221735409f619bd3ea46484, type: 3}
  highlightImage: {fileID: 0}
  negotiationBackground: {fileID: 21300000, guid: f1ded8a9014741346bd4239f25c97159, type: 3}
  description: "\uBCF4\uC720 \uC9C0\uBD84\uC774 \uB298\uC790 \uACBD\uC601\uC9C4\uC774
    \uB0B4 \uD22C\uC790 \uACC4\uD68D\uC744 \uC9C1\uC811 \uB4E3\uACE0 \uC2F6\uB2E4\uACE0
    \uD588\uB2E4. \uC5B4\uB5A4 \uC6B4\uC601\uC744 \uAE30\uB300\uD558\uB294\uC9C0
    \uC124\uBA85\uD560 \uC790\uB9AC\uB2E4."
  apCost: 1
  startButtonText: "\uB9CC\uB09C\uB2E4"
  companyIds: []
  speakerNpcId:
  speakerName:
  speakerRole:
  dialogue: "\uACF5\uC2DC\uB97C \uBD24\uC2B5\uB2C8\uB2E4. \uC6B0\uB9AC \uD68C\uC0AC
    \uC9C0\uBD84\uC744 \uC65C \uC0AC\uB4E4\uC774\uB294 \uAC81\uB2C8\uAE4C? \uD22C\uC790\uC785\uB2C8\uAE4C,
    \uACBD\uC601\uAD8C\uC785\uB2C8\uAE4C?"
  companyQuestion:
  companyPlayerLine:
  choices:
  - choiceText: "\uB2F9\uC7A5\uC740 \uD22C\uC790 \uAC80\uD1A0 \uBAA9\uC801\uC774\uB77C\uACE0
      \uB2F5\uD55C\uB2E4"
    choiceDescription: "\uD604\uC7AC \uC758\uD5A5\uC744 \uC124\uBA85\uD569\uB2C8\uB2E4.
      \uACBD\uC601\uC9C4 \uC720\uC9C0 \uACC4\uC57D\uC774\uB098 \uC758\uACB0\uAD8C
      \uC704\uC784\uC740 \uBC1C\uC0DD\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    playerLine: "\uC624\uB298\uC740 \uD22C\uC790\uD560 \uB9CC\uD55C \uACF3\uC778\uC9C0
      \uC54C\uC544\uBCF4\uB7EC \uC654\uC2B5\uB2C8\uB2E4. \uACBD\uC601\uC9C4\uC744
      \uBC14\uAFB8\uACA0\uB2E4\uACE0 \uACB0\uC815\uD560 \uB2E8\uACC4\uB294 \uC544\uB2D9\uB2C8\uB2E4."
    resultDialogue: "\uADF8\uB807\uB2E4\uBA74 \uD68C\uC0AC \uC0AC\uC815\uBD80\uD130
      \uBCF4\uC2ED\uC2DC\uC624. \uB098\uC911\uC5D0 \uACC4\uD68D\uC774 \uAD6C\uCCB4\uC801\uC73C\uB85C
      \uC7A1\uD788\uBA74 \uB2E4\uC2DC \uB4E3\uACA0\uC2B5\uB2C8\uB2E4."
    resultValue: investment_review
