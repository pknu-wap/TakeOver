  - choiceText: "\uC7A5\uCC28 \uC778\uC218\uB97C \uAC80\uD1A0\uD55C\uB2E4\uACE0 \uB9D0\uD55C\uB2E4"
    choiceDescription: "\uC778\uC218\uC5D0 \uAD00\uC2EC\uC774 \uC788\uC74C\uC744
      \uBC1D\uD799\uB2C8\uB2E4. \uC774 \uB2F5\uBCC0\uB9CC\uC73C\uB85C \uACBD\uC601\uAD8C\uC744
      \uC5BB\uC9C0\uB294 \uC54A\uC2B5\uB2C8\uB2E4."
    playerLine: "\uACBD\uC601\uAD8C\uC785\uB2C8\uB2E4. \uC228\uAE38 \uC0DD\uAC01\uC740
      \uC5C6\uC2B5\uB2C8\uB2E4."
    resultDialogue: "\uADF8\uB807\uB2E4\uBA74 \uC6B0\uB9AC\uB3C4 \uAC00\uB9CC\uC788\uC9C0
