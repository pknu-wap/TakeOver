  description: "{company} {speaker} \uB300\uD45C. \uC9C0\uBD84 \uACF5\uC2DC\uB97C
    \uBCF4\uACE0 \uBA74\uB2F4\uC744 \uC694\uCCAD\uD588\uB2E4."
  apCost: 1
  startButtonText: "\uB9CC\uB09C\uB2E4"
  companyIds: []
  speakerNpcId: 
  speakerName: 
  speakerRole: 
  dialogue: "\uACF5\uC2DC\uB97C \uBD24\uC2B5\uB2C8\uB2E4. \uC6B0\uB9AC \uD68C\uC0AC
    \uC9C0\uBD84\uC744 \uC65C \uC0AC\uB4E4\uC774\uB294 \uAC81\uB2C8\uAE4C? \uD22C\uC790\uC785\uB2C8\uAE4C,
    \uACBD\uC601\uAD8C\uC785\uB2C8\uAE4C?"
  companyQuestion: 
  companyPlayerLine: 
  choices:
  - choiceText: "\ub2f9\uc7a5\uc740 \ud22c\uc790 \uac80\ud1a0 \ubaa9\uc801\uc774\ub77c\uace0 \ub2f5\ud55c\ub2e4"
    choiceDescription: "\ud604\uc7ac \uc758\ud5a5\uc744 \uc124\uba85\ud569\ub2c8\ub2e4. \uacbd\uc601\uc9c4 \uc720\uc9c0 \uacc4\uc57d\uc774\ub098 \uc758\uacb0\uad8c \uc704\uc784\uc740 \ubc1c\uc0dd\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
    playerLine: "\uc624\ub298\uc740 \ud22c\uc790\ud560 \ub9cc\ud55c \uacf3\uc778\uc9c0 \uc54c\uc544\ubcf4\ub7ec \uc654\uc2b5\ub2c8\ub2e4. \uacbd\uc601\uc9c4\uc744 \ubc14\uafb8\uaca0\ub2e4\uace0 \uacb0\uc815\ud560 \ub2e8\uacc4\ub294 \uc544\ub2d9\ub2c8\ub2e4."
    resultDialogue: "\uadf8\ub807\ub2e4\uba74 \ud68c\uc0ac \uc0ac\uc815\ubd80\ud130 \ubcf4\uc2ed\uc2dc\uc624. \ub098\uc911\uc5d0 \uacc4\ud68d\uc774 \uad6c\uccb4\uc801\uc73c\ub85c \uc7a1\ud788\uba74 \ub2e4\uc2dc \ub4e3\uaca0\uc2b5\ub2c8\ub2e4."
    resultValue: "investment_review"
