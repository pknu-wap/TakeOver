  - choiceText: "\uc7a5\ucc28 \uc778\uc218\ub97c \uac80\ud1a0\ud55c\ub2e4\uace0 \ub9d0\ud55c\ub2e4"
    choiceDescription: "\uc778\uc218\uc5d0 \uad00\uc2ec\uc774 \uc788\uc74c\uc744 \ubc1d\ud799\ub2c8\ub2e4. \uc774 \ub2f5\ubcc0\ub9cc\uc73c\ub85c \uacbd\uc601\uad8c\uc744 \uc5bb\uc9c0\ub294 \uc54a\uc2b5\ub2c8\ub2e4."
