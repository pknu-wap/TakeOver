  - companyId: dongbang-trading
    title: "\uB3D9\uBC29\uBB3C\uC0B0 \u2014 \uC6B4\uC601 \uACC4\uD68D \uBA74\uB2F4"
    description: "\uAC15\uC7AC\uD604\uC774 \uB3D9\uBC29\uBB3C\uC0B0\uC744 \uD22C\uC790\uCC98\uB85C
      \uBCF4\uB294\uC9C0, \uC9C1\uC811 \uC6B4\uC601\uC5D0 \uAD00\uC5EC\uD560 \uC0DD\uAC01\uC778\uC9C0
      \uBB3C\uC5C8\uB2E4. \uAC70\uC810 \uC6B4\uC601\uC758 \uC5B4\uB5A4 \uACB0\uC815\uC744
      \uC54C\uACE0 \uC2F6\uC740\uC9C0 \uC815\uB9AC\uD558\uACE0 \uAC00\uC790."
    openingLines:
    - npcId: npc-dongbang-trading-ceo-kang-jaehyeon
      text: "\uBC14\uB85C \uBB3B\uACA0\uC2B5\uB2C8\uB2E4. \uC9C0\uAE08\uC740 \uD22C\uC790\uC790\uB85C
        \uBCF4\uC2DC\uB294 \uAC81\uB2C8\uAE4C, \uC9C1\uC811 \uC6B4\uC601\uD574\uBCFC
        \uC0DD\uAC01\uB3C4 \uC788\uC73C\uC2ED\uB2C8\uAE4C?"
      player: 0
      narration: 0
      scene: 0
    - npcId:
      text: "\uADF8 \uB300\uB2F5\uC5D0 \uB530\uB77C \uBCF4\uC5EC\uC904 \uACC4\uD68D\uC774
        \uB2E4\uB985\uB2C8\uAE4C?"
      player: 1
      narration: 0
      scene: 0
    - npcId: npc-dongbang-trading-ceo-kang-jaehyeon
      text: "\uACC4\uD68D\uC740 \uAC19\uC8E0. \uB300\uC2E0 \uC9C8\uBB38\uC774 \uB2EC\uB77C\uC9D1\uB2C8\uB2E4.
        \uD22C\uC790\uC790\uB294 \uD68C\uC218\uB97C \uBB3B\uACE0, \uC6B4\uC601\uD560
        \uC0AC\uB78C\uC740 \uB2E4\uC74C \uACB0\uC815\uC744 \uB204\uAC00 \uB0B4\uB9B4\uC9C0
        \uBB3B\uB354\uAD70\uC694."
      player: 0
      narration: 0
      scene: 0
    - npcId:
      text: "\uB450 \uAC00\uC9C0 \uB2E4 \uBB3C\uC5B4\uBCFC \uC218 \uC788\uACA0\uC8E0."
      player: 1
      narration: 0
      scene: 0
    - npcId: npc-dongbang-trading-ceo-kang-jaehyeon
      text: "\uC88B\uC2B5\uB2C8\uB2E4. \uB2E4\uB9CC \uACB0\uB860 \uC5C6\uB294 \uAC80\uD1A0\uB97C
        \uC624\uB798 \uB044\uB294 \uAC74 \uC11C\uB85C \uC2DC\uAC04 \uB0AD\uBE44\uC785\uB2C8\uB2E4.
        \uC5B4\uB290 \uBC94\uC704\uAE4C\uC9C0 \uBCF4\uC2DC\uB294\uC9C0 \uBA3C\uC800
        \uB4E3\uC8E0."
      player: 0
      narration: 0
      scene: 0
    choices:
    - choiceText: "\uD604\uC7AC\uB294 \uD22C\uC790 \uAC80\uD1A0 \uBAA9\uC801\uC774\uB77C\uACE0
        \uB2F5\uD55C\uB2E4"
      choiceDescription:
      playerLine: "\uC9C0\uAE08\uC740 \uC6B4\uC601 \uC218\uC775\uACFC \uD655\uC7A5
        \uBE44\uC6A9\uC744 \uBCF4\uACE0 \uC788\uC2B5\uB2C8\uB2E4. \uC758\uC0AC\uACB0\uC815\uAD8C\uC744
        \uC694\uAD6C\uD558\uB294 \uB2E8\uACC4\uB294 \uC544\uB2D9\uB2C8\uB2E4."
      resultDialogue: "\uADF8\uB7FC \uC22B\uC790\uB85C \uC124\uBA85\uD558\uACA0\uC2B5\uB2C8\uB2E4.
        \uB300\uC2E0 \uBE60\uB978 \uD655\uC7A5\uC774 \uC804\uBD80 \uBB34\uB9AC\uB77C\uACE0
        \uC0DD\uAC01\uD558\uACE0 \uBCF4\uC9C0\uB294 \uB9C8\uC138\uC694. \uAE30\uB2E4\uB824\uC11C
        \uB193\uCE58\uB294 \uAC70\uB798\uB3C4 \uBE44\uC6A9\uC774\uB2C8\uAE4C\uC694."
