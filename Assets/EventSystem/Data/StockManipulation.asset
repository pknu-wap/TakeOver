  - choiceText: "\uAC70\uC808\uD55C\uB2E4"
    choiceDescription:
    playerLine: "\uC774\uBC88 \uAC74\uC740 \uD558\uC9C0 \uC54A\uACA0\uC2B5\uB2C8\uB2E4.
      \uD68C\uC0AC\uAC00 \uB2EC\uB77C\uC9C0\uB294 \uAC70\uB798\uAC00 \uC544\uB2C8\uB77C\uB294
      \uC810\uB3C4 \uB9C8\uC74C\uC5D0 \uAC78\uB9AC\uACE0\uC694."
    resultDialogue: "\uC54C\uACA0\uC2B5\uB2C8\uB2E4. \uC774\uBC88 \uC81C\uC548\uC740
      \uC811\uC8E0. \uB2E4\uB978 \uAC70\uB798\uAE4C\uC9C0 \uC548 \uBC1B\uACA0\uB2E4\uB294
      \uB73B\uC740 \uC544\uB2CC \uAC83\uC73C\uB85C \uB4E3\uACA0\uC2B5\uB2C8\uB2E4."
    resultValue: reject
    npcResult:
      eventId:
