  m_Name: StockManipulation
  m_EditorClassIdentifier: TakeOver.Events::TakeOver.Events.EventDefinition
  eventId: stock_manipulation_01
  category: 0
  linearDialogue: 0
  tutorialOnly: 0
  title: "\uC724\uD558\uC9C4 \u2014 \uBCF4\uC720 \uC885\uBAA9\uC758 \uC2DC\uC138
    \uC81C\uC548"
  image: {fileID: 21300000, guid: e4ad3f1b63392de47bb9cbfeb6be2bd0, type: 3}
  cardImage: {fileID: 21300000, guid: e317d1d530e3577478c641da73f9c3d8, type: 3}
  npcArts:
  - npcId: npc-broker-yoon-hajin
    cardImage: {fileID: 21300000, guid: e317d1d530e3577478c641da73f9c3d8, type: 3}
    popupImage: {fileID: 21300000, guid: e4ad3f1b63392de47bb9cbfeb6be2bd0, type: 3}
  highlightImage: {fileID: 0}
  negotiationBackground: {fileID: 0}
  description: "\uC724\uD558\uC9C4\uC774 \uB0B4\uAC00 \uB4E4\uACE0 \uC788\uB294 \uC885\uBAA9\uC758
    \uAC00\uACA9\uC744 \uC6C0\uC9C1\uC77C \uC218 \uC788\uB2E4\uACE0 \uD588\uB2E4.
    \uC2E4\uC801\uC774 \uC88B\uC544\uC9C8 \uC18C\uC2DD\uB3C4 \uC5C6\uC774 \uAC00\uACA9\uBD80\uD130
    \uC598\uAE30\uD558\uB294 \uC774\uC720\uB97C \uB4E3\uACE0 \uC2F6\uB2E4."
  apCost: 1
  startButtonText: "\uB9CC\uB098\uAE30"
  companyIds: []
  speakerNpcId: npc-broker-yoon-hajin
  speakerName: "\uC724\uD558\uC9C4"
  speakerRole:
  dialogue: "\uC624\uB298\uC740 \uD68C\uC0AC \uC6B4\uC601 \uC774\uC57C\uAE30\uB294
    \uC544\uB2C8\uC5D0\uC694. \uD3C9\uD310\uC774 \uB0B4\uB824\uAC04 \uC885\uBAA9
    \uC911\uC5D0 \uC2DC\uC138\uB97C \uC6C0\uC9C1\uC77C \uC5EC\uC9C0\uAC00 \uC788\uB294
    \uACF3\uC774 \uC788\uC5B4\uC694. \uAC00\uC9C0\uACE0 \uACC4\uC2E0 \uC8FC\uC2DD\uB3C4
    \uC788\uACE0\uC694."
  companyQuestion: "\uC88B\uC2B5\uB2C8\uB2E4. \uC5B4\uB290 \uC885\uBAA9\uC73C\uB85C
    \uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
  companyPlayerLine: "{company} \uCABD\uC73C\uB85C \uD574 \uC8FC\uC2DC\uC8E0."
  choices:
  - choiceText: "\uC81C\uC548\uC744 \uBC1B\uC544\uB4E4\uC778\uB2E4"
    choiceDescription: "\uC120\uD0DD \uC885\uBAA9\uC5D0 \uAE30\uC874 \uB2E4\uC74C
      \uD134 \uAE09\uB4F1 \uD6A8\uACFC\uB97C \uC801\uC6A9\uD569\uB2C8\uB2E4. \uB9E4\uB3C4
      \uC218\uC775\uC740 \uBCF4\uC7A5\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    playerLine: "\uC704\uD5D8\uC774 \uC788\uB2E4\uB294 \uAC74 \uC54C\uACA0\uC2B5\uB2C8\uB2E4.
      \uC81C\uC548\uC744 \uAC80\uD1A0\uD558\uC8E0. \uC5B4\uB290 \uC885\uBAA9\uC5D0
      \uC801\uC6A9\uD560\uC9C0\uB294 \uC81C\uAC00 \uC815\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    resultDialogue: "\uC88B\uC2B5\uB2C8\uB2E4. \uBCF4\uC720 \uC885\uBAA9\uC744 \uBCF4\uACE0
      \uC815\uD558\uC138\uC694. \uC5B4\uB5A4 \uD68C\uC0AC \uC8FC\uC2DD\uC744 \uD314\uACA0\uB2E4\uB294
      \uB9D0\uAE4C\uC9C0 \uC9C0\uAE08 \uBC1B\uC740 \uAC74 \uC544\uB2C8\uC5D0\uC694.\n\n{company}
      \uAC74\uC73C\uB85C \uBC1B\uC558\uC2B5\uB2C8\uB2E4. \uC624\uB298 \uC774 \uC120\uD0DD\uC740
      \uD3C9\uBC94\uD55C \uB9E4\uBB3C \uC18C\uAC1C\uC640\uB294 \uB2E4\uB978 \uAE30\uB85D\uC73C\uB85C
      \uB0A8\uB294\uB2E4\uB294 \uC810\uB3C4 \uC54C\uACE0 \uACC4\uC2DC\uC8E0."
    resultValue: accept
    npcResult:
      eventId:
      companyId:
      actorId:
      actionId:
      targetNpcIds:
      - npc-broker-yoon-hajin
      targetReactions:
      - targetNpcId: npc-broker-yoon-hajin
        memoryType: 8
        strength: 2
        publicity: 0
        permanent: 0
        durationTurns: 3
        reliability: 1
        interpretation:
