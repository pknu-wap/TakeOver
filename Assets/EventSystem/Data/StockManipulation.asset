    scene: 0
  - npcId: npc-broker-yoon-hajin
    text: "\uADF8\uB7F0 \uC598\uAE30\uB77C\uBA74 \uBA3C\uC800 \uC790\uB8CC\uB97C
      \uB4DC\uB838\uACA0\uC8E0. \uC774\uBC88 \uAC74\uC740 \uAC00\uACA9 \uCABD\uC785\uB2C8\uB2E4.
      \uBC1B\uC744\uC9C0 \uB9D0\uC9C0\uBD80\uD130 \uC815\uD558\uC138\uC694. \uADF8\uB2E4\uC74C\uC5D0
      \uC885\uBAA9\uC744 \uBCF4\uC8E0."
    player: 0
    narration: 0
    scene: 0
  - npcId:
    text: "\uC704\uD5D8\uB3C4 \uAC19\uC774 \uB9D0\uC500\uD558\uC154\uC57C\uACA0\uC2B5\uB2C8\uB2E4."
    player: 1
    narration: 0
    scene: 0
  - npcId: npc-broker-yoon-hajin
    text: "\uB124. \uC88B\uC740 \uAC70\uB798\uB9CC \uC18C\uAC1C\uD558\uB294 \uC0AC\uB78C\uC73C\uB85C
