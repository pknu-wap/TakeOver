        - stock_manipulation
        relationDelta:
          trust: 20
          respect: 0
          closeness: -10
      memoryType: 8
      strength: 1
      publicity: 0
      permanent: 0
      durationTurns: 3
      reliability: 1
      interpretation: "\uD574\uB2F9 \uD68C\uCC28\uC758 \uC704\uD5D8\uD55C \uC81C\uC548
        \uC218\uB77D. \uAE30\uC874 `accept`\uC640 \uC885\uBAA9 \uC120\uD0DD \uACB0\uACFC
        \uC720\uC9C0. \uAE30\uC874 \uC5D0\uC14B\uC758 \uB2E4\uC74C \uD134 \uAE09\uB4F1
        30~40% \uD6A8\uACFC\uB97C \uC5F0\uACB0\uD560 \uACBD\uC6B0 \uADF8\uB300\uB85C
        \uBA85\uC2DC\uD558\uACE0, \uB9E4\uB3C4\xB7\uD604\uAE08 \uC218\uC775\xB7\uD68C\uC0AC
        \uC2E4\uC801 \uAC1C\uC120\uC744 \uC790\uB3D9 \uBCF4\uC7A5\uD558\uC9C0 \uC54A\uB294\uB2E4. "
      tags:
      - stock_manipulation
