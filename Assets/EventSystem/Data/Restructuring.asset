  companyVariants:
  - companyId: mirae-construction
    title: "\uBBF8\uB798\uAC74\uC124 \u2014 \uD604\uC7A5 \uC778\uAC74\uBE44 \uC808\uAC10\uC548"
    description: "\uC808\uAC10\uC548\uC774 \uC778\uAC74\uBE44\uBD80\uD130 \uC904\uC600\uB2E4.
      \uBC15\uB3C4\uC2DD\uC740 \uB0A8\uC740 \uACF5\uC815\uACFC \uD22C\uC785 \uC778\uC6D0\uC744
      \uC9C1\uC811 \uB9DE\uCDB0\uBCF4\uC790\uACE0 \uD55C\uB2E4. \uC778\uAC74\uBE44\uB97C
      \uC544\uB07C\uACE0\uB3C4 \uC900\uACF5\uC744 \uC9C0\uD0AC \uC218 \uC788\uC744\uAE4C."
    openingLines:
    - npcId: npc-mirae-construction-field-director-park-dosik
      text: "\uC774\uBC88 \uBE44\uC6A9\uC548 \uBCF4\uC168\uC2B5\uB2C8\uAE4C. \uC778\uAC74\uBE44
        \uD56D\uBAA9\uC5D0 \uBA3C\uC800 \uD45C\uC2DC\uAC00 \uB3FC \uC788\uB354\uAD70\uC694."
      player: 0
      narration: 0
      scene: 0
    - npcId:
      text: "\uC544\uC9C1 \uC138\uBD80\uC548\uC744 \uBCF4\uACE0 \uC788\uC2B5\uB2C8\uB2E4.
        \uD604\uC7A5\uC5D0\uC11C\uB294 \uC5B4\uB5BB\uC2B5\uB2C8\uAE4C?"
      player: 1
      narration: 0
      scene: 0
    - npcId: npc-mirae-construction-field-director-park-dosik
      text: "\uC0AC\uB78C \uC218\uD558\uACE0 \uB0A8\uC740 \uC77C\uBD80\uD130 \uAC19\uC774
        \uBCF4\uC154\uC57C \uD569\uB2C8\uB2E4. \uC22B\uC790\uB9CC \uC904\uC774\uBA74
        \uADF8\uB2E4\uC74C \uC904\uC740 \uACF5\uC0AC \uC9C0\uC5F0\uC785\uB2C8\uB2E4."
      player: 0
      narration: 0
      scene: 0
    - npcId:
      text: "\uBE44\uC6A9\uC744 \uADF8\uB300\uB85C \uB458 \uC5EC\uC720\uB3C4 \uC5C6\uB2E4\uB294
        \uC598\uAE30\uAC00 \uB098\uC635\uB2C8\uB2E4."
      player: 1
      narration: 0
      scene: 0
    - npcId: npc-mirae-construction-field-director-park-dosik
      text: "\uC555\uB2C8\uB2E4. \uADF8\uB798\uC11C \uBABB \uC904\uC778\uB2E4\uACE0\uB9CC
        \uB9D0\uD558\uB7EC \uC628 \uAC74 \uC544\uB2D9\uB2C8\uB2E4. \uC5B4\uB290 \uC791\uC5C5\uC744
        \uB2A6\uCD94\uACE0 \uC5B4\uB290 \uC791\uC5C5\uC740 \uACC4\uC18D\uD560\uC9C0
        \uBA3C\uC800 \uB4E3\uACE0 \uC2F6\uC740 \uAC81\uB2C8\uB2E4."
      player: 0
      narration: 0
      scene: 0
    choices:
    - choiceText: "\uD070 \uD3ED\uC758 \uAC10\uCD95\uC548\uC744 \uC6B0\uC120 \uAC80\uD1A0\uD55C\uB2E4"
      choiceDescription:
      playerLine: "\uC774\uBC88\uC5D0\uB294 \uBE44\uC6A9\uC744 \uD06C\uAC8C \uB0AE\uCD94\uB294
        \uC548\uBD80\uD130 \uBCF4\uACA0\uC2B5\uB2C8\uB2E4. \uB2E4\uB9CC \uC904\uC778
        \uC778\uC6D0\uC73C\uB85C \uC77C\uC815\uC774 \uADF8\uB300\uB85C \uB41C\uB2E4\uACE0
        \uC801\uC9C0\uB294 \uB9C8\uC2ED\uC2DC\uC624."
      resultDialogue: "\uADF8\uB7EC\uBA74 \uBA48\uCD94\uB294 \uACF5\uC815\uB3C4 \uAC19\uC774
        \uC801\uACA0\uC2B5\uB2C8\uB2E4. \uD604\uC7A5\uC5D0 \uCC45\uC784\uB9CC \uB118\uAE38
        \uC218\uB294 \uC5C6\uC2B5\uB2C8\uB2E4.\n\n\uC0AC\uB78C\uBD80\uD130 \uC815\uD574\uB193\uACE0
        \uADF8\uB2E4\uC74C\uC5D0 \uC774\uC720\uB97C \uB9DE\uCD94\uC9C0 \uC54A\uC558\uC73C\uBA74
        \uD569\uB2C8\uB2E4. \uADF8 \uBD80\uBD84\uC740 \uBD84\uBA85\uD788 \uB9D0\uC500\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4."
      resultValue: mass_layoff
      npcResult:
