  - companyId: dongbang-trading
    title: "\uB3D9\uBC29\uBB3C\uC0B0 \u2014 \uCC3D\uACE0 \uC778\uC6D0 \uC7AC\uBC30\uCE58"
    description: "\uBC15\uBBFC\uC6B0\uAC00 \uB2E4\uC74C \uBC30\uCE58\uD45C\uB97C
      \uADF8\uB9AC\uAE30 \uC804\uC5D0 \uC5F0\uB77D\uD588\uB2E4. \uC778\uC6D0\uC744
      \uC62E\uACA8\uB3C4 \uCD9C\uACE0\uAC00 \uBC00\uB9AC\uC9C0 \uC54A\uB294\uC9C0,
      \uADF8\uB3D9\uC548 \uB204\uAC00 \uBE48 \uAD50\uB300\uB97C \uB9E1\uB294\uC9C0
      \uBB3C\uC5B4\uBCF4\uC790."
    openingLines:
    - npcId: npc-dongbang-trading-hr-director-park-minu
      text: "\uD45C\uB97C \uD3B4\uAE30 \uC804\uC5D0 \uD558\uB098\uB9CC \uB9D0\uC500\uB4DC\uB9B4\uAC8C\uC694.
        \uCE78\uC744 \uC9C0\uC6B0\uBA74 \uC5D1\uC140\uC740 \uC870\uC6A9\uD569\uB2C8\uB2E4.
        \uC0AC\uB78C\uC740 \uC124\uBA85\uC744 \uB4E4\uC5B4\uC57C \uD558\uACE0\uC694."
      player: 0
      narration: 0
      scene: 0
    - npcId:
      text: "\uC774\uBC88 \uBC30\uCE58\uC548\uC774 \uB098\uC654\uC2B5\uB2C8\uAE4C?"
      player: 1
      narration: 0
      scene: 0
    - npcId: npc-dongbang-trading-hr-director-park-minu
      text: "\uBC29\uD5A5\uBD80\uD130 \uC815\uD574\uC57C \uD569\uB2C8\uB2E4. \uC904\uC77C\uC9C0,
        \uB098\uB220 \uC62E\uAE38\uC9C0, \uB2E4\uB978 \uBE44\uC6A9\uC744 \uBCFC\uC9C0\uC694.
        \uB2E4\uB9CC \uC5B4\uB290 \uCABD\uC774\uB4E0 \u2018\uC0AC\uB78C\uC740 \uB098\uC911\uC5D0
        \uB9DE\uCD98\uB2E4\u2019\uACE0 \uC801\uC744 \uC790\uB9AC\uB294 \uC5C6\uC5C8\uC73C\uBA74
        \uD569\uB2C8\uB2E4."
      player: 0
      narration: 0
      scene: 0
    - npcId:
      text: "\uAC00\uB2A5\uD55C \uB300\uC548\uC744 \uAC19\uC774 \uC900\uBE44\uD560
        \uC218 \uC788\uACA0\uC2B5\uB2C8\uAE4C?"
      player: 1
      narration: 0
      scene: 0
    - npcId: npc-dongbang-trading-hr-director-park-minu
      text: "\uB124. \uC81C\uAC00 \uC6D0\uD558\uB294 \uAC83\uB3C4 \uBE44\uAD50\uD560
        \uB300\uC548\uC785\uB2C8\uB2E4. \uC9C1\uC6D0\uB4E4 \uC55E\uC5D0\uC11C \uCC98\uC74C
        \uB4E3\uB294 \uACC4\uD68D\uC744 \uC124\uBA85\uD558\uB294 \uC5ED\uD560\uC740
        \uD53C\uD558\uACE0 \uC2F6\uAC70\uB4E0\uC694."
      player: 0
      narration: 0
      scene: 0
    choices:
    - choiceText: "\uD070 \uD3ED\uC758 \uAC10\uCD95\uC548\uC744 \uC6B0\uC120 \uAC80\uD1A0\uD55C\uB2E4"
      choiceDescription:
      playerLine: "\uBE44\uC6A9\uC744 \uBE68\uB9AC \uC904\uC774\uB294 \uC548\uBD80\uD130
        \uBCF4\uACA0\uC2B5\uB2C8\uB2E4. \uBE60\uC9C0\uB294 \uC5C5\uBB34\uC640 \uC124\uBA85\xB7\uBCF4\uC0C1
        \uBB38\uC81C\uB3C4 \uBE7C\uC9C0 \uB9D0\uACE0\uC694."
      resultDialogue: "\uC54C\uACA0\uC2B5\uB2C8\uB2E4. \uADF8\uB7FC \uBC18\uB300
        \uC758\uACAC\uB3C4 \uADF8\uB300\uB85C \uC62C\uB9AC\uACA0\uC2B5\uB2C8\uB2E4.
        \uADDC\uBAA8\uAC00 \uD06C\uBA74 \uC911\uAC04\uAD00\uB9AC\uC790 \uBA87 \uBA85\uC774
        \uC124\uB4DD\uD574\uC11C \uB05D\uB0BC \uC218 \uC788\uB294 \uC77C\uC774 \uC544\uB2D9\uB2C8\uB2E4."
      resultValue: mass_layoff
      npcResult:
