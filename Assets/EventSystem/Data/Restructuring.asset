  - companyId: hansung-industry
    title: "\uD55C\uC131\uACF5\uC5C5 \u2014 \uC778\uB825 \uAC10\uCD95\uACFC \uACF5\uC815
      \uC778\uACC4"
    description: "\uCD5C\uBBF8\uC815\uC774 \uBE44\uC6A9\uD45C\uC5D0\uC11C \uC9C0\uC6CC\uC9C8
      \uC790\uB9AC\uC758 \uC77C\uC744 \uB204\uAC00 \uB118\uACA8\uBC1B\uC744\uC9C0
      \uBB3B\uB294\uB2E4. \uACBD\uD5D8\uC774 \uD544\uC694\uD55C \uACF5\uC815\uBD80\uD130
      \uB0A8\uC740 \uC0AC\uB78C\uC5D0\uAC8C \uB118\uAE38 \uC218 \uC788\uB294\uC9C0
      \uBD10\uC57C\uACA0\uB2E4."
    openingLines:
    - npcId: npc-hansung-industry-labor-director-choi-mijeong
      text: "\uC774\uBC88 \uC548\uC5D0\uB294 \uC904\uC77C \uBE44\uC6A9\uC740 \uC788\uB294\uB370,
        \uADF8 \uC77C\uC744 \uB9E1\uB358 \uC0AC\uB78C\uC744 \uC5B4\uB5BB\uAC8C \uD560\uC9C0\uB294
        \uBE44\uC5B4 \uC788\uC2B5\uB2C8\uB2E4."
      player: 0
      narration: 0
      scene: 0
    - npcId:
      text: "\uC544\uC9C1 \uCD5C\uC885\uC548\uC740 \uC544\uB2D9\uB2C8\uB2E4."
      player: 1
      narration: 0
      scene: 0
    - npcId: npc-hansung-industry-labor-director-choi-mijeong
      text: "\uB124. \uADF8\uB798\uC11C \uC9C0\uAE08 \uB9D0\uC500\uB4DC\uB9AC\uB294
        \uAC81\uB2C8\uB2E4. \uCD5C\uC885\uC548\uC774 \uB41C \uB4A4\uC5D0 \uC124\uBA85\uC744
        \uBD99\uC774\uBA74 \uC120\uD0DD\uC9C0\uAC00 \uC801\uC5B4\uC9C0\uB2C8\uAE4C\uC694."
      player: 0
      narration: 0
      scene: 0
    - npcId:
      text: "\uC5B4\uB5A4 \uD56D\uBAA9\uC744 \uBA3C\uC800 \uBD10\uC57C \uD569\uB2C8\uAE4C?"
      player: 1
      narration: 0
      scene: 0
    - npcId: npc-hansung-industry-labor-director-choi-mijeong
      text: "\uBE60\uC9C0\uB294 \uC791\uC5C5, \uB0A8\uB294 \uC0AC\uB78C\uC758 \uBD80\uB2F4,
        \uBCF4\uC0C1\uACFC \uC804\uD658 \uC870\uAC74\uC785\uB2C8\uB2E4. \uC0AC\uB78C
        \uC218\uAC00 \uC904\uC5B4\uB3C4 \uAC19\uC740 \uC0DD\uC0B0\uB7C9\uC774 \uB098\uC628\uB2E4\uB294
        \uAC00\uC815\uB3C4 \uD655\uC778\uD574\uC57C \uD558\uACE0\uC694."
      player: 0
      narration: 0
      scene: 0
    choices:
    - choiceText: "\uD070 \uD3ED\uC758 \uAC10\uCD95\uC548\uC744 \uC6B0\uC120 \uAC80\uD1A0\uD55C\uB2E4"
      choiceDescription:
      playerLine: "\uD070 \uD3ED\uC73C\uB85C \uBE44\uC6A9\uC744 \uC904\uC774\uB294
        \uC548\uBD80\uD130 \uBCF4\uACA0\uC2B5\uB2C8\uB2E4. \uB300\uC2E0 \uC804\uD658\uACFC
        \uBCF4\uC0C1, \uC0DD\uC0B0 \uCC28\uC9C8\uC744 \uD3EC\uD568\uD55C \uC804\uCCB4
        \uBE44\uC6A9\uC744 \uC62C\uB824\uC8FC\uC138\uC694."
      resultDialogue: "\uC790\uB8CC\uB294 \uC900\uBE44\uD558\uACA0\uC2B5\uB2C8\uB2E4.
        \uADF8 \uC548\uC5D0 \uBC18\uB300\uD55C\uB2E4\uB294 \uC758\uACAC\uB3C4 \uD568\uAED8
        \uB0A8\uAE30\uACA0\uC2B5\uB2C8\uB2E4. \uB2F9\uC0AC\uC790\uC5D0\uAC8C \uC124\uBA85\uD560
        \uC808\uCC28\uB97C \uBE44\uC6A9 \uB54C\uBB38\uC5D0 \uBE7C\uC9C0\uB294 \uB9C8\uC2ED\uC2DC\uC624."
