    - choiceText: "\uC774\uBC88 \uC548\uC5D0\uC11C\uB294 \uAC10\uCD95\uC744 \uC81C\uC678\uD55C\uB2E4"
      choiceDescription:
      playerLine: "\uC774\uBC88\uC5D0\uB294 \uC778\uB825 \uAC10\uCD95 \uC5C6\uC774
        \uC870\uC815\uD560 \uD56D\uBAA9\uBD80\uD130 \uBCF4\uACA0\uC2B5\uB2C8\uB2E4.
        \uD488\uBAA9 \uC218\uC640 \uC0DD\uC0B0 \uC21C\uC11C, \uD589\uC0AC \uBB3C\uB7C9\uB3C4
        \uD3EC\uD568\uD574\uC11C\uC694."
      resultDialogue: "\uAC00\uB2A5\uD569\uB2C8\uB2E4. \uB2E4\uB9CC \uAC10\uCD95\uC744
        \uC81C\uC678\uD588\uB2E4\uB294 \uC774\uC720\uB85C \uBE44\uC6A9 \uBB38\uC81C\uAC00
        \uD574\uACB0\uB41C \uAC83\uC73C\uB85C \uC124\uBA85\uD558\uC9C0\uB294 \uC54A\uACA0\uC2B5\uB2C8\uB2E4.
        \uB2E4\uB978 \uB300\uC548\uC774 \uC5BC\uB9C8\uB098 \uC904\uC774\uB294\uC9C0
        \uD655\uC778\uD574\uC57C \uD569\uB2C8\uB2E4."
