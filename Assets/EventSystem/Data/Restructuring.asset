  - companyId: haneul-food
    title: "\uD558\uB298\uC2DD\uD488 \u2014 \uC0DD\uC0B0 \uC778\uB825 \uC870\uC815\uC548"
    description: "\uC778\uAC74\uBE44\uAC00 \uC900 \uB0B4\uC5ED\uC740 \uBC14\uB85C
      \uBCF4\uC778\uB2E4. \uC0C8 \uC778\uB825\uC744 \uAD50\uC721\uD558\uACE0 \uC0DD\uC0B0
      \uC21C\uC11C\uB97C \uBC14\uAFB8\uB294 \uB370 \uB4DC\uB294 \uC2DC\uAC04\uB3C4
      \uADF8 \uD45C\uC5D0 \uB4E4\uC5B4\uC788\uB294\uC9C0 \uD655\uC778\uD574\uC57C\uACA0\uB2E4."
    openingLines:
    - npcId: npc-haneul-food-cfo-oh-jaeseong
      text: "\uC778\uAC74\uBE44\uB97C \uC904\uC774\uB294 \uC548\uC774 \uC62C\uB77C\uC654\uC2B5\uB2C8\uB2E4.
        \uC22B\uC790\uB294 \uBC14\uB85C \uB0B4\uB824\uAC11\uB2C8\uB2E4. \uBB38\uC81C\uB294
        \uADF8 \uB4A4 \uBE44\uC6A9\uC744 \uAC19\uC740 \uD45C\uC5D0 \uB123\uC5C8\uB294\uC9C0\uC785\uB2C8\uB2E4."
      player: 0
      narration: 0
      scene: 0
    - npcId:
      text: "\uACB0\uC6D0 \uB54C\uBB38\uC5D0 \uC0DD\uAE30\uB294 \uBE44\uC6A9 \uB9D0\uC785\uB2C8\uAE4C?"
      player: 1
      narration: 0
      scene: 0
    - npcId: npc-haneul-food-cfo-oh-jaeseong
      text: "\uB300\uCCB4 \uC778\uB825 \uAD50\uC721, \uC0DD\uC0B0 \uC21C\uC11C \uBCC0\uACBD,
        \uD488\uC9C8 \uD655\uC778 \uC2DC\uAC04\uC774 \uC788\uC2B5\uB2C8\uB2E4. \uBC18\uB300\uB85C
        \uD604\uC7AC \uBC30\uCE58\uC5D0\uC11C \uD6A8\uC728\uC774 \uB0AE\uC740 \uBD80\uBD84\uB3C4
        \uC788\uACE0\uC694. \uAC10\uCD95\uC774 \uC5B8\uC81C\uB098 \uB098\uC058\uB2E4\uAC70\uB098
        \uC5B8\uC81C\uB098 \uC2F8\uB2E4\uACE0 \uB193\uACE0 \uC2DC\uC791\uD560 \uC218\uB294
        \uC5C6\uC2B5\uB2C8\uB2E4."
      player: 0
      narration: 0
      scene: 0
    - npcId:
      text: "\uC774\uBC88\uC5D0\uB294 \uBB34\uC5C7\uC744 \uBA3C\uC800 \uBE44\uAD50\uD558\uACA0\uC2B5\uB2C8\uAE4C?"
      player: 1
      narration: 0
      scene: 0
    - npcId: npc-haneul-food-cfo-oh-jaeseong
      text: "\uAC80\uD1A0\uD560 \uBC29\uD5A5\uC744 \uB9D0\uC500\uD574\uC8FC\uC2DC\uBA74
        \uADF8 \uBC29\uD5A5\uC758 \uBE44\uC6A9\uC744 \uC228\uAE30\uC9C0 \uC54A\uACE0
        \uBCF4\uACA0\uC2B5\uB2C8\uB2E4. \uD488\uC9C8 \uAE30\uC900\uC744 \uB0AE\uCD94\uB294
        \uAC74 \uACC4\uC0B0\uC758 \uC9C0\uB984\uAE38\uB85C \uC4F0\uC9C0 \uC54A\uC744
        \uC0DD\uAC01\uC785\uB2C8\uB2E4."
      player: 0
      narration: 0
      scene: 0
    choices:
    - choiceText: "\uD070 \uD3ED\uC758 \uAC10\uCD95\uC548\uC744 \uC6B0\uC120 \uAC80\uD1A0\uD55C\uB2E4"
      choiceDescription:
      playerLine: "\uBE44\uC6A9\uC744 \uBE60\uB974\uAC8C \uB0AE\uCD94\uB294 \uC548\uBD80\uD130
        \uBCF4\uACA0\uC2B5\uB2C8\uB2E4. \uC904\uC5B4\uB4E0 \uC0DD\uC0B0\uB7C9\uACFC
        \uCD94\uAC00 \uAD50\uC721\uBE44\uB3C4 \uAC19\uC740 \uC790\uB9AC\uC5D0 \uB123\uC5B4\uC8FC\uC138\uC694."
      resultDialogue: "\uADF8\uB807\uAC8C \uACC4\uC0B0\uD558\uACA0\uC2B5\uB2C8\uB2E4.
        \uB2E4\uB9CC \uD070 \uD3ED\uC758 \uAC10\uCD95\uC744 \uC804\uC81C\uB85C \uD558\uBA74
        \uCD08\uAE30 \uD63C\uB780\uB3C4 \uCEE4\uC9C8 \uAC81\uB2C8\uB2E4. \uB2E8\uAE30
        \uBE44\uC6A9 \uAC10\uC18C\uB9CC \uACB0\uACFC\uB85C \uB0B4\uC9C0\uB294 \uC54A\uACA0\uC2B5\uB2C8\uB2E4."
      resultValue: mass_layoff
      npcResult:
