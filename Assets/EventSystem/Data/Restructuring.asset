  negotiationBackground: {fileID: 21300000, guid: 0c3948cb5bd127242a3ec8551eec1e98, type: 3}
  description: "\uBE44\uC6A9\uC744 \uC904\uC774\uC790\uB294 \uC548\uC774 \uC62C\uB77C\uC654\uB2E4.
    \uC22B\uC790\uC5D0\uC11C \uC9C0\uC6CC\uC9C0\uB294 \uC790\uB9AC\uB97C \uB204\uAC00
    \uBA54\uC6B0\uACE0, \uB0A8\uC740 \uC77C\uC744 \uC5B4\uB5BB\uAC8C \uB05D\uB0BC\uC9C0
    \uD604\uC7A5\uC758 \uC124\uBA85\uBD80\uD130 \uB4E3\uACA0\uB2E4."
  apCost: 2
  startButtonText: "\uB17C\uC758\uD55C\uB2E4"
  companyIds: []
  speakerNpcId:
  speakerName:
  speakerRole:
  dialogue: "\uD68C\uC0AC\uB97C \uB9E1\uC73C\uC168\uC73C\uB2C8 \uC778\uB825 \uBB38\uC81C\uB97C
    \uC815\uD558\uC154\uC57C \uD569\uB2C8\uB2E4. \uC5BC\uB9C8\uB098 \uC904\uC774\uC2E4
    \uAC81\uB2C8\uAE4C?"
  companyQuestion:
  companyPlayerLine:
  choices:
  - choiceText: "\uB300\uADDC\uBAA8\uB85C \uAC10\uCD95\uD55C\uB2E4"
    choiceDescription: "\uBE44\uC6A9\uC740 \uD06C\uAC8C \uC904\uC9C0\uB9CC \uBC18\uBC1C\uC774
      \uAC70\uC138\uB2E4"
    playerLine: "\uD06C\uAC8C \uC904\uC774\uACA0\uC2B5\uB2C8\uB2E4. \uBC84\uD2F0\uB824\uBA74
      \uC5B4\uCA54 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    resultDialogue: "\u2026\uC54C\uACA0\uC2B5\uB2C8\uB2E4. \uACB0\uACFC\uB294 \uCC45\uC784\uC9C0\uC154\uC57C
      \uD560 \uAC81\uB2C8\uB2E4."
    resultValue: mass_layoff
