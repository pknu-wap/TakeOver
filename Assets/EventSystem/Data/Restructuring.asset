    - choiceText: "\uC774\uBC88 \uC548\uC5D0\uC11C\uB294 \uAC10\uCD95\uC744 \uC81C\uC678\uD55C\uB2E4"
      choiceDescription:
      playerLine: "\uC774\uBC88\uC5D0\uB294 \uAC10\uCD95\uC744 \uC81C\uC678\uD558\uACE0
        \uB2E4\uB978 \uBE44\uC6A9 \uB300\uC548\uBD80\uD130 \uAC80\uD1A0\uD558\uACA0\uC2B5\uB2C8\uB2E4.
        \uAE30\uC874 \uC778\uB825\uC5D0\uAC8C \uC77C\uC744 \uB354 \uC5B9\uB294 \uC548\uB3C4
        \uB530\uB85C \uBCF4\uC8E0."
      resultDialogue: "\uC54C\uACA0\uC2B5\uB2C8\uB2E4. \uADF8 \uBC29\uD5A5\uC744
        \uC624\uB298 \uAC80\uD1A0 \uC758\uACAC\uC73C\uB85C \uB0A8\uAE30\uACA0\uC2B5\uB2C8\uB2E4.
        \uD544\uC694\uD55C \uC9C0\uC6D0\uACFC \uD68C\uC0AC\uAC00 \uAC10\uB2F9\uD560
        \uBC94\uC704\uB3C4 \uAC19\uC774 \uC124\uBA85\uD574\uC8FC\uC138\uC694. \uADF8
        \uBD80\uBD84\uC774 \uC5C6\uC73C\uBA74 \uB2E4\uC74C\uBC88\uC5D0 \uAC19\uC740
        \uC790\uB9AC\uB85C \uB3CC\uC544\uC635\uB2C8\uB2E4."
