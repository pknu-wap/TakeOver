  category: 0
  linearDialogue: 0
  tutorialOnly: 0
  title: "\uC778\uB825 \uAC10\uCD95\uC548 \uAC80\uD1A0"
  image: {fileID: 21300000, guid: 7d714964754218147960c156ac4cf78f, type: 3}
