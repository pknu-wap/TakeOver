    - choiceText: "\uB2E8\uACC4\uC801 \uC870\uC815\uC548\uC744 \uC6B0\uC120 \uAC80\uD1A0\uD55C\uB2E4"
      choiceDescription:
      playerLine: "\uC791\uC5C5\uBCC4\uB85C \uC62E\uAE38 \uC218 \uC788\uB294 \uC790\uB9AC\uC640
        \uAD50\uC721 \uC2DC\uAC04\uC744 \uBA3C\uC800 \uBCF4\uC8E0. \uB2E8\uACC4\uC801\uC73C\uB85C
