    - choiceText: "\uC774\uBC88 \uC548\uC5D0\uC11C\uB294 \uAC10\uCD95\uC744 \uC81C\uC678\uD55C\uB2E4"
      choiceDescription:
      playerLine: "\uC774\uBC88 \uAC80\uD1A0\uC548\uC5D0\uC11C\uB294 \uC778\uB825
        \uAC10\uCD95\uC744 \uC81C\uC678\uD558\uACA0\uC2B5\uB2C8\uB2E4. \uB2E4\uB978
        \uBE44\uC6A9\uACFC \uC77C\uC815\uC5D0\uC11C \uC904\uC77C \uBD80\uBD84\uC744
        \uBA3C\uC800 \uCC3E\uC544\uBCF4\uC8E0."
      resultDialogue: "\uADF8 \uBC29\uD5A5\uC740 \uBC18\uAC11\uC2B5\uB2C8\uB2E4.
        \uB300\uC2E0 \uD604\uC7A5\uC5D0\uC11C \uBB58 \uB354 \uD574\uC57C \uD558\uB294\uC9C0\uB3C4
        \uB4E3\uACE0 \uC2F6\uC2B5\uB2C8\uB2E4. \uC0AC\uB78C\uC740 \uB450\uACE0 \uC77C\uC744
        \uB354 \uC5B9\uB294 \uCABD\uC774\uBA74 \uB2E4\uB978 \uBB38\uC81C\uAC00 \uC0DD\uAE41\uB2C8\uB2E4.\n\n\uADF8\uB7FC
        \uC791\uC5C5\uB7C9\uBD80\uD130 \uB2E4\uC2DC \uBCF4\uACA0\uC2B5\uB2C8\uB2E4.
        \uC624\uB298 \uC815\uD55C \uAC80\uD1A0 \uBC29\uD5A5\uC73C\uB85C \uAE30\uB85D\uD558\uC8E0."
