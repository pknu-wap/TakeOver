    - npcId:
      text: "\uACF5\uAC1C\uD560 \uC218 \uC788\uB294 \uBC94\uC704\uC758 \uC790\uAE08
        \uAD6C\uC870\uC640 \uD310\uB2E8 \uAE30\uC900\uC744 \uC124\uBA85\uD558\uACA0\uC2B5\uB2C8\uB2E4.
        \uD655\uC778\uD558\uC9C0 \uC54A\uC740 \uC218\uC775 \uC804\uB9DD\uC774\uB098
        \uC544\uC9C1 \uC815\uD558\uC9C0 \uC54A\uC740 \uC9C0\uC6D0 \uACC4\uD68D\uC740
        \uAD6C\uBD84\uD574\uC8FC\uC138\uC694."
      player: 1
      narration: 0
    - npcId: npc-economic-reporter-lee-mingyu
      text: "\uB124. \uC124\uBA85 \uAC00\uB2A5\uD55C \uBD80\uBD84\uD558\uACE0 \uBBF8\uC815\uC778
        \uBD80\uBD84\uC744 \uB098\uB220 \uC801\uACA0\uC2B5\uB2C8\uB2E4. \uC81C\uAC00
        \uD55C \uBB38\uC7A5\uC73C\uB85C \uC904\uC774\uB2E4\uAC00 \uB2E4\uB978 \uB73B\uC774
        \uB418\uBA74 \uB2E4\uC2DC \uD655\uC778\uD560\uAC8C\uC694."
      player: 0
      narration: 0
    - npcId:
      text: "\uBAA8\uB4E0 \uC790\uAE08 \uB0B4\uC5ED\uC744 \uACF5\uAC1C\uD55C\uB2E4\uB294
        \uB73B\uC740 \uC544\uB2D9\uB2C8\uB2E4."
      player: 1
      narration: 0
    - npcId: npc-economic-reporter-lee-mingyu
      text: "\uC54C\uACA0\uC2B5\uB2C8\uB2E4. \uADF8 \uC81C\uD55C\uB3C4 \uAC19\uC774
        \uB450\uC8E0. \uAC00\uB824\uB193\uC740 \uBD80\uBD84\uC744 \uACF5\uAC1C\uD588\uB2E4\uACE0
        \uC4F0\uC9C0\uB294 \uC54A\uACA0\uC2B5\uB2C8\uB2E4."
