  - choiceText: "\uC790\uAE08 \uC124\uBA85\uC740 \uD53C\uD558\uACE0 \uC131\uACFC\uB9CC
      \uAC15\uC870\uD55C\uB2E4"
    choiceDescription: "\uC774\uBC88 \uB2F5\uBCC0\uC744 \uAD00\uACC4\uC640 \uAE30\uC5B5\uC5D0
      \uBC18\uC601\uD569\uB2C8\uB2E4. \uD604\uAE08\xB7\uC9C0\uBD84 \uBCC0\uD654 \uC5C6\uC74C."
    playerLine: "\uC790\uAE08 \uC774\uC57C\uAE30\uB294 \uD558\uC9C0 \uC54A\uACA0\uC2B5\uB2C8\uB2E4.
      \uC9C0\uAE08\uAE4C\uC9C0\uC758 \uD22C\uC790 \uC131\uACFC\uB97C \uC911\uC2EC\uC73C\uB85C
      \uBD10\uC8FC\uC2DC\uC8E0."
    resultDialogue: "\uC131\uACFC\uB294 \uB530\uB85C \uD655\uC778\uD558\uACA0\uC2B5\uB2C8\uB2E4.
      \uB2E4\uB9CC \uCC98\uC74C \uC9C8\uBB38\uD55C \uC790\uAE08 \uAD6C\uC870\uC5D0\uB294
      \uB2F5\uD558\uC9C0 \uC54A\uC73C\uC2E0 \uAC78\uB85C \uB0A8\uAE38\uAC8C\uC694.
      \uC88B\uC740 \uACB0\uACFC\uAC00 \uB098\uC654\uB2E4\uACE0 \uADF8 \uC9C8\uBB38\uC774
      \uC5C6\uC5B4\uC9C0\uC9C0\uB294 \uC54A\uC73C\uB2C8\uAE4C\uC694.\n\n\uB124. \uC81C\uAC00
      \uB4E3\uC9C0 \uC54A\uC740 \uC124\uBA85\uC744 \uB4E4\uC5C8\uB2E4\uACE0 \uC4F8
      \uC218\uB3C4 \uC5C6\uC8E0. \uC624\uB298\uC740 \uC5EC\uAE30\uAE4C\uC9C0 \uD655\uC778\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    resultValue: evade
