  eventId: press_interview_01
  category: 0
  tutorialOnly: 0
  title: "\uC774\uBBFC\uADDC \u2014 \uC774\uBC88 \uD310\uB2E8\uC744 \uBB3B\uB294
    \uC778\uD130\uBDF0"
  image: {fileID: 21300000, guid: 5e4f9d2677ff7d14485fc7b35103459b, type: 3}
  cardImage: {fileID: 21300000, guid: 50c03d92d4dbc3141a37c95c1ddcd7c6, type: 3}
  npcArts: []
  highlightImage: {fileID: 0}
  negotiationBackground: {fileID: 21300000, guid: 1b2b6649c93fce445b9d1a65eb733ffb, type: 3}
  description: "\uC774\uBBFC\uADDC \u2014 \uC774\uBC88 \uD310\uB2E8\uC744 \uBB3B\uB294
    \uC778\uD130\uBDF0\uC5D0 \uAD00\uD55C \uBA74\uB2F4 \uC694\uCCAD\uC785\uB2C8\uB2E4.
    \uB0B4\uC6A9\uACFC \uBE44\uC6A9\uC744 \uD655\uC778\uD55C \uB4A4 \uB9CC\uB098\uC2ED\uC2DC\uC624."
  apCost: 1
  startButtonText: "\uB9CC\uB098\uAE30"
  companyIds: []
  speakerNpcId: npc-economic-reporter-lee-mingyu
  speakerName: "\uC774\uBBFC\uADDC"
  speakerRole:
  dialogue: "\uC624\uB298\uC740 \u2018\uCC98\uC74C \uB098\uD0C0\uB09C \uD22C\uC790\uC790\u2019
    \uAC19\uC740 \uC18C\uAC1C\uB294 \uBE7C\uACA0\uC2B5\uB2C8\uB2E4. \uADF8 \uBB38\uC7A5
    \uACC4\uC18D \uC4F0\uBA74 \uC800\uB3C4 \uCC98\uC74C \uBCF4\uB294 \uCC99\uD574\uC57C
    \uD558\uC796\uC544\uC694."
  companyQuestion:
  companyPlayerLine:
  choices:
  - choiceText: "\uACF5\uAC1C \uAC00\uB2A5\uD55C \uC790\uAE08 \uAD6C\uC870\uC640
      \uD310\uB2E8 \uAE30\uC900\uC744 \uBC1D\uD78C\uB2E4"
    choiceDescription: "\uC774\uBC88 \uB2F5\uBCC0\uC744 \uAD00\uACC4\uC640 \uAE30\uC5B5\uC5D0
      \uBC18\uC601\uD569\uB2C8\uB2E4. \uD604\uAE08\xB7\uC9C0\uBD84 \uBCC0\uD654 \uC5C6\uC74C."
    playerLine: "\uACF5\uAC1C\uD560 \uC218 \uC788\uB294 \uBC94\uC704\uC758 \uC790\uAE08
      \uAD6C\uC870\uC640 \uD310\uB2E8 \uAE30\uC900\uC744 \uC124\uBA85\uD558\uACA0\uC2B5\uB2C8\uB2E4.
      \uD655\uC778\uD558\uC9C0 \uC54A\uC740 \uC218\uC775 \uC804\uB9DD\uC774\uB098
      \uC544\uC9C1 \uC815\uD558\uC9C0 \uC54A\uC740 \uC9C0\uC6D0 \uACC4\uD68D\uC740
      \uAD6C\uBD84\uD574\uC8FC\uC138\uC694."
    resultDialogue: "\uB124. \uC124\uBA85 \uAC00\uB2A5\uD55C \uBD80\uBD84\uD558\uACE0
      \uBBF8\uC815\uC778 \uBD80\uBD84\uC744 \uB098\uB220 \uC801\uACA0\uC2B5\uB2C8\uB2E4.
      \uC81C\uAC00 \uD55C \uBB38\uC7A5\uC73C\uB85C \uC904\uC774\uB2E4\uAC00 \uB2E4\uB978
      \uB73B\uC774 \uB418\uBA74 \uB2E4\uC2DC \uD655\uC778\uD560\uAC8C\uC694.\n\n\uC54C\uACA0\uC2B5\uB2C8\uB2E4.
      \uADF8 \uC81C\uD55C\uB3C4 \uAC19\uC774 \uB450\uC8E0. \uAC00\uB824\uB193\uC740
      \uBD80\uBD84\uC744 \uACF5\uAC1C\uD588\uB2E4\uACE0 \uC4F0\uC9C0\uB294 \uC54A\uACA0\uC2B5\uB2C8\uB2E4."
    resultValue: disclose
    npcResult:
