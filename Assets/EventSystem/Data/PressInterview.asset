      \uD558\uC796\uC544\uC694."
    player: 0
    narration: 0
  - npcId:
    text: "\uADF8\uB7EC\uBA74 \uBB34\uC5C7\uC744 \uBB3C\uC73C\uC2E4 \uAC81\uB2C8\uAE4C?"
    player: 1
    narration: 0
  - npcId: npc-economic-reporter-lee-mingyu
    text: "\uC9C0\uAE08\uC740 \uBB58 \uBCF4\uACE0 \uACB0\uC815\uD558\uC2DC\uB294\uC9C0\uC694.
      \uC790\uAE08\uC740 \uC5B4\uB5A4 \uBC94\uC704\uC5D0\uC11C \uC124\uBA85\uD558\uC2E4
      \uC218 \uC788\uB294\uC9C0\uB3C4 \uD655\uC778\uD558\uACE0\uC694. \uC8FC\uC2DD\uC744
      \uC0C0\uB2E4\uB294 \uC18C\uC2DD\uB9CC \uC4F0\uBA74 \uC0AC\uB78C\uB4E4 \uC0C1\uC0C1\uB825\uC774
      \uAE30\uC0AC\uB97C \uB300\uC2E0\uD558\uB354\uB77C\uACE0\uC694."
    player: 0
    narration: 0
  - npcId:
    text: "\uACF5\uAC1C\uD558\uAE30 \uC5B4\uB824\uC6B4 \uBD80\uBD84\uB3C4 \uC788\uC2B5\uB2C8\uB2E4."
    player: 1
    narration: 0
  - npcId: npc-economic-reporter-lee-mingyu
    text: "\uADF8\uB7FC \uADF8 \uBC94\uC704\uBD80\uD130 \uB9D0\uC500\uD574\uC8FC\uC138\uC694.
      \uB300\uB2F5 \uC548 \uD55C \uBD80\uBD84\uC744 \uC81C\uAC00 \uC54C\uC544\uC11C
      \uC88B\uC740 \uCABD\uC73C\uB85C \uCC44\uC6B8 \uC218\uB294 \uC5C6\uC73C\uB2C8\uAE4C\uC694."
    player: 0
    narration: 0
  companyVariants: []
